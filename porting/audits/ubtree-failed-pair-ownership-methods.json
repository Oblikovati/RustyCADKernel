    "editable1 NB1/NO2/AB1 plus Clear": "ebtree_native_add_contracts::unpublished_pair_failure_retains_native_allocation_and_exact_callbacks",
    "reset lease and expired borrowed bytes": "Rust-only safety regressions; native Incremental reset does not enforce safe live-owner leases",
    "all allocator policy repair/ZST/owned cleanup": "ncollection::ubtree::storage::pair::failed_contracts private-owner tests"
  },
  "compatibility": {
    "public_api": "No new public methods or tightened bounds. Existing borrowed/static payload, covariance, Send/Sync/Unpin/unwind, standalone node dropck and partial move probes pass; short-lived tree references/Rc Send/Cell Sync remain rejected.",
    "borrowing": "A regression abandons children containing borrowed strings, then clears the live tree, expires the strings and resets the raw allocator without inspecting those expired bytes. Strict Miri validates this path.",
    "reset": "All eight prepublication failures on an Incremental allocator retain the live root lease until Clear; reset fails before Clear, then succeeds and reuses the original block after Clear. Dropped completed pairs do not retain hidden allocator handles or typed leases.",
