+}
+
+/// `Prs3d_DatumParts`: the parts of a datum.
+#[repr(i32)]
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash, PartialOrd, Ord)]
+pub enum Prs3dDatumParts {
+    /// `Prs3d_DatumParts_Origin`.
