+++ b/crates/tkv3d/src/v3d/enums.rs
@@ -0,0 +1,207 @@
+//! The V3d enumerations and `V3d_ImageDumpOptions`, with their native discriminants.
+use rustycad_tkservice::graphic3d::{
+    GRAPHIC3D_ZLAYER_ID_BOT_OSD, Graphic3dBufferType, Graphic3dZLayerId,
+};
+
+/// `V3d_TypeOfAxe`: the view axes.
+#[repr(i32)]
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub enum V3dTypeOfAxe {
+    /// `V3d_X`.
+    X = 0,
+    /// `V3d_Y`.
+    Y = 1,
+    /// `V3d_Z`.
+    Z = 2,
+}
+
+/// `V3d_TypeOfView`: orthographic or perspective projection.
+#[repr(i32)]
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub enum V3dTypeOfView {
+    /// `V3d_ORTHOGRAPHIC`.
+    Orthographic = 0,
+    /// `V3d_PERSPECTIVE`.
+    Perspective = 1,
+}
+
+/// `V3d_TypeOfVisualization`: wireframe or Z-buffer.
+#[repr(i32)]
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub enum V3dTypeOfVisualization {
+    /// `V3d_WIREFRAME`.
+    Wireframe = 0,
+    /// `V3d_ZBUFFER`.
+    Zbuffer = 1,
+}
+
+/// `V3d_StereoDumpOptions`: which stereo projection a view dump renders.
+#[repr(i32)]
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub enum V3dStereoDumpOptions {
+    /// `V3d_SDO_MONO`: the monographic middle projection.
+    Mono = 0,
+    /// `V3d_SDO_LEFT_EYE`.
+    LeftEye = 1,
+    /// `V3d_SDO_RIGHT_EYE`.
+    RightEye = 2,
+    /// `V3d_SDO_BLENDED`: the blended pair of the active stereo mode.
+    Blended = 3,
+}
+
+/// `V3d_TypeOfOrientation`: the predefined view directions.
+#[repr(i32)]
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash, PartialOrd, Ord)]
+#[allow(missing_docs)]
+pub enum V3dTypeOfOrientation {
+    Xpos = 0,
+    Ypos = 1,
+    Zpos = 2,
+    Xneg = 3,
+    Yneg = 4,
+    Zneg = 5,
+    XposYpos = 6,
+    XposZpos = 7,
+    YposZpos = 8,
+    XnegYneg = 9,
+    XnegYpos = 10,
+    XnegZneg = 11,
+    XnegZpos = 12,
+    YnegZneg = 13,
+    YnegZpos = 14,
+    XposYneg = 15,
+    XposZneg = 16,
+    YposZneg = 17,
+    XposYposZpos = 18,
+    XposYnegZpos = 19,
+    XposYposZneg = 20,
+    XnegYposZpos = 21,
+    XposYnegZneg = 22,
+    XnegYposZneg = 23,
+    XnegYnegZpos = 24,
+    XnegYnegZneg = 25,
+}
+
+impl V3dTypeOfOrientation {
+    /// Every orientation in native order.
+    pub const ALL: [Self; 26] = [
+        Self::Xpos,
+        Self::Ypos,
+        Self::Zpos,
+        Self::Xneg,
+        Self::Yneg,
+        Self::Zneg,
+        Self::XposYpos,
+        Self::XposZpos,
+        Self::YposZpos,
+        Self::XnegYneg,
+        Self::XnegYpos,
+        Self::XnegZneg,
+        Self::XnegZpos,
+        Self::YnegZneg,
+        Self::YnegZpos,
+        Self::XposYneg,
+        Self::XposZneg,
+        Self::YposZneg,
+        Self::XposYposZpos,
+        Self::XposYnegZpos,
+        Self::XposYposZneg,
+        Self::XnegYposZpos,
+        Self::XposYnegZneg,
+        Self::XnegYposZneg,
+        Self::XnegYnegZpos,
+        Self::XnegYnegZneg,
+    ];
+    /// `V3d_TypeOfOrientation_Zup_AxoLeft`.
+    pub const ZUP_AXO_LEFT: Self = Self::XnegYnegZpos;
+    /// `V3d_TypeOfOrientation_Zup_AxoRight`.
+    pub const ZUP_AXO_RIGHT: Self = Self::XposYnegZpos;
+    /// `V3d_TypeOfOrientation_Zup_Front`.
+    pub const ZUP_FRONT: Self = Self::Yneg;
+    /// `V3d_TypeOfOrientation_Zup_Back`.
+    pub const ZUP_BACK: Self = Self::Ypos;
+    /// `V3d_TypeOfOrientation_Zup_Top`.
+    pub const ZUP_TOP: Self = Self::Zpos;
+    /// `V3d_TypeOfOrientation_Zup_Bottom`.
+    pub const ZUP_BOTTOM: Self = Self::Zneg;
+    /// `V3d_TypeOfOrientation_Zup_Left`.
+    pub const ZUP_LEFT: Self = Self::Xneg;
+    /// `V3d_TypeOfOrientation_Zup_Right`.
+    pub const ZUP_RIGHT: Self = Self::Xpos;
+    /// `V3d_TypeOfOrientation_Yup_AxoLeft`.
+    pub const YUP_AXO_LEFT: Self = Self::XnegYposZpos;
+    /// `V3d_TypeOfOrientation_Yup_AxoRight`.
+    pub const YUP_AXO_RIGHT: Self = Self::XposYposZpos;
+    /// `V3d_TypeOfOrientation_Yup_Front`.
+    pub const YUP_FRONT: Self = Self::Zpos;
+    /// `V3d_TypeOfOrientation_Yup_Back`.
+    pub const YUP_BACK: Self = Self::Zneg;
+    /// `V3d_TypeOfOrientation_Yup_Top`.
+    pub const YUP_TOP: Self = Self::Ypos;
+    /// `V3d_TypeOfOrientation_Yup_Bottom`.
+    pub const YUP_BOTTOM: Self = Self::Yneg;
+    /// `V3d_TypeOfOrientation_Yup_Left`.
+    pub const YUP_LEFT: Self = Self::Xpos;
+    /// `V3d_TypeOfOrientation_Yup_Right`.
+    pub const YUP_RIGHT: Self = Self::Xneg;
+}
+
+/// `V3d_ImageDumpOptions`: the parameters of `V3d_View::ToPixMap`.
+///
+/// Example: `let options = V3dImageDumpOptions { width: 64, height: 32, ..Default::default() };`.
+#[derive(Clone, Debug, PartialEq)]
+pub struct V3dImageDumpOptions {
+    /// `Width`: 0 means an already allocated image.
+    pub width: i32,
+    /// `Height`: 0 means an already allocated image.
+    pub height: i32,
+    /// `BufferType`.
+    pub buffer_type: Graphic3dBufferType,
+    /// `StereoOptions`.
+    pub stereo_options: V3dStereoDumpOptions,
+    /// `TileSize`: 0 for automatic tiling.
+    pub tile_size: i32,
+    /// `ToAdjustAspect`.
+    pub to_adjust_aspect: bool,
+    /// `TargetZLayerId`.
+    pub target_z_layer_id: Graphic3dZLayerId,
+    /// `IsSingleLayer`.
+    pub is_single_layer: bool,
+    /// `LightName`: the light whose shadow map is dumped.
+    pub light_name: String,
+}
+
+impl Default for V3dImageDumpOptions {
+    /// RGB, mono, automatic tiling, aspect adjusted, up to the bottom OSD layer.
+    fn default() -> Self {
+        Self {
+            width: 0,
+            height: 0,
+            buffer_type: Graphic3dBufferType::Rgb,
+            stereo_options: V3dStereoDumpOptions::Mono,
+            tile_size: 0,
+            to_adjust_aspect: true,
+            target_z_layer_id: GRAPHIC3D_ZLAYER_ID_BOT_OSD,
+            is_single_layer: false,
+            light_name: String::new(),
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn discriminants_and_aliases() {
+        assert_eq!(V3dTypeOfOrientation::XnegYnegZneg as i32, 25);
+        assert_eq!(
+            V3dTypeOfOrientation::ALL[19],
+            V3dTypeOfOrientation::XposYnegZpos
+        );
+        assert_eq!(V3dTypeOfOrientation::YUP_RIGHT, V3dTypeOfOrientation::Xneg);
+        assert_eq!(V3dStereoDumpOptions::Blended as i32, 3);
+        let options = V3dImageDumpOptions::default();
+        assert!(options.to_adjust_aspect && !options.is_single_layer);
+    }
+}
diff --git a/crates/tkv3d/src/v3d/grid_common.rs b/crates/tkv3d/src/v3d/grid_common.rs
new file mode 100644
index 000000000..0f3eab220
--- /dev/null
+++ b/crates/tkv3d/src/v3d/grid_common.rs
@@ -0,0 +1,125 @@
+//! The code that `V3d_RectangularGrid` and `V3d_CircularGrid` repeat natively: the placement
+//! of the grid structure in the privileged plane and the end of a group rebuild.
+use super::V3dViewer;
+use rustycad_tkernel::standard::{Failure, Handle};
+use rustycad_tkmath::gp::{Axis3, Transform3};
+use rustycad_tkmath::toploc::Datum3;
+use rustycad_tkservice::graphic3d::{
+    Graphic3dGroup, Graphic3dGroupMembers as _, Graphic3dStructureMembers as _,
+    Graphic3dStructureSource,
+};
+
+/// The placement a grid structure was last transformed with (`myCurViewPlane`, `myCurXo`,
+/// `myCurYo`, `myCurAngle`).
+#[derive(Clone, Copy, Debug, Default)]
+pub(crate) struct V3dGridPlacement {
+    pub(crate) view_plane: Axis3,
+    pub(crate) x_origin: f64,
+    pub(crate) y_origin: f64,
+    pub(crate) angle: f64,
+}
+
+/// The twelve coordinates of a frame, compared field by field natively.
+fn frame_values(plane: &Axis3) -> [f64; 12] {
+    let (l, x, y, d) = (
+        plane.location(),
+        plane.x_direction(),
+        plane.y_direction(),
+        plane.direction(),
+    );
+    [
+        l.x(),
+        l.y(),
+        l.z(),
+        x.x(),
+        x.y(),
+        x.z(),
+        y.x(),
+        y.y(),
+        y.z(),
+        d.x(),
+        d.y(),
+        d.z(),
+    ]
+}
+
+impl V3dGridPlacement {
+    /// Whether the structure needs a new transformation (`MakeTransform`).
+    pub(crate) fn needs_transform(&self, defined: bool, plane: &Axis3, wanted: &Self) -> bool {
+        if !defined {
+            return true;
+        }
+        if wanted.angle != self.angle
+            || wanted.x_origin != self.x_origin
+            || wanted.y_origin != self.y_origin
+        {
+            return true;
+        }
+        frame_values(plane) != frame_values(&self.view_plane)
+    }
+    /// The privileged plane frame composed with the grid rotation and origin.
+    pub(crate) fn transformation(&self) -> Result<Transform3, Failure> {
+        let [xl, yl, zl, xdx, xdy, xdz, ydx, ydy, ydz, dx, dy, dz] = frame_values(&self.view_plane);
+        let (cos_alpha, sin_alpha) = (self.angle.cos(), self.angle.sin());
+        let mut trsf = Transform3::default();
+        trsf.set_values([[xdx, ydx, dx, xl], [xdy, ydy, dy, yl], [xdz, ydz, dz, zl]])?;
+        let mut trsf2 = Transform3::default();
+        trsf2.set_values([
+            [cos_alpha, sin_alpha, 0.0, -self.x_origin],
+            [-sin_alpha, cos_alpha, 0.0, -self.y_origin],
+            [0.0, 0.0, 1.0, 0.0],
+        ])?;
+        trsf.multiply(trsf2);
+        Ok(trsf)
+    }
+    /// Applies the transformation to the grid structure.
+    pub(crate) fn apply(
+        &self,
+        structure: &Handle<dyn Graphic3dStructureSource>,
+    ) -> Result<(), Failure> {
+        let trsf = self.transformation()?;
+        if let Some(value) = structure.get() {
+            value.set_transformation(&Handle::new(Datum3::new(trsf)));
+        }
+        Ok(())
+    }
+}
+
+/// The end of a group rebuild: the group bounds, the structure box and a manager update.
+pub(crate) fn finish_grid_group(
+    group: &Handle<dyn Graphic3dGroup>,
+    structure: &Handle<dyn Graphic3dStructureSource>,
+    viewer: &Handle<V3dViewer>,
+    min_max: [f64; 6],
+) {
+    if let Some(group) = group.get() {
+        group.set_min_max_values(min_max);
+    }
+    let Some(value) = structure.get() else {
+        return;
+    };
+    value.calculate_bound_box();
+    if let Some(manager) = viewer.get().map(V3dViewer::structure_manager)
+        && let Some(manager) = manager.get()
+    {
+        manager.update(value.get_z_layer());
+    }
+}
+
+/// Whether the grid geometry must be rebuilt: `toUpdate`, `myToComputePrs` and the display
+/// state; marks a pending rebuild when the structure is not displayed. Returns true to rebuild.
+pub(crate) fn should_rebuild(
+    to_update: bool,
+    to_compute_prs: &mut bool,
+    structure: &Handle<dyn Graphic3dStructureSource>,
+) -> bool {
+    if !to_update && !*to_compute_prs {
+        return false;
+    }
+    if !structure.get().is_some_and(|s| s.is_displayed()) {
+        *to_compute_prs = true;
+        return false;
+    }
+    *to_compute_prs = false;
+    true
+}
diff --git a/crates/tkv3d/src/v3d/lights.rs b/crates/tkv3d/src/v3d/lights.rs
new file mode 100644
index 000000000..00d664ed2
--- /dev/null
+++ b/crates/tkv3d/src/v3d/lights.rs
@@ -0,0 +1,198 @@
+//! The V3d light classes over `Graphic3d_CLight` (`V3d_Light` is a typedef of it):
+//! `V3d_AmbientLight`, `V3d_PositionLight`, `V3d_DirectionalLight`, `V3d_PositionalLight` and
+//! `V3d_SpotLight`. Each embeds its parent and derefs to it; the members the native classes
+//! re-declare as private (`using Graphic3d_CLight::SetAngle` for an ambient light...) stay
+//! reachable through the parent, as they do natively through a `Graphic3d_CLight` handle.
+use super::{V3d, V3dTypeOfOrientation};
+use rustycad_tkernel::quantity::Color;
+use rustycad_tkernel::standard::Failure;
+use rustycad_tkmath::gp::{Direction3, Point3};
+use rustycad_tkservice::graphic3d::{Graphic3dCLight, Graphic3dTypeOfLightSource};
+
+/// Implements `Deref` to the embedded parent light.
+macro_rules! light_parent {
+    ($ty:ident, $parent:ty, $field:ident) => {
+        impl std::ops::Deref for $ty {
+            type Target = $parent;
+            fn deref(&self) -> &$parent {
+                &self.$field
+            }
+        }
+    };
+}
+
+/// An ambient light; `V3dAmbientLight::new(white)`.
+pub struct V3dAmbientLight {
+    light: Graphic3dCLight,
+}
+rustycad_tkernel::impl_transient!(V3dAmbientLight, "V3d_AmbientLight", Graphic3dCLight, light);
+light_parent!(V3dAmbientLight, Graphic3dCLight, light);
+
+impl V3dAmbientLight {
+    /// An ambient light of a color; `V3dAmbientLight::new(white)`.
+    pub fn new(color: Color) -> Self {
+        let light = Graphic3dCLight::new(Graphic3dTypeOfLightSource::Ambient);
+        light.set_color(color);
+        Self { light }
+    }
+}
+
+/// The base of the lights with a position or a direction (`V3d_PositionLight`).
+pub struct V3dPositionLight {
+    light: Graphic3dCLight,
+}
+rustycad_tkernel::impl_transient!(
+    V3dPositionLight,
+    "V3d_PositionLight",
+    Graphic3dCLight,
+    light
+);
+light_parent!(V3dPositionLight, Graphic3dCLight, light);
+
+impl V3dPositionLight {
+    /// The protected constructor: a light of a source type; `V3dPositionLight::new(kind)`.
+    pub fn new(kind: Graphic3dTypeOfLightSource) -> Self {
+        Self {
+            light: Graphic3dCLight::new(kind),
+        }
+    }
+}
+
+/// A directional light; `V3dDirectionalLight::new(V3dTypeOfOrientation::Zneg, white, true)?`.
+pub struct V3dDirectionalLight {
+    base: V3dPositionLight,
+}
+rustycad_tkernel::impl_transient!(
+    V3dDirectionalLight,
+    "V3d_DirectionalLight",
+    V3dPositionLight,
+    base
+);
+light_parent!(V3dDirectionalLight, V3dPositionLight, base);
+
+impl V3dDirectionalLight {
+    /// A directional light along a predefined orientation; setting a headlight on a
+    /// non-directional light raises natively, here the light is directional.
+    /// Example: `V3dDirectionalLight::new(V3dTypeOfOrientation::XposYposZpos, white, false)?`.
+    pub fn new(
+        direction: V3dTypeOfOrientation,
+        color: Color,
+        is_headlight: bool,
+    ) -> Result<Self, Failure> {
+        Self::with_direction(&V3d::get_proj_axis(direction), color, is_headlight)
+    }
+    /// A directional light along a direction; `V3dDirectionalLight::with_direction(&dir, white, false)?`.
+    pub fn with_direction(
+        direction: &Direction3,
+        color: Color,
+        is_headlight: bool,
+    ) -> Result<Self, Failure> {
+        let base = V3dPositionLight::new(Graphic3dTypeOfLightSource::Directional);
+        base.set_color(color);
+        base.set_headlight(is_headlight)?;
+        base.set_direction(direction)?;
+        Ok(Self { base })
+    }
+    /// `SetDirection(V3d_TypeOfOrientation)`; `light.set_direction_orientation(V3dTypeOfOrientation::Zneg)?`.
+    pub fn set_direction_orientation(
+        &self,
+        direction: V3dTypeOfOrientation,
+    ) -> Result<(), Failure> {
+        self.set_direction(&V3d::get_proj_axis(direction))
+    }
+}
+
+/// A positional (point) light; `V3dPositionalLight::new(&p, white)?`.
+pub struct V3dPositionalLight {
+    base: V3dPositionLight,
+}
+rustycad_tkernel::impl_transient!(
+    V3dPositionalLight,
+    "V3d_PositionalLight",
+    V3dPositionLight,
+    base
+);
+light_parent!(V3dPositionalLight, V3dPositionLight, base);
+
+impl V3dPositionalLight {
+    /// A point light at a position; `V3dPositionalLight::new(&p, white)?`.
+    pub fn new(position: &Point3, color: Color) -> Result<Self, Failure> {
+        let base = V3dPositionLight::new(Graphic3dTypeOfLightSource::Positional);
+        base.set_color(color);
+        base.set_position(position)?;
+        Ok(Self { base })
+    }
+}
+
+/// A spot light; `V3dSpotLight::new(&p, V3dTypeOfOrientation::XnegYnegZpos, white)?`.
+pub struct V3dSpotLight {
+    base: V3dPositionLight,
+}
+rustycad_tkernel::impl_transient!(V3dSpotLight, "V3d_SpotLight", V3dPositionLight, base);
+light_parent!(V3dSpotLight, V3dPositionLight, base);
+
+impl V3dSpotLight {
+    /// A spot light at a position along a predefined orientation.
+    /// Example: `V3dSpotLight::new(&p, V3dTypeOfOrientation::Zneg, white)?`.
+    pub fn new(
+        position: &Point3,
+        direction: V3dTypeOfOrientation,
+        color: Color,
+    ) -> Result<Self, Failure> {
+        Self::with_direction(position, &V3d::get_proj_axis(direction), color)
+    }
+    /// A spot light at a position along a direction; `V3dSpotLight::with_direction(&p, &dir, white)?`.
+    pub fn with_direction(
+        position: &Point3,
+        direction: &Direction3,
+        color: Color,
+    ) -> Result<Self, Failure> {
+        let base = V3dPositionLight::new(Graphic3dTypeOfLightSource::Spot);
+        base.set_color(color);
+        base.set_position(position)?;
+        base.set_direction(direction)?;
+        Ok(Self { base })
+    }
+    /// `SetDirection(V3d_TypeOfOrientation)`; `light.set_direction_orientation(V3dTypeOfOrientation::Yneg)?`.
+    pub fn set_direction_orientation(
+        &self,
+        direction: V3dTypeOfOrientation,
+    ) -> Result<(), Failure> {
+        self.set_direction(&V3d::get_proj_axis(direction))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use rustycad_tkernel::quantity::NamedColor;
+    use rustycad_tkernel::standard::{Handle, RuntimeTyped};
+
+    #[test]
+    fn lights_keep_type_color_and_geometry() {
+        let white = Color::named(NamedColor::WHITE);
+        let ambient = V3dAmbientLight::new(white);
+        assert_eq!(ambient.light_type(), Graphic3dTypeOfLightSource::Ambient);
+        let dir = V3dDirectionalLight::new(V3dTypeOfOrientation::Zneg, white, true).unwrap();
+        assert!(dir.is_headlight());
+        assert_eq!(dir.direction().unwrap().z(), -1.0);
+        let spot = V3dSpotLight::new(
+            &Point3::new(1.0, 2.0, 3.0),
+            V3dTypeOfOrientation::Xpos,
+            white,
+        )
+        .unwrap();
+        assert_eq!(spot.position().x(), 1.0);
+        spot.set_direction_orientation(V3dTypeOfOrientation::Yneg)
+            .unwrap();
+        assert_eq!(spot.direction().unwrap().y(), -1.0);
+        let point =
+            Handle::new(V3dPositionalLight::new(&Point3::new(0.0, 0.0, 5.0), white).unwrap());
+        let base: Handle<Graphic3dCLight> = point.clone().cast();
+        assert!(!base.is_null());
+        assert_eq!(
+            point.dynamic_type().unwrap().name(),
+            V3dPositionalLight::TYPE_NAME
+        );
+    }
+}
