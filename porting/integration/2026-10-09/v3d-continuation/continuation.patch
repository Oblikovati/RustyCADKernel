@@ -0,0 +1,39 @@
+//! The SelectBasics package: the pick result and the abstract selecting volume that the
+//! Select3D sensitive entities test themselves against.
+mod pick_result;
+mod selecting_volume_manager;
+
+pub use pick_result::SelectBasicsPickResult;
+pub use selecting_volume_manager::{
+    SelectBasicsSelectingVolumeManager, SelectBasicsSelectionTypeAliases,
+};
+
+/// The package class `SelectBasics`: the owner priority range.
+pub struct SelectBasics;
+
+impl SelectBasics {
+    /// `MaxOwnerPriority`: 9; `SelectBasics::max_owner_priority()`.
+    pub fn max_owner_priority() -> i32 {
+        9
+    }
+    /// `MinOwnerPriority`: 0; `SelectBasics::min_owner_priority()`.
+    pub fn min_owner_priority() -> i32 {
+        0
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn owner_priority_range_is_zero_to_nine() {
+        assert_eq!(
+            (
+                SelectBasics::min_owner_priority(),
+                SelectBasics::max_owner_priority()
+            ),
+            (0, 9)
+        );
+    }
+}
diff --git a/crates/tkv3d/src/select_basics/pick_result.rs b/crates/tkv3d/src/select_basics/pick_result.rs
new file mode 100644
index 000000000..6f0374fdb
--- /dev/null
+++ b/crates/tkv3d/src/select_basics/pick_result.rs
@@ -0,0 +1,142 @@
+//! `SelectBasics_PickResult`: the depth, picked point, surface normal and distance to the
+//! geometry center of one detection.
+use rustycad_tkernel::ncollection::Vec3;
+use rustycad_tkernel::standard::real::real_last;
+use rustycad_tkmath::gp::{Point3, Vector3};
+
+/// The all-in-one result of `Select3D_SensitiveEntity::Matches`.
+///
+/// Example: `let mut pick = SelectBasicsPickResult::default(); pick.set_depth(2.0); assert!(pick.is_valid());`.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct SelectBasicsPickResult {
+    obj_picked_pnt: Point3,
+    normal: Vec3<f32>,
+    depth: f64,
+    dist_to_center: f64,
+}
+
+impl Default for SelectBasicsPickResult {
+    /// The invalid result: depth, distance and picked X at `RealLast`.
+    fn default() -> Self {
+        Self {
+            obj_picked_pnt: Point3::new(real_last(), 0.0, 0.0),
+            normal: Vec3::new(0.0, 0.0, 0.0),
+            depth: real_last(),
+            dist_to_center: real_last(),
+        }
+    }
+}
+
+impl SelectBasicsPickResult {
+    /// A defined result; `SelectBasicsPickResult::new(1.0, 0.5, Point3::new(0.0, 0.0, 1.0))`.
+    pub fn new(depth: f64, dist_to_center: f64, obj_picked_pnt: Point3) -> Self {
+        Self {
+            obj_picked_pnt,
+            normal: Vec3::new(0.0, 0.0, 0.0),
+            depth,
+            dist_to_center,
+        }
+    }
+    /// `Min`: the closest of two results by depth, the first one on a tie.
+    /// Example: `SelectBasicsPickResult::min(&a, &b).depth()`.
+    pub fn min<'a>(first: &'a Self, second: &'a Self) -> &'a Self {
+        if first.depth() <= second.depth() {
+            first
+        } else {
+            second
+        }
+    }
+    /// Whether the depth is defined; `pick.is_valid()`.
+    pub fn is_valid(&self) -> bool {
+        self.depth != real_last()
+    }
+    /// Resets the depth, the picked point and the normal; `pick.invalidate()`.
+    pub fn invalidate(&mut self) {
+        self.depth = real_last();
+        self.obj_picked_pnt = Point3::new(real_last(), 0.0, 0.0);
+        self.normal = Vec3::new(0.0, 0.0, 0.0);
+    }
+    /// The depth along the picking ray; `pick.depth()`.
+    pub fn depth(&self) -> f64 {
+        self.depth
+    }
+    /// Sets the depth; `pick.set_depth(1.5)`.
+    pub fn set_depth(&mut self, depth: f64) {
+        self.depth = depth;
+    }
+    /// Whether a picked point was set; `pick.has_picked_point()`.
+    pub fn has_picked_point(&self) -> bool {
+        self.obj_picked_pnt.x() != real_last()
+    }
+    /// The picked point, in the local coordinate system of the entity; `pick.picked_point()`.
+    pub fn picked_point(&self) -> &Point3 {
+        &self.obj_picked_pnt
+    }
+    /// Sets the picked point; `pick.set_picked_point(Point3::new(1.0, 2.0, 3.0))`.
+    pub fn set_picked_point(&mut self, point: Point3) {
+        self.obj_picked_pnt = point;
+    }
+    /// The distance to the geometry center; `pick.dist_to_geom_center()`.
+    pub fn dist_to_geom_center(&self) -> f64 {
+        self.dist_to_center
+    }
+    /// Sets the distance to the geometry center; `pick.set_dist_to_geom_center(0.25)`.
+    pub fn set_dist_to_geom_center(&mut self, distance: f64) {
+        self.dist_to_center = distance;
+    }
+    /// The unnormalized surface normal (zero when undefined), local coordinates; `pick.surface_normal()`.
+    pub fn surface_normal(&self) -> &Vec3<f32> {
+        &self.normal
+    }
+    /// Sets the surface normal; `pick.set_surface_normal(Vec3::new(0.0, 0.0, 1.0))`.
+    pub fn set_surface_normal(&mut self, normal: Vec3<f32>) {
+        self.normal = normal;
+    }
+    /// Sets the surface normal from a vector, narrowed to float; `pick.set_surface_normal_vec(&v)`.
+    pub fn set_surface_normal_vec(&mut self, normal: &Vector3) {
+        self.normal = Vec3::new(normal.x() as f32, normal.y() as f32, normal.z() as f32);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn default_result_is_invalid_and_has_no_point() {
+        let pick = SelectBasicsPickResult::default();
+        assert!(!pick.is_valid());
+        assert!(!pick.has_picked_point());
+        assert_eq!(pick.dist_to_geom_center(), real_last());
+    }
+
+    #[test]
+    fn min_prefers_the_first_on_ties() {
+        let a = SelectBasicsPickResult::new(1.0, 2.0, Point3::default());
+        let b = SelectBasicsPickResult::new(1.0, 3.0, Point3::default());
+        assert_eq!(
+            SelectBasicsPickResult::min(&a, &b).dist_to_geom_center(),
+            2.0
+        );
+        let c = SelectBasicsPickResult::new(0.5, 4.0, Point3::default());
+        assert_eq!(
+            SelectBasicsPickResult::min(&a, &c).dist_to_geom_center(),
+            4.0
+        );
+    }
+
+    #[test]
+    fn invalidate_resets_depth_point_and_normal() {
+        let mut pick = SelectBasicsPickResult::new(1.0, 2.0, Point3::new(1.0, 2.0, 3.0));
+        pick.set_surface_normal_vec(&Vector3::new(0.1, 0.2, 0.3));
+        assert_eq!(pick.surface_normal().z, 0.3f32);
+        pick.invalidate();
+        assert!(!pick.is_valid() && !pick.has_picked_point());
+        assert_eq!(pick.surface_normal().x, 0.0);
+        pick.set_depth(3.0);
+        pick.set_picked_point(Point3::new(4.0, 0.0, 0.0));
+        pick.set_dist_to_geom_center(5.0);
+        assert!(pick.is_valid() && pick.has_picked_point());
+        assert_eq!((pick.depth(), pick.picked_point().x()), (3.0, 4.0));
+    }
+}
diff --git a/crates/tkv3d/src/select_basics/selecting_volume_manager.rs b/crates/tkv3d/src/select_basics/selecting_volume_manager.rs
new file mode 100644
index 000000000..4ef8d2e2d
--- /dev/null
+++ b/crates/tkv3d/src/select_basics/selecting_volume_manager.rs
@@ -0,0 +1,169 @@
+//! `SelectBasics_SelectingVolumeManager`: the abstract selecting volume that the sensitive
+//! entities test themselves against (v3d-design.md section 2).
+//!
+//! The native overloads that differ by their last argument get one name each: the pick-result
+//! form keeps the native name (`overlaps_box`), the `bool* theInside` form takes the suffix
+//! `_inside` and an `Option<&mut bool>` (`None` is the native null pointer), and the
+//! depth-less point test is `overlaps_point_only`.
+use super::SelectBasicsPickResult;
+use crate::select_mgr::SelectMgrSelectionType;
+use rustycad_tkernel::ncollection::{Array1, DynamicArray, HArray1, Vec3, Vec4};
+use rustycad_tkernel::standard::Failure;
+use rustycad_tkernel::standard::dump::DumpStream;
+use rustycad_tkmath::gp::{Direction3, Point2, Point3, Transform3};
+use std::io;
+
+/// A selecting volume (frustum, frustum set or axis) as seen by the sensitive entities.
+///
+/// Example: `if manager.overlaps_point(&p, &mut pick) { pick.depth(); }`.
+pub trait SelectBasicsSelectingVolumeManager {
+    /// `GetActiveSelectionType`; `manager.get_active_selection_type()`.
+    fn get_active_selection_type(&self) -> SelectMgrSelectionType;
+    /// `OverlapsBox` with depth: whether the box overlaps the volume; `manager.overlaps_box(&min, &max, &mut pick)`.
+    fn overlaps_box(
+        &self,
+        box_min: &Vec3<f64>,
+        box_max: &Vec3<f64>,
+        pick_result: &mut SelectBasicsPickResult,
+    ) -> Result<bool, Failure>;
+    /// `OverlapsBox` with the full-inside flag; `manager.overlaps_box_inside(&min, &max, Some(&mut inside))`.
+    fn overlaps_box_inside(
+        &self,
+        box_min: &Vec3<f64>,
+        box_max: &Vec3<f64>,
+        inside: Option<&mut bool>,
+    ) -> Result<bool, Failure>;
+    /// `OverlapsPoint` with depth; `manager.overlaps_point(&p, &mut pick)`.
+    fn overlaps_point(
+        &self,
+        point: &Point3,
+        pick_result: &mut SelectBasicsPickResult,
+    ) -> Result<bool, Failure>;
+    /// `OverlapsPoint` without depth (the inclusion helper); `manager.overlaps_point_only(&p)`.
+    fn overlaps_point_only(&self, point: &Point3) -> Result<bool, Failure>;
+    /// `OverlapsPolygon`; `sens_type` is a `Select3D_TypeOfSensitivity` value.
+    /// Example: `manager.overlaps_polygon(&points, 0, &mut pick)`.
+    fn overlaps_polygon(
+        &self,
+        points: &Array1<'_, Point3>,
+        sens_type: i32,
+        pick_result: &mut SelectBasicsPickResult,
+    ) -> Result<bool, Failure>;
+    /// `OverlapsSegment`; `manager.overlaps_segment(&a, &b, &mut pick)`.
+    fn overlaps_segment(
+        &self,
+        pt1: &Point3,
+        pt2: &Point3,
+        pick_result: &mut SelectBasicsPickResult,
+    ) -> Result<bool, Failure>;
+    /// `OverlapsTriangle`; `manager.overlaps_triangle(&a, &b, &c, 0, &mut pick)`.
+    fn overlaps_triangle(
+        &self,
+        pt1: &Point3,
+        pt2: &Point3,
+        pt3: &Point3,
+        sens_type: i32,
+        pick_result: &mut SelectBasicsPickResult,
+    ) -> Result<bool, Failure>;
+    /// `OverlapsSphere` with depth; `manager.overlaps_sphere(&center, 1.0, &mut pick)`.
+    fn overlaps_sphere(
+        &self,
+        center: &Point3,
+        radius: f64,
+        pick_result: &mut SelectBasicsPickResult,
+    ) -> Result<bool, Failure>;
+    /// `OverlapsSphere` with the full-inside flag; `manager.overlaps_sphere_inside(&c, 1.0, None)`.
+    fn overlaps_sphere_inside(
+        &self,
+        center: &Point3,
+        radius: f64,
+        inside: Option<&mut bool>,
+    ) -> Result<bool, Failure>;
+    /// `OverlapsCylinder` with depth (a cone when the radii differ).
+    /// Example: `manager.overlaps_cylinder(1.0, 1.0, 2.0, &trsf, false, &mut pick)`.
+    fn overlaps_cylinder(
+        &self,
+        bottom_rad: f64,
+        top_rad: f64,
+        height: f64,
+        trsf: &Transform3,
+        is_hollow: bool,
+        pick_result: &mut SelectBasicsPickResult,
+    ) -> Result<bool, Failure>;
+    /// `OverlapsCylinder` with the full-inside flag.
+    /// Example: `manager.overlaps_cylinder_inside(1.0, 1.0, 2.0, &trsf, false, None)`.
+    fn overlaps_cylinder_inside(
+        &self,
+        bottom_rad: f64,
+        top_rad: f64,
+        height: f64,
+        trsf: &Transform3,
+        is_hollow: bool,
+        inside: Option<&mut bool>,
+    ) -> Result<bool, Failure>;
+    /// `OverlapsCircle` with depth: a circle of `gp::XOY()` placed by `trsf`.
+    /// Example: `manager.overlaps_circle(1.0, &trsf, true, &mut pick)`.
+    fn overlaps_circle(
+        &self,
+        radius: f64,
+        trsf: &Transform3,
+        is_filled: bool,
+        pick_result: &mut SelectBasicsPickResult,
+    ) -> Result<bool, Failure>;
+    /// `OverlapsCircle` with the full-inside flag; `manager.overlaps_circle_inside(1.0, &trsf, true, None)`.
+    fn overlaps_circle_inside(
+        &self,
+        radius: f64,
+        trsf: &Transform3,
+        is_filled: bool,
+        inside: Option<&mut bool>,
+    ) -> Result<bool, Failure>;
+    /// `DistToGeometryCenter`; `manager.dist_to_geometry_center(&cog)`.
+    fn dist_to_geometry_center(&self, cog: &Point3) -> f64;
+    /// `DetectedPoint`: the point at a depth of the picking ray; `manager.detected_point(1.0)`.
+    fn detected_point(&self, depth: f64) -> Point3;
+    /// `IsOverlapAllowed`: false for the inclusion test; `manager.is_overlap_allowed()`.
+    fn is_overlap_allowed(&self) -> bool;
+    /// `GetNearPickedPnt`; `manager.get_near_picked_pnt()`.
+    fn get_near_picked_pnt(&self) -> Point3;
+    /// `GetFarPickedPnt`; `manager.get_far_picked_pnt()`.
+    fn get_far_picked_pnt(&self) -> Point3;
+    /// `GetViewRayDirection`; `manager.get_view_ray_direction()`.
+    fn get_view_ray_direction(&self) -> Direction3;
+    /// `IsScalableActiveVolume`; `manager.is_scalable_active_volume()`.
+    fn is_scalable_active_volume(&self) -> bool;
+    /// `GetMousePosition` (an infinite point when not supported); `manager.get_mouse_position()`.
+    fn get_mouse_position(&self) -> Point2;
+    /// `GetPlanes`: the plane equations `Ax + By + Cz + D = 0`; `manager.get_planes(&mut planes)`.
+    fn get_planes(&self, plane_equations: &mut DynamicArray<Vec4<f64>>);
+    /// `DumpJson`: writes nothing by default; `manager.dump_json(&mut stream, -1)?`.
+    fn dump_json(&self, stream: &mut DumpStream, depth: i32) -> io::Result<()> {
+        let _ = (stream, depth);
+        Ok(())
+    }
+    /// The deprecated `Overlaps(theArrayOfPts handle, ...)` alias of `OverlapsPolygon`.
+    /// Example: `manager.overlaps_harray_polygon(&points, 0, &mut pick)`.
+    fn overlaps_harray_polygon(
+        &self,
+        points: &HArray1<Point3>,
+        sens_type: i32,
+        pick_result: &mut SelectBasicsPickResult,
+    ) -> Result<bool, Failure> {
+        self.overlaps_polygon(&points.array1(), sens_type, pick_result)
+    }
+}
+
+/// The deprecated `SelectBasics_SelectingVolumeManager::Point`, `Box`, `Polyline` and
+/// `Unknown` aliases of [`SelectMgrSelectionType`].
+pub struct SelectBasicsSelectionTypeAliases;
+
+impl SelectBasicsSelectionTypeAliases {
+    /// `SelectBasics_SelectingVolumeManager::Point`.
+    pub const POINT: SelectMgrSelectionType = SelectMgrSelectionType::Point;
+    /// `SelectBasics_SelectingVolumeManager::Box`.
+    pub const BOX: SelectMgrSelectionType = SelectMgrSelectionType::Box;
+    /// `SelectBasics_SelectingVolumeManager::Polyline`.
+    pub const POLYLINE: SelectMgrSelectionType = SelectMgrSelectionType::Polyline;
+    /// `SelectBasics_SelectingVolumeManager::Unknown`.
+    pub const UNKNOWN: SelectMgrSelectionType = SelectMgrSelectionType::Unknown;
+}
diff --git a/crates/tkv3d/src/select_mgr/entity_owner.rs b/crates/tkv3d/src/select_mgr/entity_owner.rs
new file mode 100644
index 000000000..5d168e203
--- /dev/null
+++ b/crates/tkv3d/src/select_mgr/entity_owner.rs
@@ -0,0 +1,378 @@
+//! `SelectMgr_EntityOwner`: what a detected sensitive entity stands for, usually a selectable
+//! object or a part of it (v3d-design.md section 6). The class is concrete but derived (the
+//! BRep and AIS owners override its virtual members), so it is the
+//! [`SelectMgrEntityOwnerSource`] trait over [`SelectMgrEntityOwnerBase`], with the concrete
+//! class [`SelectMgrEntityOwner`].
+use super::SelectMgrSelectableObject;
+use crate::ais::AisSelectionScheme;
+use crate::prs_mgr::{
+    PrsMgrPresentableObject, PrsMgrPresentableObjectMembers as _, PrsMgrPresentationManager,
+};
+use crate::prs3d::Prs3dDrawer;
+use crate::v3d::V3dViewer;
+use rustycad_tkernel::ncollection::Vec2;
+use rustycad_tkernel::standard::dump::DumpStream;
+use rustycad_tkernel::standard::{
+    Failure, Handle, SharedState, StandardTransient, Transient, WeakHandle,
+};
+use rustycad_tkmath::toploc::Location;
+use rustycad_tkservice::aspect::{AspectVKeyFlags, AspectVKeyMouse};
+use rustycad_tkservice::graphic3d::{
+    GRAPHIC3D_ZLAYER_ID_UNKNOWN, Graphic3dPresentationAttributesMembers as _, Graphic3dZLayerId,
+};
+use rustycad_tkservice::json_dump::{class_begin, field_integer, field_pointer};
+use std::io;
+
+/// The protected fields of `SelectMgr_EntityOwner`.
+#[derive(Clone)]
+pub struct SelectMgrEntityOwnerFields {
+    /// `mySelectable` (a raw pointer natively).
+    pub selectable: WeakHandle<dyn SelectMgrSelectableObject>,
+    /// `mypriority`.
+    pub priority: i32,
+    /// `myIsSelected`.
+    pub is_selected: bool,
+    /// `myFromDecomposition`.
+    pub from_decomposition: bool,
+}
+
+/// The state every entity owner embeds.
+pub struct SelectMgrEntityOwnerBase {
+    /// The protected fields.
+    pub fields: SharedState<SelectMgrEntityOwnerFields>,
+    this: SharedState<WeakHandle<dyn SelectMgrEntityOwnerSource>>,
+}
+
+impl SelectMgrEntityOwnerBase {
+    /// An owner of `selectable` (null for none) with a priority.
+    /// Example: `SelectMgrEntityOwnerBase::new(&object, 0)`.
+    pub fn new(selectable: &Handle<dyn SelectMgrSelectableObject>, priority: i32) -> Self {
+        let fields = SelectMgrEntityOwnerFields {
+            selectable: selectable.downgrade(),
+            priority,
+            is_selected: false,
+            from_decomposition: false,
+        };
+        Self {
+            fields: SharedState::new(fields),
+            this: SharedState::new(WeakHandle::default()),
+        }
+    }
+    /// A copy of the fields; `base.read()`.
+    pub fn read(&self) -> SelectMgrEntityOwnerFields {
+        self.fields.read().clone()
+    }
+    /// The handle of the owner, null before [`select_mgr_entity_owner_bind`]; `base.this()`.
+    pub fn this(&self) -> Handle<dyn SelectMgrEntityOwnerSource> {
+        self.this.read().upgrade()
+    }
+}
+
+/// Records `owner` as its own handle (passed to `HilightOwnerWithColor`); every constructor of
+/// an owner class calls it once the handle exists. Example: `select_mgr_entity_owner_bind(&owner)`.
+pub fn select_mgr_entity_owner_bind(owner: &Handle<dyn SelectMgrEntityOwnerSource>) {
+    if let Some(value) = owner.get() {
+        *value.owner_base().this.write() = owner.downgrade();
+    }
+}
+
+/// The selectable object of an owner as a presentable object.
+fn presentable_of(
+    selectable: &Handle<dyn SelectMgrSelectableObject>,
+) -> Handle<dyn PrsMgrPresentableObject> {
+    selectable.cast()
+}
+
+/// An owner of detected entities; the default bodies are the native ones.
+pub trait SelectMgrEntityOwnerSource: Transient {
+    /// The embedded base; `owner.owner_base()`.
+    fn owner_base(&self) -> &SelectMgrEntityOwnerBase;
+    /// `Selectable`: the selectable object, null without; `owner.selectable()`.
+    fn selectable(&self) -> Handle<dyn SelectMgrSelectableObject> {
+        self.owner_base().read().selectable.upgrade()
+    }
+    /// `SetSelectable`; `owner.set_selectable(&object)`.
+    fn set_selectable(&self, selectable: &Handle<dyn SelectMgrSelectableObject>) {
+        self.owner_base().fields.write().selectable = selectable.downgrade();
+    }
+    /// `HandleMouseClick`: false (not handled) by default.
+    /// Example: `owner.handle_mouse_click(Vec2::new(1, 2), button, flags, false)`.
+    fn handle_mouse_click(
+        &self,
+        point: Vec2<i32>,
+        button: AspectVKeyMouse,
+        modifiers: AspectVKeyFlags,
+        is_double_click: bool,
+    ) -> bool {
+        let _ = (point, button, modifiers, is_double_click);
+        false
+    }
+    /// `IsHilighted`: the manager highlights the selectable object in the mode.
+    /// Example: `owner.is_hilighted(&manager, 0)`.
+    fn is_hilighted(&self, manager: &Handle<PrsMgrPresentationManager>, mode: i32) -> bool {
+        let selectable = self.selectable();
+        !selectable.is_null()
+            && manager
+                .get()
+                .is_some_and(|m| m.is_highlighted(&presentable_of(&selectable), mode))
+    }
+    /// `HilightWithColor`: highlights the selectable object (in the style layer, else its
+    /// own), or asks the object to highlight this owner when it is not auto-highlighted.
+    /// Example: `owner.hilight_with_color(&manager, &style, 0)?`.
+    fn hilight_with_color(
+        &self,
+        manager: &Handle<PrsMgrPresentationManager>,
+        style: &Handle<Prs3dDrawer>,
+        mode: i32,
+    ) -> Result<(), Failure> {
+        select_mgr_owner_hilight_with_color(self, manager, style, mode)
+    }
+    /// `Unhilight`: unhighlights the selectable object; `owner.unhilight(&manager, 0)`.
+    fn unhilight(&self, manager: &Handle<PrsMgrPresentationManager>, mode: i32) {
+        let _ = mode;
+        let selectable = self.selectable();
+        if let (false, Some(manager)) = (selectable.is_null(), manager.get()) {
+            manager.unhighlight(&presentable_of(&selectable));
+        }
+    }
+    /// `Clear`: nothing by default; `owner.clear(&manager, 0)`.
+    fn clear(&self, manager: &Handle<PrsMgrPresentationManager>, mode: i32) {
+        let _ = (manager, mode);
+    }
+    /// `HasLocation`: the selectable object has a transformation; `owner.has_location()`.
+    fn has_location(&self) -> bool {
+        self.selectable()
+            .get()
+            .is_some_and(|s| s.has_transformation())
+    }
+    /// `Location`: the transformation of the selectable object; `owner.location()`.
+    fn location(&self) -> Location {
+        match self.selectable().get().filter(|s| s.has_transformation()) {
+            Some(object) => Location::new(object.transformation()),
+            None => Location::default(),
+        }
+    }
+    /// `SetLocation`: nothing by default; `owner.set_location(&location)`.
+    fn set_location(&self, location: &Location) {
+        let _ = location;
+    }
+    /// `IsAutoHilight`: true without selectable object, else the object's flag.
+    /// Example: `owner.is_auto_hilight()`.
+    fn is_auto_hilight(&self) -> bool {
+        self.selectable().get().is_none_or(|s| s.is_auto_hilight())
+    }
+    /// `IsForcedHilight`: false by default; `owner.is_forced_hilight()`.
+    fn is_forced_hilight(&self) -> bool {
+        false
+    }
+    /// `SetZLayer`: nothing by default; `owner.set_z_layer(layer)`.
+    fn set_z_layer(&self, layer_id: Graphic3dZLayerId) {
+        let _ = layer_id;
+    }
+    /// `UpdateHighlightTrsf`: the manager updates the highlight transformation of the object.
+    /// Example: `owner.update_highlight_trsf(&viewer, &manager, 0)?`.
+    fn update_highlight_trsf(
+        &self,
+        viewer: &Handle<V3dViewer>,
+        manager: &Handle<PrsMgrPresentationManager>,
+        disp_mode: i32,
+    ) -> Result<(), Failure> {
+        let selectable = self.selectable();
+        match (selectable.is_null(), manager.get()) {
+            (false, Some(m)) => m.update_highlight_trsf(
+                viewer,
+                &presentable_of(&selectable),
+                disp_mode,
+                &Handle::default(),
+            ),
+            _ => Ok(()),
+        }
+    }
+    /// `DumpJson`; `owner.dump_json(&mut stream, -1)?`.
+    fn dump_json(&self, stream: &mut DumpStream, depth: i32) -> io::Result<()> {
+        let _ = depth;
+        select_mgr_entity_owner_dump_json(self, stream)
+    }
+}
+rustycad_tkernel::impl_transient_interface!(
+    dyn SelectMgrEntityOwnerSource,
+    "SelectMgr_EntityOwner",
+    StandardTransient
+);
+
+/// The native body of `SelectMgr_EntityOwner::HilightWithColor`.
+/// Example: `select_mgr_owner_hilight_with_color(&*owner, &manager, &style, 0)?`.
+pub fn select_mgr_owner_hilight_with_color<O: SelectMgrEntityOwnerSource + ?Sized>(
+    owner: &O,
+    manager: &Handle<PrsMgrPresentationManager>,
+    style: &Handle<Prs3dDrawer>,
+    mode: i32,
+) -> Result<(), Failure> {
+    let selectable = owner.selectable();
+    let Some(object) = selectable.get() else {
+        return Ok(());
+    };
+    if !owner.is_auto_hilight() {
+        return object.hilight_owner_with_color(manager, style, &owner.owner_base().this());
+    }
+    let style_layer = style
+        .get()
+        .map_or(GRAPHIC3D_ZLAYER_ID_UNKNOWN, |s| s.z_layer());
+    let layer = if style_layer != GRAPHIC3D_ZLAYER_ID_UNKNOWN {
+        style_layer
+    } else {
+        object.z_layer()
+    };
+    match manager.get() {
+        Some(m) => m.color(
+            &presentable_of(&selectable),
+            style,
+            mode,
+            &Handle::default(),
+            layer,
+        ),
+        None => Ok(()),
+    }
+}
+
+/// The native body of `SelectMgr_EntityOwner::DumpJson`.
+/// Example: `select_mgr_entity_owner_dump_json(&*owner, &mut stream)?`.
+pub fn select_mgr_entity_owner_dump_json<O: SelectMgrEntityOwnerSource + ?Sized>(
+    owner: &O,
+    stream: &mut DumpStream,
+) -> io::Result<()> {
+    class_begin(stream, "SelectMgr_EntityOwner")?;
+    let fields = owner.owner_base().read();
+    field_pointer(stream, "this", (owner as *const O).cast::<()>() as usize)?;
+    field_pointer(
+        stream,
+        "mySelectable",
+        fields.selectable.object_address() as usize,
+    )?;
+    field_integer(stream, "mypriority", fields.priority)?;
+    field_integer(stream, "myIsSelected", i32::from(fields.is_selected))?;
+    field_integer(
+        stream,
+        "myFromDecomposition",
+        i32::from(fields.from_decomposition),
+    )
+}
+
+/// The non-virtual members of every entity owner.
+pub trait SelectMgrEntityOwnerMembers: SelectMgrEntityOwnerSource {
+    /// `Priority`; `owner.priority()`.
+    fn priority(&self) -> i32 {
+        self.owner_base().read().priority
+    }
+    /// `SetPriority`; `owner.set_priority(2)`.
+    fn set_priority(&self, priority: i32) {
+        self.owner_base().fields.write().priority = priority;
+    }
+    /// `HasSelectable`; `owner.has_selectable()`.
+    fn has_selectable(&self) -> bool {
+        !self.owner_base().read().selectable.upgrade().is_null()
+    }
+    /// `IsSelected`; `owner.is_selected()`.
+    fn is_selected(&self) -> bool {
+        self.owner_base().read().is_selected
+    }
+    /// `SetSelected`; `owner.set_selected(true)`.
+    fn set_selected(&self, is_selected: bool) {
+        self.owner_base().fields.write().is_selected = is_selected;
+    }
+    /// `Select`: the selected state the scheme gives for a detected or undetected owner.
+    /// Example: `owner.select(AisSelectionScheme::Add, true)`.
+    fn select(&self, scheme: AisSelectionScheme, is_detected: bool) -> bool {
+        let selected = self.is_selected();
+        match scheme {
+            AisSelectionScheme::Unknown => selected,
+            AisSelectionScheme::Replace | AisSelectionScheme::ReplaceExtra => is_detected,
+            AisSelectionScheme::Add => !selected || is_detected || self.is_forced_hilight(),
+            AisSelectionScheme::Remove => selected && !is_detected,
+            AisSelectionScheme::Xor if is_detected => !selected && !self.is_forced_hilight(),
+            AisSelectionScheme::Xor => selected,
+            AisSelectionScheme::Clear => false,
+        }
+    }
+    /// `State()` (deprecated): 1 when selected, else 0; `owner.state()`.
+    fn state(&self) -> i32 {
+        i32::from(self.is_selected())
+    }
+    /// `State(status)` (deprecated): selected when the status is 1; `owner.set_state(1)`.
+    fn set_state(&self, status: i32) {
+        self.set_selected(status == 1);
+    }
+    /// `IsSameSelectable`: the same selectable object; `owner.is_same_selectable(&object)`.
+    fn is_same_selectable(&self, other: &Handle<dyn SelectMgrSelectableObject>) -> bool {
+        self.owner_base().read().selectable.object_address() == other.object_address()
+    }
+    /// `ComesFromDecomposition`; `owner.comes_from_decomposition()`.
+    fn comes_from_decomposition(&self) -> bool {
+        self.owner_base().read().from_decomposition
+    }
+    /// `SetComesFromDecomposition`; `owner.set_comes_from_decomposition(true)`.
+    fn set_comes_from_decomposition(&self, is_from_decomposition: bool) {
+        self.owner_base().fields.write().from_decomposition = is_from_decomposition;
+    }
+    /// `Set(selectable)` (deprecated): `SetSelectable`; `owner.set_selectable_deprecated(&object)`.
+    fn set_selectable_deprecated(&self, selectable: &Handle<dyn SelectMgrSelectableObject>) {
+        self.set_selectable(selectable);
+    }
+    /// `Set(priority)` (deprecated): `SetPriority`; `owner.set_priority_deprecated(1)`.
+    fn set_priority_deprecated(&self, priority: i32) {
+        self.set_priority(priority);
+    }
+}
+impl<T: SelectMgrEntityOwnerSource + ?Sized> SelectMgrEntityOwnerMembers for T {}
+
+/// The concrete `SelectMgr_EntityOwner`.
+///
+/// Example: `let owner = SelectMgrEntityOwner::new(0); owner.set_priority(3);`.
+pub struct SelectMgrEntityOwner {
+    transient: StandardTransient,
+    base: SelectMgrEntityOwnerBase,
+}
+rustycad_tkernel::impl_transient!(SelectMgrEntityOwner, "SelectMgr_EntityOwner", StandardTransient, transient,
+    interfaces: [dyn SelectMgrEntityOwnerSource]);
+
+impl SelectMgrEntityOwnerSource for SelectMgrEntityOwner {
+    fn owner_base(&self) -> &SelectMgrEntityOwnerBase {
+        &self.base
+    }
+}
+
+impl SelectMgrEntityOwner {
+    /// An owner of `selectable` (null for none); the bound handle.
+    fn bound(selectable: &Handle<dyn SelectMgrSelectableObject>, priority: i32) -> Handle<Self> {
+        let owner = Handle::new(Self {
+            transient: StandardTransient::default(),
+            base: SelectMgrEntityOwnerBase::new(selectable, priority),
+        });
+        select_mgr_entity_owner_bind(&owner.clone().cast());
+        owner
+    }
+    /// `SelectMgr_EntityOwner(priority)`: an owner without selectable object.
+    /// Example: `SelectMgrEntityOwner::new(0)`.
+    pub fn new(priority: i32) -> Handle<Self> {
+        Self::bound(&Handle::default(), priority)
+    }
+    /// `SelectMgr_EntityOwner(selectable, priority)`; `SelectMgrEntityOwner::with_selectable(&object, 0)`.
+    pub fn with_selectable(
+        selectable: &Handle<dyn SelectMgrSelectableObject>,
+        priority: i32,
+    ) -> Handle<Self> {
+        Self::bound(selectable, priority)
+    }
+    /// `SelectMgr_EntityOwner(owner, priority)`: the selectable object of another owner.
+    /// Example: `SelectMgrEntityOwner::from_owner(&other, 0)`.
+    pub fn from_owner(
+        owner: &Handle<dyn SelectMgrEntityOwnerSource>,
+        priority: i32,
+    ) -> Handle<Self> {
+        let selectable = owner
+            .get()
+            .map(|o| o.owner_base().read().selectable.upgrade())
+            .unwrap_or_default();
+        Self::bound(&selectable, priority)
+    }
+}
diff --git a/crates/tkv3d/src/select_mgr/enums.rs b/crates/tkv3d/src/select_mgr/enums.rs
new file mode 100644
index 000000000..b7f701f67
--- /dev/null
+++ b/crates/tkv3d/src/select_mgr/enums.rs
@@ -0,0 +1,107 @@
+//! The SelectMgr enumerations, with their native discriminants.
+
+/// `SelectMgr_SelectionType`: the kind of selecting volume.
+#[repr(i32)]
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub enum SelectMgrSelectionType {
+    /// `SelectMgr_SelectionType_Unknown`: undefined.
+    Unknown = -1,
+    /// `SelectMgr_SelectionType_Point`: by point (a frustum with a tolerance or an axis).
+    Point = 0,
+    /// `SelectMgr_SelectionType_Box`: by rectangle.
+    Box = 1,
+    /// `SelectMgr_SelectionType_Polyline`: by polygon.
+    Polyline = 2,
+}
+
+/// `SelectMgr_FilterType`: how a composition filter combines its filters.
+#[repr(i32)]
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub enum SelectMgrFilterType {
+    /// `SelectMgr_FilterType_AND`: every filter must accept.
+    And = 0,
+    /// `SelectMgr_FilterType_OR`: one filter must accept.
+    Or = 1,
+}
+
+/// `SelectMgr_PickingStrategy`: which detected entity is picked.
+#[repr(i32)]
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub enum SelectMgrPickingStrategy {
+    /// `SelectMgr_PickingStrategy_FirstAcceptable`: the first one that passes the filter.
+    FirstAcceptable = 0,
+    /// `SelectMgr_PickingStrategy_OnlyTopmost`: only the topmost one, when it passes.
+    OnlyTopmost = 1,
+}
+
+/// `SelectMgr_TypeOfDepthTolerance`: how entities at nearly the same depth compare.
+#[repr(i32)]
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub enum SelectMgrTypeOfDepthTolerance {
+    /// `SelectMgr_TypeOfDepthTolerance_Uniform`: a tolerance in world units.
+    Uniform = 0,
+    /// `SelectMgr_TypeOfDepthTolerance_UniformPixels`: a tolerance in pixels.
+    UniformPixels = 1,
+    /// `SelectMgr_TypeOfDepthTolerance_SensitivityFactor`: the entity's sensitivity in pixels.
+    SensitivityFactor = 2,
+}
+
+/// `SelectMgr_StateOfSelection`: the activation state of a selection.
+#[repr(i32)]
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub enum SelectMgrStateOfSelection {
+    /// `SelectMgr_SOS_Any`: any state (queries only).
+    Any = -2,
+    /// `SelectMgr_SOS_Unknown`: never activated.
+    Unknown = -1,
+    /// `SelectMgr_SOS_Deactivated`: deactivated after an activation.
+    Deactivated = 0,
+    /// `SelectMgr_SOS_Activated`: activated.
+    Activated = 1,
+}
+
+/// `SelectMgr_TypeOfUpdate`: the pending update of a selection.
+#[repr(i32)]
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub enum SelectMgrTypeOfUpdate {
+    /// `SelectMgr_TOU_Full`: recompute the sensitive entities.
+    Full = 0,
+    /// `SelectMgr_TOU_Partial`: update the location only.
+    Partial = 1,
+    /// `SelectMgr_TOU_None`: nothing to do.
+    None = 2,
+}
+
+/// `SelectMgr_TypeOfBVHUpdate`: the pending update of a selection's BVH.
+#[repr(i32)]
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub enum SelectMgrTypeOfBvhUpdate {
+    /// `SelectMgr_TBU_Add`.
+    Add = 0,
+    /// `SelectMgr_TBU_Remove`.
+    Remove = 1,
+    /// `SelectMgr_TBU_Renew`.
+    Renew = 2,
+    /// `SelectMgr_TBU_Invalidate`.
+    Invalidate = 3,
+    /// `SelectMgr_TBU_None`.
+    None = 4,
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn discriminants_match_the_native_values() {
+        assert_eq!(SelectMgrSelectionType::Unknown as i32, -1);
+        assert_eq!(SelectMgrSelectionType::Polyline as i32, 2);
+        assert_eq!(SelectMgrStateOfSelection::Any as i32, -2);
+        assert_eq!(SelectMgrStateOfSelection::Activated as i32, 1);
+        assert_eq!(SelectMgrTypeOfBvhUpdate::None as i32, 4);
+        assert_eq!(SelectMgrTypeOfUpdate::None as i32, 2);
+        assert_eq!(SelectMgrTypeOfDepthTolerance::SensitivityFactor as i32, 2);
+        assert_eq!(SelectMgrPickingStrategy::OnlyTopmost as i32, 1);
+        assert_eq!(SelectMgrFilterType::Or as i32, 1);
+    }
+}
diff --git a/crates/tkv3d/src/select_mgr/filter.rs b/crates/tkv3d/src/select_mgr/filter.rs
new file mode 100644
index 000000000..e9c7619c4
--- /dev/null
+++ b/crates/tkv3d/src/select_mgr/filter.rs
@@ -0,0 +1,214 @@
+//! `SelectMgr_Filter` and the composition filters (`SelectMgr_CompositionFilter`,
+//! `SelectMgr_AndFilter`, `SelectMgr_OrFilter`, `SelectMgr_AndOrFilter`).
+use super::{SelectMgrEntityOwnerSource, SelectMgrFilterType};
+use rustycad_tkernel::ncollection::Shared;
+use rustycad_tkernel::standard::{Handle, SharedState, StandardTransient, Transient};
+use rustycad_tkg3d::top_abs::ShapeEnum;
+use std::collections::BTreeSet;
+
+/// A filter of the detected owners.
+pub trait SelectMgrFilter: Transient {
+    /// `IsOk` (pure virtual): whether the owner may be detected; `filter.is_ok(&owner)`.
+    fn is_ok(&self, owner: &Handle<dyn SelectMgrEntityOwnerSource>) -> bool;
+    /// `ActsOn`: false by default; `filter.acts_on(ShapeEnum::Face)`.
+    fn acts_on(&self, standard_mode: ShapeEnum) -> bool {
+        let _ = standard_mode;
+        false
+    }
+}
+rustycad_tkernel::impl_transient_interface!(
+    dyn SelectMgrFilter,
+    "SelectMgr_Filter",
+    StandardTransient
+);
+
+/// The filters of a composition filter (`myFilters`).
+#[derive(Default)]
+pub struct SelectMgrCompositionFilterBase {
+    /// `myFilters`.
+    pub filters: SharedState<Vec<Handle<dyn SelectMgrFilter>>>,
+}
+
+/// A filter combining other filters.
+pub trait SelectMgrCompositionFilter: SelectMgrFilter {
+    /// The embedded filter list; `filter.composition_base()`.
+    fn composition_base(&self) -> &SelectMgrCompositionFilterBase;
+    /// `Add`; `composition.add(&filter)`.
+    fn add(&self, filter: &Handle<dyn SelectMgrFilter>) {
+        self.composition_base().filters.write().push(filter.clone());
+    }
+    /// `Remove`: the first occurrence of the filter; `composition.remove(&filter)`.
+    fn remove(&self, filter: &Handle<dyn SelectMgrFilter>) {
+        let mut filters = self.composition_base().filters.write();
+        if let Some(index) = filters.iter().position(|f| f == filter) {
+            filters.remove(index);
+        }
+    }
+    /// `IsEmpty`; `composition.is_empty()`.
+    fn is_empty(&self) -> bool {
+        self.composition_base().filters.read().is_empty()
+    }
+    /// `IsIn`; `composition.is_in(&filter)`.
+    fn is_in(&self, filter: &Handle<dyn SelectMgrFilter>) -> bool {
+        self.composition_base()
+            .filters
+            .read()
+            .iter()
+            .any(|f| f == filter)
+    }
+    /// `StoredFilters`; `composition.stored_filters()`.
+    fn stored_filters(&self) -> Vec<Handle<dyn SelectMgrFilter>> {
+        self.composition_base().filters.read().clone()
+    }
+    /// `Clear`; `composition.clear()`.
+    fn clear(&self) {
+        self.composition_base().filters.write().clear();
+    }
+}
+
+/// `SelectMgr_CompositionFilter::ActsOn`: one stored filter acts on the mode.
+/// Example: `select_mgr_composition_acts_on(&*filter, ShapeEnum::Edge)`.
+pub fn select_mgr_composition_acts_on<F: SelectMgrCompositionFilter + ?Sized>(
+    filter: &F,
+    standard_mode: ShapeEnum,
+) -> bool {
+    filter
+        .stored_filters()
+        .iter()
+        .filter_map(Handle::get)
+        .any(|f| f.acts_on(standard_mode))
+}
+
+macro_rules! composition_filter {
+    ($name:ident, $native:literal, $doc:literal) => {
+        #[doc = $doc]
+        #[derive(Default)]
+        pub struct $name {
+            transient: StandardTransient,
+            base: SelectMgrCompositionFilterBase,
+        }
+        rustycad_tkernel::impl_transient!($name, $native, StandardTransient, transient,
+            interfaces: [dyn SelectMgrFilter]);
+        impl SelectMgrCompositionFilter for $name {
+            fn composition_base(&self) -> &SelectMgrCompositionFilterBase {
+                &self.base
+            }
+        }
+    };
+}
+
+composition_filter!(
+    SelectMgrAndFilter,
+    "SelectMgr_AndFilter",
+    "`SelectMgr_AndFilter`: every stored filter must accept; `SelectMgrAndFilter::default()`."
+);
+composition_filter!(
+    SelectMgrOrFilter,
+    "SelectMgr_OrFilter",
+    "`SelectMgr_OrFilter`: one stored filter (or none stored) must accept; `SelectMgrOrFilter::default()`."
+);
+
+impl SelectMgrFilter for SelectMgrAndFilter {
+    fn is_ok(&self, owner: &Handle<dyn SelectMgrEntityOwnerSource>) -> bool {
+        self.stored_filters()
+            .iter()
+            .filter_map(Handle::get)
+            .all(|f| f.is_ok(owner))
+    }
+    fn acts_on(&self, standard_mode: ShapeEnum) -> bool {
+        select_mgr_composition_acts_on(self, standard_mode)
+    }
+}
+
+impl SelectMgrFilter for SelectMgrOrFilter {
+    fn is_ok(&self, owner: &Handle<dyn SelectMgrEntityOwnerSource>) -> bool {
+        let filters = self.stored_filters();
+        filters.is_empty()
+            || filters
+                .iter()
+                .filter_map(Handle::get)
+                .any(|f| f.is_ok(owner))
+    }
+    fn acts_on(&self, standard_mode: ShapeEnum) -> bool {
+        select_mgr_composition_acts_on(self, standard_mode)
+    }
+}
+
+/// The disabled objects of an `SelectMgr_AndOrFilter`, by object address
+/// (`NCollection_Shared<NCollection_Map<const Standard_Transient*>>`).
+pub type SelectMgrDisabledObjects = Shared<SharedState<BTreeSet<usize>>>;
+
+/// `SelectMgr_AndOrFilter`: the stored filters combined by AND or OR, refusing the disabled
+/// objects. Example: `SelectMgrAndOrFilter::new(SelectMgrFilterType::Or)`.
+pub struct SelectMgrAndOrFilter {
+    transient: StandardTransient,
+    base: SelectMgrCompositionFilterBase,
+    disabled_objects: SharedState<Handle<SelectMgrDisabledObjects>>,
+    filter_type: SharedState<SelectMgrFilterType>,
+}
+rustycad_tkernel::impl_transient!(SelectMgrAndOrFilter, "SelectMgr_AndOrFilter", StandardTransient, transient,
+    interfaces: [dyn SelectMgrFilter]);
+
+impl SelectMgrAndOrFilter {
+    /// A filter of a type without disabled objects; `SelectMgrAndOrFilter::new(SelectMgrFilterType::And)`.
+    pub fn new(filter_type: SelectMgrFilterType) -> Self {
+        Self {
+            transient: StandardTransient::default(),
+            base: SelectMgrCompositionFilterBase::default(),
+            disabled_objects: SharedState::new(Handle::default()),
+            filter_type: SharedState::new(filter_type),
+        }
+    }
+    /// `SetDisabledObjects`; `filter.set_disabled_objects(&objects)`.
+    pub fn set_disabled_objects(&self, objects: &Handle<SelectMgrDisabledObjects>) {
+        *self.disabled_objects.write() = objects.clone();
+    }
+    /// `FilterType`; `filter.filter_type()`.
+    pub fn filter_type(&self) -> SelectMgrFilterType {
+        *self.filter_type.read()
+    }
+    /// `SetFilterType`; `filter.set_filter_type(SelectMgrFilterType::Or)`.
+    pub fn set_filter_type(&self, filter_type: SelectMgrFilterType) {
+        *self.filter_type.write() = filter_type;
+    }
+    /// Whether the selectable object of the owner is disabled.
+    fn is_disabled(&self, owner: &Handle<dyn SelectMgrEntityOwnerSource>) -> bool {
+        let address = owner
+            .get()
+            .map_or(std::ptr::null(), |o| o.selectable().object_address())
+            as usize;
+        self.disabled_objects
+            .read()
+            .get()
+            .is_some_and(|set| set.read().contains(&address))
+    }
+}
+
+impl SelectMgrCompositionFilter for SelectMgrAndOrFilter {
+    fn composition_base(&self) -> &SelectMgrCompositionFilterBase {
+        &self.base
+    }
+}
+
+impl SelectMgrFilter for SelectMgrAndOrFilter {
+    fn is_ok(&self, owner: &Handle<dyn SelectMgrEntityOwnerSource>) -> bool {
+        if self.is_disabled(owner) {
+            return false;
+        }
+        let filter_type = self.filter_type();
+        let filters = self.stored_filters();
+        for filter in filters.iter().filter_map(Handle::get) {
+            let is_ok = filter.is_ok(owner);
+            if is_ok && filter_type == SelectMgrFilterType::Or {
+                return true;
+            }
+            if !is_ok && filter_type == SelectMgrFilterType::And {
+                return false;
+            }
+        }
+        filter_type != SelectMgrFilterType::Or || filters.is_empty()
+    }
+    fn acts_on(&self, standard_mode: ShapeEnum) -> bool {
+        select_mgr_composition_acts_on(self, standard_mode)
+    }
+}
diff --git a/crates/tkv3d/src/select_mgr/frustum_builder.rs b/crates/tkv3d/src/select_mgr/frustum_builder.rs
