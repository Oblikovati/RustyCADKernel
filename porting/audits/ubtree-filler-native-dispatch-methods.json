  "design": {
    "ownership": "NativeBoundingTree stores only an exclusive borrowed tree reference. It owns no node, allocator, callback pointer or raw storage. All insertions and tree_view queries delegate to actual canonical UBTree or EBTree engines.",
    "bounds": "The existing BoundingTreeInsertion trait and its broad UBTree/EBTree implementations remain unchanged. Existing Clone-only Bounds users keep constructor/type inference. Only the explicit native wrapper constructors require native Default construction capability.",
    "drop_policy": "Filler retains its original Drop implementation and dispatches through the same selected borrowed target on explicit fill or destructor fill. No generic Drop, unsafe trait implementation or contravariant stored callback function was added.",
    "instrumentation": "Native RecordingTree derives from actual pinned UBTree or EBTree and brackets qualified base Add calls. Rust Recording delegates to actual NativeBoundingTree and brackets the same calls. Neither substitutes storage or callback behavior. Only these insertion spans are compared as native dispatch parity; queue and self-assignment events remain independently observed."
  },
  "native_observations": [
    "24 native dispatch rows cover UBTree/EBTree, one/two/three pending items, both mt19937 selection modes, repeated editable keys, explicit Fill, automatic destructor Fill, root bound/object copy failures, and EBTree map-key construction failures after tree publication.",
    "Each row compares ordered per-call input identity, result or failed-call marker, every insertion payload/query/hash/equality callback and real live tree allocation count, plus final last object/root bound and released pending allocator count.",
    "Editable duplicates return false before input copies; filler still counts all queued items in its return value as natively. Native map insertion failures leave committed tree state unchanged by filler Reset.",
    "Ten separate full-phase native observations retain queued Add copy/destructor and all assignment events. The new adapter does not claim these whole traces match. One-item Fill explicitly records the still-missing native self-assignment AO1/AB10 events in a Rust regression.",
    "Queue Add on copy-only native payloads performs temporary object/bound copies, additional storage construction copies, then temporary destruction. The full-phase fixture also observes its caller input-temporary destruction. Existing Rust add_ref still has a broader moving convenience policy; a later explicit constructor-capability slice is required.",
    "DefaultHasher noexcept termination remains separately captured by six unchanged subprocess fixtures. No equality/hash or destructor-failure recovery equivalence is inferred from successful implicit Fill."
  ],
  "native_row_test_bindings": {
    "dispatch UBTree/EBTree counts1/2/3 full0/1": "native_base_and_editable_dispatch_match_both_random_orders",
    "dispatch EBTree duplicate explicit/implicit full0/1": "derived_duplicates_reject_before_copies_during_explicit_and_implicit_fill",
    "dispatch ordinary implicit base/editable": "dropping_filler_retains_selected_native_insertion_dispatch",
    "dispatch rejected first bound/object copy": "copied_input_failures_preserve_native_virtual_call_prefixes",
    "dispatch EBTree first/second map binding copy": "editable_binding_failures_retain_committed_tree_in_filler_dispatch",
    "full-phase one-item Fill": "phase_gap::native_dispatch_does_not_claim_observable_self_assignment_parity (explicit difference)",
    "remaining full-phase observations": "Native evidence for next queue construction/self-assignment slice; not whole-method parity."
  },
