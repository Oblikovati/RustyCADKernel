+  bool MemoryInfo(size_t& theFree, TCollection_AsciiString& theInfo) const override { theFree = 0; theInfo.Clear(); return false; }
+  float DefaultTextHeight() const override { return 16.0f; }
+  void TextSize(const occ::handle<Graphic3d_CView>&, const char* const, const float, float& theW, float& theA, float& theD) const override { theW = theA = theD = 0.0f; }
+  void InsertLayerBefore(const Graphic3d_ZLayerId theId, const Graphic3d_ZLayerSettings& theSettings, const Graphic3d_ZLayerId theAfter) override { Graphic3d_GraphicDriver::InsertLayerBefore(theId, theSettings, theAfter); }
+  void InsertLayerAfter(const Graphic3d_ZLayerId theId, const Graphic3d_ZLayerSettings& theSettings, const Graphic3d_ZLayerId theBefore) override { Graphic3d_GraphicDriver::InsertLayerAfter(theId, theSettings, theBefore); }
+  void RemoveZLayer(const Graphic3d_ZLayerId theId) override { Graphic3d_GraphicDriver::RemoveZLayer(theId); }
+  void SetZLayerSettings(const Graphic3d_ZLayerId theId, const Graphic3d_ZLayerSettings& theSettings) override { Graphic3d_GraphicDriver::SetZLayerSettings(theId, theSettings); }
+  bool ViewExists(const occ::handle<Aspect_Window>&, occ::handle<Graphic3d_CView>&) override { return false; }
+};
diff --git a/tools/oracle/tkv3d_probe.cxx b/tools/oracle/tkv3d_probe.cxx
new file mode 100644
index 000000000..86f3fff99
--- /dev/null
+++ b/tools/oracle/tkv3d_probe.cxx
@@ -0,0 +1,51 @@
+// Exact numeric oracle for the TKV3d packages at pinned OCCT 3d097a0.
+// Each input line is `operation numbers...`; tools/verify_tkv3d_numeric.py compares the
+// output with crates/tkv3d/examples/numeric_probe.rs bit for bit. Each package adds its own
+// tkv3d_probe_<family>.cxx, included below, and its rows in probe_cases under its own
+// package comment.
+// Every request prints exactly one line and never depends on an earlier request: the
+// verifier deals the corpus to parallel shards (tools/probe_shards.py).
+#include <map>
+#include <memory>
+#include <string>
+#include <vector>
+#include <iostream>
+#include <sstream>
+#include <cstring>
+#include <cstdint>
+#include <Standard_Failure.hxx>
+#include <gp_Dir.hxx>
+#include <gp_Dir2d.hxx>
+#include <gp_Pnt.hxx>
+#include <gp_Pnt2d.hxx>
+#include <gp_XY.hxx>
+#include <gp_XYZ.hxx>
+// The TKGeomAlgo reader and bit printers (ga_*), shared so every toolkit prints the same
+// token stream; the Rust twin includes crates/tkgeomalgo/examples/ga_probe/common.rs.
+#include "tkgeomalgo_probe_common.cxx"
+// The TKService primitive array printer (sv_array_state); the Rust twin includes
+// crates/tkservice/examples/sv_probe/array.rs.
+#include "tkservice_probe_array.cxx"
+#include "tkv3d_probe_prs3d.cxx"
+#include "tkv3d_probe_v3d.cxx"
+#include "tkv3d_probe_selection_helpers.cxx"
+const std::map<std::string,void(*)(std::istream&)> probe_cases={
+ // Prs3d tools, arrows, deflection and boxes (tkv3d_probe_prs3d.cxx)
+ {"v3_quadric", v3_quadric_case},
+ {"v3_arrow", v3_arrow_case},
+ {"v3_prs3d", v3_prs3d_case},
+ // V3d view camera operations (tkv3d_probe_v3d.cxx)
+ {"v3_view", v3_view_case},
+ {"v3_frustum_builder", v3_frustum_builder_case},
+ {"v3_clip_range", v3_clip_range_case},
+};
+int main() {
+ std::string line;
+ while(std::getline(std::cin,line)) {
+  std::istringstream input(line);std::string op;input>>op;
+  if(op.empty())continue;
+  auto found=probe_cases.find(op);
+  if(found==probe_cases.end()) {std::cerr<<"Unknown probe operation: "<<op<<std::endl;return 2;}
+  found->second(input);
+ }
+}
diff --git a/tools/oracle/tkv3d_probe_prs3d.cxx b/tools/oracle/tkv3d_probe_prs3d.cxx
new file mode 100644
index 000000000..7d5707347
--- /dev/null
+++ b/tools/oracle/tkv3d_probe_prs3d.cxx
@@ -0,0 +1,61 @@
+// Prs3d numeric parts, the Rust twin of crates/tkv3d/examples/v3_probe/prs3d.rs.
+#include <Bnd_Box.hxx>
+#include <Graphic3d_ArrayOfTriangles.hxx>
+#include <Poly_Triangulation.hxx>
+#include <Prs3d.hxx>
+#include <Prs3d_Arrow.hxx>
+#include <Prs3d_BndBox.hxx>
+#include <Prs3d_ToolCylinder.hxx>
+#include <Prs3d_ToolDisk.hxx>
+#include <Prs3d_ToolSector.hxx>
+#include <Prs3d_ToolSphere.hxx>
+#include <Prs3d_ToolTorus.hxx>
+#include <gp_Ax1.hxx>
+#include <gp_Trsf.hxx>
+// Reads `Tx Ty Tz Ax Ay Az Angle`: a rotation about the axis through the origin, then a
+// translation part.
+gp_Trsf v3_trsf(GaReader& r){
+ gp_XYZ t=r.xyz();gp_Dir a=r.dir();double angle=r.real();gp_Trsf trsf;
+ trsf.SetRotation(gp_Ax1(gp_Pnt(0,0,0),a),angle);trsf.SetTranslationPart(gp_Vec(t));return trsf;}
+// The tool of a kind with its five parameters (unused ones are ignored).
+std::unique_ptr<Prs3d_ToolQuadric> v3_tool(int kind,const double* p,int slices,int stacks){
+ switch(kind){
+  case 0:return std::make_unique<Prs3d_ToolCylinder>(p[0],p[1],p[2],slices,stacks);
+  case 1:{auto d=std::make_unique<Prs3d_ToolDisk>(p[0],p[1],slices,stacks);d->SetAngleRange(p[2],p[3]);return d;}
+  case 2:return std::make_unique<Prs3d_ToolSphere>(p[0],slices,stacks);
+  case 3:return std::make_unique<Prs3d_ToolTorus>(p[0],p[1],p[2],p[3],p[4],slices,stacks);
+  default:return std::make_unique<Prs3d_ToolSector>(p[0],slices,stacks);}}
+// `Kind P0..P4 Slices Stacks Trsf`: the counts, the indexed array of CreateTriangulation, a
+// non-indexed array filled by FillArray, and the nodes and triangles of CreatePolyTriangulation.
+void v3_quadric_case(std::istream& input){
+ GaReader r{input};int kind=r.integer();double p[5];for(double& v:p)v=r.real();int slices=r.integer(),stacks=r.integer();
+ gp_Trsf trsf=v3_trsf(r);std::unique_ptr<Prs3d_ToolQuadric> tool=v3_tool(kind,p,slices,stacks);
+ ga_int(tool->TrianglesNb());ga_int(tool->VerticesNb());ga_int(tool->VerticesNb(false));
+ GA_TRY(occ::handle<Graphic3d_ArrayOfTriangles> a=tool->CreateTriangulation(trsf);sv_array_state(a))
+ GA_TRY(occ::handle<Graphic3d_ArrayOfTriangles> b=new Graphic3d_ArrayOfTriangles(tool->VerticesNb(false),0,Graphic3d_ArrayFlags_VertexNormal);
+  tool->FillArray(b,trsf);sv_array_state(b))
+ GA_TRY(occ::handle<Poly_Triangulation> t=tool->CreatePolyTriangulation(trsf);ga_int(t->NbNodes());ga_int(t->NbTriangles());
+  for(int i=1;i<=t->NbNodes();++i)ga_pnt(t->Node(i));
+  for(int i=1;i<=t->NbTriangles();++i){int n1,n2,n3;t->Triangle(i).Get(n1,n2,n3);ga_int(n1);ga_int(n2);ga_int(n3);})
+ ga_end();}
+// `Loc(3) Dir(3) Angle Length NbSegments TubeRadius AxisLength ConeRadius ConeLength NbFacettes`:
+// DrawSegments and DrawShaded.
+void v3_arrow_case(std::istream& input){
+ GaReader r{input};gp_Pnt loc=r.pnt();gp_Dir dir=r.dir();double angle=r.real(),length=r.real();int nb=r.integer();
+ double tube=r.real(),axisLength=r.real(),cone=r.real(),coneLength=r.real();int facettes=r.integer();
+ GA_TRY(sv_array_state(Prs3d_Arrow::DrawSegments(loc,dir,angle,length,nb)))
+ GA_TRY(occ::handle<Graphic3d_ArrayOfTriangles> s=Prs3d_Arrow::DrawShaded(gp_Ax1(loc,dir),tube,axisLength,cone,coneLength,facettes);
+  ga_flag(!s.IsNull());if(!s.IsNull())sv_array_state(s))
+ ga_end();}
+// `Min(3) Max(3) Coef MaxChord Open X Y Z Distance P1(3) P2(3)`: GetDeflection of the corners
+// and of the box (void when Min.X > Max.X, opened in -X when Open), MatchSegment and the box
+// segments.
+void v3_prs3d_case(std::istream& input){
+ GaReader r{input};gp_Pnt mn=r.pnt(),mx=r.pnt();double coef=r.real(),chord=r.real();bool open=r.flag();
+ double x=r.real(),y=r.real(),z=r.real(),distance=r.real();gp_Pnt p1=r.pnt(),p2=r.pnt();
+ ga_real(Prs3d::GetDeflection(NCollection_Vec3<double>(mn.X(),mn.Y(),mn.Z()),NCollection_Vec3<double>(mx.X(),mx.Y(),mx.Z()),coef));
+ Bnd_Box box;if(mn.X()<=mx.X()){box.Update(mn.X(),mn.Y(),mn.Z(),mx.X(),mx.Y(),mx.Z());if(open)box.OpenXmin();}
+ ga_real(Prs3d::GetDeflection(box,coef,chord));
+ double dist=-1.0;ga_flag(Prs3d::MatchSegment(x,y,z,distance,p1,p2,dist));ga_real(dist);
+ occ::handle<Graphic3d_ArrayOfSegments> segs=Prs3d_BndBox::FillSegments(box);ga_flag(!segs.IsNull());if(!segs.IsNull())sv_array_state(segs);
+ ga_end();}
diff --git a/tools/oracle/tkv3d_probe_selection_helpers.cxx b/tools/oracle/tkv3d_probe_selection_helpers.cxx
new file mode 100644
index 000000000..551c5e6ab
--- /dev/null
+++ b/tools/oracle/tkv3d_probe_selection_helpers.cxx
@@ -0,0 +1,54 @@
+// SelectMgr helpers at OCCT 3d097a0. Twin: v3_probe/selection_helpers.rs.
+#include <SelectMgr_FrustumBuilder.hxx>
+#include <SelectMgr_ViewClipRange.hxx>
+#include <Graphic3d_SequenceOfHClipPlane.hxx>
+#include <Graphic3d_ClipPlane.hxx>
+void v3_frustum_builder_case(std::istream& input) {
+  GaReader r{input}; SelectMgr_FrustumBuilder builder;
+  int width=0,height=0; builder.WindowSize(width,height); ga_int(width); ga_int(height);
+  ga_flag(builder.Camera().IsNull()); ga_pnt(builder.ProjectPntOnViewPlane(1,2,0));
+  bool present=r.flag(), perspective=r.flag(), zero=r.flag();
+  occ::handle<Graphic3d_Camera> camera=new Graphic3d_Camera;
+  camera->SetProjectionType(perspective?Graphic3d_Camera::Projection_Perspective:Graphic3d_Camera::Projection_Orthographic);
+  camera->SetZeroToOneDepth(zero); camera->SetZRange(0.1,100.);
+  if(present) builder.SetCamera(camera);
+  width=r.integer();height=r.integer();builder.SetWindowSize(width,height);
+  bool viewport=r.flag();double vx=r.real(),vy=r.real(),vw=r.real(),vh=r.real();
+  if(viewport)builder.SetViewport(vx,vy,vw,vh);
+  double x=r.real(),y=r.real(),z=r.real();gp_XYZ eq=r.xyz(),point=r.xyz();
+  ga_flag(builder.Camera()==camera);builder.WindowSize(width,height);ga_int(width);ga_int(height);
+  ga_real(builder.SignedPlanePntDist(NCollection_Vec3<double>(eq.X(),eq.Y(),eq.Z()),NCollection_Vec3<double>(point.X(),point.Y(),point.Z())));
+  ga_real(builder.SignedPlanePntDist(NCollection_Vec3<double>(0.,0.,0.),NCollection_Vec3<double>(point.X(),point.Y(),point.Z())));
+  GA_TRY(ga_pnt(builder.ProjectPntOnViewPlane(x,y,z)))
+  builder.InvalidateViewport();GA_TRY(ga_pnt(builder.ProjectPntOnViewPlane(x,y,z)))
+  ga_end();
+}
+Graphic3d_SequenceOfHClipPlane v3_clip_planes(GaReader& r) {
+  Graphic3d_SequenceOfHClipPlane sequence;occ::handle<Graphic3d_ClipPlane> previous;
+  int count=r.integer();
+  for(int i=0;i<count;++i) {
+    double a=r.real(),b=r.real(),c=r.real(),d=r.real();bool on=r.flag(),linked=r.flag();
+    occ::handle<Graphic3d_ClipPlane> plane=new Graphic3d_ClipPlane(Graphic3d_ClipPlane::Equation(a,b,c,d));
+    plane->SetOn(on);if(linked)previous->SetChainNextPlane(plane);else sequence.Append(plane);
+    previous=plane;
+  }
+  return sequence;
+}
+void v3_clip_queries(SelectMgr_ViewClipRange& clip,GaReader& r) {
+  for(int n=r.integer();n>0;--n) {
+    double first=r.real(),last=r.real(),depth=123.;Bnd_Range query;
+    if(first<=last)query=Bnd_Range(first,last);
+    ga_flag(clip.IsClipped(first));ga_flag(clip.IsClipped(last));
+    ga_flag(clip.GetNearestDepth(query,depth));ga_real(depth);
+  }
+  ga_captured([&]{clip.DumpJson(std::cout,-1);});clip.SetVoid();ga_flag(clip.IsClipped(0.));
+}
+void v3_clip_range_case(std::istream& input) {
+  GaReader r{input};SelectMgr_ViewClipRange clip;
+  bool empty=r.flag();double first=r.real(),last=r.real();
+  if(empty)clip.ChangeUnclipRange().SetVoid();else clip.ChangeUnclipRange()=Bnd_Range(first,last);
+  for(int n=r.integer();n>0;--n){double a=r.real(),b=r.real();clip.AddClipSubRange(Bnd_Range(a,b));}
+  auto planes=v3_clip_planes(r);gp_Pnt origin=r.pnt();gp_Dir direction=r.dir();
+  GA_TRY(clip.AddClippingPlanes(planes,gp_Ax1(origin,direction));v3_clip_queries(clip,r))
+  ga_end();
+}
