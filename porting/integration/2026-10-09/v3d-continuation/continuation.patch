index 000000000..e969df564
--- /dev/null
+++ b/crates/tkv3d/tests/view_clip_range.rs
@@ -0,0 +1,44 @@
+//! Exact clipping-depth behavior, including output values on an unsuccessful lookup.
+use rustycad_tkmath::bnd::Range1;
+use rustycad_tkv3d::select_mgr::SelectMgrViewClipRange;
+
+#[test]
+fn void_query_preserves_the_callers_depth_like_native_get_min() {
+    let mut clip = SelectMgrViewClipRange::default();
+    let mut depth = 123.0;
+    assert!(!clip.get_nearest_depth_into(&Range1::default(), &mut depth));
+    *clip.change_unclip_range() = Range1::default();
+    assert!(clip.get_nearest_depth_into(&Range1::default(), &mut depth));
+    assert_eq!(depth, 123.0);
+}
+
+#[test]
+fn clipped_lookup_reports_its_boundary_even_when_outside_query() {
+    let mut clip = SelectMgrViewClipRange::default();
+    clip.add_clip_sub_range(Range1::new(0.0, 5.0).unwrap());
+    let query = Range1::new(1.0, 2.0).unwrap();
+    let mut depth = 123.0;
+    assert!(!clip.get_nearest_depth_into(&query, &mut depth));
+    assert_eq!(depth, 5.0);
+    assert_eq!(clip.get_nearest_depth(&query), None);
+}
+
+#[test]
+fn clipping_subranges_merge_in_native_single_pass_order() {
+    let mut clip = SelectMgrViewClipRange::default();
+    for (first, last) in [(0., 2.), (4., 6.), (1., 5.)] {
+        clip.add_clip_sub_range(Range1::new(first, last).unwrap());
+    }
+    assert_eq!(
+        clip.get_nearest_depth(&Range1::new(1., 10.).unwrap()),
+        Some(5.)
+    );
+    assert!(clip.is_clipped(5.0));
+    clip.set_void();
+    assert!(!clip.is_clipped(5.0));
+    clip.change_unclip_range().trim_from(7.0);
+    assert_eq!(
+        clip.get_nearest_depth(&Range1::new(1., 10.).unwrap()),
+        Some(7.)
+    );
+}
diff --git a/docs/v3d-design.md b/docs/v3d-design.md
new file mode 100644
index 000000000..b93cf0def
--- /dev/null
+++ b/docs/v3d-design.md
@@ -0,0 +1,87 @@
+# TKV3d design notes
+
+This note fixes how the OCCT toolkit TKV3d maps to Rust (`crates/tkv3d`, `rustycad-tkv3d`:
+packages BRepFont, Select3D, SelectBasics, SelectMgr, Prs3d, StdPrs, StdSelect, DsgPrs, PrsDim,
+PrsMgr, AIS and V3d). The rules of [geom-design.md](geom-design.md) sections 1 to 4,
+[ocaf-design.md](ocaf-design.md) section 1 and [visualization-design.md](visualization-design.md)
+apply: an abstract class is a trait over an embedded base, `Handle<dyn Trait>` holds it, the
+fields that any handle may change sit in one `SharedState`, exceptions are `Failure` values with
+the offending value, one snake-case module per package, the package prefix stays in each Rust
+name. Code comments and ledger notes cite this note as "v3d-design.md section N".
+
+## 1. Presentations and the driver
+
+`Prs3d_Presentation` is a typedef of `Graphic3d_Structure`, so a presentation is a
+`Handle<dyn Graphic3dStructureSource>`. Nothing in TKV3d talks to OpenGL: V3d and PrsMgr reach the
+graphic driver only through the TKService traits (`Graphic3dGraphicDriver`, `Graphic3dCView`,
+`Graphic3dCStructure`, `Graphic3dGroup`). The tests run on the TKService null driver
+(`rustycad_tkservice::null_driver::NullGraphicDriver`); the Vulkan 1.3 driver plugs in later
+behind the same traits.
+
+## 2. Selecting volumes
+
+`SelectBasics_SelectingVolumeManager` is the trait `SelectBasicsSelectingVolumeManager`. Its
+overloads that differ only by the last argument get one name each: the pick-result form keeps the
+native name (`overlaps_box`), the `bool* theInside` form takes the suffix `_inside` and an
+`Option<&mut bool>` (`None` is the native null pointer), and the depth-less point test is
+`overlaps_point_only`. The deprecated `Overlaps` aliases are the same trait methods.
+
+## 3. Drawer link fallback
+
+`Prs3d_Drawer` getters that fall back to the link drawer read their own fields, release the
+lock and then ask the link. A drawer linked to itself therefore cannot deadlock, where the native
+code recurses without end. The uninitialized native fields (`myPreviousDeviationCoefficient`,
+`myPreviousDeviationAngle` until the first set, `Prs3d_ArrowAspect::myIsZoomable` in two
+constructors) start at 0 and `true` in the port; their values are only observable through
+`DumpJson` natively, where they are garbage.
+
+## 4. Numeric probes
+
+The numeric code (quadric tools, arrows, frustums, sensitive entities, view and camera
+operations) is compared bit for bit with the native toolkit by
+`tools/oracle/tkv3d_probe.cxx` and its Rust twin `crates/tkv3d/examples/numeric_probe.rs`
+through `tools/verify_tkv3d_numeric.py`, on the request corpus of `tools/tkv3d_corpus.py`.
+The native float steps of `Prs3d_ToolQuadric::FillArray` (`1.0f / n`) are kept.
+
+The V3d view requests run a viewer on a null driver on both sides: the Rust probe uses the
+TKService `NullGraphicDriver`, the native probe the `SvDriver` of
+`tools/oracle/tkservice_probe_null_driver.cxx`. A view refers to its viewer without owning
+it (native `V3d_View::MyViewer` is a raw pointer), so a caller keeps the viewer alive while
+it uses the view; a view whose viewer is gone skips its redraw.
+
+## 5. Presentable objects
+
+`PrsMgr_PresentableObject` is abstract and its virtual members are overridden down to the
+AIS objects, so it is the trait `PrsMgrPresentableObject` over an embedded
+`PrsMgrPresentableObjectBase` that holds the protected fields in one `SharedState`. Each
+virtual member has a default body that calls a `prs_mgr_*` function with the native base
+body; an override calls that function where the native code calls
+`PrsMgr_PresentableObject::Member`. The non-virtual members are the blanket traits
+`PrsMgrPresentableObjectMembers` and `PrsMgrPresentableObjectUpdates`. A constructor calls
+`prs_mgr_presentable_bind` once the handle exists, so the presentations and children receive
+the object handle (`this`).
+
+The raw back pointers (`myParent`, `PrsMgr_Presentation::myPresentableObject`) are weak
+handles. The structure manager keeps strong handles to displayed structures, so a
+presentation never relies on its destructor to leave the scene: the members that drop a
+presentation (`Erase`, the deprecated `Update(mode, true)`, the object destructor) erase it
+first. The virtual members of `Graphic3d_Structure` that return nothing natively
+(`Compute`, `computeHLR`) report a failure of the object computation as a fail message.
+Bounding boxes come from the driver structure, which a view computes when it displays the
+structure: without a view the box stays void, as natively.
+
+## 6. Selecting volume foundations
+
+`SelectMgrFrustumBuilder` retains the camera handle and the native pixel-to-world
+and viewport coordinate conventions. `SelectMgrViewClipRange` preserves the native
+single-pass, insertion-order merging of clipping sub-ranges. Its
+`get_nearest_depth_into` method exposes the output argument, including mutations
+when the lookup returns false; `get_nearest_depth` is the convenience form for
+callers that only need a successful depth. Void query ranges preserve the caller's
+output value where native `Bnd_Range::GetMin` leaves it untouched.
+
+These helpers are tested without a rendering backend. Their differential corpus
+covers camera projection and depth modes, viewport invalidation, plane chains,
+parallel and opposite rays, finite/void ranges, and JSON dumps. The unfinished
+base-intersector and frustum implementations remain in Claude's original worktree
+until their algorithms and concrete selecting volumes are validated.
diff --git a/tools/oracle/tkbool_probe_brepfill_evolved.cxx b/tools/oracle/tkbool_probe_brepfill_evolved.cxx
new file mode 100644
index 000000000..02b512945
--- /dev/null
+++ b/tools/oracle/tkbool_probe_brepfill_evolved.cxx
@@ -0,0 +1,55 @@
+// Independent OCCT oracle for the recovered BRepFill_Evolved translation.
+// `program spine profile face solid constructor join origin normal xdirection`.
+#include <BRepFill_Evolved.hxx>
+#include <BRepLib_MakeFace.hxx>
+
+void bl_evolved_history(const BRepFill_Evolved& evolved, const TopoDS_Shape& spine,
+                        const TopoDS_Shape& profile) {
+  NCollection_IndexedMap<TopoDS_Shape, TopTools_ShapeMapHasher> spines, profiles;
+  TopExp::MapShapes(spine, spines); TopExp::MapShapes(profile, profiles);
+  for (int i = 1; i <= spines.Extent(); ++i)
+    for (int j = 1; j <= profiles.Extent(); ++j) {
+      const auto& generated = evolved.GeneratedShapes(spines(i), profiles(j));
+      ga_int(generated.Size());
+      for (const auto& shape : generated) { ga_int(shape.ShapeType()); ga_int(shape.Orientation()); }
+    }
+}
+
+void bl_evolved_result(const BRepFill_Evolved& evolved) {
+  ga_flag(evolved.IsDone());
+  GA_TRY(bl_evolved_digest(evolved.Shape()))
+  GA_TRY(bl_evolved_digest(evolved.Top()))
+  GA_TRY(bl_evolved_digest(evolved.Bottom()))
+}
+
+void bl_bf_evolved_empty_case(std::istream&) {
+  BRepFill_Evolved evolved;
+  bl_evolved_result(evolved);
+  ga_int(evolved.GeneratedShapes(TopoDS_Shape(), TopoDS_Shape()).Size());
+  ga_end();
+}
+
+void bl_bf_evolved_case(std::istream& input) {
+  GaReader r{input};
+  try {
+    TpShapes table = tp_shapes(r);
+    const auto spine = TopoDS::Wire(table.shapes.at(r.integer()));
+    const auto profile = TopoDS::Wire(table.shapes.at(r.integer()));
+    const bool face = r.flag(), solid = r.flag(), constructor = r.flag();
+    const auto join = static_cast<GeomAbs_JoinType>(r.integer());
+    const gp_Pnt origin=r.pnt(); const gp_Dir normal=r.dir(), xdir=r.dir();
+    const gp_Ax3 axes(origin,normal,xdir);
+    BRepFill_Evolved evolved;
+    if (face) {
+      const auto spineFace = BRepLib_MakeFace(spine, true).Face();
+      if (constructor) evolved = BRepFill_Evolved(spineFace, profile, axes, join, solid);
+      else evolved.Perform(spineFace, profile, axes, join, solid);
+    } else {
+      if (constructor) evolved = BRepFill_Evolved(spine, profile, axes, join, solid);
+      else evolved.Perform(spine, profile, axes, join, solid);
+    }
+    bl_evolved_result(evolved); ga_int(evolved.JoinType());
+    bl_evolved_history(evolved, spine, profile);
+  } catch (const Standard_Failure& error) { std::cout << error.ExceptionType() << ' '; }
+  ga_end();
+}
diff --git a/tools/oracle/tkbool_probe_curve_explorer.cxx b/tools/oracle/tkbool_probe_curve_explorer.cxx
new file mode 100644
index 000000000..fa4a2cf42
--- /dev/null
+++ b/tools/oracle/tkbool_probe_curve_explorer.cxx
@@ -0,0 +1,65 @@
+// Behavioral oracle for TopOpeBRepDS_CurveExplorer at pinned OCCT 3d097a0.
+// Input: count gap keep-mask only-kept query-index. Gaps follow the first curve.
+#include <TopOpeBRepDS_CurveExplorer.hxx>
+#include <TopOpeBRepDS_DataStructure.hxx>
+#include <TopOpeBRepDS_Curve.hxx>
+
+static void bl_explorer_curve(const TopOpeBRepDS_Curve& curve) {
+  ga_int(curve.DSIndex());
+  ga_flag(curve.Keep());
+  ga_real(curve.Tolerance());
+  ga_flag(curve.Curve().IsNull());
+}
+
+static void bl_explorer_walk(TopOpeBRepDS_CurveExplorer& explorer) {
+  for (; explorer.More(); explorer.Next()) {
+    ga_int(explorer.Index());
+    bl_explorer_curve(explorer.Curve());
+  }
+  ga_int(explorer.Index());
+  bl_explorer_curve(explorer.Curve());
+  ga_int(explorer.NbCurve());
+  ga_flag(explorer.More());
+  ga_int(explorer.Index());
+}
+
+static void bl_explorer_source(TopOpeBRepDS_DataStructure& curves, int count, int gap, int mask) {
+  for (int slot = 0; slot < count; ++slot) {
+    if (slot == 1) curves.ChangeNbCurves(curves.NbCurves() + gap);
+    TopOpeBRepDS_Curve curve;
+    curve.Tolerance(0.25 * (slot + 1));
+    curve.ChangeKeep((mask & (1 << slot)) != 0);
+    curves.AddCurve(curve);
+  }
+  curves.ChangeCurve(-1).Tolerance(12.0);
+}
+
+static void bl_curve_explorer_case(std::istream& input) {
+  GaReader reader{input};
+  const int count = reader.integer(), gap = reader.integer(), mask = reader.integer();
+  const bool onlyKept = reader.integer() != 0;
+  const int query = reader.integer();
+  TopOpeBRepDS_DataStructure curves;
+  bl_explorer_source(curves, count, gap, mask);
+  TopOpeBRepDS_CurveExplorer explorer(curves, onlyKept);
+  ga_flag(explorer.IsCurve(query)); ga_flag(explorer.IsCurveKeep(query));
+  bl_explorer_curve(explorer.Curve(query)); bl_explorer_walk(explorer);
+  explorer.Init(curves, !onlyKept); bl_explorer_walk(explorer); ga_end();
+}
+
+static void bl_curve_explorer_mutation_case(std::istream& input) {
+  GaReader reader{input};
+  const int gap = reader.integer();
+  TopOpeBRepDS_DataStructure curves;
+  bl_explorer_source(curves, 2, gap, 1);
+  TopOpeBRepDS_CurveExplorer explorer(curves, true);
+  curves.ChangeKeepCurve(2 + gap, true);
+  TopOpeBRepDS_Curve added;
+  const int index = curves.AddCurve(added);
+  ga_flag(explorer.IsCurve(index)); bl_explorer_curve(explorer.Curve(index));
+  bl_explorer_walk(explorer);
+  explorer.Init(curves, true); curves.Init(); curves.ChangeCurve(-1).Tolerance(12.0);
+  ga_flag(explorer.More()); bl_explorer_curve(explorer.Curve());
+  bl_explorer_curve(explorer.Curve(1)); explorer.Next();
+  ga_flag(explorer.More()); ga_int(explorer.Index()); ga_end();
+}
diff --git a/tools/oracle/tkbool_probe_evolved_digest.cxx b/tools/oracle/tkbool_probe_evolved_digest.cxx
new file mode 100644
index 000000000..b90c26ca2
--- /dev/null
+++ b/tools/oracle/tkbool_probe_evolved_digest.cxx
@@ -0,0 +1,83 @@
+// Address-independent BRepFill_Evolved digest. Native Quilt and DataMap traversal
+// changes between executions; retain exact sampled geometry and oriented incidence
+// while sorting siblings and p-curve representations. A free shell may reverse as
+// a whole depending on its seed face. In a solid, consume the shell orientation
+// into its face incidences, retaining the physically significant total orientation.
+#include <algorithm>
+using BlEvolvedKey = std::vector<uint64_t>;
+void bl_key_point(BlEvolvedKey& key, const gp_Pnt& p) {
+  key.insert(key.end(), {ga_bits(p.X()), ga_bits(p.Y()), ga_bits(p.Z())});
+}
+void bl_key_type(BlEvolvedKey& key, const occ::handle<Standard_Transient>& value) {
+  std::string name = value.IsNull() ? "null" : value->DynamicType()->Name();
+  key.push_back(name.size()); for (unsigned char c : name) key.push_back(c);
+}
+void bl_key_children(BlEvolvedKey& key, std::vector<BlEvolvedKey> children) {
+  std::sort(children.begin(), children.end()); key.push_back(children.size());
+  for (const auto& child : children) { key.push_back(child.size()); key.insert(key.end(), child.begin(), child.end()); }
+}
+BlEvolvedKey bl_key_pcurves(const TopoDS_Edge& edge) {
+  std::vector<BlEvolvedKey> rows;
+  for (int i = 1;; ++i) {
+    occ::handle<Geom2d_Curve> curve; occ::handle<Geom_Surface> surface;
+    TopLoc_Location location; double first=0., last=0.;
+    BRep_Tool::CurveOnSurface(edge, curve, surface, location, first, last, i);
+    if (curve.IsNull()) break;
+    BlEvolvedKey row{uint64_t(location.IsIdentity()), ga_bits(first), ga_bits(last)};
+    bl_key_type(row, surface); bl_key_type(row, curve);
+    for (double u : {first, last, 0.5*(first+last)}) {
+      gp_Pnt2d p=curve->Value(u); row.insert(row.end(), {ga_bits(p.X()), ga_bits(p.Y())});
+    }
+    rows.push_back(row);
+  }
+  BlEvolvedKey key; bl_key_children(key, rows); return key;
+}
+void bl_key_edge(BlEvolvedKey& key, const TopoDS_Edge& edge) {
+  key.insert(key.end(), {ga_bits(BRep_Tool::Tolerance(edge)), uint64_t(BRep_Tool::SameParameter(edge)),
+                        uint64_t(BRep_Tool::SameRange(edge)), uint64_t(BRep_Tool::Degenerated(edge))});
+  double first=0., last=0.; auto curve=BRep_Tool::Curve(edge, first, last);
+  bl_key_type(key, curve);
+  if (!curve.IsNull()) {
+    key.insert(key.end(), {ga_bits(first), ga_bits(last)});
+    for (double u : {first, last, 0.5*(first+last)}) bl_key_point(key, curve->Value(u));
+  }
+  auto pcurves=bl_key_pcurves(edge); key.insert(key.end(), pcurves.begin(), pcurves.end());
+}
+void bl_key_face(BlEvolvedKey& key, const TopoDS_Face& face) {
+  key.insert(key.end(), {ga_bits(BRep_Tool::Tolerance(face)), uint64_t(BRep_Tool::NaturalRestriction(face))});
+  auto surface=BRep_Tool::Surface(face); bl_key_type(key, surface);
+  if (surface.IsNull()) return;
+  bl_key_point(key, surface->Value(0.25, 0.5));
+  gp_Pnt point; gp_Vec du,dv; surface->D1(0.3,0.7,point,du,dv);
+  bl_key_point(key, point); bl_key_point(key, gp_Pnt(du.XYZ())); bl_key_point(key, gp_Pnt(dv.XYZ()));
+}
+BlEvolvedKey bl_evolved_key(const TopoDS_Shape& shape, bool inSolid=false) {
+  if (shape.IsNull()) return {UINT64_MAX};
+  BlEvolvedKey key{uint64_t(shape.ShapeType()), uint64_t(shape.Closed()), uint64_t(shape.Location().IsIdentity())};
+  bool solid=inSolid || shape.ShapeType()==TopAbs_SOLID;
+  std::vector<BlEvolvedKey> children, reversed;
+  for (TopoDS_Iterator it(shape, solid && shape.ShapeType()==TopAbs_SHELL, true); it.More(); it.Next()) {
+    auto child=bl_evolved_key(it.Value(),solid);
+    if (shape.ShapeType()==TopAbs_EDGE) child.push_back(ga_bits(BRep_Tool::Parameter(TopoDS::Vertex(it.Value()),TopoDS::Edge(shape))));
+    child.insert(child.begin(),solid && it.Value().ShapeType()==TopAbs_SHELL ? 0 : uint64_t(it.Value().Orientation())); children.push_back(child);
+    child[0]=uint64_t(TopAbs::Reverse(it.Value().Orientation())); reversed.push_back(child);
+  }
+  BlEvolvedKey incidence; bl_key_children(incidence,children);
+  if (!solid && shape.ShapeType()==TopAbs_SHELL) {
+    BlEvolvedKey reverse; bl_key_children(reverse,reversed); incidence=std::min(incidence,reverse);
+  }
+  key.insert(key.end(),incidence.begin(),incidence.end());
+  if (shape.ShapeType()==TopAbs_VERTEX) { bl_key_point(key,BRep_Tool::Pnt(TopoDS::Vertex(shape))); key.push_back(ga_bits(BRep_Tool::Tolerance(TopoDS::Vertex(shape)))); }
+  if (shape.ShapeType()==TopAbs_EDGE) bl_key_edge(key,TopoDS::Edge(shape));
+  if (shape.ShapeType()==TopAbs_FACE) bl_key_face(key,TopoDS::Face(shape));
+  return key;
+}
+void bl_evolved_digest(const TopoDS_Shape& shape) {
+  auto key=bl_evolved_key(shape);
+  ga_int(key.size()); for (auto value:key) std::cout<<value<<' ';
+  for (int kind=0;kind<8;++kind) {
+    NCollection_IndexedMap<TopoDS_Shape,TopTools_ShapeMapHasher> shapes;
+    if (!shape.IsNull()) TopExp::MapShapes(shape,static_cast<TopAbs_ShapeEnum>(kind),shapes);
+    ga_int(shapes.Extent());
+  }
+}
diff --git a/tools/oracle/tkbool_probe_interference_tool.cxx b/tools/oracle/tkbool_probe_interference_tool.cxx
new file mode 100644
index 000000000..f8502f19a
--- /dev/null
+++ b/tools/oracle/tkbool_probe_interference_tool.cxx
@@ -0,0 +1,63 @@
+// Factory/aliasing oracle for TopOpeBRepDS_InterferenceTool at OCCT 3d097a0.
+#include <TopOpeBRepDS_InterferenceTool.hxx>
+#include <TopOpeBRepDS_CurvePointInterference.hxx>
+#include <TopOpeBRepDS_EdgeVertexInterference.hxx>
+#include <TopOpeBRepDS_FaceEdgeInterference.hxx>
+#include <TopOpeBRepDS_SurfaceCurveInterference.hxx>
+#include <Geom2d_Line.hxx>
+using BlInterferenceTool = TopOpeBRepDS_InterferenceTool;
+
+static void bl_interference_fields(const occ::handle<TopOpeBRepDS_Interference>& interference) {
+  ga_text(interference->DynamicType()->Name());
+  ga_int(interference->SupportType()); ga_int(interference->Support());
+  ga_int(interference->GeometryType()); ga_int(interference->Geometry());
+  bl_transition(interference->Transition());
+}
+
+static void bl_interference_curves(const TopOpeBRepDS_Transition& transition, int support, int geometry, double parameter) {
+  auto edge = BlInterferenceTool::MakeEdgeInterference(transition, TopOpeBRepDS_EDGE, support, TopOpeBRepDS_VERTEX, geometry, parameter);
+  auto curve = BlInterferenceTool::MakeCurveInterference(transition, TopOpeBRepDS_CURVE, support, TopOpeBRepDS_POINT, geometry, parameter);
+  bl_interference_fields(edge); ga_real(BlInterferenceTool::Parameter(edge));
+  bl_interference_fields(curve); ga_real(BlInterferenceTool::Parameter(curve));
+  auto copy = BlInterferenceTool::DuplicateCurvePointInterference(curve);
+  bl_interference_fields(copy); ga_flag(copy != curve);
+  auto alias = curve;
+  BlInterferenceTool::Parameter(curve, parameter + 1.0);
+  ga_real(BlInterferenceTool::Parameter(alias)); ga_real(BlInterferenceTool::Parameter(copy));
+}
+
+static void bl_interference_surfaces(const TopOpeBRepDS_Transition& transition, int support, int geometry, bool hasCurve) {
+  occ::handle<Geom2d_Curve> pcurve;
+  if (hasCurve) pcurve = new Geom2d_Line(gp_Pnt2d(1, 2), gp_Dir2d(1, 0));
+  auto face = BlInterferenceTool::MakeFaceCurveInterference(transition, support, geometry, pcurve);
+  bl_interference_fields(face);
+  auto typed = occ::down_cast<TopOpeBRepDS_SurfaceCurveInterference>(face);
+  ga_flag(typed->PCurve() == pcurve); ga_flag(typed->PCurve().IsNull());
+  if (!pcurve.IsNull()) ga_pnt2d(typed->PCurve()->Value(0.5));
+  bl_interference_fields(BlInterferenceTool::MakeSolidSurfaceInterference(transition, support, geometry));
+}
+
+static void bl_interference_shapes(const TopOpeBRepDS_Transition& transition, int support, int geometry,
+                                   double parameter, TopOpeBRepDS_Config config, bool bound) {
+  auto edge = BlInterferenceTool::MakeEdgeVertexInterference(transition, support, geometry, bound, config, parameter);
+  bl_interference_fields(edge);
+  auto vertex = occ::down_cast<TopOpeBRepDS_EdgeVertexInterference>(edge);
+  ga_flag(vertex->GBound()); ga_int(vertex->Config()); ga_real(vertex->Parameter());
+  auto face = BlInterferenceTool::MakeFaceEdgeInterference(transition, support, geometry, bound, config);
+  bl_interference_fields(face);
+  auto typed = occ::down_cast<TopOpeBRepDS_FaceEdgeInterference>(face);
+  ga_flag(typed->GBound()); ga_int(typed->Config());
+}
+
+static void bl_interference_tool_case(std::istream& input) {
+  GaReader reader{input};
+  TopOpeBRepDS_Transition transition((TopAbs_Orientation)reader.integer());
+  transition.IndexBefore(11); transition.IndexAfter(13);
+  const int support = reader.integer(), geometry = reader.integer();
+  const double parameter = reader.real();
+  const auto config = (TopOpeBRepDS_Config)reader.integer();
+  const bool bound = reader.integer() != 0;
+  bl_interference_curves(transition, support, geometry, parameter);
+  bl_interference_surfaces(transition, support, geometry, bound);
+  bl_interference_shapes(transition, support, geometry, parameter, config, bound); ga_end();
+}
diff --git a/tools/oracle/tkbool_probe_point_explorer.cxx b/tools/oracle/tkbool_probe_point_explorer.cxx
new file mode 100644
index 000000000..d6cf28b76
--- /dev/null
+++ b/tools/oracle/tkbool_probe_point_explorer.cxx
@@ -0,0 +1,55 @@
+// PointExplorer oracle at OCCT 3d097a0. Empty points have an uninitialized
+// native tolerance, so only bound points contribute a tolerance token.
+#include <TopOpeBRepDS_PointExplorer.hxx>
+
+static void bl_explorer_point(const TopOpeBRepDS_Point& point) {
+  ga_pnt(point.Point());
+  ga_flag(point.Keep());
+}
+
+static void bl_point_source(TopOpeBRepDS_DataStructure& source, int count, int mask) {
+  for (int slot = 0; slot < count; ++slot) {
+    TopOpeBRepDS_Point point(gp_Pnt(slot + 1, 2, 3), 0.25 * (slot + 1));
+    point.ChangeKeep((mask & (1 << slot)) != 0);
+    source.AddPoint(point);
+  }
+}
+
+static void bl_point_walk(TopOpeBRepDS_PointExplorer& explorer) {
+  for (; explorer.More(); explorer.Next()) {
+    ga_int(explorer.Index()); bl_explorer_point(explorer.Point());
+    ga_real(explorer.Point().Tolerance());
+  }
+  ga_int(explorer.Index()); bl_explorer_point(explorer.Point());
+  ga_int(explorer.NbPoint()); ga_flag(explorer.More()); ga_int(explorer.Index());
+}
+
+static void bl_point_explorer_case(std::istream& input) {
+  GaReader reader{input};
+  const int count = reader.integer(), mask = reader.integer();
+  const bool kept = reader.integer() != 0;
+  const int query = reader.integer();
+  TopOpeBRepDS_DataStructure source;
+  bl_point_source(source, count, mask);
+  TopOpeBRepDS_PointExplorer explorer;
+  ga_flag(explorer.More()); ga_int(explorer.Index()); bl_explorer_point(explorer.Point());
+  explorer.Next(); ga_int(explorer.Index());
+  explorer.Init(source, kept);
+  ga_flag(explorer.IsPoint(query)); ga_flag(explorer.IsPointKeep(query));
+  bl_explorer_point(explorer.Point(query)); bl_point_walk(explorer);
+  explorer.Init(source, !kept); bl_point_walk(explorer); ga_end();
+}
+
+static void bl_point_explorer_mutation_case(std::istream&) {
+  TopOpeBRepDS_DataStructure source;
+  bl_point_source(source, 2, 1);
+  TopOpeBRepDS_PointExplorer explorer(source, true);
+  source.ChangeKeepPoint(2, true);
+  source.AddPoint(TopOpeBRepDS_Point(gp_Pnt(3, 2, 3), 0.75));
+  ga_flag(explorer.IsPoint(3)); bl_explorer_point(explorer.Point(3));
+  bl_point_walk(explorer);
+  explorer.Init(source, true); source.Init();
+  ga_flag(explorer.More()); GA_TRY(bl_explorer_point(explorer.Point()))
+  bl_explorer_point(explorer.Point(1)); explorer.Next();
+  ga_flag(explorer.More()); ga_int(explorer.Index()); ga_end();
+}
diff --git a/tools/oracle/tkservice_probe_null_driver.cxx b/tools/oracle/tkservice_probe_null_driver.cxx
new file mode 100644
index 000000000..2c394afae
--- /dev/null
+++ b/tools/oracle/tkservice_probe_null_driver.cxx
@@ -0,0 +1,156 @@
+// The Graphic3d null driver of the native probes: SvDriver, SvCStructure, SvGroup and SvView
+// mirror rustycad_tkservice::null_driver; they keep the scene and draw nothing. Included by
+// tkservice_probe_driver.cxx and by the TKV3d probe, whose viewers run on it.
+#include <Aspect_NeutralWindow.hxx>
+#include <BVH_LinearBuilder.hxx>
+#include <Graphic3d_ArrayOfPoints.hxx>
+#include <Graphic3d_CStructure.hxx>
+#include <Graphic3d_CView.hxx>
+#include <Graphic3d_CullingTool.hxx>
+#include <Graphic3d_GraphicDriver.hxx>
+#include <Graphic3d_Group.hxx>
+#include <Graphic3d_Layer.hxx>
+#include <Graphic3d_Structure.hxx>
+#include <Graphic3d_StructureManager.hxx>
+#include <Graphic3d_Text.hxx>
+#include <Graphic3d_TransformPers.hxx>
+#include <TopLoc_Datum3D.hxx>
+class SvGroup : public Graphic3d_Group
+{
+public:
+  SvGroup(const occ::handle<Graphic3d_Structure>& theStruct) : Graphic3d_Group(theStruct) {}
+  occ::handle<Graphic3d_Aspects> Aspects() const override { return myAspects; }
+  void SetGroupPrimitivesAspect(const occ::handle<Graphic3d_Aspects>& theAspect) override { myAspects = theAspect; }
+  void SetPrimitivesAspect(const occ::handle<Graphic3d_Aspects>& theAspect) override { myAspects = theAspect; }
+  void SynchronizeAspects() override {}
+  void ReplaceAspects(const NCollection_DataMap<occ::handle<Graphic3d_Aspects>, occ::handle<Graphic3d_Aspects>>&) override {}
+  void SetStencilTestOptions(const bool) override {}
+  void SetFlippingOptions(const bool, const gp_Ax2&) override {}
+private:
+  occ::handle<Graphic3d_Aspects> myAspects;
+};
+class SvCStructure : public Graphic3d_CStructure
+{
+public:
+  SvCStructure(const occ::handle<Graphic3d_StructureManager>& theMgr) : Graphic3d_CStructure(theMgr) {}
+  void OnVisibilityChanged() override {}
+  void Clear() override { myGroups.Clear(); Is2dText = false; IsForHighlight = false; }
+  void Connect(Graphic3d_CStructure&) override {}
+  void Disconnect(Graphic3d_CStructure&) override {}
+  void GraphicHighlight(const occ::handle<Graphic3d_PresentationAttributes>& theStyle) override { myHighlightStyle = theStyle; highlight = 1; }
+  void GraphicUnhighlight() override { highlight = 0; myHighlightStyle.Nullify(); }
+  occ::handle<Graphic3d_CStructure> ShadowLink(const occ::handle<Graphic3d_StructureManager>& theMgr) const override
+  { occ::handle<SvCStructure> aShadow = new SvCStructure(theMgr); aShadow->myGroups = myGroups; return aShadow; }
+  occ::handle<Graphic3d_Group> NewGroup(const occ::handle<Graphic3d_Structure>& theStruct) override
+  { occ::handle<Graphic3d_Group> aGroup = new SvGroup(theStruct); myGroups.Append(aGroup); return aGroup; }
+  void RemoveGroup(const occ::handle<Graphic3d_Group>& theGroup) override
+  {
+    if (theGroup.IsNull()) return;
+    for (NCollection_Sequence<occ::handle<Graphic3d_Group>>::Iterator anIt(myGroups); anIt.More(); anIt.Next())
+      if (anIt.Value() == theGroup) { theGroup->Clear(false); myGroups.Remove(anIt); return; }
+  }
+};
+class SvView : public Graphic3d_CView
+{
+public:
+  SvView(const occ::handle<Graphic3d_StructureManager>& theMgr, const NCollection_List<occ::handle<Graphic3d_Layer>>& theLayers) : Graphic3d_CView(theMgr)
+  {
+    // The culling builder of OpenGl_LayerList.
+    occ::handle<BVH_Builder3d> aBuilder = new BVH_LinearBuilder<double, 3>(BVH_Constants_LeafNodeSizeSingle, BVH_Constants_MaxTreeDepth);
+    for (NCollection_List<occ::handle<Graphic3d_Layer>>::Iterator anIt(theLayers); anIt.More(); anIt.Next())
+    { occ::handle<Graphic3d_Layer> aCopy = new Graphic3d_Layer(anIt.Value()->LayerId(), aBuilder); aCopy->SetLayerSettings(anIt.Value()->LayerSettings()); myLayers.Append(aCopy); }
+  }
+  void SetSvWindow(const occ::handle<Aspect_Window>& theWindow) { myWindow = theWindow; }
+  void Redraw() override {}
+  void RedrawImmediate() override {}
+  void Invalidate() override {}
+  bool IsInvalidated() override { return false; }
+  void Resized() override { Graphic3d_CView::Resized(); }
+  bool SetImmediateModeDrawToFront(const bool) override { return false; }
+  void SetWindow(const occ::handle<Graphic3d_CView>&, const occ::handle<Aspect_Window>& theWindow, const Aspect_RenderingContext) override { myWindow = theWindow; }
+  occ::handle<Aspect_Window> Window() const override { return myWindow; }
+  bool IsDefined() const override { return !myWindow.IsNull(); }
+  bool BufferDump(Image_PixMap&, const Graphic3d_BufferType&) override { return false; }
+  bool ShadowMapDump(Image_PixMap&, const TCollection_AsciiString&) override { return false; }
+  void InvalidateBVHData(const Graphic3d_ZLayerId theLayerId) override { occ::handle<Graphic3d_Layer> aLayer = Layer(theLayerId); if (!aLayer.IsNull()) aLayer->InvalidateBVHData(); }
+  void InsertLayerBefore(const Graphic3d_ZLayerId, const Graphic3d_ZLayerSettings&, const Graphic3d_ZLayerId) override {}
+  void InsertLayerAfter(const Graphic3d_ZLayerId, const Graphic3d_ZLayerSettings&, const Graphic3d_ZLayerId) override {}
+  int ZLayerMax() const override { return 0; }
+  const NCollection_List<occ::handle<Graphic3d_Layer>>& Layers() const override { return myLayers; }
+  occ::handle<Graphic3d_Layer> Layer(const Graphic3d_ZLayerId theLayerId) const override
+  { for (NCollection_List<occ::handle<Graphic3d_Layer>>::Iterator anIt(myLayers); anIt.More(); anIt.Next()) if (anIt.Value()->LayerId() == theLayerId) return anIt.Value(); return occ::handle<Graphic3d_Layer>(); }
+  void RemoveZLayer(const Graphic3d_ZLayerId) override {}
+  void SetZLayerSettings(const Graphic3d_ZLayerId, const Graphic3d_ZLayerSettings&) override {}
+  occ::handle<Standard_Transient> FBO() const override { return occ::handle<Standard_Transient>(); }
+  void SetFBO(const occ::handle<Standard_Transient>&) override {}
+  occ::handle<Standard_Transient> FBOCreate(const int, const int) override { return occ::handle<Standard_Transient>(); }
+  void FBORelease(occ::handle<Standard_Transient>&) override {}
+  void FBOGetDimensions(const occ::handle<Standard_Transient>&, int&, int&, int&, int&) override {}
+  void FBOChangeViewport(const occ::handle<Standard_Transient>&, const int, const int) override {}
+  Aspect_GradientBackground GradientBackground() const override { return Aspect_GradientBackground(); }
+  void SetGradientBackground(const Aspect_GradientBackground&) override {}
+  void SetBackgroundImage(const occ::handle<Graphic3d_TextureMap>&, bool) override {}
+  Aspect_FillMethod BackgroundImageStyle() const override { return Aspect_FM_NONE; }
+  void SetBackgroundImageStyle(const Aspect_FillMethod) override {}
+  void SetImageBasedLighting(bool) override {}
+  void SetTextureEnv(const occ::handle<Graphic3d_TextureEnv>&) override {}
+  const occ::handle<Graphic3d_LightSet>& Lights() const override { return myLights; }
+  void SetLights(const occ::handle<Graphic3d_LightSet>&) override {}
+  const occ::handle<Graphic3d_SequenceOfHClipPlane>& ClipPlanes() const override { return myPlanes; }
+  void SetClipPlanes(const occ::handle<Graphic3d_SequenceOfHClipPlane>&) override {}
+  void DiagnosticInformation(NCollection_IndexedDataMap<TCollection_AsciiString, TCollection_AsciiString>& theDict, Graphic3d_DiagnosticInfo theFlags) const override
+  { Graphic3d_CView::DiagnosticInformation(theDict, theFlags); }
+  TCollection_AsciiString StatisticInformation() const override { return TCollection_AsciiString(); }
+  void StatisticInformation(NCollection_IndexedDataMap<TCollection_AsciiString, TCollection_AsciiString>&) const override {}
+private:
+  occ::handle<Graphic3d_Layer> layerOf(Graphic3d_ZLayerId theId) const { occ::handle<Graphic3d_Layer> aLayer = Layer(theId); return aLayer.IsNull() ? Layer(Graphic3d_ZLayerId_Default) : aLayer; }
+  Graphic3d_DisplayPriority removeFromLayers(const occ::handle<Graphic3d_CStructure>& theStruct, Graphic3d_ZLayerId theId, bool theForChange)
+  {
+    occ::handle<Graphic3d_Layer> anOwn = layerOf(theId);
+    Graphic3d_DisplayPriority aPriority = Graphic3d_DisplayPriority_INVALID;
+    if (!anOwn.IsNull()) anOwn->Remove(theStruct.get(), aPriority, theForChange);
+    if (aPriority != Graphic3d_DisplayPriority_INVALID) return aPriority;
+    for (NCollection_List<occ::handle<Graphic3d_Layer>>::Iterator anIt(myLayers); anIt.More(); anIt.Next())
+    { if (anIt.Value() == anOwn) continue; anIt.Value()->Remove(theStruct.get(), aPriority, theForChange); if (aPriority != Graphic3d_DisplayPriority_INVALID) break; }
+    return aPriority;
+  }
+  void displayStructure(const occ::handle<Graphic3d_CStructure>& theStruct, const Graphic3d_DisplayPriority thePriority) override
+  { occ::handle<Graphic3d_Layer> aLayer = layerOf(theStruct->ZLayer()); if (!aLayer.IsNull()) aLayer->Add(theStruct.get(), thePriority, false); }
+  void eraseStructure(const occ::handle<Graphic3d_CStructure>& theStruct) override { removeFromLayers(theStruct, theStruct->ZLayer(), false); }
+  void changeZLayer(const occ::handle<Graphic3d_CStructure>& theStruct, const Graphic3d_ZLayerId theNewLayerId) override
+  {
+    Graphic3d_DisplayPriority aPriority = removeFromLayers(theStruct, theStruct->ZLayer(), false);
+    occ::handle<Graphic3d_Layer> aLayer = layerOf(theNewLayerId); if (!aLayer.IsNull()) aLayer->Add(theStruct.get(), aPriority, false);
+  }
+  void changePriority(const occ::handle<Graphic3d_CStructure>& theStruct, const Graphic3d_DisplayPriority thePriority) override
+  {
+    if (removeFromLayers(theStruct, theStruct->ZLayer(), true) == Graphic3d_DisplayPriority_INVALID) return;
+    occ::handle<Graphic3d_Layer> aLayer = layerOf(theStruct->ZLayer()); if (!aLayer.IsNull()) aLayer->Add(theStruct.get(), thePriority, true);
+  }
+  NCollection_List<occ::handle<Graphic3d_Layer>> myLayers;
+  occ::handle<Aspect_Window> myWindow;
+  occ::handle<Graphic3d_LightSet> myLights;
+  occ::handle<Graphic3d_SequenceOfHClipPlane> myPlanes;
+};
+class SvDriver : public Graphic3d_GraphicDriver
