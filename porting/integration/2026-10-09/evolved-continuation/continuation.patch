new file mode 100644
index 000000000..608f3da43
--- /dev/null
+++ b/crates/tkbool/examples/bl_probe/curve_explorer.rs
@@ -0,0 +1,84 @@
+//! Counterpart of tools/oracle/tkbool_probe_curve_explorer.cxx.
+use super::common::{Reader, end, flag, int, real};
+use rustycad_tkbool::top_ope_brep_ds::{
+    TopOpeBRepDSCurve, TopOpeBRepDSCurveExplorer, TopOpeBRepDSDataStructure,
+};
+
+fn explorer_curve(curve: &TopOpeBRepDSCurve) {
+    int(curve.ds_index());
+    flag(curve.keep());
+    real(curve.tolerance());
+    flag(curve.curve().is_null());
+}
+
+fn explorer_walk(explorer: &mut TopOpeBRepDSCurveExplorer<'_>) {
+    while explorer.more() {
+        int(explorer.index());
+        explorer_curve(explorer.curve());
+        explorer.next();
+    }
+    int(explorer.index());
+    explorer_curve(explorer.curve());
+    int(explorer.nb_curve());
+    flag(explorer.more());
+    int(explorer.index());
+}
+
+fn explorer_source(count: i32, gap: i32, mask: i32) -> TopOpeBRepDSDataStructure {
+    let mut curves = TopOpeBRepDSDataStructure::new();
+    for slot in 0..count {
+        if slot == 1 {
+            curves.change_nb_curves(curves.nb_curves() + gap);
+        }
+        let mut curve = TopOpeBRepDSCurve::default();
+        curve.set_tolerance(0.25 * f64::from(slot + 1));
+        curve.change_keep(mask & (1 << slot) != 0);
+        curves.add_curve(&mut curve);
+    }
+    curves.change_curve(-1).set_tolerance(12.0);
+    curves
+}
+
+/// Compares filtered traversal and lookup; `curve_explorer_case(&[3., 2., 5., 1., 4.])`.
+pub fn curve_explorer_case(values: &[f64]) {
+    let mut reader = Reader::new(values);
+    let curves = explorer_source(reader.integer(), reader.integer(), reader.integer());
+    let only_kept = reader.integer() != 0;
+    let query = reader.integer();
+    let mut explorer = TopOpeBRepDSCurveExplorer::new(&curves, only_kept);
+    flag(explorer.is_curve(query));
+    flag(explorer.is_curve_keep(query));
+    explorer_curve(explorer.curve_at(query));
+    explorer_walk(&mut explorer);
+    explorer.init(&curves, !only_kept);
+    explorer_walk(&mut explorer);
+    end();
+}
+
+/// Edits the borrowed source during traversal; `curve_explorer_mutation_case(&[2.])`.
+pub fn curve_explorer_mutation_case(values: &[f64]) {
+    let gap = Reader::new(values).integer();
+    let mut curves = explorer_source(2, gap, 1);
+    let mut explorer = TopOpeBRepDSCurveExplorer::new_mut(&mut curves, true);
+    let source = explorer.source_mut().expect("exclusive explorer source");
+    source.change_keep_curve(2 + gap, true);
+    let index = source.add_curve(&mut TopOpeBRepDSCurve::default());
+    flag(explorer.is_curve(index));
+    explorer_curve(explorer.curve_at(index));
+    explorer_walk(&mut explorer);
+    explorer_clear_source(&mut curves);
+    end();
+}
+
+fn explorer_clear_source(curves: &mut TopOpeBRepDSDataStructure) {
+    let mut explorer = TopOpeBRepDSCurveExplorer::new_mut(curves, true);
+    let source = explorer.source_mut().expect("exclusive explorer source");
+    source.init();
+    source.change_curve(-1).set_tolerance(12.0);
+    flag(explorer.more());
+    explorer_curve(explorer.curve());
+    explorer_curve(explorer.curve_at(1));
+    explorer.next();
+    flag(explorer.more());
+    int(explorer.index());
+}
diff --git a/crates/tkbool/examples/bl_probe/evolved_digest.rs b/crates/tkbool/examples/bl_probe/evolved_digest.rs
new file mode 100644
index 000000000..8d2532da4
--- /dev/null
+++ b/crates/tkbool/examples/bl_probe/evolved_digest.rs
@@ -0,0 +1,178 @@
+//! Address-independent twin of tools/oracle/tkbool_probe_evolved_digest.cxx.
+use rustycad_tkbrep::{
+    brep::BRepTool,
+    topexp,
+    topods::{self, Edge, Face, Shape, ShapeIterator},
+    toptools::IndexedMapOfShape,
+};
+use rustycad_tkernel::standard::{Failure, Handle, RuntimeTyped};
+use rustycad_tkg3d::top_abs::{self, ShapeEnum};
+use rustycad_tkmath::gp::Point3;
+
+fn key_point(key: &mut Vec<u64>, point: Point3) {
+    key.extend([
+        point.x().to_bits(),
+        point.y().to_bits(),
+        point.z().to_bits(),
+    ]);
+}
+fn key_type<T: RuntimeTyped + ?Sized>(key: &mut Vec<u64>, value: &Handle<T>) {
+    let name = value.dynamic_type().map_or("null", |kind| kind.name());
+    key.push(name.len() as u64);
+    key.extend(name.bytes().map(u64::from));
+}
+fn key_children(mut children: Vec<Vec<u64>>) -> Vec<u64> {
+    children.sort();
+    let mut key = vec![children.len() as u64];
+    for child in children {
+        key.push(child.len() as u64);
+        key.extend(child);
+    }
+    key
+}
+fn key_pcurves(edge: &Edge) -> Result<Vec<u64>, Failure> {
+    let mut rows = Vec::new();
+    for index in 1.. {
+        let found = BRepTool::curve_on_surface_by_index(edge, index)?;
+        let Some(curve) = found.pcurve.get() else {
+            break;
+        };
+        let mut row = vec![
+            u64::from(found.location.is_identity()),
+            found.first.to_bits(),
+            found.last.to_bits(),
+        ];
+        key_type(&mut row, &found.surface);
+        key_type(&mut row, &found.pcurve);
+        for u in [found.first, found.last, 0.5 * (found.first + found.last)] {
+            let point = curve.value(u)?;
+            row.extend([point.x().to_bits(), point.y().to_bits()]);
+        }
+        rows.push(row);
+    }
+    Ok(key_children(rows))
+}
+fn key_edge(key: &mut Vec<u64>, edge: &Edge) -> Result<(), Failure> {
+    key.extend([
+        BRepTool::edge_tolerance(edge)?.to_bits(),
+        u64::from(BRepTool::same_parameter(edge)?),
+        u64::from(BRepTool::same_range(edge)?),
+        u64::from(BRepTool::degenerated(edge)?),
+    ]);
+    let (curve, first, last) = BRepTool::curve(edge)?;
+    key_type(key, &curve);
+    if let Some(curve) = curve.get() {
+        key.extend([first.to_bits(), last.to_bits()]);
+        for u in [first, last, 0.5 * (first + last)] {
+            key_point(key, curve.value(u)?);
+        }
+    }
+    key.extend(key_pcurves(edge)?);
+    Ok(())
+}
+fn key_face(key: &mut Vec<u64>, face: &Face) -> Result<(), Failure> {
+    key.extend([
+        BRepTool::face_tolerance(face)?.to_bits(),
+        u64::from(BRepTool::natural_restriction(face)?),
+    ]);
+    let surface = BRepTool::surface(face)?;
+    key_type(key, &surface);
+    let Some(surface) = surface.get() else {
+        return Ok(());
+    };
+    key_point(key, surface.value(0.25, 0.5)?);
+    let frame = surface.d1(0.3, 0.7)?;
+    key_point(key, frame.point);
+    key_point(
+        key,
+        Point3::new(frame.d1u.x(), frame.d1u.y(), frame.d1u.z()),
+    );
+    key_point(
+        key,
+        Point3::new(frame.d1v.x(), frame.d1v.y(), frame.d1v.z()),
+    );
+    Ok(())
+}
+fn key_incidence(shape: &Shape, solid: bool) -> Result<Vec<u64>, Failure> {
+    let (mut children, mut reversed) = (Vec::new(), Vec::new());
+    let mut iterator = ShapeIterator::new(
+        shape,
+        solid && shape.shape_type()? == ShapeEnum::Shell,
+        true,
+    );
+    while iterator.more() {
+        let child = iterator.value()?;
+        let mut key = evolved_key(child, solid)?;
+        if shape.shape_type()? == ShapeEnum::Edge {
+            key.push(
+                BRepTool::parameter(&topods::vertex(child)?, &topods::edge(shape)?)?.to_bits(),
+            );
+        }
+        key.insert(
+            0,
+            if solid && child.shape_type()? == ShapeEnum::Shell {
+                0
+            } else {
+                child.orientation() as u64
+            },
+        );
+        children.push(key.clone());
+        key[0] = top_abs::reverse(child.orientation()) as u64;
+        reversed.push(key);
+        iterator.next();
+    }
+    let key = key_children(children);
+    Ok(if !solid && shape.shape_type()? == ShapeEnum::Shell {
+        key.min(key_children(reversed))
+    } else {
+        key
+    })
+}
+fn evolved_key(shape: &Shape, in_solid: bool) -> Result<Vec<u64>, Failure> {
+    if shape.is_null() {
+        return Ok(vec![u64::MAX]);
+    }
+    let kind = shape.shape_type()?;
+    let mut key = vec![
+        kind as u64,
+        u64::from(shape.closed()?),
+        u64::from(shape.location().is_identity()),
+    ];
+    key.extend(key_incidence(shape, in_solid || kind == ShapeEnum::Solid)?);
+    match kind {
+        ShapeEnum::Vertex => {
+            let vertex = topods::vertex(shape)?;
+            key_point(&mut key, BRepTool::pnt(&vertex)?);
+            key.push(BRepTool::vertex_tolerance(&vertex)?.to_bits());
+        }
+        ShapeEnum::Edge => key_edge(&mut key, &topods::edge(shape)?)?,
+        ShapeEnum::Face => key_face(&mut key, &topods::face(shape)?)?,
+        _ => {}
+    }
+    Ok(key)
+}
+/// Compare geometry and oriented incidence independently of hash traversal; `evolved_digest(&shape)?`.
+pub fn evolved_digest(shape: &Shape) -> Result<(), Failure> {
+    let key = evolved_key(shape, false)?;
+    print!("{} ", key.len());
+    for value in key {
+        print!("{value} ");
+    }
+    for kind in [
+        ShapeEnum::Compound,
+        ShapeEnum::CompSolid,
+        ShapeEnum::Solid,
+        ShapeEnum::Shell,
+        ShapeEnum::Face,
+        ShapeEnum::Wire,
+        ShapeEnum::Edge,
+        ShapeEnum::Vertex,
+    ] {
+        let mut shapes = IndexedMapOfShape::default();
+        if !shape.is_null() {
+            topexp::map_shapes_of_type(shape, kind, &mut shapes)?;
+        }
+        print!("{} ", shapes.len());
+    }
+    Ok(())
+}
diff --git a/crates/tkbool/examples/bl_probe/interference_tool.rs b/crates/tkbool/examples/bl_probe/interference_tool.rs
new file mode 100644
index 000000000..6b278b3d6
--- /dev/null
+++ b/crates/tkbool/examples/bl_probe/interference_tool.rs
@@ -0,0 +1,131 @@
+//! Counterpart of tools/oracle/tkbool_probe_interference_tool.cxx.
+use super::common::{Reader, end, flag, int, pnt2d, real, text};
+use rustycad_tkbool::top_ope_brep_ds::*;
+use rustycad_tkernel::standard::Handle;
+use rustycad_tkg2d::geom2d::{Geom2dCurve, Geom2dLine};
+use rustycad_tkg3d::top_abs::Orientation;
+use rustycad_tkmath::gp::{Direction2, Point2};
+type Tool = TopOpeBRepDSInterferenceTool;
+type Kind = TopOpeBRepDSKind;
+
+fn interference_fields(interference: &Handle<TopOpeBRepDSInterference>) {
+    let value = interference.get().unwrap();
+    text(interference.dynamic_type().unwrap().name().as_bytes());
+    int(value.support_type() as i32);
+    int(value.support());
+    int(value.geometry_type() as i32);
+    int(value.geometry());
+    let transition = value.transition();
+    int(transition.before() as i32);
+    int(transition.after() as i32);
+    int(transition.shape_before() as i32);
+    int(transition.shape_after() as i32);
+    int(transition.index_before());
+    int(transition.index_after());
+}
+
+fn interference_curves(
+    transition: &TopOpeBRepDSTransition,
+    support: i32,
+    geometry: i32,
+    parameter: f64,
+) {
+    let edge = Tool::make_edge_interference(
+        transition,
+        Kind::Edge,
+        support,
+        Kind::Vertex,
+        geometry,
+        parameter,
+    );
+    let curve = Tool::make_curve_interference(
+        transition,
+        Kind::Curve,
+        support,
+        Kind::Point,
+        geometry,
+        parameter,
+    );
+    interference_fields(&edge);
+    real(Tool::parameter(&edge).unwrap());
+    interference_fields(&curve);
+    real(Tool::parameter(&curve).unwrap());
+    let copy = Tool::duplicate_curve_point_interference(&curve).unwrap();
+    interference_fields(&copy);
+    flag(copy.object_address() != curve.object_address());
+    let alias = curve.clone();
+    Tool::set_parameter(&curve, parameter + 1.0).unwrap();
+    real(Tool::parameter(&alias).unwrap());
+    real(Tool::parameter(&copy).unwrap());
+}
+
+fn interference_surfaces(
+    transition: &TopOpeBRepDSTransition,
+    support: i32,
+    geometry: i32,
+    has_curve: bool,
+) {
+    let pcurve: Handle<dyn Geom2dCurve> = if has_curve {
+        Handle::new(Geom2dLine::from_point(Point2::new(1., 2.), Direction2::X)).cast()
+    } else {
+        Handle::default()
+    };
+    let face = Tool::make_face_curve_interference(transition, support, geometry, &pcurve);
+    interference_fields(&face);
+    let typed: Handle<TopOpeBRepDSSurfaceCurveInterference> = face.cast();
+    let retained = typed.get().unwrap().pcurve();
+    flag(retained.object_address() == pcurve.object_address());
+    flag(retained.is_null());
+    if let Some(curve) = retained.get() {
+        pnt2d(curve.value(0.5).unwrap());
+    }
+    interference_fields(&Tool::make_solid_surface_interference(
+        transition, support, geometry,
+    ));
+}
+
+fn interference_shapes(
+    transition: &TopOpeBRepDSTransition,
+    support: i32,
+    geometry: i32,
+    parameter: f64,
+    config: TopOpeBRepDSConfig,
+    bound: bool,
+) {
+    let edge = Tool::make_edge_vertex_interference(
+        transition, support, geometry, bound, config, parameter,
+    );
+    interference_fields(&edge);
+    let typed: Handle<TopOpeBRepDSEdgeVertexInterference> = edge.cast();
+    flag(typed.get().unwrap().gbound());
+    int(typed.get().unwrap().config() as i32);
+    real(typed.get().unwrap().parameter());
+    let face = Tool::make_face_edge_interference(transition, support, geometry, bound, config);
+    interference_fields(&face);
+    let typed: Handle<TopOpeBRepDSFaceEdgeInterference> = face.cast();
+    flag(typed.get().unwrap().gbound());
+    int(typed.get().unwrap().config() as i32);
+}
+
+/// Compares every factory and shared parameter edit; `interference_tool_case(&[0., 1., 2., 0.5, 0., 1.])`.
+pub fn interference_tool_case(values: &[f64]) {
+    let mut reader = Reader::new(values);
+    let mut transition =
+        TopOpeBRepDSTransition::from_orientation(Orientation::ALL[reader.integer() as usize]);
+    transition.set_index_before(11);
+    transition.set_index_after(13);
+    let support = reader.integer();
+    let geometry = reader.integer();
+    let parameter = reader.real();
+    let configs = [
+        TopOpeBRepDSConfig::UnshGeometry,
+        TopOpeBRepDSConfig::SameOriented,
+        TopOpeBRepDSConfig::DiffOriented,
+    ];
+    let config = configs[reader.integer() as usize];
+    let bound = reader.integer() != 0;
+    interference_curves(&transition, support, geometry, parameter);
+    interference_surfaces(&transition, support, geometry, bound);
+    interference_shapes(&transition, support, geometry, parameter, config, bound);
+    end();
+}
diff --git a/crates/tkbool/examples/bl_probe/point_explorer.rs b/crates/tkbool/examples/bl_probe/point_explorer.rs
new file mode 100644
index 000000000..acb229d1d
--- /dev/null
+++ b/crates/tkbool/examples/bl_probe/point_explorer.rs
@@ -0,0 +1,89 @@
+//! Counterpart of tools/oracle/tkbool_probe_point_explorer.cxx.
+use super::common::{Reader, attempt, end, flag, int, pnt, real};
+use rustycad_tkbool::top_ope_brep_ds::{
+    TopOpeBRepDSDataStructure, TopOpeBRepDSPoint, TopOpeBRepDSPointExplorer,
+};
+use rustycad_tkmath::gp::Point3;
+
+fn explorer_point(point: &TopOpeBRepDSPoint) {
+    pnt(point.point());
+    flag(point.keep());
+}
+
+fn point_source(count: i32, mask: i32) -> TopOpeBRepDSDataStructure {
+    let mut source = TopOpeBRepDSDataStructure::new();
+    for slot in 0..count {
+        let mut point = TopOpeBRepDSPoint::new(
+            Point3::new(f64::from(slot + 1), 2., 3.),
+            0.25 * f64::from(slot + 1),
+        );
+        point.change_keep(mask & (1 << slot) != 0);
+        source.add_point(&point);
+    }
+    source
+}
+
+fn point_walk(explorer: &mut TopOpeBRepDSPointExplorer<'_>) {
+    while explorer.more() {
+        int(explorer.index());
+        explorer_point(explorer.point().unwrap());
+        real(explorer.point().unwrap().tolerance());
+        explorer.next();
+    }
+    int(explorer.index());
+    explorer_point(explorer.point().unwrap());
+    int(explorer.nb_point());
+    flag(explorer.more());
+    int(explorer.index());
+}
+
+fn point_default(explorer: &mut TopOpeBRepDSPointExplorer<'_>) {
+    flag(explorer.more());
+    int(explorer.index());
+    explorer_point(explorer.point().unwrap());
+    explorer.next();
+    int(explorer.index());
+}
+
+/// Exercises binding, filtering and recount; `point_explorer_case(&[4., 5., 1., 2.])`.
+pub fn point_explorer_case(values: &[f64]) {
+    let mut reader = Reader::new(values);
+    let source = point_source(reader.integer(), reader.integer());
+    let kept = reader.integer() != 0;
+    let query = reader.integer();
+    let mut explorer = TopOpeBRepDSPointExplorer::default();
+    point_default(&mut explorer);
+    explorer.init(&source, kept);
+    flag(explorer.is_point(query));
+    flag(explorer.is_point_keep(query));
+    explorer_point(explorer.point_at(query));
+    point_walk(&mut explorer);
+    explorer.init(&source, !kept);
+    point_walk(&mut explorer);
+    end();
+}
+
+/// Compares live edits and stale-current failure after clearing; `point_explorer_mutation_case(&[])`.
+pub fn point_explorer_mutation_case(_: &[f64]) {
+    let mut source = point_source(2, 1);
+    let mut explorer = TopOpeBRepDSPointExplorer::new_mut(&mut source, true);
+    let editable = explorer.source_mut().unwrap();
+    editable.change_keep_point(2, true).unwrap();
+    editable.add_point(&TopOpeBRepDSPoint::new(Point3::new(3., 2., 3.), 0.75));
+    flag(explorer.is_point(3));
+    explorer_point(explorer.point_at(3));
+    point_walk(&mut explorer);
+    point_clear_source(&mut source);
+    end();
+}
+
+fn point_clear_source(source: &mut TopOpeBRepDSDataStructure) {
+    let mut explorer = TopOpeBRepDSPointExplorer::new_mut(source, true);
+    explorer.source_mut().unwrap().init();
+    flag(explorer.more());
+    attempt(|| explorer.point().map(explorer_point));
+    explorer_point(explorer.point_at(1));
+    explorer.next();
+    flag(explorer.more());
+    int(explorer.index());
+}
diff --git a/crates/tkbool/src/brep_fill/evolved/assemble.rs b/crates/tkbool/src/brep_fill/evolved/assemble.rs
new file mode 100644
index 000000000..0c8e1b60c
--- /dev/null
+++ b/crates/tkbool/src/brep_fill/evolved/assemble.rs
@@ -0,0 +1,392 @@
+// Rust translation of BRepFill_Evolved::Add, Transfert, AddTopAndBottom, MakeSolid and
+// ContinuityOnOffsetEdge of ModelingAlgorithms/TKBool/BRepFill/BRepFill_Evolved.cxx at
+// 3d097a0328e71b826377d4814ab05ec3c3d23871.
+
+//! The assembly of the elementary volevos: their edges on common profile vertices
+//! glued in a quilt, their maps merged and moved back to the initial space, the caps
+//! of a solid and the regularity along the edges of profile vertices on Oz.
+use super::statics::{altitud, compare, confusion, distance_to_oz, edge_vertices, relative};
+use super::{BRepFillEvolved, ProfileGenerated, ShapeOrigins, first_of};
+use crate::brep_algo::BRepAlgoLoop;
+use rustycad_tkbrep::brep::{BRepBuilder, BRepTool};
+use rustycad_tkbrep::brep_adaptor::BRepAdaptorCurve;
+use rustycad_tkbrep::brep_lprop;
+use rustycad_tkbrep::brep_tools::{Quilt, WireExplorer};
+use rustycad_tkbrep::topexp::{self, Explorer};
+use rustycad_tkbrep::topods::{self, Compound, Edge, Shape, Solid, Vertex};
+use rustycad_tkbrep::toptools::MapOfShape;
+use rustycad_tkernel::ncollection::List;
+use rustycad_tkernel::standard::Failure;
+use rustycad_tkg3d::adaptor3d::Adaptor3dCurve;
+use rustycad_tkg3d::top_abs::{self, Orientation, ShapeEnum, State};
+use rustycad_tkmath::geom_abs::Shape as Continuity;
+use rustycad_tkmath::gp::{Plane3, Vector3};
+use rustycad_tkmath::toploc::Location;
+use rustycad_tktopalgo::brep_class3d::BRepClass3dSolidClassifier;
+use rustycad_tktopalgo::brep_lib::{self, BRepLibMakeFace};
+
+impl BRepFillEvolved {
+    /// The edges generated by a common profile vertex in both volevos bound in the quilt
+    /// (the volevo edge onto this one, oriented by their first points).
+    fn bind_common_edges(&self, vevo: &Self, vv: &Shape, glue: &mut Quilt) -> Result<(), Failure> {
+        for (sp, inner) in self.my_map.items() {
+            let Some(my_list) = inner.seek(vv) else {
+                continue;
+            };
+            if !vevo.my_map.seek(sp).is_some_and(|m| m.is_bound(vv)) {
+                continue;
+            }
+            let mut vevo_it = vevo.generated_shapes(sp, vv).iter();
+            for me in my_list.iter() {
+                let ve = vevo_it.next().ok_or_else(|| {
+                    super::no_such("fewer volevo edges than edges at a common vertex")
+                })?;
+                let (me, ve) = (topods::edge(me)?, topods::edge(ve)?);
+                let og = compare(&me, &ve)?;
+                glue.bind_edge(
+                    &topods::edge(&ve.as_ref().oriented(Orientation::Forward))?,
+                    &topods::edge(&me.as_ref().oriented(og))?,
+                )?;
+            }
+        }
+        Ok(())
+    }
+
+    /// `Add(Vevo, Prof, Glue)` (private): the volevo of the profile part `prof` glued:
+    /// its edges at profile vertices common with this profile bound in the quilt, its
+    /// shape added, and its map merged (with the quilt copies).
+    pub(super) fn add(
+        &mut self,
+        vevo: &mut Self,
+        prof: &topods::Wire,
+        glue: &mut Quilt,
+    ) -> Result<(), Failure> {
+        if vevo.shape().is_null() {
+            return Ok(());
+        }
+        for vv in Explorer::new(prof.as_ref(), ShapeEnum::Vertex, ShapeEnum::Shape)? {
+            let (_, commun) = relative(&self.my_profile, prof, &topods::vertex(&vv)?)?;
+            if commun {
+                self.bind_common_edges(vevo, &vv, glue)?;
+            }
+        }
+        glue.add(vevo.shape())?;
+        for (current_spine, inner) in vevo.generated().items() {
+            for (current_prof, gen_shapes) in inner.items() {
+                let mine = self
+                    .my_map
+                    .try_emplaced(current_spine.clone(), ProfileGenerated::default);
+                if mine.is_bound(current_prof) {
+                    continue;
+                }
+                let mut l = List::default();
+                for s in gen_shapes.iter() {
+                    // during Glue.Add the shared shapes are recreated.
+                    l.append(if glue.is_copied(s) {
+                        glue.copy(s)?
+                    } else {
+                        s.clone()
+                    });
+                }
+                mine.bind(current_prof.clone(), l);
+            }
+        }
+        Ok(())
+    }
+
+    /// The edges of the shape with SameRange and SameParameter forced (expecting for
+    /// better, as natively: the planar and tube parts disagree on SameParameter).
+    fn force_same_parameter(&self) -> Result<(), Failure> {
+        let b = BRepBuilder::default();
+        for e in Explorer::new(&self.my_shape, ShapeEnum::Edge, ShapeEnum::Shape)? {
+            let e = topods::edge(&e)?;
+            b.same_range(&e, false)?;
+            b.same_parameter(&e, false)?;
+            brep_lib::same_parameter_edge(&e, 1.0e-5)?;
+        }
+        Ok(())
+    }
+
+    /// `Transfert(Vevo, MapProf, MapSpine, LS, InitLS, InitLP)` (private): the shape
+    /// and the map of the volevo moved back by `ls` onto the initial spine and profile
+    /// shapes (the lists of the volevo are emptied, NCollection_List::Append(List)),
+    /// with its top and bottom.
+    pub(super) fn transfert(
+        &mut self,
+        vevo: &mut Self,
+        map_prof: &ShapeOrigins,
+        map_spine: &ShapeOrigins,
+        ls: &Location,
+        init_ls: &Location,
+        init_lp: &Location,
+    ) -> Result<(), Failure> {
+        self.my_shape = vevo.shape().clone();
+        let mut spine = self.my_spine.as_ref().clone();
+        spine.set_location(init_ls, true)?;
+        self.my_spine = topods::face(&spine)?;
+        let mut profile = self.my_profile.as_ref().clone();
+        profile.set_location(init_lp, true)?;
+        self.my_profile = topods::wire(&profile)?;
+        self.my_shape.move_by(ls, true)?;
+        self.force_same_parameter()?;
+        let spines: Vec<Shape> = vevo.my_map.items().map(|(k, _)| k.clone()).collect();
+        for key_s in &spines {
+            let mut initial_spine = map_spine
+                .seek(key_s)
+                .cloned()
+                .ok_or_else(|| super::no_such("a spine shape without origin"))?;
+            initial_spine.move_by(ls, true)?;
+            let inner = vevo
+                .my_map
+                .change_seek(key_s)
+                .ok_or_else(|| super::no_such("a spine shape of the volevo"))?;
+            let profs: Vec<Shape> = inner.items().map(|(k, _)| k.clone()).collect();
+            for key_p in &profs {
+                let mut initial_prof = map_prof
+                    .seek(key_p)
+                    .cloned()
+                    .ok_or_else(|| super::no_such("a profile shape without origin"))?;
+                initial_prof.set_location(init_lp, true)?;
+                let gen_shapes = inner
+                    .change_seek(key_p)
+                    .map(std::mem::take)
+                    .unwrap_or_default();
+                let mut moved = Vec::with_capacity(gen_shapes.len());
+                for mut s in gen_shapes.iter().cloned() {
+                    s.move_by(ls, true)?;
+                    moved.push(s);
+                }
+                self.append_generated(&initial_spine, &initial_prof, moved);
+            }
+        }
+        self.my_top = vevo.top().clone();
+        self.my_top.move_by(ls, true)?;
+        self.my_bottom = vevo.bottom().clone();
+        self.my_bottom.move_by(ls, true)?;
+        Ok(())
+    }
+
+    /// The edges generated by the spine edges at the profile vertex `v` added to the
+    /// loop, oriented as their spine edge (reversed when the tangents disagree; the
+    /// decision of the first edge of each spine edge, kept in `to_reverse`).
+    fn cap_edges_of_spine_edges(
+        &self,
+        v: &Shape,
+        lp: &mut BRepAlgoLoop,
+        to_reverse: &mut bool,
+    ) -> Result<(), Failure> {
+        for es in Explorer::new(self.my_spine.as_ref(), ShapeEnum::Edge, ShapeEnum::Shape)? {
+            let es_edge = topods::edge(&es)?;
+            let mut compute_orientation = false;
+            for e in self.generated_shapes(&es, v).iter() {
+                let e = topods::edge(e)?;
+                if !compute_orientation {
+                    let (c1, c2) = (
+                        BRepAdaptorCurve::with_edge(&es_edge)?,
+                        BRepAdaptorCurve::with_edge(&e)?,
+                    );
+                    let ((f, l), (fs, ls)) = (BRepTool::range(&e)?, BRepTool::range(&es_edge)?);
+                    let v1 = c1.d1(0.3 * fs + 0.7 * ls)?.1;
+                    let v2 = c2.d1(0.3 * f + 0.7 * l)?.1;
+                    *to_reverse = v1.dot(v2) < 0.;
+                    compute_orientation = true;
+                }
+                let or = if *to_reverse {
+                    top_abs::reverse(es.orientation())
+                } else {
+                    es.orientation()
+                };
+                lp.add_const_edge(&topods::edge(&e.as_ref().oriented(or))?);
+            }
+        }
+        Ok(())
+    }
+
+    /// The circles generated by the spine vertices at the profile vertex `v` added to
+    /// the loop, turning so that their centre is in the cap for a profile vertex out
+    /// (Y < 0) and out of it otherwise.
+    fn cap_edges_of_spine_vertices(
+        &self,
+        v: &Vertex,
+        lp: &mut BRepAlgoLoop,
+        to_reverse: &mut bool,
+    ) -> Result<(), Failure> {
+        let is_out = BRepTool::pnt(v)?.y() < 0.;
+        let mut view = MapOfShape::default();
+        for es in Explorer::new(self.my_spine.as_ref(), ShapeEnum::Vertex, ShapeEnum::Shape)? {
+            if !view.add(es.clone()) {
+                continue;
+            }
+            let p = BRepTool::pnt(&topods::vertex(&es)?)?;
+            for e in self.generated_shapes(&es, v.as_ref()).iter() {
+                let e = topods::edge(e)?;
+                if BRepTool::degenerated(&e)? {
+                    continue;
+                }
+                let c = BRepAdaptorCurve::with_edge(&e)?;
+                let (f, l) = BRepTool::range(&e)?;
+                let (pc, vc) = c.d1(0.3 * f + 0.7 * l)?;
+                let prod = Vector3::between(p, pc).crossed(vc);
+                *to_reverse = if is_out { prod.z() < 0. } else { prod.z() > 0. };
+                let or = if *to_reverse {
+                    Orientation::Reversed
+                } else {
+                    Orientation::Forward
+                };
+                lp.add_const_edge(&topods::edge(&e.as_ref().oriented(or))?);
+            }
+        }
+        Ok(())
+    }
+
+    /// The faces of a cap, glued, kept as top (`i` 0) or bottom (a compound for several).
+    fn keep_cap(&mut self, i: usize, faces: &List<Shape>, glue: &mut Quilt) -> Result<(), Failure> {
+        let b = BRepBuilder::default();
+        let mut bouchon = Compound::default();
+        b.make_compound(&mut bouchon);
+        let mut bouchon = bouchon.into_shape();
+        for (j, f) in faces.iter().enumerate() {
+            glue.add(f)?;
+            if j == 0 {
+                *(if i == 0 {
+                    &mut self.my_top
+                } else {
+                    &mut self.my_bottom
+                }) = f.clone();
+            }
+            b.add(&mut bouchon, f)?;
+        }
+        if faces.len() > 1 {
+            *(if i == 0 {
+                &mut self.my_top
+            } else {
+                &mut self.my_bottom
+            }) = bouchon;
+        }
+        Ok(())
+    }
+
+    /// `AddTopAndBottom(Glue)` (private): for an open profile, the caps at its end
+    /// vertices: the faces of the loops of the edges generated there on the horizontal
+    /// planes, glued and kept as top and bottom.
+    pub(super) fn add_top_and_bottom(&mut self, glue: &mut Quilt) -> Result<(), Failure> {
+        let (v0, v1) = topexp::wire_vertices(&self.my_profile);
+        if v0.as_ref().is_same(v1.as_ref()) {
+            return Ok(());
+        }
+        let mut to_reverse = false;
+        for (i, v) in [v0, v1].iter().enumerate() {
+            let mut lp = BRepAlgoLoop::new();
+            let f = BRepLibMakeFace::from_plane(Plane3::from_equation(0., 0., 1., -altitud(v)?)?)?
+                .face()?;
+            lp.init(&f);
+            self.cap_edges_of_spine_edges(v.as_ref(), &mut lp, &mut to_reverse)?;
+            self.cap_edges_of_spine_vertices(v, &mut lp, &mut to_reverse)?;
+            lp.perform()?;
+            lp.wires_to_faces()?;
+            let faces = lp.new_faces().clone();
+            self.keep_cap(i, &faces, glue)?;
+        }
+        Ok(())
+    }
+
+    /// `MakeSolid()` (private): a solid per shell, reversed when the infinite point is
+    /// IN; the solid alone, else a compound of them.
+    pub(super) fn make_solid(&mut self) -> Result<(), Failure> {
+        let b = BRepBuilder::default();
+        let mut res = Compound::default();
+        b.make_compound(&mut res);
+        let mut res = res.into_shape();
+        let (mut ish, mut sol) = (0, Shape::default());
+        for sh in Explorer::new(&self.my_shape, ShapeEnum::Shell, ShapeEnum::Shape)? {
+            sol = Self::solid_of(&b, &sh)?;
+            let mut sc = BRepClass3dSolidClassifier::with_shape(&sol)?;
+            sc.perform_infinite_point(confusion())?;
+            if sc.state() == State::In {
+                sol = Self::solid_of(&b, &sh.reversed())?;
+            }
+            b.add(&mut res, &sol)?;
+            ish += 1;
+        }
+        self.my_shape = if ish == 1 { sol } else { res };
+        Ok(())
+    }
+
+    /// A new solid of one shell.
+    fn solid_of(b: &BRepBuilder, sh: &Shape) -> Result<Shape, Failure> {
+        let mut sol = Solid::default();
+        b.make_solid(&mut sol);
+        let mut sol = sol.into_shape();
+        b.add(&mut sol, sh)?;
+        Ok(sol)
+    }
+
+    /// The regularity of two profile edges at `v` (G1 or more) coded on the edges
+    /// generated by `v` between the faces generated by the edges, for every spine
+    /// shape.
+    fn code_continuity(&self, v: &Vertex, cur_e: &Edge, other_e: &Edge) -> Result<(), Failure> {
+        let u1 = BRepTool::parameter(v, cur_e)?;
+        let u2 = BRepTool::parameter(v, other_e)?;
+        let (curve1, curve2) = (
+            BRepAdaptorCurve::with_edge(cur_e)?,
+            BRepAdaptorCurve::with_edge(other_e)?,
+        );
+        let continuity = brep_lprop::continuity(&curve1, &curve2, u1, u2)?;
+        if (continuity as i32) < (Continuity::G1 as i32) {
+            return Ok(());
+        }
+        let b = BRepBuilder::default();
+        for (_, m) in self.my_map.items() {
+            let (Some(lv), Some(lc), Some(lo)) = (
+                m.seek(v.as_ref()),
+                m.seek(cur_e.as_ref()),
+                m.seek(other_e.as_ref()),
+            ) else {
+                continue;
+            };
+            if lv.is_empty() || lc.is_empty() || lo.is_empty() {
+                continue;
+            }
+            let (e, f1, f2) = (
+                topods::edge(&first_of(lv)?)?,
+                topods::face(&first_of(lc)?)?,
+                topods::face(&first_of(lo)?)?,
+            );
+            b.continuity_on_faces(&e, &f1, &f2, continuity)?;
+        }
+        Ok(())
+    }
+
+    /// `ContinuityOnOffsetEdge(WorkProf)` (private): the regularities between the
+    /// faces generated by consecutive profile edges at their vertices on Oz (and at
+    /// the closing vertex of a closed profile).
+    pub(super) fn continuity_on_offset_edge(
+        &self,
+        _work_prof: &List<Shape>,
+    ) -> Result<(), Failure> {
+        let mut wexp = WireExplorer::with_wire(&self.my_profile)?;
+        let first_e = wexp.current().clone();
+        let mut prec_e = first_e.clone();
+        let (vf, _) = edge_vertices(&first_e);
+        if wexp.more() {
+            wexp.next()?;
+        }
+        let mut cur_e = Edge::default();
+        while wexp.more() {
+            cur_e = wexp.current().clone();
+            let v = wexp.current_vertex().clone();
+            if distance_to_oz(&v)? <= confusion() {
+                // the regularities are already coded on the edges of elementary volevos
+                self.code_continuity(&v, &cur_e, &prec_e)?;
+            }
+            prec_e = cur_e.clone();
+            wexp.next()?;
+        }
+        let (_, vl) = edge_vertices(&prec_e);
+        if vf.as_ref().is_same(vl.as_ref()) {
+            // Closed profile.
+            self.code_continuity(&vf, &cur_e, &first_e)?;
+        }
+        Ok(())
+    }
+}
diff --git a/crates/tkbool/src/brep_fill/evolved/elementary.rs b/crates/tkbool/src/brep_fill/evolved/elementary.rs
new file mode 100644
index 000000000..5be2c0d0c
--- /dev/null
+++ b/crates/tkbool/src/brep_fill/evolved/elementary.rs
@@ -0,0 +1,267 @@
+// Rust translation of BRepFill_Evolved::ElementaryPerform (the tubes and revolutions, the
+// parallel edges and the cut of the faces) of
+// ModelingAlgorithms/TKBool/BRepFill/BRepFill_Evolved.cxx at
+// 3d097a0328e71b826377d4814ab05ec3c3d23871.
+
+//! The elementary volevo of a profile part on one side of Oz: the tubes along the
+//! spine edges and the revolutions at the spine vertices, trimmed by the edges of the
+//! bisectors of the spine, then their parallel edges cut and their faces bounded.
+use super::statics::edge_vertices;
+use super::trim::{trim_edge, trim_face};
+use super::{BRepFillEvolved, find2, find2_mut, first_of};
+use rustycad_tkbrep::brep::BRepBuilder;
+use rustycad_tkbrep::brep_tools::{self, WireExplorer};
+use rustycad_tkbrep::topexp::Explorer;
+use rustycad_tkbrep::topods::{self, Face, Shape, Wire};
+use rustycad_tkbrep::toptools::{MapOfShape, ShapeMapHasher};
+use rustycad_tkernel::ncollection::DataMap;
+use rustycad_tkernel::standard::Failure;
+use rustycad_tkg3d::top_abs::ShapeEnum;
+use rustycad_tkmath::geom_abs::JoinType;
+use rustycad_tkmath::gp::{self, Axis3, Point3};
+use rustycad_tktopalgo::brep_mat2d::{BRepMAT2dBisectingLocus, BRepMAT2dLinkTopoBilo};
+
+/// The edges and vertices generated by the bisectors on each face or parallel edge
+/// (`MapBis`).
+pub(super) type BisectorShapes = DataMap<Shape, Vec<Shape>, ShapeMapHasher>;
+/// The parameters of the vertices of MapBis on each parallel edge (`MapVerPar`).
+pub(super) type VertexParameters = DataMap<Shape, Vec<f64>, ShapeMapHasher>;
+
+/// The frame of the profile: origin, Z and X.
+pub(super) fn profile_frame() -> Result<Axis3, Failure> {
+    Axis3::new(Point3::new(0., 0., 0.), gp::dz(), gp::dx())
+}
+
+impl BRepFillEvolved {
+    /// The revolution at the last vertex of each spine edge with bisectors starting
+    /// there, then the tube of each spine edge with bisectors.
+    fn tubes_and_revolutions(
+        &mut self,
+        link: &mut BRepMAT2dLinkTopoBilo,
+        axe_ref: &Axis3,
+    ) -> Result<(), Failure> {
+        for w in Explorer::new(self.my_spine.as_ref(), ShapeEnum::Wire, ShapeEnum::Shape)? {
+            let mut wire_exp = WireExplorer::with_wire(&topods::wire(&w)?)?;
+            while wire_exp.more() {
+                let current_edge = wire_exp.current().clone();
+                let (_, v_last) = edge_vertices(&current_edge);
+                link.init(v_last.as_ref());
+                while link.more()? {
+                    self.make_revol(&current_edge, &v_last, axe_ref)?;
+                    link.next();
+                }
+                link.init(current_edge.as_ref());
+                while link.more()? {
+                    self.make_pipe(&current_edge, axe_ref)?;
+                    link.next();
+                }
+                wire_exp.next()?;
+            }
+        }
+        Ok(())
+    }
+
+    /// The face controlling the parallel edge of `current_prof` at its first vertex:
+    /// the face of the profile edge, else of the previous one, when it has bisectors.
+    fn controle_face(
+        &self,
+        current_spine: &Shape,
+        current_prof: &Shape,
+        prec_prof: &Shape,
+        map_bis: &BisectorShapes,
+    ) -> Result<Option<Shape>, Failure> {
+        let face_controle = first_of(find2(&self.my_map, current_spine, current_prof)?)?;
+        if map_bis.is_bound(&face_controle) {
+            return Ok(Some(face_controle));
+        }
+        if prec_prof.is_null() {
+            return Ok(None);
+        }
+        let face_controle = first_of(find2(&self.my_map, current_spine, prec_prof)?)?;
+        Ok(map_bis.is_bound(&face_controle).then_some(face_controle))
+    }
+
+    /// The parallel edge `current_edge` trimmed between its bisector vertices against
+    /// the control face, the pieces appended to the shapes of (`spine`, `v`).
+    fn trim_parallel(
+        &mut self,
+        spine: &Shape,
+        v: &Shape,
+        current_edge: &Shape,
+        face_controle: &Shape,
+        map_bis: &mut BisectorShapes,
+        map_ver_par: &mut VertexParameters,
+    ) -> Result<(), Failure> {
+        let control = map_bis.seek(face_controle).cloned().unwrap_or_default();
+        let mut ver = map_bis.seek(current_edge).cloned().unwrap_or_default();
+        let mut par = map_ver_par.seek(current_edge).cloned().unwrap_or_default();
+        let pieces = trim_edge(&topods::edge(current_edge)?, &control, &mut ver, &mut par)?;
+        map_bis.bind(current_edge.clone(), ver);
+        map_ver_par.bind(current_edge.clone(), par);
+        let list = find2_mut(&mut self.my_map, spine, v)?;
+        for p in pieces {
+            list.append(p);
+        }
+        Ok(())
+    }
+
+    /// The parallel edges of one spine shape cut by the vertices of the bisectors;
+    /// `prec_prof` is the previous profile edge, kept from one spine shape to the next
+    /// as natively.
+    fn parallel_edges_of(
+        &mut self,
+        current_spine: &Shape,
+        prec_prof: &mut Shape,
+        map_bis: &mut BisectorShapes,
+        map_ver_par: &mut VertexParameters,
+    ) -> Result<(), Failure> {
+        let mut prof_exp = WireExplorer::with_wire(&self.my_profile)?;
+        let (mut current_prof, mut vcl) = (Shape::default(), Shape::default());
+        while prof_exp.more() {
+            current_prof = prof_exp.current().as_ref().clone();
+            let (vcf, vl) = edge_vertices(prof_exp.current());
+            vcl = vl.as_ref().clone();
+            let current_edge = first_of(find2(&self.my_map, current_spine, vcf.as_ref())?)?;
+            if map_bis.is_bound(&current_edge)
+                && let Some(face_controle) =
+                    self.controle_face(current_spine, &current_prof, prec_prof, map_bis)?
+            {
+                self.trim_parallel(
+                    current_spine,
+                    vcf.as_ref(),
+                    &current_edge,
+                    &face_controle,
+                    map_bis,
+                    map_ver_par,
+                )?;
+            }
+            *prec_prof = current_prof.clone();
+            prof_exp.next()?;
+        }
+        // The parallel edge of the last vertex of the profile.
+        let current_edge = first_of(find2(&self.my_map, current_spine, &vcl)?)?;
+        if !map_bis.is_bound(&current_edge) {
+            return Ok(());
+        }
+        let face_controle = first_of(find2(&self.my_map, current_spine, &current_prof)?)?;
+        // The count of shapes tells whether the edges are done (closed profile).
+        if map_bis.is_bound(&face_controle) && find2(&self.my_map, current_spine, &vcl)?.len() <= 1
+        {
+            self.trim_parallel(
+                current_spine,
+                &vcl,
+                &current_edge,
+                &face_controle,
+                map_bis,
+                map_ver_par,
+            )?;
+        }
+        Ok(())
+    }
+
+    /// The trimming edges of a face completed with the parallel pieces at both ends of
+    /// its profile edge, oriented as their first parallel edge in the face.
+    fn complete_face_edges(
+        &self,
+        current_spine: &Shape,
+        current_prof: &Shape,
+        current_face: &Face,
+        map_bis: &mut BisectorShapes,
+    ) -> Result<(), Failure> {
+        let (vcf, vcl) = edge_vertices(&topods::edge(current_prof)?);
+        for v in [vcf, vcl] {
+            let l: Vec<Shape> = find2(&self.my_map, current_spine, v.as_ref())?
+                .iter()
+                .cloned()
+                .collect();
+            let first = l
+                .first()
+                .ok_or_else(|| super::no_such("no parallel edge at a profile vertex"))?;
+            let ori = brep_tools::ori_edge_in_face(&topods::edge(first)?, current_face)?;
+            let edges = map_bis.try_emplaced(current_face.as_ref().clone(), Vec::new);
+            for re in &l[1..] {
+                edges.push(re.oriented(ori));
+            }
+        }
+        Ok(())
+    }
+
+    /// The faces of one spine shape cut by their trimming edges (a face without
+    /// bisector edges is dropped), then the edges of origin removed from the vertex
+    /// lists.
+    fn cut_faces_of(
+        &mut self,
+        current_spine: &Shape,
+        map_bis: &mut BisectorShapes,
+    ) -> Result<(), Failure> {
+        let mut prof_exp = WireExplorer::with_wire(&self.my_profile)?;
+        while prof_exp.more() {
+            let current_prof = prof_exp.current().as_ref().clone();
+            let current_face = topods::face(&first_of(find2(
+                &self.my_map,
+                current_spine,
+                &current_prof,
+            )?)?)?;
+            find2_mut(&mut self.my_map, current_spine, &current_prof)?.clear();
+            if map_bis.is_bound(current_face.as_ref()) {
+                self.complete_face_edges(current_spine, &current_prof, &current_face, map_bis)?;
+                let mut edges = map_bis
+                    .change_seek(current_face.as_ref())
+                    .map(std::mem::take)
+                    .unwrap_or_default();
+                let faces = trim_face(&current_face, &mut edges)?;
+                map_bis.bind(current_face.as_ref().clone(), edges);
+                for f in faces {
+                    BRepBuilder::default().add(&mut self.my_shape, &f)?;
+                    find2_mut(&mut self.my_map, current_spine, &current_prof)?.append(f);
+                }
+            }
+            prof_exp.next()?;
+        }
+        let mut vmap = MapOfShape::default();
+        for v in Explorer::new(
+            self.my_profile.as_ref(),
+            ShapeEnum::Vertex,
+            ShapeEnum::Shape,
+        )? {
+            if vmap.add(v.clone()) {
+                find2_mut(&mut self.my_map, current_spine, &v)?.remove_first()?;
+            }
+        }
+        Ok(())
+    }
+
+    /// `ElementaryPerform(Spine, Profile, Locus, Link, Join)` (private): the tubes and
+    /// revolutions, the edges of the bisectors on them, the parallel edges cut and the
+    /// faces bounded.
+    pub(super) fn elementary_perform(
+        &mut self,
+        sp: &Face,
+        pr: &Wire,
+        locus: &BRepMAT2dBisectingLocus,
+        link: &mut BRepMAT2dLinkTopoBilo,
+        _join: JoinType,
+    ) -> Result<(), Failure> {
+        self.start_volevo(sp, pr)?;
+        let axe_ref = profile_frame()?;
+        self.tubes_and_revolutions(link, &axe_ref)?;
+        let (mut map_bis, mut map_ver_par) =
+            (BisectorShapes::default(), VertexParameters::default());
+        self.bisector_edges(locus, link, &mut map_bis, &mut map_ver_par)?;
+        let spines: Vec<Shape> = self.my_map.items().map(|(k, _)| k.clone()).collect();
+        let mut prec_prof = Shape::default();
+        for current_spine in &spines {
+            self.parallel_edges_of(
+                current_spine,
+                &mut prec_prof,
+                &mut map_bis,
+                &mut map_ver_par,
+            )?;
+        }
+        for current_spine in &spines {
+            self.cut_faces_of(current_spine, &mut map_bis)?;
+        }
+        self.my_is_done = true;
+        Ok(())
+    }
+}
diff --git a/crates/tkbool/src/brep_fill/evolved/elementary_arcs.rs b/crates/tkbool/src/brep_fill/evolved/elementary_arcs.rs
new file mode 100644
index 000000000..90b1dd3a8
--- /dev/null
+++ b/crates/tkbool/src/brep_fill/evolved/elementary_arcs.rs
@@ -0,0 +1,475 @@
+// Rust translation of the bisector loop of BRepFill_Evolved::ElementaryPerform and the
+// static VertexFromNode and ComputeIntervals of
+// ModelingAlgorithms/TKBool/BRepFill/BRepFill_Evolved.cxx at
+// 3d097a0328e71b826377d4814ab05ec3c3d23871.
+
+//! The edges of the bisectors of the spine on the tubes and revolutions: for each arc
+//! of the map and each profile edge, the bisector projected on the two faces it
+//! separates between its vertices on the parallel edges and at the nodes.
+use super::elementary::{BisectorShapes, VertexParameters};
+use super::node_vertices::{NodeVertices, null_item, vertex_from_node};
+use super::statics::{
+    concave_side, confusion, distance_to_oz, edge_vertices, is_inversed, simple_expression,
+};
+use super::{BRepFillEvolved, find2, first_of};
+use crate::brep_fill::BRepFillTrimSurfaceTool;
+use rustycad_tkbrep::brep::BRepBuilder;
+use rustycad_tkbrep::brep_tools;
+use rustycad_tkbrep::topods::{self, Edge, Face, Shape, Vertex};
+use rustycad_tkbrep::toptools::ShapeMapHasher;
+use rustycad_tkernel::ncollection::{DataMap, Sequence};
+use rustycad_tkernel::standard::{Failure, Handle};
+use rustycad_tkg2d::geom2d::Geom2dCurve;
+use rustycad_tkg3d::top_abs::{self, Orientation, ShapeEnum};
+use rustycad_tkmath::gp::Point3;
+use rustycad_tktopalgo::brep_mat2d::{BRepMAT2dBisectingLocus, BRepMAT2dLinkTopoBilo};
+use rustycad_tktopalgo::mat::{MatArc, MatNode};
+
+/// The intervals of a bisector projected on its faces: parameters and end vertices.
+#[derive(Default)]
+struct Intervals {
+    first_par: Vec<f64>,
+    last_par: Vec<f64>,
+    first_v: Vec<Shape>,
+    last_v: Vec<Shape>,
+}
+
+impl Intervals {
+    /// The interval [`u1`, `u2`] kept when its middle point projects on the faces.
+    fn push_if_on_face(
+        &mut self,
+        trim: &BRepFillTrimSurfaceTool,
+        bis: &Handle<dyn Geom2dCurve>,
+        (u1, v1): (f64, &Shape),
+        (u2, v2): (f64, &Shape),
+    ) -> Result<(), Failure> {
+        if v1.is_null() || v2.is_same(v1) {
+            return Ok(());
+        }
+        if trim.is_on_face(bis.value((u2 + u1) * 0.5)?)? {
+            self.first_par.push(u1);
+            self.last_par.push(u2);
+            self.first_v.push(v1.clone());
+            self.last_v.push(v2.clone());
+        }
+        Ok(())
+    }
+}
+
+/// The vertices of a bisector on the parallel edges of the first and last vertices of
+/// the profile edge, with their parameters.
+#[derive(Clone, Default)]
+struct OnParallels {
+    v_on_f: Vec<Shape>,
+    v_on_l: Vec<Shape>,
+    par_on_f: Vec<Point3>,
+    par_on_l: Vec<Point3>,
+}
+
+/// `ComputeIntervals(VOnF, VOnL, ParOnF, ParOnL, Trim, Bis, VS, VE, ...)` (static): the
+/// intervals of the bisector between consecutive vertices (by parameter, from the
+/// node vertices `vs` to `ve`) whose middle projects on the faces.
+fn compute_intervals(
+    on: &OnParallels,
+    trim: &BRepFillTrimSurfaceTool,
+    bis: &Handle<dyn Geom2dCurve>,
+    vs: &Option<Vertex>,
+    ve: &Option<Vertex>,
+) -> Result<Intervals, Failure> {
+    let mut out = Intervals::default();
+    let (mut i_on_f, mut i_on_l) = (0, 0);
+    let (mut u1, mut v1) = (0., Shape::default());
+    if let Some(vs) = vs {
+        (u1, v1) = (bis.first_parameter(), vs.as_ref().clone());
+    }
+    while i_on_f < on.v_on_f.len() || i_on_l < on.v_on_l.len() {
+        let take_f = i_on_l >= on.v_on_l.len()
+            || (i_on_f < on.v_on_f.len() && on.par_on_f[i_on_f].x() < on.par_on_l[i_on_l].x());
+        let (u2, v2) = if take_f {
+            i_on_f += 1;
+            (on.par_on_f[i_on_f - 1].x(), on.v_on_f[i_on_f - 1].clone())
+        } else {
+            i_on_l += 1;
+            (on.par_on_l[i_on_l - 1].x(), on.v_on_l[i_on_l - 1].clone())
+        };
+        out.push_if_on_face(trim, bis, (u1, &v1), (u2, &v2))?;
+        (u1, v1) = (u2, v2);
+    }
+    if let Some(ve) = ve {
+        out.push_if_on_face(trim, bis, (u1, &v1), (bis.last_parameter(), ve.as_ref()))?;
+    }
+    Ok(out)
+}
+
+/// `seq.SetValue(i, v)` (from 1): Standard_OutOfRange outside the sequence.
+fn set_value(seq: &mut [Shape], i: usize, v: &Option<Vertex>) -> Result<(), Failure> {
+    let len = seq.len();
+    let slot = i
+        .checked_sub(1)
+        .and_then(|k| seq.get_mut(k))
+        .ok_or_else(|| {
+            Failure::with_type(
+                "Standard_OutOfRange",
+                &format!("BRepFill_Evolved: vertex index {i}; expected 1..={len}"),
+                "NCollection_Sequence",
+            )
+        })?;
+    *slot = v.as_ref().map(|v| v.as_ref().clone()).unwrap_or_default();
+    Ok(())
+}
+
+/// The data of one arc of the map in ElementaryPerform.
+struct ArcData {
+    arc: Handle<MatArc>,
+    bis: Handle<dyn Geom2dCurve>,
+    reverse: bool,
+    s: [Shape; 2],
+    concave: [bool; 2],
+}
+
+/// The faces, parallel edges and inversions of the bisector on one profile edge.
+struct ArcFaces {
+    f: [Face; 2],
+    e: [Edge; 4],
+    inv0: [bool; 2],
+    inv1: [bool; 2],
+}
+
+/// The per-arc maps of the vertices and parameters already made at a profile vertex.
+#[derive(Default)]
+struct SeenVertices {
+    ver: DataMap<Shape, Vec<Shape>, ShapeMapHasher>,
+    par: DataMap<Shape, Vec<Point3>, ShapeMapHasher>,
+}
+
+impl BRepFillEvolved {
+    /// The faces separated by the bisector on the profile edge and their parallel
+    /// edges at its vertices.
+    fn arc_faces(
+        &self,
+        a: &ArcData,
+        prof: &Edge,
+        vf: &Vertex,
+        vl: &Vertex,
+    ) -> Result<ArcFaces, Failure> {
+        let face = |k: usize| -> Result<Face, Failure> {
+            topods::face(&first_of(find2(&self.my_map, &a.s[k], prof.as_ref())?)?)
+        };
+        let edge = |k: usize, v: &Vertex| -> Result<Edge, Failure> {
+            topods::edge(&first_of(find2(&self.my_map, &a.s[k], v.as_ref())?)?)
+        };
+        let f = [face(0)?, face(1)?];
+        let e = [edge(0, vf)?, edge(0, vl)?, edge(1, vf)?, edge(1, vl)?];
+        let inv0 = if a.concave[0] {
+            is_inversed(&a.s[0], &e[0], &e[1])?
+        } else {
+            [false, false]
+        };
+        let inv1 = if a.concave[1] {
+            is_inversed(&a.s[1], &e[2], &e[3])?
+        } else {
+            [false, false]
+        };
+        Ok(ArcFaces { f, e, inv0, inv1 })
+    }
+
+    /// The end nodes of the arc from the start of the bisector; a start node on a
+    /// basic element at a spine vertex is replaced by the first node of the start arc
+    /// of that element.
+    fn arc_nodes(a: &ArcData) -> Result<[Handle<MatNode>; 2], Failure> {
+        let arc = a.arc.get().ok_or_else(|| null_item("arc"))?;
+        let (mut node1, node2) = if a.reverse {
+            (arc.second_node(), arc.first_node())
+        } else {
+            (arc.first_node(), arc.second_node())
+        };
+        if node1.get().ok_or_else(|| null_item("node"))?.on_basic_elt() {
+            let element = if a.s[0].shape_type()? == ShapeEnum::Vertex {
+                Some(arc.first_element())
+            } else if a.s[1].shape_type()? == ShapeEnum::Vertex {
+                Some(arc.second_element())
+            } else {
+                None
+            };
+            if let Some(element) = element {
+                let start_arc = element
+                    .get()
+                    .ok_or_else(|| null_item("basic element"))?
+                    .start_arc();
+                node1 = start_arc
+                    .get()
+                    .ok_or_else(|| null_item("arc"))?
+                    .first_node();
+            }
+        }
+        Ok([node1, node2])
+    }
+
+    /// The vertices of the bisector on the parallel edges `ea`/`eb` at a profile
+    /// vertex: new ones at the intersections (the node vertices at the ends when the
+    /// node is on that vertex, status `at`), none when a face is inverted, or the ones
+    /// already made at that vertex.
+    #[allow(clippy::too_many_arguments)] // The native inline block reads all of them.
+    fn vertices_on_parallel(
+        &self,
+        trim: &BRepFillTrimSurfaceTool,
+        (ea, eb): (&Edge, &Edge),
+        inverted: bool,
+        seen: Option<(&Vec<Shape>, &Vec<Point3>)>,
+        at: i32,
+        (start_on_f, vs): (i32, &Option<Vertex>),
+        (end_on_f, ve): (i32, &Option<Vertex>),
+    ) -> Result<(Vec<Shape>, Vec<Point3>), Failure> {
+        if let Some((ver, par)) = seen {
+            return Ok((ver.clone(), par.clone()));
+        }
+        if inverted {
+            return Ok((Vec::new(), Vec::new()));
+        }
+        let mut seq: Sequence<Point3> = Sequence::default();
+        trim.intersect_with(ea, eb, &mut seq)?;
+        let par: Vec<Point3> = seq.iter().copied().collect();
+        let mut ver = Vec::with_capacity(par.len());
+        for _ in 0..par.len() {
+            let mut vc = Vertex::default();
+            BRepBuilder::default().make_vertex(&mut vc);
+            ver.push(vc.into_shape());
+        }
+        if start_on_f == at {
+            set_value(&mut ver, 1, vs)?;
+        }
+        if end_on_f == at {
+            let n = par.len();
+            set_value(&mut ver, n, ve)?;
+        }
+        Ok((ver, par))
+    }
+
+    /// The bisector edge of one interval: on the projected curve, between the interval
+    /// vertices, with its p-curves on both faces and their regularity.
+    fn bisector_edge(
+        trim: &BRepFillTrimSurfaceTool,
+        faces: &ArcFaces,
+        (u1, v1): (f64, &Shape),
+        (u2, v2): (f64, &Shape),
+    ) -> Result<Shape, Failure> {
+        let ((cbis, pcurve1, pcurve2), continuity) = trim.project(u1, u2)?;
+        let b = BRepBuilder::default();
+        let c = cbis.get().ok_or_else(|| null_item("bisector curve"))?;
+        let (first, last) = (c.first_parameter(), c.last_parameter());
+        let mut current_edge = Edge::default();
+        b.make_edge_with_curve(&mut current_edge, &cbis, confusion())?;
+        let (v1, v2) = (topods::vertex(v1)?, topods::vertex(v2)?);
+        b.update_vertex_point(&v1, c.value(first)?, confusion())?;
+        b.update_vertex_point(&v2, c.value(last)?, confusion())?;
+        let mut ce = current_edge.into_shape();
+        b.add(&mut ce, &v1.as_ref().oriented(Orientation::Forward))?;
+        b.add(&mut ce, &v2.as_ref().oriented(Orientation::Reversed))?;
+        let ce_edge = topods::edge(&ce)?;
+        b.range(&ce_edge, first, last, false)?;
+        b.update_edge_pcurve_on_face(&ce_edge, &pcurve1, &faces.f[0], confusion())?;
+        b.update_edge_pcurve_on_face(&ce_edge, &pcurve2, &faces.f[1], confusion())?;
+        b.continuity_on_faces(&ce_edge, &faces.f[0], &faces.f[1], continuity)?;
+        Ok(ce)
+    }
+
+    /// The bisector edges of the intervals stored on both faces: with the orientation
+    /// of the parallel edge of one face and the complement of the other's (skin when
+    /// the profile edge goes away from Oz, contreskin otherwise).
+    fn store_bisector_edges(
+        &self,
+        trim: &BRepFillTrimSurfaceTool,
+        faces: &mut ArcFaces,
+        intervals: &Intervals,
+        skin: bool,
+        map_bis: &mut BisectorShapes,
+    ) -> Result<(), Failure> {
+        for ti in 0..intervals.first_par.len() {
+            let ce = Self::bisector_edge(
+                trim,
+                faces,
+                (intervals.first_par[ti], &intervals.first_v[ti]),
+                (intervals.last_par[ti], &intervals.last_v[ti]),
+            )?;
+            for f in &faces.f {
+                map_bis.try_emplaced(f.as_ref().clone(), Vec::new);
+            }
+            let o0 = brep_tools::ori_edge_in_face(&faces.e[0], &faces.f[0])?;
+            faces.e[0] = topods::edge(&faces.e[0].as_ref().oriented(o0))?;
+            let o2 = brep_tools::ori_edge_in_face(&faces.e[2], &faces.f[1])?;
+            faces.e[2] = topods::edge(&faces.e[2].as_ref().oriented(o2))?;
+            let (first, second, o_first, o_second) =
+                if skin { (0, 1, o0, o2) } else { (1, 0, o2, o0) };
+            let push = |map_bis: &mut BisectorShapes, k: usize, s: Shape| {
+                map_bis
+                    .try_emplaced(faces.f[k].as_ref().clone(), Vec::new)
+                    .push(s);
+            };
+            push(map_bis, first, ce.oriented(o_first));
+            push(map_bis, second, ce.oriented(top_abs::complement(o_second)));
+        }
+        Ok(())
+    }
+
+    /// The vertices on the parallel edges `e[k]` (k from `ks`) stored with their
+    /// parameters (Y on the first face, Z on the second).
+    fn store_parallel_vertices(
+        faces: &ArcFaces,
+        ks: [usize; 2],
+        ver: &[Shape],
+        par: &[Point3],
+        map_bis: &mut BisectorShapes,
+        map_ver_par: &mut VertexParameters,
+    ) {
+        if ver.is_empty() {
+            return;
+        }
+        for (j, k) in ks.into_iter().enumerate() {
+            let key = faces.e[k].as_ref().clone();
+            if !map_bis.is_bound(&key) {
+                map_bis.bind(key.clone(), Vec::new());
+                map_ver_par.bind(key.clone(), Vec::new());
+            }
+            for (v, p) in ver.iter().zip(par) {
+                map_bis.try_emplaced(key.clone(), Vec::new).push(v.clone());
+                map_ver_par
+                    .try_emplaced(key.clone(), Vec::new)
+                    .push(if j == 0 { p.y() } else { p.z() });
+            }
+        }
+    }
+
+    /// The bisector of one arc on one profile edge: its vertices on the parallel edges
+    /// and at the nodes, its edges on the two faces, the vertices recorded on the
+    /// parallel edges.
+    fn arc_on_profile_edge(
+        &self,
+        a: &ArcData,
+        prof: &Edge,
+        on: &mut OnParallels,
+        seen: &mut SeenVertices,
+        node_vertices: &mut NodeVertices,
+        maps: (&mut BisectorShapes, &mut VertexParameters),
+    ) -> Result<(), Failure> {
+        let (map_bis, map_ver_par) = maps;
+        let (vf, vl) = edge_vertices(prof);
+        let mut faces = self.arc_faces(a, prof, &vf, &vl)?;
+        let trim = BRepFillTrimSurfaceTool::new(
+            &a.bis,
+            &faces.f[0],
+            &faces.f[1],
+            &faces.e[0],
+            &faces.e[2],
+            faces.inv0[0],
+            faces.inv1[0],
+        );
+        let [node1, node2] = Self::arc_nodes(a)?;
+        let (start_on_f, vs) = vertex_from_node(&node1, prof, &vf, &vl, node_vertices)?;
+        let (end_on_f, ve) = vertex_from_node(&node2, prof, &vf, &vl, node_vertices)?;
+        let seen_f = seen.ver.seek(vf.as_ref()).zip(seen.par.seek(vf.as_ref()));
+        let first_new = seen_f.is_none();
+        (on.v_on_f, on.par_on_f) = self.vertices_on_parallel(
+            &trim,
+            (&faces.e[0], &faces.e[2]),
+            faces.inv0[0] || faces.inv1[0],
+            seen_f,
+            1,
+            (start_on_f, &vs),
+            (end_on_f, &ve),
+        )?;
+        let seen_l = seen.ver.seek(vl.as_ref()).zip(seen.par.seek(vl.as_ref()));
+        let last_new = seen_l.is_none();
+        (on.v_on_l, on.par_on_l) = self.vertices_on_parallel(
+            &trim,
+            (&faces.e[1], &faces.e[3]),
+            faces.inv0[1] || faces.inv1[1],
+            seen_l,
+            3,
+            (start_on_f, &vs),
+            (end_on_f, &ve),
+        )?;
+        if start_on_f == 0 && end_on_f == 0 && on.v_on_l.len() + on.v_on_f.len() <= 1 {
+            // No trace of the bisector on the face, or only a node on an edge.
+            return Ok(());
+        }
+        let intervals = compute_intervals(on, &trim, &a.bis, &vs, &ve)?;
+        let skin = distance_to_oz(&vf)? < distance_to_oz(&vl)?;
+        self.store_bisector_edges(&trim, &mut faces, &intervals, skin, map_bis)?;
+        if first_new {
+            Self::store_parallel_vertices(
+                &faces,
+                [0, 2],
+                &on.v_on_f,
+                &on.par_on_f,
+                map_bis,
+                map_ver_par,
+            );
+        }
+        if last_new {
+            Self::store_parallel_vertices(
+                &faces,
+                [1, 3],
+                &on.v_on_l,
+                &on.par_on_l,
+                map_bis,
+                map_ver_par,
+            );
+        }
+        // Edge [1] of the current face will be edge [0] of the next face.
+        seen.par.bind(vf.as_ref().clone(), on.par_on_f.clone());
+        seen.ver.bind(vf.as_ref().clone(), on.v_on_f.clone());
+        seen.par.bind(vl.as_ref().clone(), on.par_on_l.clone());
+        seen.ver.bind(vl.as_ref().clone(), on.v_on_l.clone());
+        Ok(())
+    }
+
+    /// The edges of the bisectors of every arc of the map on the faces it separates.
+    pub(super) fn bisector_edges(
+        &self,
+        locus: &BRepMAT2dBisectingLocus,
+        link: &BRepMAT2dLinkTopoBilo,
+        map_bis: &mut BisectorShapes,
+        map_ver_par: &mut VertexParameters,
+    ) -> Result<(), Failure> {
+        let graph = locus.graph();
+        let graph = graph.get().ok_or_else(|| null_item("graph"))?;
+        let mut node_vertices = NodeVertices::default();
+        for i in 1..=graph.number_of_arcs() {
+            let arc = graph.arc(i)?;
+            let (bisec, reverse) = locus.geom_bis(&arc)?;
+            let bis = simple_expression(&bisec)?;
+            let arc_ref = arc.get().ok_or_else(|| null_item("arc"))?;
+            let s = [
+                link.generating_shape(&arc_ref.first_element())?,
+                link.generating_shape(&arc_ref.second_element())?,
+            ];
+            let concave = [
+                concave_side(&s[0], &self.my_spine)?,
+                concave_side(&s[1], &self.my_spine)?,
+            ];
+            let a = ArcData {
+                arc: arc.clone(),
+                bis,
+                reverse,
+                s,
+                concave,
+            };
+            let (mut on, mut seen) = (OnParallels::default(), SeenVertices::default());
+            let mut prof_exp =
+                rustycad_tkbrep::brep_tools::WireExplorer::with_wire(&self.my_profile)?;
+            while prof_exp.more() {
+                let prof = prof_exp.current().clone();
+                self.arc_on_profile_edge(
+                    &a,
+                    &prof,
+                    &mut on,
+                    &mut seen,
+                    &mut node_vertices,
+                    (map_bis, map_ver_par),
+                )?;
+                prof_exp.next()?;
+            }
+        }
+        Ok(())
+    }
+}
