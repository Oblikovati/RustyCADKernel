@@ -0,0 +1,183 @@
+//! `Select3D_SensitiveCurve` (a sensitive polyline of sensitivity 3) and
+//! `Select3D_SensitiveCircle` (an exact sensitive circle).
+use super::{
+    Select3DBndBox3d, Select3DSensitiveEntity, Select3DSensitiveEntityBase,
+    Select3DSensitiveEntityMembers as _, Select3DSensitivePolyCore, Select3DTypeOfSensitivity,
+};
+use crate::impl_select3d_poly;
+use crate::select_basics::{SelectBasicsPickResult, SelectBasicsSelectingVolumeManager};
+use crate::select_mgr::{SelectMgrEntityOwnerSource, SelectMgrSelectionType};
+use rustycad_tkernel::ncollection::{Mat4, Vec3};
+use rustycad_tkernel::standard::{Failure, Handle, StandardTransient};
+use rustycad_tkg3d::geom::GeomCurve;
+use rustycad_tkmath::bvh::BvhBox;
+use rustycad_tkmath::gp::{Axis3, Circle3, Point3, Transform3, xoy};
+
+/// A sensitive polyline of sensitivity 3.
+///
+/// Example: `let curve = Select3DSensitiveCurve::from_points(&owner, &points)?;`.
+pub struct Select3DSensitiveCurve {
+    transient: StandardTransient,
+    /// The poly state.
+    pub core: Select3DSensitivePolyCore,
+}
+rustycad_tkernel::impl_transient!(Select3DSensitiveCurve, "Select3D_SensitiveCurve", dyn super::Select3DSensitiveSet, transient,
+    interfaces: [dyn Select3DSensitiveEntity, dyn super::Select3DSensitiveSet]);
+impl_select3d_poly!(Select3DSensitiveCurve, |curve: &Select3DSensitiveCurve| {
+    let connected =
+        Select3DSensitiveCurve::from_points(&curve.owner_id(), &curve.core.points_3d())?;
+    Ok(Handle::new(connected).cast())
+});
+
+impl Select3DSensitiveCurve {
+    /// A curve of a core, with the sensitivity factor 3.
+    fn of(core: Select3DSensitivePolyCore) -> Self {
+        core.entity.fields.write().sensitivity_factor = 3;
+        Self {
+            transient: StandardTransient::default(),
+            core,
+        }
+    }
+    /// `Select3D_SensitiveCurve(owner, Geom_Curve, nbPnts)`: `nb_pnts` evenly spaced points of
+    /// the curve, with BVH. Example: `Select3DSensitiveCurve::from_curve(&owner, &*curve, 17)?`.
+    pub fn from_curve(
+        owner: &Handle<dyn SelectMgrEntityOwnerSource>,
+        curve: &dyn GeomCurve,
+        nb_pnts: i32,
+    ) -> Result<Self, Failure> {
+        let core = Select3DSensitivePolyCore::with_size(owner, true, nb_pnts)?;
+        let step = (curve.last_parameter() - curve.first_parameter()) / f64::from(nb_pnts - 1);
+        let mut param = curve.first_parameter();
+        {
+            let mut data = core.data.write();
+            for index in 0..data.polyg.size() {
+                data.polyg.set_pnt(index, &curve.value(param)?)?;
+                param += step;
+            }
+        }
+        Ok(Self::of(core))
+    }
+    /// `Select3D_SensitiveCurve(owner, points)`, with BVH; `Select3DSensitiveCurve::from_points(&owner, &points)?`.
+    pub fn from_points(
+        owner: &Handle<dyn SelectMgrEntityOwnerSource>,
+        points: &[Point3],
+    ) -> Result<Self, Failure> {
+        Ok(Self::of(Select3DSensitivePolyCore::from_points(
+            owner, points, true,
+        )?))
+    }
+}
+
+/// An exact sensitive circle, the circle of radius `radius` in `gp::XOY` placed by `trsf`.
+///
+/// Example: `let circle = Select3DSensitiveCircle::new(&owner, &circ, false);`.
+pub struct Select3DSensitiveCircle {
+    transient: StandardTransient,
+    base: Select3DSensitiveEntityBase,
+    sens_type: Select3DTypeOfSensitivity,
+    trsf: Transform3,
+    radius: f64,
+}
+rustycad_tkernel::impl_transient!(Select3DSensitiveCircle, "Select3D_SensitiveCircle", dyn Select3DSensitiveEntity, transient,
+    interfaces: [dyn Select3DSensitiveEntity]);
+
+impl Select3DSensitiveCircle {
+    /// A circle of an owner, filled or a boundary of sensitivity 6.
+    /// Example: `Select3DSensitiveCircle::new(&owner, &circ, false)`.
+    pub fn new(
+        owner: &Handle<dyn SelectMgrEntityOwnerSource>,
+        circle: &Circle3,
+        is_filled: bool,
+    ) -> Self {
+        let mut trsf = Transform3::default();
+        trsf.set_transformation_between(
+            Axis3::from_axis2(circle.position()),
+            Axis3::from_axis2(xoy()),
+        );
+        let sens_type = if is_filled {
+            Select3DTypeOfSensitivity::Interior
+        } else {
+            Select3DTypeOfSensitivity::Boundary
+        };
+        let entity = Self {
+            transient: StandardTransient::default(),
+            base: Select3DSensitiveEntityBase::new(owner),
+            sens_type,
+            trsf,
+            radius: circle.radius(),
+        };
+        if sens_type == Select3DTypeOfSensitivity::Boundary {
+            entity.base.fields.write().sensitivity_factor = 6;
+        }
+        entity
+    }
+    /// `Transformation`; `circle.transformation()`.
+    pub fn transformation(&self) -> Transform3 {
+        self.trsf
+    }
+    /// `Circle`: the circle of `gp::XOY` transformed; the radius check of `gp_Circ` cannot fail
+    /// for a stored radius. Example: `circle.circle()?`.
+    pub fn circle(&self) -> Result<Circle3, Failure> {
+        Circle3::new(xoy().transformed(self.trsf)?, self.radius)
+    }
+    /// `Radius`; `circle.radius()`.
+    pub fn radius(&self) -> f64 {
+        self.radius
+    }
+}
+
+impl Select3DSensitiveEntity for Select3DSensitiveCircle {
+    fn sensitive_base(&self) -> &Select3DSensitiveEntityBase {
+        &self.base
+    }
+    /// `Matches`: as the sphere, with the filled flag of the sensitivity.
+    fn matches(
+        &self,
+        manager: &dyn SelectBasicsSelectingVolumeManager,
+        pick_result: &mut SelectBasicsPickResult,
+    ) -> Result<bool, Failure> {
+        let is_filled = self.sens_type == Select3DTypeOfSensitivity::Interior;
+        if manager.get_active_selection_type() != SelectMgrSelectionType::Point {
+            if !manager.is_overlap_allowed() {
+                let mut is_inside = true;
+                return Ok(manager.overlaps_circle_inside(
+                    self.radius,
+                    &self.trsf,
+                    is_filled,
+                    Some(&mut is_inside),
+                )? && is_inside);
+            }
+            return manager.overlaps_circle_inside(self.radius, &self.trsf, is_filled, None);
+        }
+        if !manager.overlaps_circle(self.radius, &self.trsf, is_filled, pick_result)? {
+            return Ok(false);
+        }
+        pick_result
+            .set_dist_to_geom_center(manager.dist_to_geometry_center(&self.center_of_geometry()));
+        Ok(true)
+    }
+    fn nb_sub_elements(&self) -> i32 {
+        1
+    }
+    /// `BoundingBox`: the square of the radius in XOY, transformed.
+    fn bounding_box(&self) -> Select3DBndBox3d {
+        let mut matrix = Mat4::<f64>::default();
+        self.trsf.get_mat4(&mut matrix);
+        let mut bounds = BvhBox::from_corners(
+            Vec3::new(-self.radius, -self.radius, 0.0),
+            Vec3::new(self.radius, self.radius, 0.0),
+        );
+        bounds.transform(&matrix);
+        bounds
+    }
+    fn center_of_geometry(&self) -> Point3 {
+        Point3::from(self.trsf.translation_part())
+    }
+    fn get_connected(&self) -> Result<Handle<dyn Select3DSensitiveEntity>, Failure> {
+        let is_filled = self.sens_type == Select3DTypeOfSensitivity::Interior;
+        Ok(Handle::new(Self::new(&self.owner_id(), &self.circle()?, is_filled)).cast())
+    }
+    fn to_build_bvh(&self) -> bool {
+        false
+    }
+}
diff --git a/crates/tkv3d/src/select3d/sensitive_entity.rs b/crates/tkv3d/src/select3d/sensitive_entity.rs
new file mode 100644
index 000000000..5d7ea00de
--- /dev/null
+++ b/crates/tkv3d/src/select3d/sensitive_entity.rs
@@ -0,0 +1,199 @@
+//! `Select3D_SensitiveEntity`: the abstract entity a selecting volume tests (v3d-design.md
+//! section 6). The class is abstract with virtual members, so it is the
+//! [`Select3DSensitiveEntity`] trait over the embedded [`Select3DSensitiveEntityBase`]; the
+//! non-virtual members are [`Select3DSensitiveEntityMembers`].
+use crate::select_basics::{SelectBasicsPickResult, SelectBasicsSelectingVolumeManager};
+use crate::select_mgr::SelectMgrEntityOwnerSource;
+use rustycad_tkernel::standard::dump::DumpStream;
+use rustycad_tkernel::standard::exceptions::program_error;
+use rustycad_tkernel::standard::{Failure, Handle, SharedState, StandardTransient, Transient};
+use rustycad_tkmath::bvh::{BvhBox, BvhVec3d};
+use rustycad_tkmath::gp::{Axis2, GeneralTransform3, Point3, Transform3};
+use rustycad_tkservice::graphic3d::{Graphic3dFlipper, Graphic3dTransformPersSource};
+use rustycad_tkservice::json_dump::{class_begin, field_dumped, field_integer, field_pointer};
+use std::io;
+
+/// `Select3D_BndBox3d`: the axis-aligned box of a sensitive entity (`BVH_Box<double, 3>`).
+pub type Select3DBndBox3d = BvhBox<BvhVec3d>;
+
+/// The protected fields of `Select3D_SensitiveEntity`.
+#[derive(Clone)]
+pub struct Select3DSensitiveEntityFields {
+    /// `myOwnerId`.
+    pub owner_id: Handle<dyn SelectMgrEntityOwnerSource>,
+    /// `myTrsfPers`.
+    pub trsf_pers: Handle<dyn Graphic3dTransformPersSource>,
+    /// `myFlipper`.
+    pub flipper: Handle<Graphic3dFlipper>,
+    /// `mySFactor`.
+    pub sensitivity_factor: i32,
+}
+
+/// The state every sensitive entity embeds.
+pub struct Select3DSensitiveEntityBase {
+    /// The protected fields.
+    pub fields: SharedState<Select3DSensitiveEntityFields>,
+}
+
+impl Select3DSensitiveEntityBase {
+    /// The constructor state: the owner and the sensitivity factor 2.
+    /// Example: `Select3DSensitiveEntityBase::new(&owner)`.
+    pub fn new(owner: &Handle<dyn SelectMgrEntityOwnerSource>) -> Self {
+        let fields = Select3DSensitiveEntityFields {
+            owner_id: owner.clone(),
+            trsf_pers: Handle::default(),
+            flipper: Handle::default(),
+            sensitivity_factor: 2,
+        };
+        Self {
+            fields: SharedState::new(fields),
+        }
+    }
+    /// A copy of the fields; `base.read()`.
+    pub fn read(&self) -> Select3DSensitiveEntityFields {
+        self.fields.read().clone()
+    }
+}
+
+/// An entity that a selecting volume tests; the default bodies are the native ones.
+pub trait Select3DSensitiveEntity: Transient {
+    /// The embedded base; `entity.sensitive_base()`.
+    fn sensitive_base(&self) -> &Select3DSensitiveEntityBase;
+    /// `Matches` (pure virtual): whether the volume detects the entity, filling the pick
+    /// result; a failure to build the entity BVH is returned. Example: `entity.matches(&manager, &mut pick)?`.
+    fn matches(
+        &self,
+        manager: &dyn SelectBasicsSelectingVolumeManager,
+        pick_result: &mut SelectBasicsPickResult,
+    ) -> Result<bool, Failure>;
+    /// `NbSubElements` (pure virtual); `entity.nb_sub_elements()`.
+    fn nb_sub_elements(&self) -> i32;
+    /// `BoundingBox` (pure virtual); `entity.bounding_box()`.
+    fn bounding_box(&self) -> Select3DBndBox3d;
+    /// `CenterOfGeometry` (pure virtual); `entity.center_of_geometry()`.
+    fn center_of_geometry(&self) -> Point3;
+    /// `Set`: the owner; `entity.set(&owner)`.
+    fn set(&self, owner: &Handle<dyn SelectMgrEntityOwnerSource>) {
+        self.sensitive_base().fields.write().owner_id = owner.clone();
+    }
+    /// `GetConnected`: null by default; `entity.get_connected()`.
+    fn get_connected(&self) -> Result<Handle<dyn Select3DSensitiveEntity>, Failure> {
+        Ok(Handle::default())
+    }
+    /// `BVH`: builds the internal BVH (nothing by default); `entity.bvh()?`.
+    fn bvh(&self) -> Result<(), Failure> {
+        Ok(())
+    }
+    /// `ToBuildBVH`: true by default; `entity.to_build_bvh()`.
+    fn to_build_bvh(&self) -> bool {
+        true
+    }
+    /// `Clear`: forgets the owner; `entity.clear()`.
+    fn clear(&self) {
+        self.set(&Handle::default());
+    }
+    /// `HasInitLocation`: false by default; `entity.has_init_location()`.
+    fn has_init_location(&self) -> bool {
+        false
+    }
+    /// `InvInitLocation`: the identity by default; `entity.inv_init_location()`.
+    fn inv_init_location(&self) -> GeneralTransform3 {
+        GeneralTransform3::from(Transform3::default())
+    }
+    /// `SetTransformPersistence`; `entity.set_transform_persistence(&pers)`.
+    fn set_transform_persistence(&self, trsf_pers: &Handle<dyn Graphic3dTransformPersSource>) {
+        self.sensitive_base().fields.write().trsf_pers = trsf_pers.clone();
+    }
+    /// `SetFlippingOptions`: a flipper about the plane when enabled, none otherwise.
+    /// Example: `entity.set_flipping_options(true, &plane)`.
+    fn set_flipping_options(&self, is_enabled: bool, ref_plane: &Axis2) {
+        let flipper = if is_enabled {
+            Handle::new(Graphic3dFlipper::new(*ref_plane))
+        } else {
+            Handle::default()
+        };
+        self.sensitive_base().fields.write().flipper = flipper;
+    }
+    /// `DumpJson`; `entity.dump_json(&mut stream, -1)?`.
+    fn dump_json(&self, stream: &mut DumpStream, depth: i32) -> io::Result<()> {
+        select3d_sensitive_entity_dump_json(self, stream, depth)
+    }
+}
+rustycad_tkernel::impl_transient_interface!(
+    dyn Select3DSensitiveEntity,
+    "Select3D_SensitiveEntity",
+    StandardTransient
+);
+
+/// The non-virtual members of every sensitive entity.
+pub trait Select3DSensitiveEntityMembers: Select3DSensitiveEntity {
+    /// `OwnerId`; `entity.owner_id()`.
+    fn owner_id(&self) -> Handle<dyn SelectMgrEntityOwnerSource> {
+        self.sensitive_base().read().owner_id
+    }
+    /// `SensitivityFactor`; `entity.sensitivity_factor()`.
+    fn sensitivity_factor(&self) -> i32 {
+        self.sensitive_base().read().sensitivity_factor
+    }
+    /// `SetSensitivityFactor`: a negative factor raises `Standard_ProgramError`.
+    /// Example: `entity.set_sensitivity_factor(4)?`.
+    fn set_sensitivity_factor(&self, new_sens: i32) -> Result<(), Failure> {
+        if new_sens < 0 {
+            return Err(program_error(&format!(
+                "Error! Selection sensitivity should not be negative value: {new_sens}; expected >= 0"
+            )));
+        }
+        self.sensitive_base().fields.write().sensitivity_factor = new_sens;
+        Ok(())
+    }
+    /// `TransformPersistence`; `entity.transform_persistence()`.
+    fn transform_persistence(&self) -> Handle<dyn Graphic3dTransformPersSource> {
+        self.sensitive_base().read().trsf_pers
+    }
+    /// `Flipper`; `entity.flipper()`.
+    fn flipper(&self) -> Handle<Graphic3dFlipper> {
+        self.sensitive_base().read().flipper
+    }
+}
+impl<T: Select3DSensitiveEntity + ?Sized> Select3DSensitiveEntityMembers for T {}
+
+/// The native `Select3D_SensitiveEntity::DumpJson` body, for the overrides that dump it.
+/// Example: `select3d_sensitive_entity_dump_json(&*entity, &mut stream, -1)?`.
+pub fn select3d_sensitive_entity_dump_json<E: Select3DSensitiveEntity + ?Sized>(
+    entity: &E,
+    stream: &mut DumpStream,
+    depth: i32,
+) -> io::Result<()> {
+    class_begin(stream, "Select3D_SensitiveEntity")?;
+    let fields = entity.sensitive_base().read();
+    field_pointer(
+        stream,
+        "myOwnerId.get()",
+        fields.owner_id.object_address() as usize,
+    )?;
+    if let Some(pers) = fields.trsf_pers.get() {
+        field_dumped(stream, depth, "myTrsfPers.get()", &|s, d| {
+            pers.dump_json(s, d)
+        })?;
+    }
+    if let Some(flipper) = fields.flipper.get() {
+        field_dumped(stream, depth, "myFlipper.get()", &|s, d| {
+            flipper.dump_json(s, d)
+        })?;
+    }
+    field_integer(stream, "mySFactor", fields.sensitivity_factor)?;
+    field_integer(stream, "NbSubElements()", entity.nb_sub_elements())?;
+    let center = entity.center_of_geometry();
+    field_dumped(stream, depth, "&aCenterOfGeometry", &|s, _| {
+        center.dump_json(s)
+    })?;
+    field_integer(
+        stream,
+        "aHasInitLocation",
+        i32::from(entity.has_init_location()),
+    )?;
+    let inverse = entity.inv_init_location();
+    field_dumped(stream, depth, "&anInvInitLocation", &|s, d| {
+        inverse.dump_json(s, d)
+    })
+}
diff --git a/crates/tkv3d/src/select3d/sensitive_face.rs b/crates/tkv3d/src/select3d/sensitive_face.rs
new file mode 100644
index 000000000..cff680f58
--- /dev/null
+++ b/crates/tkv3d/src/select3d/sensitive_face.rs
@@ -0,0 +1,137 @@
+//! `Select3D_SensitiveFace`: a sensitive polygon, its interior (planar parts) or its boundary
+//! (a poly with BVH).
+use super::{
+    Select3DBndBox3d, Select3DInteriorSensitivePointSet, Select3DSensitiveEntity,
+    Select3DSensitiveEntityBase, Select3DSensitiveEntityMembers as _, Select3DSensitivePoly,
+    Select3DTypeOfSensitivity, select3d_sensitive_entity_dump_json,
+};
+use crate::select_basics::{SelectBasicsPickResult, SelectBasicsSelectingVolumeManager};
+use crate::select_mgr::SelectMgrEntityOwnerSource;
+use rustycad_tkernel::standard::dump::DumpStream;
+use rustycad_tkernel::standard::{Failure, Handle, StandardTransient};
+use rustycad_tkmath::gp::Point3;
+use rustycad_tkservice::json_dump::{base_class, class_begin, field_dumped, field_integer};
+use std::io;
+
+/// The sensitive set of a face (`myFacePoints`), by sensitivity.
+#[derive(Clone)]
+enum FacePoints {
+    Interior(Handle<Select3DInteriorSensitivePointSet>),
+    Boundary(Handle<Select3DSensitivePoly>),
+}
+
+impl FacePoints {
+    /// The set as a sensitive entity.
+    fn entity(&self) -> Handle<dyn Select3DSensitiveEntity> {
+        match self {
+            Self::Interior(set) => set.clone().cast(),
+            Self::Boundary(poly) => poly.clone().cast(),
+        }
+    }
+}
+
+/// A sensitive face.
+///
+/// Example: `let face = Select3DSensitiveFace::new(&owner, &points, Select3DTypeOfSensitivity::Interior)?;`.
+pub struct Select3DSensitiveFace {
+    transient: StandardTransient,
+    base: Select3DSensitiveEntityBase,
+    sens_type: Select3DTypeOfSensitivity,
+    face_points: FacePoints,
+}
+rustycad_tkernel::impl_transient!(Select3DSensitiveFace, "Select3D_SensitiveFace", dyn Select3DSensitiveEntity, transient,
+    interfaces: [dyn Select3DSensitiveEntity]);
+
+impl Select3DSensitiveFace {
+    /// A face of an owner: an interior point set or a boundary poly with BVH; no point raises
+    /// `Standard_ConstructionError` for a boundary. Example: `Select3DSensitiveFace::new(&owner, &points, kind)?`.
+    pub fn new(
+        owner: &Handle<dyn SelectMgrEntityOwnerSource>,
+        points: &[Point3],
+        sens_type: Select3DTypeOfSensitivity,
+    ) -> Result<Self, Failure> {
+        let face_points = match sens_type {
+            Select3DTypeOfSensitivity::Interior => FacePoints::Interior(Handle::new(
+                Select3DInteriorSensitivePointSet::new(owner, points)?,
+            )),
+            Select3DTypeOfSensitivity::Boundary => FacePoints::Boundary(Handle::new(
+                Select3DSensitivePoly::new(owner, points, true)?,
+            )),
+        };
+        Ok(Self {
+            transient: StandardTransient::default(),
+            base: Select3DSensitiveEntityBase::new(owner),
+            sens_type,
+            face_points,
+        })
+    }
+    /// `GetPoints`: the points of the boundary poly or of the interior set; `face.get_points()`.
+    pub fn get_points(&self) -> Vec<Point3> {
+        match &self.face_points {
+            FacePoints::Interior(set) => set.get_points(),
+            FacePoints::Boundary(poly) => poly.points_3d(),
+        }
+    }
+    /// The inner set as an entity.
+    fn inner(&self) -> Handle<dyn Select3DSensitiveEntity> {
+        self.face_points.entity()
+    }
+}
+
+impl Select3DSensitiveEntity for Select3DSensitiveFace {
+    fn sensitive_base(&self) -> &Select3DSensitiveEntityBase {
+        &self.base
+    }
+    fn matches(
+        &self,
+        manager: &dyn SelectBasicsSelectingVolumeManager,
+        pick_result: &mut SelectBasicsPickResult,
+    ) -> Result<bool, Failure> {
+        self.inner()
+            .get()
+            .map_or(Ok(false), |e| e.matches(manager, pick_result))
+    }
+    fn nb_sub_elements(&self) -> i32 {
+        self.inner().get().map_or(0, |e| e.nb_sub_elements())
+    }
+    fn bounding_box(&self) -> Select3DBndBox3d {
+        self.inner()
+            .get()
+            .map(|e| e.bounding_box())
+            .unwrap_or_default()
+    }
+    fn center_of_geometry(&self) -> Point3 {
+        self.inner()
+            .get()
+            .map(|e| e.center_of_geometry())
+            .unwrap_or_default()
+    }
+    fn get_connected(&self) -> Result<Handle<dyn Select3DSensitiveEntity>, Failure> {
+        Ok(Handle::new(Self::new(
+            &self.owner_id(),
+            &self.get_points(),
+            self.sens_type,
+        )?)
+        .cast())
+    }
+    fn bvh(&self) -> Result<(), Failure> {
+        self.inner().get().map_or(Ok(()), |e| e.bvh())
+    }
+    fn to_build_bvh(&self) -> bool {
+        self.inner().get().is_some_and(|e| e.to_build_bvh())
+    }
+    fn dump_json(&self, stream: &mut DumpStream, depth: i32) -> io::Result<()> {
+        class_begin(stream, "Select3D_SensitiveFace")?;
+        base_class(stream, depth, &|s, d| {
+            select3d_sensitive_entity_dump_json(self, s, d)
+        })?;
+        field_integer(stream, "mySensType", self.sens_type as i32)?;
+        let inner = self.inner();
+        if let Some(entity) = inner.get() {
+            field_dumped(stream, depth, "myFacePoints.get()", &|s, d| {
+                entity.dump_json(s, d)
+            })?;
+        }
+        Ok(())
+    }
+}
diff --git a/crates/tkv3d/src/select3d/sensitive_group.rs b/crates/tkv3d/src/select3d/sensitive_group.rs
new file mode 100644
index 000000000..f7f12af27
--- /dev/null
+++ b/crates/tkv3d/src/select3d/sensitive_group.rs
@@ -0,0 +1,392 @@
+//! `Select3D_SensitiveGroup`: distinct sensitive entities matched together (all of them for a
+//! box or polyline when asked) or through a BVH tree.
+use super::{
+    Select3DBndBox3d, Select3DSensitiveEntity, Select3DSensitiveEntityBase,
+    Select3DSensitiveEntityMembers as _, Select3DSensitiveSet, Select3DSensitiveSetBase,
+    select3d_set_build_bvh, select3d_set_dump_json, select3d_set_matches,
+};
+use crate::select_basics::{SelectBasicsPickResult, SelectBasicsSelectingVolumeManager};
+use crate::select_mgr::{SelectMgrEntityOwnerSource, SelectMgrSelectionType};
+use rustycad_tkernel::standard::dump::DumpStream;
+use rustycad_tkernel::standard::{Failure, Handle, SharedState, StandardTransient};
+use rustycad_tkmath::gp::{Point3, Xyz};
+use rustycad_tkservice::json_dump::{base_class, class_begin, field_dumped, field_integer};
+use std::io;
+
+/// The mutable state of a group.
+#[derive(Clone)]
+struct GroupState {
+    entities: Vec<Handle<dyn Select3DSensitiveEntity>>,
+    must_match_all: bool,
+    to_check_overlap_all: bool,
+    center: Point3,
+    bnd_box: Select3DBndBox3d,
+    bvh_prim_indexes: Vec<i32>,
+}
+
+impl GroupState {
+    /// `myEntities.Add`: appends a new entity; false when it is already in the group.
+    fn add_entity(&mut self, entity: &Handle<dyn Select3DSensitiveEntity>) -> bool {
+        if self.entities.iter().any(|e| e == entity) {
+            return false;
+        }
+        self.entities.push(entity.clone());
+        true
+    }
+}
+
+/// A group of sensitive entities.
+///
+/// Example: `let group = Select3DSensitiveGroup::new(&owner, true); group.add(&entity);`.
+pub struct Select3DSensitiveGroup {
+    transient: StandardTransient,
+    entity: Select3DSensitiveEntityBase,
+    set: Select3DSensitiveSetBase,
+    state: SharedState<GroupState>,
+}
+rustycad_tkernel::impl_transient!(Select3DSensitiveGroup, "Select3D_SensitiveGroup", dyn Select3DSensitiveSet, transient,
+    interfaces: [dyn Select3DSensitiveEntity, dyn Select3DSensitiveSet]);
+
+impl Select3DSensitiveGroup {
+    /// An empty group; `Select3DSensitiveGroup::new(&owner, true)`.
+    pub fn new(owner: &Handle<dyn SelectMgrEntityOwnerSource>, is_must_match_all: bool) -> Self {
+        let state = GroupState {
+            entities: Vec::new(),
+            must_match_all: is_must_match_all,
+            to_check_overlap_all: false,
+            center: Point3::new(0.0, 0.0, 0.0),
+            bnd_box: Select3DBndBox3d::default(),
+            bvh_prim_indexes: Vec::new(),
+        };
+        Self {
+            transient: StandardTransient::default(),
+            entity: Select3DSensitiveEntityBase::new(owner),
+            set: Select3DSensitiveSetBase::default(),
+            state: SharedState::new(state),
+        }
+    }
+    /// A group of the distinct entities, centered on their mean; `Select3DSensitiveGroup::with_entities(&owner, &entities, true)`.
+    pub fn with_entities(
+        owner: &Handle<dyn SelectMgrEntityOwnerSource>,
+        entities: &[Handle<dyn Select3DSensitiveEntity>],
+        is_must_match_all: bool,
+    ) -> Self {
+        let group = Self::new(owner, is_must_match_all);
+        {
+            let mut state = group.state.write();
+            let mut center = Xyz::new(0.0, 0.0, 0.0);
+            for entity in entities {
+                if !state.add_entity(entity) {
+                    continue;
+                }
+                let Some(value) = entity.get() else { continue };
+                state.bnd_box.combine(&value.bounding_box());
+                let extent = state.entities.len() as i32;
+                state.bvh_prim_indexes.push(extent);
+                center += value.center_of_geometry().xyz();
+            }
+            state.center = Point3::from(center / state.entities.len() as f64);
+        }
+        group.set.mark_dirty();
+        group
+    }
+    /// `Entities`; `group.entities()`.
+    pub fn entities(&self) -> Vec<Handle<dyn Select3DSensitiveEntity>> {
+        self.state.read().entities.clone()
+    }
+    /// `SubEntity`: the entity at a one-based index, null out of range; `group.sub_entity(1)`.
+    pub fn sub_entity(&self, index: i32) -> Handle<dyn Select3DSensitiveEntity> {
+        let state = self.state.read();
+        usize::try_from(index - 1)
+            .ok()
+            .and_then(|i| state.entities.get(i).cloned())
+            .unwrap_or_default()
+    }
+    /// `LastDetectedEntity`; `group.last_detected_entity()`.
+    pub fn last_detected_entity(&self) -> Handle<dyn Select3DSensitiveEntity> {
+        let index = self.last_detected_entity_index();
+        if index == -1 {
+            Handle::default()
+        } else {
+            self.sub_entity(index)
+        }
+    }
+    /// `LastDetectedEntityIndex`: the one-based index of the detected entity, -1 without.
+    /// Example: `group.last_detected_entity_index()`.
+    pub fn last_detected_entity_index(&self) -> i32 {
+        let detected = self.set.detected_idx();
+        if detected == -1 {
+            return -1;
+        }
+        self.state
+            .read()
+            .bvh_prim_indexes
+            .get(detected as usize)
+            .copied()
+            .unwrap_or(-1)
+    }
+    /// `Add(sequence)`: the new entities, the center moved halfway to their mean.
+    /// Example: `group.add_all(&entities)`.
+    pub fn add_all(&self, entities: &[Handle<dyn Select3DSensitiveEntity>]) {
+        if entities.is_empty() {
+            return;
+        }
+        let mut state = self.state.write();
+        let mut center = Xyz::new(0.0, 0.0, 0.0);
+        for entity in entities {
+            if !state.add_entity(entity) {
+                continue;
+            }
+            let Some(value) = entity.get() else { continue };
+            state.bnd_box.combine(&value.bounding_box());
+            let extent = state.entities.len() as i32;
+            state.bvh_prim_indexes.push(extent);
+            center += value.center_of_geometry().xyz();
+        }
+        center /= state.entities.len() as f64;
+        state.center = Point3::from((state.center.xyz() + center) * 0.5);
+    }
+    /// `Add(entity)`: a new entity; the center is the running half-sum (natively not a mean).
+    /// Example: `group.add(&entity)`.
+    pub fn add(&self, sensitive: &Handle<dyn Select3DSensitiveEntity>) {
+        let mut state = self.state.write();
+        if !state.add_entity(sensitive) {
+            return;
+        }
+        let extent = state.entities.len() as i32;
+        state.bvh_prim_indexes.push(extent);
+        let Some(value) = sensitive.get() else { return };
+        state.bnd_box.combine(&value.bounding_box());
+        let mut center = state.center.xyz() + value.center_of_geometry().xyz();
+        if extent >= 2 {
+            center *= 0.5;
+        }
+        state.center = Point3::from(center);
+    }
+    /// `Remove`: the entity (the last one takes its index, as `NCollection_IndexedMap`), then
+    /// the box, the mean center and the indexes are rebuilt. Example: `group.remove(&entity)`.
+    pub fn remove(&self, sensitive: &Handle<dyn Select3DSensitiveEntity>) {
+        let mut state = self.state.write();
+        let Some(index) = state.entities.iter().position(|e| e == sensitive) else {
+            return;
+        };
+        state.entities.swap_remove(index);
+        state.bnd_box.clear();
+        state.bvh_prim_indexes.clear();
+        let mut center = Xyz::new(0.0, 0.0, 0.0);
+        let entities = state.entities.clone();
+        for (offset, entity) in entities.iter().enumerate() {
+            if let Some(value) = entity.get() {
+                state.bnd_box.combine(&value.bounding_box());
+                center += value.center_of_geometry().xyz();
+            }
+            state.bvh_prim_indexes.push(offset as i32 + 1);
+        }
+        state.center = Point3::from(center / state.entities.len() as f64);
+    }
+    /// `IsIn`; `group.is_in(&entity)`.
+    pub fn is_in(&self, sensitive: &Handle<dyn Select3DSensitiveEntity>) -> bool {
+        self.state.read().entities.iter().any(|e| e == sensitive)
+    }
+    /// `SetMatchType`; `group.set_match_type(false)`.
+    pub fn set_match_type(&self, is_must_match_all: bool) {
+        self.state.write().must_match_all = is_must_match_all;
+    }
+    /// `MustMatchAll`; `group.must_match_all()`.
+    pub fn must_match_all(&self) -> bool {
+        self.state.read().must_match_all
+    }
+    /// `ToCheckOverlapAll`; `group.to_check_overlap_all()`.
+    pub fn to_check_overlap_all(&self) -> bool {
+        self.state.read().to_check_overlap_all
+    }
+    /// `SetCheckOverlapAll`; `group.set_check_overlap_all(true)`.
+    pub fn set_check_overlap_all(&self, to_check_all: bool) {
+        self.state.write().to_check_overlap_all = to_check_all;
+    }
+    /// The entity at a BVH index.
+    fn element(&self, idx: i32) -> Handle<dyn Select3DSensitiveEntity> {
+        let index = self
+            .state
+            .read()
+            .bvh_prim_indexes
+            .get(idx as usize)
+            .copied()
+            .unwrap_or(0);
+        self.sub_entity(index)
+    }
+    /// The match of every entity (`Matches` for a box or polyline with `MustMatchAll` or
+    /// `ToCheckOverlapAll`), keeping the nearest pick.
+    fn matches_all(
+        &self,
+        manager: &dyn SelectBasicsSelectingVolumeManager,
+        pick_result: &mut SelectBasicsPickResult,
+        to_match_all: bool,
+        to_check_all: bool,
+    ) -> Result<bool, Failure> {
+        let mut pick = SelectBasicsPickResult::default();
+        let mut is_failed = false;
+        for child in self.entities().iter().filter_map(Handle::get) {
+            if !child.matches(manager, &mut pick)? {
+                if to_match_all {
+                    is_failed = true;
+                    if !to_check_all {
+                        break;
+                    }
+                }
+            } else {
+                *pick_result = *SelectBasicsPickResult::min(pick_result, &pick);
+            }
+        }
+        if is_failed {
+            return Ok(false);
+        }
+        pick_result.set_dist_to_geom_center(self.distance_to_cog(manager));
+        Ok(true)
+    }
+}
+
+impl Select3DSensitiveEntity for Select3DSensitiveGroup {
+    fn sensitive_base(&self) -> &Select3DSensitiveEntityBase {
+        &self.entity
+    }
+    fn matches(
+        &self,
+        manager: &dyn SelectBasicsSelectingVolumeManager,
+        pick_result: &mut SelectBasicsPickResult,
+    ) -> Result<bool, Failure> {
+        let is_volume = manager.get_active_selection_type() != SelectMgrSelectionType::Point;
+        let (must_all, check_all) = {
+            let state = self.state.read();
+            (state.must_match_all, state.to_check_overlap_all)
+        };
+        let (to_match_all, to_check_all) = (is_volume && must_all, is_volume && check_all);
+        if !to_match_all && !to_check_all {
+            return select3d_set_matches(self, manager, pick_result, false);
+        }
+        self.matches_all(manager, pick_result, to_match_all, to_check_all)
+    }
+    fn nb_sub_elements(&self) -> i32 {
+        self.state.read().entities.len() as i32
+    }
+    fn bounding_box(&self) -> Select3DBndBox3d {
+        let (mut bounds, entities) = {
+            let state = self.state.read();
+            if state.bnd_box.is_valid() {
+                return state.bnd_box;
+            }
+            (state.bnd_box, state.entities.clone())
+        };
+        for entity in entities.iter().filter_map(Handle::get) {
+            bounds.combine(&entity.bounding_box());
+        }
+        self.state.write().bnd_box = bounds;
+        bounds
+    }
+    fn center_of_geometry(&self) -> Point3 {
+        self.state.read().center
+    }
+    fn set(&self, owner: &Handle<dyn SelectMgrEntityOwnerSource>) {
+        self.entity.fields.write().owner_id = owner.clone();
+        for entity in self.entities().iter().filter_map(Handle::get) {
+            entity.set(owner);
+        }
+    }
+    fn get_connected(&self) -> Result<Handle<dyn Select3DSensitiveEntity>, Failure> {
+        let group = Self::new(&self.owner_id(), self.must_match_all());
+        let mut connected = Vec::new();
+        for entity in self.entities().iter().filter_map(Handle::get) {
+            connected.push(entity.get_connected()?);
+        }
+        group.add_all(&connected);
+        Ok(Handle::new(group).cast())
+    }
+    fn bvh(&self) -> Result<(), Failure> {
+        select3d_set_build_bvh(self)
+    }
+    fn to_build_bvh(&self) -> bool {
+        self.set.is_dirty()
+    }
+    /// `Clear`: forgets every entity (the owner is kept).
+    fn clear(&self) {
+        let mut state = self.state.write();
+        state.entities.clear();
+        state.bnd_box.clear();
+        state.center = Point3::new(0.0, 0.0, 0.0);
+        state.bvh_prim_indexes.clear();
+    }
+    fn dump_json(&self, stream: &mut DumpStream, depth: i32) -> io::Result<()> {
+        class_begin(stream, "Select3D_SensitiveGroup")?;
+        base_class(stream, depth, &|s, d| select3d_set_dump_json(self, s, d))?;
+        let state = self.state.read().clone();
+        for entity in state.entities.iter().filter_map(Handle::get) {
+            field_dumped(stream, depth, "anEntity.get()", &|s, d| {
+                entity.dump_json(s, d)
+            })?;
+        }
+        field_integer(stream, "myMustMatchAll", i32::from(state.must_match_all))?;
+        field_integer(
+            stream,
+            "myToCheckOverlapAll",
+            i32::from(state.to_check_overlap_all),
+        )?;
+        let bounds = state.bnd_box;
+        field_dumped(stream, depth, "&myBndBox", &|s, _| bounds.dump_json(s))
+    }
+}
+
+impl Select3DSensitiveSet for Select3DSensitiveGroup {
+    fn set_base(&self) -> &Select3DSensitiveSetBase {
+        &self.set
+    }
+    fn size(&self) -> i32 {
+        self.state.read().bvh_prim_indexes.len() as i32
+    }
+    fn element_box(&self, idx: i32) -> Select3DBndBox3d {
+        self.element(idx)
+            .get()
+            .map(|e| e.bounding_box())
+            .unwrap_or_default()
+    }
+    fn center(&self, idx: i32, axis: i32) -> Result<f64, Failure> {
+        let center = self
+            .element(idx)
+            .get()
+            .map(|e| e.center_of_geometry())
+            .unwrap_or_default();
+        Ok(match axis {
+            0 => center.x(),
+            1 => center.y(),
+            _ => center.z(),
+        })
+    }
+    fn swap(&self, idx1: i32, idx2: i32) {
+        self.state
+            .write()
+            .bvh_prim_indexes
+            .swap(idx1 as usize, idx2 as usize);
+    }
+    fn overlaps_element(
+        &self,
+        pick_result: &mut SelectBasicsPickResult,
+        manager: &dyn SelectBasicsSelectingVolumeManager,
+        elem_idx: i32,
+        _is_full_inside: bool,
+    ) -> Result<bool, Failure> {
+        self.element(elem_idx)
+            .get()
+            .map_or(Ok(false), |e| e.matches(manager, pick_result))
+    }
+    fn element_is_inside(
+        &self,
+        manager: &dyn SelectBasicsSelectingVolumeManager,
+        elem_idx: i32,
+        is_full_inside: bool,
+    ) -> Result<bool, Failure> {
+        let mut dummy = SelectBasicsPickResult::default();
+        self.overlaps_element(&mut dummy, manager, elem_idx, is_full_inside)
+    }
+    fn distance_to_cog(&self, manager: &dyn SelectBasicsSelectingVolumeManager) -> f64 {
+        manager.dist_to_geometry_center(&self.center_of_geometry())
+    }
+}
diff --git a/crates/tkv3d/src/select3d/sensitive_point.rs b/crates/tkv3d/src/select3d/sensitive_point.rs
new file mode 100644
index 000000000..dd850a0f6
--- /dev/null
+++ b/crates/tkv3d/src/select3d/sensitive_point.rs
@@ -0,0 +1,83 @@
+//! `Select3D_SensitivePoint`: a sensitive point (sensitivity 12).
+use super::{
+    Select3DBndBox3d, Select3DSensitiveEntity, Select3DSensitiveEntityBase,
+    Select3DSensitiveEntityMembers as _, select3d_sensitive_entity_dump_json,
+};
+use crate::select_basics::{SelectBasicsPickResult, SelectBasicsSelectingVolumeManager};
+use crate::select_mgr::SelectMgrEntityOwnerSource;
+use rustycad_tkernel::ncollection::Vec3;
+use rustycad_tkernel::standard::dump::DumpStream;
+use rustycad_tkernel::standard::{Failure, Handle, StandardTransient};
+use rustycad_tkmath::bvh::BvhBox;
+use rustycad_tkmath::gp::Point3;
+use rustycad_tkservice::json_dump::{base_class, class_begin};
+use std::io;
+
+/// A sensitive point.
+///
+/// Example: `let point = Select3DSensitivePoint::new(&owner, Point3::new(1.0, 2.0, 3.0));`.
+pub struct Select3DSensitivePoint {
+    transient: StandardTransient,
+    base: Select3DSensitiveEntityBase,
+    point: Point3,
+}
+rustycad_tkernel::impl_transient!(Select3DSensitivePoint, "Select3D_SensitivePoint", dyn Select3DSensitiveEntity, transient,
+    interfaces: [dyn Select3DSensitiveEntity]);
+
+impl Select3DSensitivePoint {
+    /// A point of an owner, with the sensitivity factor 12; `Select3DSensitivePoint::new(&owner, p)`.
+    pub fn new(owner: &Handle<dyn SelectMgrEntityOwnerSource>, point: Point3) -> Self {
+        let entity = Self {
+            transient: StandardTransient::default(),
+            base: Select3DSensitiveEntityBase::new(owner),
+            point,
+        };
+        entity.base.fields.write().sensitivity_factor = 12;
+        entity
+    }
+    /// `Point`; `entity.point()`.
+    pub fn point(&self) -> Point3 {
+        self.point
+    }
+}
+
+impl Select3DSensitiveEntity for Select3DSensitivePoint {
+    fn sensitive_base(&self) -> &Select3DSensitiveEntityBase {
+        &self.base
+    }
+    /// `Matches`: the point overlaps; the distance to the center is the depth.
+    fn matches(
+        &self,
+        manager: &dyn SelectBasicsSelectingVolumeManager,
+        pick_result: &mut SelectBasicsPickResult,
+    ) -> Result<bool, Failure> {
+        if !manager.overlaps_point(&self.point, pick_result)? {
+            return Ok(false);
+        }
+        pick_result.set_dist_to_geom_center(pick_result.depth());
+        Ok(true)
+    }
+    fn nb_sub_elements(&self) -> i32 {
+        1
+    }
+    fn bounding_box(&self) -> Select3DBndBox3d {
+        let p = Vec3::new(self.point.x(), self.point.y(), self.point.z());
+        BvhBox::from_corners(p, p)
+    }
+    fn center_of_geometry(&self) -> Point3 {
+        self.point
+    }
+    /// `GetConnected`: a new point of the same owner (sensitivity 12).
+    fn get_connected(&self) -> Result<Handle<dyn Select3DSensitiveEntity>, Failure> {
+        Ok(Handle::new(Self::new(&self.owner_id(), self.point)).cast())
+    }
+    fn to_build_bvh(&self) -> bool {
+        false
+    }
+    fn dump_json(&self, stream: &mut DumpStream, depth: i32) -> io::Result<()> {
+        class_begin(stream, "Select3D_SensitivePoint")?;
+        base_class(stream, depth, &|s, d| {
+            select3d_sensitive_entity_dump_json(self, s, d)
+        })
+    }
+}
diff --git a/crates/tkv3d/src/select3d/sensitive_poly.rs b/crates/tkv3d/src/select3d/sensitive_poly.rs
new file mode 100644
index 000000000..340346faf
--- /dev/null
+++ b/crates/tkv3d/src/select3d/sensitive_poly.rs
@@ -0,0 +1,568 @@
+//! `Select3D_SensitivePoly`: a sensitive polyline (its segments in a BVH tree) or a filled
+//! polygon. The behaviour is in [`Select3DSensitivePolyCore`], which the poly and its
+//! subclass `Select3D_SensitiveCurve` embed; [`impl_select3d_poly`] writes their trait
+//! implementations.
+use super::point_data::Select3DPointData;
+use super::{
+    Select3DBndBox3d, Select3DSensitiveEntityBase, Select3DSensitiveSet, Select3DSensitiveSetBase,
+    Select3DTypeOfSensitivity, select3d_set_dump_json, select3d_set_matches,
+};
+use crate::select_basics::{SelectBasicsPickResult, SelectBasicsSelectingVolumeManager};
+use crate::select_mgr::{SelectMgrEntityOwnerSource, SelectMgrSelectionType};
+use rustycad_tkernel::ncollection::{Array1, Vec3};
+use rustycad_tkernel::precision::confusion;
+use rustycad_tkernel::standard::dump::DumpStream;
+use rustycad_tkernel::standard::real::real_last;
+use rustycad_tkernel::standard::{Failure, Handle, SharedState};
+use rustycad_tkmath::bvh::{BvhBox, std_max, std_min};
+use rustycad_tkmath::elclib::{circle_d1, circle_value};
+use rustycad_tkmath::gp::{Circle3, Point3, Xyz, resolution};
+use rustycad_tkservice::json_dump::{base_class, class_begin, field_dumped, field_integer};
+use std::f64::consts::PI;
+use std::io;
+
+/// The mutable data of a poly.
+#[derive(Clone)]
+pub struct Select3DPolyData {
+    /// `myPolyg`.
+    pub polyg: Select3DPointData,
+    /// `myCOG`.
+    pub cog: Point3,
+    /// `mySegmentIndexes` (null without BVH).
+    pub segment_indexes: Option<Vec<i32>>,
+    /// `myBndBox`.
+    pub bnd_box: Select3DBndBox3d,
+    /// `mySensType`.
+    pub sens_type: Select3DTypeOfSensitivity,
+    /// `myIsComputed`.
+    pub is_computed: bool,
+}
+
+/// The state of a poly: the entity and set bases and the poly data.
+pub struct Select3DSensitivePolyCore {
+    /// The entity base.
+    pub entity: Select3DSensitiveEntityBase,
+    /// The set base.
+    pub set: Select3DSensitiveSetBase,
+    /// The poly data.
+    pub data: SharedState<Select3DPolyData>,
+}
+
+/// `GetCircleNbPoints`: 2n+1 points (2 more for a filled sector), 1 for a null radius.
+fn circle_nb_points(circle: &Circle3, nb_pnts: i32, u1: f64, u2: f64, is_filled: bool) -> i32 {
+    if nb_pnts <= 0 {
+        return 0;
+    }
+    if circle.radius() <= confusion() {
+        return 1;
+    }
+    let is_sector = is_filled && ((u2 - u1).abs() - 2.0 * PI).abs() > resolution();
+    2 * nb_pnts + 1 + if is_sector { 2 } else { 0 }
+}
+
+/// `initCircle`: the points of an arc with the mid tangent points (and the center for a
+/// filled sector).
+fn init_circle(
+    polygon: &mut Select3DPointData,
+    circle: &Circle3,
+    u1: f64,
+    u2: f64,
+    is_filled: bool,
+    nb_pnts: i32,
+) -> Result<(), Failure> {
+    let step = (u2 - u1) / f64::from(nb_pnts);
+    let radius = circle.radius();
+    let (mut index, mut cur_u) = (0, u1);
+    let is_sector = (u2 - u1 - 2.0 * PI).abs() > resolution();
+    if is_sector && is_filled {
+        polygon.set_pnt(index, &circle.location())?;
+        index += 1;
+    }
+    for _ in 1..=nb_pnts {
+        let (p1, v1) = circle_d1(cur_u, circle.position(), radius);
+        polygon.set_pnt(index, &p1)?;
+        let v1 = v1.normalized()?;
+        let p2 = Point3::from(p1.xyz() + *v1.xyz() * (step * 0.5).tan() * radius);
+        polygon.set_pnt(index + 1, &p2)?;
+        index += 2;
+        cur_u += step;
+    }
+    polygon.set_pnt(index, &circle_value(u2, circle.position(), radius))?;
+    if is_sector && is_filled {
+        polygon.set_pnt(index + 1, &circle.location())?;
+    }
+    Ok(())
+}
+
+/// The segment indexes `0..n-1` of a BVH-enabled poly of `nb_pnts` points.
+fn segment_indexes(bvh_enabled: bool, nb_pnts: i32) -> Option<Vec<i32>> {
+    bvh_enabled.then(|| (0..(nb_pnts - 1).max(0)).collect())
+}
+
+impl Select3DSensitivePolyCore {
+    /// The core of a poly of the given points (boundary sensitivity); no point raises
+    /// `Standard_ConstructionError`. Example: `Select3DSensitivePolyCore::from_points(&owner, &points, true)?`.
+    pub fn from_points(
+        owner: &Handle<dyn SelectMgrEntityOwnerSource>,
+        points: &[Point3],
+        bvh_enabled: bool,
+    ) -> Result<Self, Failure> {
+        let mut polyg = Select3DPointData::new(points.len() as i32)?;
+        let mut sum = Xyz::new(0.0, 0.0, 0.0);
+        let mut bnd_box = Select3DBndBox3d::default();
+        for (index, point) in points.iter().enumerate() {
+            sum += point.xyz();
+            bnd_box.add(&Vec3::new(point.x(), point.y(), point.z()));
+            polyg.set_pnt(index as i32, point)?;
+        }
+        let size = polyg.size();
+        let data = Select3DPolyData {
+            polyg,
+            cog: Point3::from(sum / f64::from(size)),
+            segment_indexes: segment_indexes(bvh_enabled, size),
+            bnd_box,
+            sens_type: Select3DTypeOfSensitivity::Boundary,
+            is_computed: true,
+        };
+        Ok(Self::with_data(owner, data))
+    }
+    /// The core of a poly of `nb_pnts` points to fill; `Select3DSensitivePolyCore::with_size(&owner, true, 6)?`.
+    pub fn with_size(
+        owner: &Handle<dyn SelectMgrEntityOwnerSource>,
+        bvh_enabled: bool,
+        nb_pnts: i32,
+    ) -> Result<Self, Failure> {
+        let data = Select3DPolyData {
+            polyg: Select3DPointData::new(nb_pnts)?,
+            cog: Point3::new(real_last(), real_last(), real_last()),
+            segment_indexes: segment_indexes(bvh_enabled, nb_pnts),
+            bnd_box: Select3DBndBox3d::default(),
+            sens_type: Select3DTypeOfSensitivity::Boundary,
+            is_computed: false,
+        };
+        Ok(Self::with_data(owner, data))
+    }
+    /// The core of an arc of a circle (a filled sector or a boundary of sensitivity 6).
+    /// Example: `Select3DSensitivePolyCore::circle(&owner, &circle, 0.0, PI, false, 12)?`.
+    pub fn circle(
+        owner: &Handle<dyn SelectMgrEntityOwnerSource>,
+        circle: &Circle3,
+        u1: f64,
+        u2: f64,
+        is_filled: bool,
+        nb_pnts: i32,
+    ) -> Result<Self, Failure> {
+        let core = Self::with_size(
+            owner,
+            !is_filled,
+            circle_nb_points(circle, nb_pnts, u1, u2, is_filled),
+        )?;
+        {
+            let mut data = core.data.write();
+            data.sens_type = if is_filled {
+                Select3DTypeOfSensitivity::Interior
+            } else {
+                Select3DTypeOfSensitivity::Boundary
+            };
+            if data.polyg.size() != 1 {
+                init_circle(
+                    &mut data.polyg,
+                    circle,
+                    std_min(u1, u2),
+                    std_max(u1, u2),
+                    is_filled,
+                    nb_pnts,
+                )?;
+            } else {
+                data.polyg.set_pnt(0, &circle.position().location())?;
+            }
+        }
+        if !is_filled {
+            core.entity.fields.write().sensitivity_factor = 6;
+        }
+        Ok(core)
+    }
+    /// The core with its data.
+    fn with_data(owner: &Handle<dyn SelectMgrEntityOwnerSource>, data: Select3DPolyData) -> Self {
+        Self {
+            entity: Select3DSensitiveEntityBase::new(owner),
+            set: Select3DSensitiveSetBase::default(),
+            data: SharedState::new(data),
+        }
+    }
+    /// `Points3D`: the points in double precision (natively a new array from index 1).
+    /// Example: `core.points_3d()`.
+    pub fn points_3d(&self) -> Vec<Point3> {
+        self.data
+            .read()
+            .polyg
+            .points()
+            .iter()
+            .map(|p| p.to_point())
+            .collect()
+    }
+    /// `ArrayBounds`: `(0, size - 1)`; `core.array_bounds()`.
+    pub fn array_bounds(&self) -> (i32, i32) {
+        (0, self.data.read().polyg.size() - 1)
+    }
+    /// `GetPoint3d`: the point, or the origin out of range; `core.get_point_3d(0)`.
+    pub fn get_point_3d(&self, pnt_idx: i32) -> Point3 {
+        self.data.read().polyg.pnt3d(pnt_idx).unwrap_or_default()
+    }
+    /// `Matches`: the BVH traversal of the segments for a boundary, the polygon test for an interior.
+    pub fn matches_poly<S: Select3DSensitiveSet + ?Sized>(
+        &self,
+        set: &S,
+        manager: &dyn SelectBasicsSelectingVolumeManager,
+        pick_result: &mut SelectBasicsPickResult,
+    ) -> Result<bool, Failure> {
+        let sens_type = self.data.read().sens_type;
+        match sens_type {
+            Select3DTypeOfSensitivity::Boundary => {
+                select3d_set_matches(set, manager, pick_result, false)
+            }
+            Select3DTypeOfSensitivity::Interior => self.matches_interior(manager, pick_result),
+        }
+    }
+    /// The interior test of `Matches`.
+    fn matches_interior(
+        &self,
+        manager: &dyn SelectBasicsSelectingVolumeManager,
+        pick_result: &mut SelectBasicsPickResult,
+    ) -> Result<bool, Failure> {
+        let points = self.points_3d();
+        let array = Array1::from_shared(&points, 1);
+        let interior = Select3DTypeOfSensitivity::Interior as i32;
+        if !manager.is_overlap_allowed() {
+            if manager.get_active_selection_type() == SelectMgrSelectionType::Polyline {
+                let mut dummy = SelectBasicsPickResult::default();
+                return manager.overlaps_polygon(&array, interior, &mut dummy);
+            }
+            for p in &points {
+                if !manager.overlaps_point_only(p)? {
+                    return Ok(false);
+                }
+            }
+            return Ok(true);
+        }
+        if !manager.overlaps_polygon(&array, interior, pick_result)? {
+            return Ok(false);
+        }
+        pick_result.set_dist_to_geom_center(self.distance_to_cog(manager));
+        Ok(true)
+    }
+    /// `BoundingBox`: the box of the points, computed once.
+    pub fn bounding_box(&self) -> Select3DBndBox3d {
+        let mut data = self.data.write();
+        if data.bnd_box.is_valid() {
+            return data.bnd_box;
+        }
+        let mut bounds = Select3DBndBox3d::default();
+        for p in data.polyg.points() {
+            bounds.add(&Vec3::new(f64::from(p.x), f64::from(p.y), f64::from(p.z)));
+        }
+        data.bnd_box = bounds;
+        bounds
+    }
+    /// `Size`: the number of segments, -1 without BVH.
+    pub fn size(&self) -> i32 {
+        self.data
+            .read()
+            .segment_indexes
+            .as_ref()
+            .map_or(-1, |s| s.len() as i32)
+    }
+    /// The two points of the segment at a BVH index.
+    fn segment(&self, idx: i32) -> Option<(Point3, Point3)> {
+        let data = self.data.read();
+        let segment = *data.segment_indexes.as_ref()?.get(idx as usize)?;
+        Some((
+            data.polyg.pnt3d(segment).ok()?,
+            data.polyg.pnt3d(segment + 1).ok()?,
+        ))
+    }
+    /// `Box`: the box of a segment, the point box (RealLast) without BVH.
+    pub fn element_box(&self, idx: i32) -> Select3DBndBox3d {
+        let Some((a, b)) = self.segment(idx) else {
+            let last = Vec3::new(real_last(), real_last(), real_last());
+            return BvhBox::from_corners(last, last);
+        };
+        let min = Vec3::new(
+            std_min(a.x(), b.x()),
+            std_min(a.y(), b.y()),
+            std_min(a.z(), b.z()),
+        );
+        let max = Vec3::new(
+            std_max(a.x(), b.x()),
+            std_max(a.y(), b.y()),
+            std_max(a.z(), b.z()),
+        );
+        BvhBox::from_corners(min, max)
+    }
+    /// `Center`: the center of the segment box along an axis, RealLast without BVH.
+    pub fn center(&self, idx: i32, axis: i32) -> Result<f64, Failure> {
+        if self.data.read().segment_indexes.is_none() {
+            return Ok(real_last());
+        }
+        let bounds = self.element_box(idx);
+        let center = (*bounds.corner_min() + *bounds.corner_max()) * 0.5;
+        Ok(match axis {
+            0 => center.x,
+            1 => center.y,
+            _ => center.z,
+        })
+    }
+    /// `Swap`: exchanges two segment indexes.
+    pub fn swap(&self, idx1: i32, idx2: i32) {
+        if let Some(indexes) = self.data.write().segment_indexes.as_mut() {
+            indexes.swap(idx1 as usize, idx2 as usize);
+        }
+    }
+    /// `overlapsElement`: the segment overlaps (always for a full-inside node).
+    pub fn overlaps_element(
+        &self,
+        pick_result: &mut SelectBasicsPickResult,
+        manager: &dyn SelectBasicsSelectingVolumeManager,
+        elem_idx: i32,
+        is_full_inside: bool,
+    ) -> Result<bool, Failure> {
+        if self.data.read().segment_indexes.is_none() {
+            return Ok(false);
+        }
+        if is_full_inside {
+            return Ok(true);
+        }
+        match self.segment(elem_idx) {
+            Some((a, b)) => manager.overlaps_segment(&a, &b, pick_result),
+            None => Ok(false),
+        }
+    }
+    /// `elementIsInside`: the segment (polyline) or both its points are inside.
+    pub fn element_is_inside(
+        &self,
+        manager: &dyn SelectBasicsSelectingVolumeManager,
+        elem_idx: i32,
+        is_full_inside: bool,
+    ) -> Result<bool, Failure> {
+        if is_full_inside {
+            return Ok(true);
+        }
+        let Some((a, b)) = self.segment(elem_idx) else {
+            return Ok(false);
+        };
+        if manager.get_active_selection_type() == SelectMgrSelectionType::Polyline {
+            let mut dummy = SelectBasicsPickResult::default();
+            return manager.overlaps_segment(&a, &b, &mut dummy);
+        }
+        Ok(manager.overlaps_point_only(&a)? && manager.overlaps_point_only(&b)?)
+    }
+    /// The center of geometry, computed once from the single-precision points.
+    pub fn center_of_geometry(&self) -> Point3 {
+        let mut data = self.data.write();
+        if !data.is_computed {
+            let mut center = Xyz::new(0.0, 0.0, 0.0);
+            for p in data.polyg.points() {
+                center += p.to_xyz();
+            }
+            data.cog = Point3::from(center / f64::from(data.polyg.size()));
+            data.is_computed = true;
+        }
+        data.cog
+    }
+    /// `distanceToCOG`; `core.distance_to_cog(&manager)`.
+    pub fn distance_to_cog(&self, manager: &dyn SelectBasicsSelectingVolumeManager) -> f64 {
+        manager.dist_to_geometry_center(&self.center_of_geometry())
+    }
+    /// `NbSubElements`: the number of points.
+    pub fn nb_sub_elements(&self) -> i32 {
+        self.data.read().polyg.size()
+    }
+    /// `Select3D_SensitivePoly::DumpJson`.
+    pub fn dump_json<S: Select3DSensitiveSet + ?Sized>(
+        &self,
+        set: &S,
+        stream: &mut DumpStream,
+        depth: i32,
+    ) -> io::Result<()> {
+        class_begin(stream, "Select3D_SensitivePoly")?;
+        base_class(stream, depth, &|s, d| select3d_set_dump_json(set, s, d))?;
+        let data = self.data.read().clone();
+        let bounds = data.bnd_box;
+        field_dumped(stream, depth, "&myBndBox", &|s, _| bounds.dump_json(s))?;
+        field_integer(stream, "myIsComputed", i32::from(data.is_computed))
+    }
+}
+
+/// The `Select3DSensitiveEntity` and `Select3DSensitiveSet` implementations of a poly type
+/// with a `core: Select3DSensitivePolyCore` field; the caller adds `get_connected` and
+/// `dump_json` through the closures. Example: `impl_select3d_poly!(Select3DSensitivePoly, |s| ..., |s, st, d| ...);`.
+#[macro_export]
+macro_rules! impl_select3d_poly {
+    ($type:ty, $connected:expr) => {
+        impl $crate::select3d::Select3DSensitiveEntity for $type {
+            fn sensitive_base(&self) -> &$crate::select3d::Select3DSensitiveEntityBase {
+                &self.core.entity
+            }
+            fn matches(
+                &self,
+                manager: &dyn $crate::select_basics::SelectBasicsSelectingVolumeManager,
+                pick_result: &mut $crate::select_basics::SelectBasicsPickResult,
+            ) -> Result<bool, rustycad_tkernel::standard::Failure> {
+                self.core.matches_poly(self, manager, pick_result)
+            }
+            fn nb_sub_elements(&self) -> i32 {
+                self.core.nb_sub_elements()
+            }
+            fn bounding_box(&self) -> $crate::select3d::Select3DBndBox3d {
+                self.core.bounding_box()
+            }
+            fn center_of_geometry(&self) -> rustycad_tkmath::gp::Point3 {
+                self.core.center_of_geometry()
+            }
+            fn get_connected(
+                &self,
+            ) -> Result<
+                rustycad_tkernel::standard::Handle<dyn $crate::select3d::Select3DSensitiveEntity>,
+                rustycad_tkernel::standard::Failure,
+            > {
+                ($connected)(self)
+            }
+            fn bvh(&self) -> Result<(), rustycad_tkernel::standard::Failure> {
+                $crate::select3d::select3d_set_build_bvh(self)
+            }
+            fn to_build_bvh(&self) -> bool {
+                self.core.set.is_dirty()
+            }
+            fn clear(&self) {}
+            fn dump_json(
+                &self,
+                stream: &mut rustycad_tkernel::standard::dump::DumpStream,
+                depth: i32,
+            ) -> std::io::Result<()> {
+                self.core.dump_json(self, stream, depth)
+            }
+        }
+        impl $crate::select3d::Select3DSensitiveSet for $type {
+            fn set_base(&self) -> &$crate::select3d::Select3DSensitiveSetBase {
+                &self.core.set
+            }
+            fn size(&self) -> i32 {
+                self.core.size()
+            }
+            fn element_box(&self, idx: i32) -> $crate::select3d::Select3DBndBox3d {
+                self.core.element_box(idx)
+            }
+            fn center(
+                &self,
+                idx: i32,
+                axis: i32,
+            ) -> Result<f64, rustycad_tkernel::standard::Failure> {
+                self.core.center(idx, axis)
+            }
+            fn swap(&self, idx1: i32, idx2: i32) {
+                self.core.swap(idx1, idx2);
+            }
+            fn overlaps_element(
+                &self,
+                pick_result: &mut $crate::select_basics::SelectBasicsPickResult,
+                manager: &dyn $crate::select_basics::SelectBasicsSelectingVolumeManager,
+                elem_idx: i32,
+                is_full_inside: bool,
+            ) -> Result<bool, rustycad_tkernel::standard::Failure> {
+                self.core
+                    .overlaps_element(pick_result, manager, elem_idx, is_full_inside)
+            }
+            fn element_is_inside(
+                &self,
+                manager: &dyn $crate::select_basics::SelectBasicsSelectingVolumeManager,
+                elem_idx: i32,
+                is_full_inside: bool,
+            ) -> Result<bool, rustycad_tkernel::standard::Failure> {
+                self.core
+                    .element_is_inside(manager, elem_idx, is_full_inside)
+            }
+            fn distance_to_cog(
+                &self,
+                manager: &dyn $crate::select_basics::SelectBasicsSelectingVolumeManager,
+            ) -> f64 {
+                self.core.distance_to_cog(manager)
+            }
+        }
+    };
+}
+
+/// A sensitive polyline or filled polygon.
+///
+/// Example: `let poly = Select3DSensitivePoly::new(&owner, &points, true)?; poly.nb_sub_elements();`.
+pub struct Select3DSensitivePoly {
+    transient: rustycad_tkernel::standard::StandardTransient,
+    /// The poly state.
+    pub core: Select3DSensitivePolyCore,
+}
+rustycad_tkernel::impl_transient!(Select3DSensitivePoly, "Select3D_SensitivePoly", dyn Select3DSensitiveSet, transient,
+    interfaces: [dyn super::Select3DSensitiveEntity, dyn Select3DSensitiveSet]);
+impl_select3d_poly!(Select3DSensitivePoly, |_: &Select3DSensitivePoly| Ok(
+    Handle::default()
+));
+
+impl Select3DSensitivePoly {
+    /// `Select3D_SensitivePoly(owner, points, isBVHEnabled)`; no point raises
+    /// `Standard_ConstructionError`. Example: `Select3DSensitivePoly::new(&owner, &points, true)?`.
+    pub fn new(
+        owner: &Handle<dyn SelectMgrEntityOwnerSource>,
+        points: &[Point3],
+        bvh_enabled: bool,
+    ) -> Result<Self, Failure> {
+        Ok(Self::of(Select3DSensitivePolyCore::from_points(
+            owner,
+            points,
+            bvh_enabled,
+        )?))
+    }
+    /// `Select3D_SensitivePoly(owner, isBVHEnabled, nbPnts)`: `nb_pnts` points to fill.
+    /// Example: `Select3DSensitivePoly::with_size(&owner, true, 6)?`.
+    pub fn with_size(
+        owner: &Handle<dyn SelectMgrEntityOwnerSource>,
+        bvh_enabled: bool,
+        nb_pnts: i32,
+    ) -> Result<Self, Failure> {
+        Ok(Self::of(Select3DSensitivePolyCore::with_size(
+            owner,
+            bvh_enabled,
+            nb_pnts,
+        )?))
+    }
+    /// `Select3D_SensitivePoly(owner, circle, U1, U2, isFilled, nbPnts)`: an arc.
+    /// Example: `Select3DSensitivePoly::circle(&owner, &circle, 0.0, PI, false, 12)?`.
+    pub fn circle(
+        owner: &Handle<dyn SelectMgrEntityOwnerSource>,
+        circle: &Circle3,
+        u1: f64,
+        u2: f64,
+        is_filled: bool,
+        nb_pnts: i32,
+    ) -> Result<Self, Failure> {
+        Ok(Self::of(Select3DSensitivePolyCore::circle(
+            owner, circle, u1, u2, is_filled, nb_pnts,
+        )?))
+    }
+    /// A poly of a core.
+    fn of(core: Select3DSensitivePolyCore) -> Self {
+        Self {
+            transient: rustycad_tkernel::standard::StandardTransient::default(),
+            core,
+        }
+    }
+    /// `Points3D`; `poly.points_3d()`.
+    pub fn points_3d(&self) -> Vec<Point3> {
+        self.core.points_3d()
+    }
+    /// `ArrayBounds`; `poly.array_bounds()`.
+    pub fn array_bounds(&self) -> (i32, i32) {
+        self.core.array_bounds()
+    }
+    /// `GetPoint3d`; `poly.get_point_3d(0)`.
+    pub fn get_point_3d(&self, pnt_idx: i32) -> Point3 {
+        self.core.get_point_3d(pnt_idx)
+    }
+}
diff --git a/crates/tkv3d/src/select3d/sensitive_segment.rs b/crates/tkv3d/src/select3d/sensitive_segment.rs
new file mode 100644
index 000000000..2793dfa24
--- /dev/null
+++ b/crates/tkv3d/src/select3d/sensitive_segment.rs
@@ -0,0 +1,126 @@
+//! `Select3D_SensitiveSegment`: a sensitive segment (sensitivity 3).
+use super::{
+    Select3DBndBox3d, Select3DSensitiveEntity, Select3DSensitiveEntityBase,
+    Select3DSensitiveEntityMembers as _, select3d_sensitive_entity_dump_json,
+};
+use crate::select_basics::{SelectBasicsPickResult, SelectBasicsSelectingVolumeManager};
+use crate::select_mgr::{SelectMgrEntityOwnerSource, SelectMgrSelectionType};
+use rustycad_tkernel::ncollection::Vec3;
+use rustycad_tkernel::standard::dump::DumpStream;
+use rustycad_tkernel::standard::{Failure, Handle, SharedState, StandardTransient};
+use rustycad_tkmath::bvh::{BvhBox, std_max, std_min};
+use rustycad_tkmath::gp::Point3;
+use rustycad_tkservice::json_dump::{base_class, class_begin, field_dumped};
+use std::io;
+
+/// A sensitive segment.
+///
+/// Example: `let segment = Select3DSensitiveSegment::new(&owner, a, b); segment.set_end_point(c);`.
+pub struct Select3DSensitiveSegment {
+    transient: StandardTransient,
+    base: Select3DSensitiveEntityBase,
+    ends: SharedState<(Point3, Point3)>,
+}
+rustycad_tkernel::impl_transient!(Select3DSensitiveSegment, "Select3D_SensitiveSegment", dyn Select3DSensitiveEntity, transient,
+    interfaces: [dyn Select3DSensitiveEntity]);
+
+impl Select3DSensitiveSegment {
+    /// A segment of an owner, with the sensitivity factor 3; `Select3DSensitiveSegment::new(&owner, a, b)`.
+    pub fn new(
+        owner: &Handle<dyn SelectMgrEntityOwnerSource>,
+        first: Point3,
+        last: Point3,
+    ) -> Self {
+        let entity = Self {
+            transient: StandardTransient::default(),
+            base: Select3DSensitiveEntityBase::new(owner),
+            ends: SharedState::new((first, last)),
+        };
+        entity.base.fields.write().sensitivity_factor = 3;
+        entity
+    }
+    /// `SetStartPoint` (and the deprecated `StartPoint(p)`); `segment.set_start_point(p)`.
+    pub fn set_start_point(&self, point: Point3) {
+        self.ends.write().0 = point;
+    }
+    /// `SetEndPoint` (and the deprecated `EndPoint(p)`); `segment.set_end_point(p)`.
+    pub fn set_end_point(&self, point: Point3) {
+        self.ends.write().1 = point;
+    }
+    /// `StartPoint`; `segment.start_point()`.
+    pub fn start_point(&self) -> Point3 {
+        self.ends.read().0
+    }
+    /// `EndPoint`; `segment.end_point()`.
+    pub fn end_point(&self) -> Point3 {
+        self.ends.read().1
+    }
+}
+
+impl Select3DSensitiveEntity for Select3DSensitiveSegment {
+    fn sensitive_base(&self) -> &Select3DSensitiveEntityBase {
+        &self.base
+    }
+    /// `Matches`: both ends inside (the segment for a polyline) for the inclusion test, else
+    /// the segment overlaps and the distance to the middle is computed.
+    fn matches(
+        &self,
+        manager: &dyn SelectBasicsSelectingVolumeManager,
+        pick_result: &mut SelectBasicsPickResult,
+    ) -> Result<bool, Failure> {
+        let (start, end) = *self.ends.read();
+        if !manager.is_overlap_allowed() {
+            if manager.get_active_selection_type() == SelectMgrSelectionType::Polyline {
+                return manager.overlaps_segment(&start, &end, pick_result);
+            }
+            return Ok(manager.overlaps_point(&start, pick_result)?
+                && manager.overlaps_point(&end, pick_result)?);
+        }
+        if !manager.overlaps_segment(&start, &end, pick_result)? {
+            return Ok(false);
+        }
+        pick_result
+            .set_dist_to_geom_center(manager.dist_to_geometry_center(&self.center_of_geometry()));
+        Ok(true)
+    }
+    fn nb_sub_elements(&self) -> i32 {
+        2
+    }
+    fn bounding_box(&self) -> Select3DBndBox3d {
+        let (a, b) = *self.ends.read();
+        let min = Vec3::new(
+            std_min(a.x(), b.x()),
+            std_min(a.y(), b.y()),
+            std_min(a.z(), b.z()),
+        );
+        let max = Vec3::new(
+            std_max(a.x(), b.x()),
+            std_max(a.y(), b.y()),
+            std_max(a.z(), b.z()),
+        );
+        BvhBox::from_corners(min, max)
+    }
+    fn center_of_geometry(&self) -> Point3 {
+        let (a, b) = *self.ends.read();
+        Point3::from((a.xyz() + b.xyz()) * 0.5)
+    }
+    /// `GetConnected`: a new segment of the same owner and ends (sensitivity 3).
+    fn get_connected(&self) -> Result<Handle<dyn Select3DSensitiveEntity>, Failure> {
+        let (a, b) = *self.ends.read();
+        Ok(Handle::new(Self::new(&self.owner_id(), a, b)).cast())
+    }
+    fn to_build_bvh(&self) -> bool {
+        false
+    }
+    fn dump_json(&self, stream: &mut DumpStream, depth: i32) -> io::Result<()> {
+        class_begin(stream, "Select3D_SensitiveSegment")?;
+        base_class(stream, depth, &|s, d| {
+            select3d_sensitive_entity_dump_json(self, s, d)
+        })?;
+        let (a, b) = *self.ends.read();
+        field_dumped(stream, depth, "&myStart", &|s, _| a.dump_json(s))?;
+        field_dumped(stream, depth, "&myEnd", &|s, _| b.dump_json(s))?;
+        let bounds = self.bounding_box();
+        field_dumped(stream, depth, "&aBoundingBox", &|s, _| bounds.dump_json(s))
+    }
+}
diff --git a/crates/tkv3d/src/select3d/sensitive_set.rs b/crates/tkv3d/src/select3d/sensitive_set.rs
new file mode 100644
index 000000000..1e8c22cb1
--- /dev/null
+++ b/crates/tkv3d/src/select3d/sensitive_set.rs
@@ -0,0 +1,520 @@
+//! `Select3D_SensitiveSet`: a sensitive entity made of elements kept in a BVH tree, which the
+//! selecting volume traverses (v3d-design.md section 6). The abstract class is the
+//! [`Select3DSensitiveSet`] trait over [`Select3DSensitiveSetBase`]; the native members it
+//! implements are the `select3d_set_*` functions, which every set type calls from its
+//! `Select3DSensitiveEntity` implementation.
+use super::{Select3DBndBox3d, Select3DSensitiveEntity, select3d_sensitive_entity_dump_json};
+use crate::select_basics::{SelectBasicsPickResult, SelectBasicsSelectingVolumeManager};
+use crate::select_mgr::SelectMgrSelectionType;
+use rustycad_tkernel::ncollection::Vec3;
+use rustycad_tkernel::standard::dump::DumpStream;
+use rustycad_tkernel::standard::real::{real_first, real_last};
+use rustycad_tkernel::standard::{Failure, SharedState};
+use rustycad_tkmath::bvh::constants::{LEAF_NODE_SIZE_SMALL, MAX_TREE_DEPTH};
+use rustycad_tkmath::bvh::{
+    BvhBox, BvhBuilder, BvhLinearBuilder, BvhPrimitiveSet, BvhPrimitiveSetAccess, BvhSet, BvhTree,
+    BvhVec3d,
+};
+use rustycad_tkmath::gp::Point3;
+use rustycad_tkservice::json_dump::{base_class, class_begin, field_dumped, field_integer};
+use std::io;
+use std::sync::{Arc, Mutex, MutexGuard, RwLock};
+
+/// `Select3D_BVHBuilder3d`: the builder of the sensitive set trees.
+pub type Select3DBvhBuilder3d = Arc<dyn BvhBuilder<BvhVec3d>>;
+
+/// `THE_SENS_SET_BUILDER`: a linear builder (8 primitives per leaf) unless replaced.
+static DEFAULT_BUILDER: RwLock<Option<Select3DBvhBuilder3d>> = RwLock::new(None);
+
+/// `Select3D_SensitiveSet::DefaultBVHBuilder`; `select3d_default_bvh_builder()`.
+pub fn select3d_default_bvh_builder() -> Select3DBvhBuilder3d {
+    let current = DEFAULT_BUILDER
+        .read()
+        .map(|b| b.clone())
+        .unwrap_or_default();
+    current.unwrap_or_else(|| {
+        Arc::new(BvhLinearBuilder::<BvhVec3d>::new(
+            LEAF_NODE_SIZE_SMALL,
+            MAX_TREE_DEPTH,
+        ))
+    })
+}
+
+/// `Select3D_SensitiveSet::SetDefaultBVHBuilder`: the builder of the sets created afterwards.
+/// Example: `select3d_set_default_bvh_builder(builder)`.
+pub fn select3d_set_default_bvh_builder(builder: Select3DBvhBuilder3d) {
+    if let Ok(mut current) = DEFAULT_BUILDER.write() {
+        *current = Some(builder);
+    }
+}
+
+/// The state every sensitive set embeds: the BVH content and the detected element.
+pub struct Select3DSensitiveSetBase {
+    content: Mutex<BvhPrimitiveSet<BvhVec3d>>,
+    detected_idx: SharedState<i32>,
+}
+
+impl Default for Select3DSensitiveSetBase {
+    /// The constructor state: the default builder, a dirty tree, no detected element.
+    fn default() -> Self {
+        // The constructor marks the content dirty (SetSensitiveSet and MarkDirty): the tree is
+        // built on the first traversal.
+        let mut content = BvhPrimitiveSet::new(Some(select3d_default_bvh_builder()));
+        content.object_transient_mut().is_dirty = true;
+        Self {
+            content: Mutex::new(content),
+            detected_idx: SharedState::new(-1),
+        }
+    }
+}
+
+impl Select3DSensitiveSetBase {
+    /// The locked BVH content (a poisoned lock keeps its data: the content stays consistent
+    /// between the builder calls).
+    fn lock_content(&self) -> MutexGuard<'_, BvhPrimitiveSet<BvhVec3d>> {
+        self.content
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+    }
+    /// `myDetectedIdx`: the detected element in the BVH order, -1 without; `base.detected_idx()`.
+    pub fn detected_idx(&self) -> i32 {
+        *self.detected_idx.read()
+    }
+    /// Sets `myDetectedIdx` (a subclass match outside the traversal); `base.set_detected_idx(0)`.
+    pub fn set_detected_idx(&self, idx: i32) {
+        *self.detected_idx.write() = idx;
+    }
+    /// `MarkDirty`: the tree is built again before the next traversal; `base.mark_dirty()`.
+    pub fn mark_dirty(&self) {
+        self.lock_content().object_transient_mut().is_dirty = true;
+    }
+    /// `SetBuilder`: the builder of the next build; `base.set_builder(builder)`.
+    pub fn set_builder(&self, builder: Select3DBvhBuilder3d) {
+        let mut content = self.lock_content();
+        ContentOnly {
+            content: &mut content,
+        }
+        .set_builder(Some(builder));
+    }
+    /// `GetLeafNodeSize`: the leaf size of the builder; `base.leaf_node_size()`.
+    pub fn leaf_node_size(&self) -> i32 {
+        let mut content = self.lock_content();
+        let adapter = ContentOnly {
+            content: &mut content,
+        };
+        adapter
+            .builder()
+            .as_ref()
+            .map_or(0, |b| b.builder_transient().leaf_node_size())
+    }
+    /// Whether the tree must be built (`ToBuildBVH`); `base.is_dirty()`.
+    pub fn is_dirty(&self) -> bool {
+        self.lock_content().object_transient().is_dirty
+    }
+}
+
+/// The content of a set without its elements, to reach the builder of the primitive set.
+struct ContentOnly<'a> {
+    content: &'a mut BvhPrimitiveSet<BvhVec3d>,
+}
+
+impl BvhSet<BvhVec3d> for ContentOnly<'_> {
+    fn size(&self) -> i32 {
+        0
+    }
+    fn element_box(&self, _index: i32) -> Result<BvhBox<BvhVec3d>, Failure> {
+        Ok(BvhBox::default())
+    }
+    fn center(&self, _index: i32, _axis: i32) -> Result<f64, Failure> {
+        Ok(0.0)
+    }
+    fn swap(&mut self, _first: i32, _second: i32) -> Result<(), Failure> {
+        Ok(())
+    }
+}
+
+impl BvhPrimitiveSetAccess<BvhVec3d> for ContentOnly<'_> {
+    fn primitive_set(&self) -> &BvhPrimitiveSet<BvhVec3d> {
+        self.content
+    }
+    fn primitive_set_mut(&mut self) -> &mut BvhPrimitiveSet<BvhVec3d> {
+        self.content
+    }
+}
+
+/// A sensitive entity made of elements in a BVH tree.
+pub trait Select3DSensitiveSet: Select3DSensitiveEntity {
+    /// The embedded set state; `set.set_base()`.
+    fn set_base(&self) -> &Select3DSensitiveSetBase;
+    /// `Size` (pure virtual): the number of elements; `set.size()`.
+    fn size(&self) -> i32;
+    /// `Box` (pure virtual): the box of an element; `set.element_box(0)`.
+    fn element_box(&self, idx: i32) -> Select3DBndBox3d;
+    /// `Center` (pure virtual): the center of an element along an axis; an invalid
+    /// coordinate index raises `Standard_OutOfRange`. Example: `set.center(0, 1)?`.
+    fn center(&self, idx: i32, axis: i32) -> Result<f64, Failure>;
+    /// `Swap` (pure virtual): exchanges two elements; `set.swap(0, 1)`.
+    fn swap(&self, idx1: i32, idx2: i32);
+    /// `overlapsElement` (pure virtual): the overlap test of one element with depth.
+    /// Example: `set.overlaps_element(&mut pick, &manager, 0, false)`.
+    fn overlaps_element(
+        &self,
+        pick_result: &mut SelectBasicsPickResult,
+        manager: &dyn SelectBasicsSelectingVolumeManager,
+        elem_idx: i32,
+        is_full_inside: bool,
+    ) -> Result<bool, Failure>;
+    /// `elementIsInside` (pure virtual): the inclusion test of one element.
+    /// Example: `set.element_is_inside(&manager, 0, false)`.
+    fn element_is_inside(
+        &self,
+        manager: &dyn SelectBasicsSelectingVolumeManager,
+        elem_idx: i32,
+        is_full_inside: bool,
+    ) -> Result<bool, Failure>;
+    /// `distanceToCOG` (pure virtual); `set.distance_to_cog(&manager)`.
+    fn distance_to_cog(&self, manager: &dyn SelectBasicsSelectingVolumeManager) -> f64;
+}
+
+rustycad_tkernel::impl_transient_interface!(
+    dyn Select3DSensitiveSet,
+    "Select3D_SensitiveSet",
+    dyn Select3DSensitiveEntity
+);
+
+/// The sensitive set seen as the BVH primitive set of its content.
+struct SetPrimitives<'a, S: Select3DSensitiveSet + ?Sized> {
+    set: &'a S,
+    content: &'a mut BvhPrimitiveSet<BvhVec3d>,
+}
+
+impl<S: Select3DSensitiveSet + ?Sized> BvhSet<BvhVec3d> for SetPrimitives<'_, S> {
+    fn size(&self) -> i32 {
+        self.set.size()
+    }
+    fn element_box(&self, index: i32) -> Result<BvhBox<BvhVec3d>, Failure> {
+        Ok(self.set.element_box(index))
+    }
+    fn center(&self, index: i32, axis: i32) -> Result<f64, Failure> {
+        self.set.center(index, axis)
+    }
+    fn swap(&mut self, first: i32, second: i32) -> Result<(), Failure> {
+        self.set.swap(first, second);
+        Ok(())
+    }
+    fn bounding_box(&self) -> Result<BvhBox<BvhVec3d>, Failure> {
+        self.cached_box()
+    }
+}
+
+impl<S: Select3DSensitiveSet + ?Sized> BvhPrimitiveSetAccess<BvhVec3d> for SetPrimitives<'_, S> {
+    fn primitive_set(&self) -> &BvhPrimitiveSet<BvhVec3d> {
+        self.content
+    }
+    fn primitive_set_mut(&mut self) -> &mut BvhPrimitiveSet<BvhVec3d> {
+        self.content
+    }
+}
+
+/// `Select3D_SensitiveSet::BVH`: builds the tree when dirty; `select3d_set_build_bvh(&*set)?`.
+pub fn select3d_set_build_bvh<S: Select3DSensitiveSet + ?Sized>(set: &S) -> Result<(), Failure> {
+    let mut content = set.set_base().lock_content();
+    let mut primitives = SetPrimitives {
+        set,
+        content: &mut content,
+    };
+    primitives.update()
+}
+
+/// Runs `body` on the built tree and the box of the content, holding the content lock; the
+/// tree is taken out of the primitive set for the traversal and put back afterwards.
+fn with_built_tree<S: Select3DSensitiveSet + ?Sized, R>(
+    set: &S,
+    body: impl FnOnce(&BvhTree<BvhVec3d>, &Select3DBndBox3d) -> Result<R, Failure>,
+) -> Result<R, Failure> {
+    let mut content = set.set_base().lock_content();
+    let (tree, bounds) = {
+        let mut primitives = SetPrimitives {
+            set,
+            content: &mut content,
+        };
+        primitives.update()?;
+        let bounds = primitives.cached_box()?;
+        (primitives.take_primitive_bvh()?, bounds)
+    };
+    let result = body(&tree, &bounds);
+    SetPrimitives {
+        set,
+        content: &mut content,
+    }
+    .restore_primitive_bvh(tree);
+    result
+}
+
+/// The arguments of `processElements`.
+struct ElementRange {
+    first: i32,
+    last: i32,
+    is_full_inside: bool,
+}
+
+/// `processElements` (protected): the inclusion or overlap test of the elements of a range,
+/// keeping the nearest overlap; false when an inclusion fails. Counts the matches.
+fn process_elements<S: Select3DSensitiveSet + ?Sized>(
+    set: &S,
+    manager: &dyn SelectBasicsSelectingVolumeManager,
+    range: &ElementRange,
+    to_check_all_inside: bool,
+    pick_result: &mut SelectBasicsPickResult,
+    matches_nb: &mut i32,
+) -> Result<bool, Failure> {
+    let mut pick = SelectBasicsPickResult::default();
+    for idx in range.first..=range.last {
+        if !manager.is_overlap_allowed() {
+            if !set.element_is_inside(manager, idx, range.is_full_inside)? {
+                if to_check_all_inside {
+                    continue;
+                }
+                return Ok(false);
+            }
+        } else {
+            if !set.overlaps_element(&mut pick, manager, idx, range.is_full_inside)? {
+                continue;
+            }
+            if pick_result.depth() > pick.depth() {
+                *pick_result = pick;
+                *set.set_base().detected_idx.write() = idx;
+            }
+        }
+        *matches_nb += 1;
+    }
+    Ok(true)
+}
+
+/// A node of the traversal stack (`NodeInStack`).
+#[derive(Clone, Copy, Default)]
+struct NodeInStack {
+    id: i32,
+    is_full_inside: bool,
+}
+
+/// `Select3D_SensitiveSet::matches` (protected): the traversal of the tree with the overlap
+/// or inclusion test; the distance to the center of geometry is set on a match.
+/// Example: `select3d_set_matches(&*set, &manager, &mut pick, false)?`.
+pub fn select3d_set_matches<S: Select3DSensitiveSet + ?Sized>(
+    set: &S,
+    manager: &dyn SelectBasicsSelectingVolumeManager,
+    pick_result: &mut SelectBasicsPickResult,
+    to_check_all_inside: bool,
+) -> Result<bool, Failure> {
+    *set.set_base().detected_idx.write() = -1;
+    if set.size() < 1 {
+        return Ok(false);
+    }
+    with_built_tree(set, |tree, global_box| {
+        traverse_set(
+            set,
+            manager,
+            tree,
+            global_box,
+            pick_result,
+            to_check_all_inside,
+        )
+    })
+}
+
+/// The body of `matches` once the tree is built.
+fn traverse_set<S: Select3DSensitiveSet + ?Sized>(
+    set: &S,
+    manager: &dyn SelectBasicsSelectingVolumeManager,
+    tree: &BvhTree<BvhVec3d>,
+    global_box: &Select3DBndBox3d,
+    pick_result: &mut SelectBasicsPickResult,
+    to_check_all_inside: bool,
+) -> Result<bool, Failure> {
+    let mut is_full_inside = true;
+    if !manager.overlaps_box_inside(
+        global_box.corner_min(),
+        global_box.corner_max(),
+        Some(&mut is_full_inside),
+    )? {
+        return Ok(false);
+    }
+    let mut matches_nb = -1;
+    let to_check_full_inside = manager.get_active_selection_type() != SelectMgrSelectionType::Point;
+    if to_check_full_inside && is_full_inside {
+        let range = ElementRange {
+            first: 0,
+            last: set.size() - 1,
+            is_full_inside: true,
+        };
+        if !process_elements(
+            set,
+            manager,
+            &range,
+            to_check_all_inside,
+            pick_result,
+            &mut matches_nb,
+        )? {
+            return Ok(false);
+        }
+    } else if !traverse(
+        set,
+        manager,
+        tree,
+        to_check_full_inside,
+        to_check_all_inside,
+        pick_result,
+        &mut matches_nb,
+    )? {
+        return Ok(false);
+    }
+    if matches_nb != -1 {
+        pick_result.set_dist_to_geom_center(set.distance_to_cog(manager));
+    }
+    Ok(matches_nb != -1 || (!to_check_all_inside && !manager.is_overlap_allowed()))
+}
+
+/// The left and right children of an inner node with whether to visit them.
+type ChildVisits = ((NodeInStack, bool), (NodeInStack, bool));
+
+/// The children of an inner node and whether to visit them; None stops the traversal (an
+/// inclusion failure).
+fn visit_children(
+    manager: &dyn SelectBasicsSelectingVolumeManager,
+    tree: &BvhTree<BvhVec3d>,
+    node: NodeInStack,
+    data: (i32, i32),
+    full_inside_check: bool,
+    to_check_all_inside: bool,
+) -> Result<Option<ChildVisits>, Failure> {
+    let mut left = NodeInStack {
+        id: data.0,
+        is_full_inside: full_inside_check,
+    };
+    let mut right = NodeInStack {
+        id: data.1,
+        is_full_inside: full_inside_check,
+    };
+    let (mut to_left, mut to_right) = (true, true);
+    if !node.is_full_inside {
+        to_left = overlaps_node(manager, tree, &mut left, full_inside_check)?;
+        to_right = overlaps_node(manager, tree, &mut right, full_inside_check)?;
+    }
+    if !manager.is_overlap_allowed() && !to_check_all_inside {
+        if !to_left || !to_right {
+            return Ok(None);
+        }
+        to_left &= !left.is_full_inside;
+        to_right &= !right.is_full_inside;
+    }
+    Ok(Some(((left, to_left), (right, to_right))))
+}
+
+/// The overlap test of a child node box, clearing its full-inside flag when it misses.
+fn overlaps_node(
+    manager: &dyn SelectBasicsSelectingVolumeManager,
+    tree: &BvhTree<BvhVec3d>,
+    node: &mut NodeInStack,
+    full_inside_check: bool,
+) -> Result<bool, Failure> {
+    let (min, max) = (tree.min_point(node.id)?, tree.max_point(node.id)?);
+    let overlaps = manager.overlaps_box_inside(
+        min,
+        max,
+        full_inside_check.then_some(&mut node.is_full_inside),
+    )?;
+    if !overlaps {
+        node.is_full_inside = false;
+    }
+    Ok(overlaps)
+}
+
+/// The depth-first traversal of `matches` with the native fixed stack order.
+fn traverse<S: Select3DSensitiveSet + ?Sized>(
+    set: &S,
+    manager: &dyn SelectBasicsSelectingVolumeManager,
+    tree: &BvhTree<BvhVec3d>,
+    full_inside_check: bool,
+    to_check_all_inside: bool,
+    pick_result: &mut SelectBasicsPickResult,
+    matches_nb: &mut i32,
+) -> Result<bool, Failure> {
+    let mut stack: Vec<NodeInStack> = Vec::with_capacity(MAX_TREE_DEPTH as usize);
+    let mut node = NodeInStack::default();
+    loop {
+        let info = tree.node_info_buffer()[node.id as usize];
+        if info.x() == 0 {
+            let Some(((left, to_left), (right, to_right))) = visit_children(
+                manager,
+                tree,
+                node,
+                (info.y(), info.z()),
+                full_inside_check,
+                to_check_all_inside,
+            )?
+            else {
+                return Ok(false);
+            };
+            if to_left || to_right {
+                node = if to_left { left } else { right };
+                if to_left && to_right {
+                    stack.push(right);
+                }
+                continue;
+            }
+        } else {
+            let range = ElementRange {
+                first: info.y(),
+                last: info.z(),
+                is_full_inside: node.is_full_inside,
+            };
+            if !process_elements(
+                set,
+                manager,
+                &range,
+                to_check_all_inside,
+                pick_result,
+                matches_nb,
+            )? {
+                return Ok(false);
+            }
+        }
+        let Some(next) = stack.pop() else {
+            return Ok(true);
+        };
+        node = next;
+    }
+}
+
+/// `Select3D_SensitiveSet::BoundingBox`: an invalid box (RealLast to RealFirst).
+/// Example: `select3d_set_bounding_box()`.
+pub fn select3d_set_bounding_box() -> Select3DBndBox3d {
+    BvhBox::from_corners(
+        Vec3::new(real_last(), real_last(), real_last()),
+        Vec3::new(real_first(), real_first(), real_first()),
+    )
+}
+
+/// `Select3D_SensitiveSet::CenterOfGeometry`: the point (RealLast, RealLast, RealLast).
+/// Example: `select3d_set_center_of_geometry()`.
+pub fn select3d_set_center_of_geometry() -> Point3 {
+    Point3::new(real_last(), real_last(), real_last())
+}
+
+/// The native `Select3D_SensitiveSet::DumpJson` body (the content dumps nothing natively).
+/// Example: `select3d_set_dump_json(&*set, &mut stream, -1)?`.
+pub fn select3d_set_dump_json<S: Select3DSensitiveSet + ?Sized>(
+    set: &S,
+    stream: &mut DumpStream,
+    depth: i32,
+) -> io::Result<()> {
+    class_begin(stream, "Select3D_SensitiveSet")?;
+    base_class(stream, depth, &|s, d| {
+        select3d_sensitive_entity_dump_json(set, s, d)
+    })?;
+    field_dumped(stream, depth, "&myContent", &|_, _| Ok(()))?;
+    field_integer(stream, "myDetectedIdx", set.set_base().detected_idx())?;
+    let bounds = set.bounding_box();
+    field_dumped(stream, depth, "&aBoundingBox", &|s, _| bounds.dump_json(s))
+}
