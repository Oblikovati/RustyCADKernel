index 000000000..e7d6a2d78
--- /dev/null
+++ b/crates/tkernel/src/ncollection/linked_slots.rs
@@ -0,0 +1,147 @@
+//! Safe doubly linked node storage shared by `NCollection_List` and `NCollection_Sequence`.
+//!
+//! Nodes live in one dense `Vec`; the native `Next`/`Previous` pointers are slot indices.
+//! Removal moves the last slot into the hole and repoints the moved node's neighbours, the
+//! ends and its identity, as the ordered maps do (Phase 2c). Each node carries a serial: the
+//! native node identity that a detached cursor holds. A serial is unique in the process and
+//! never reused, as a live node address is unique, so a cursor never names a node of another
+//! collection. A splice moves nodes with their serials, because a native splice relinks the
+//! same nodes and the cursors that name them stay valid in the destination.
+use super::slot_chains::SlotLink;
+use std::collections::HashMap;
+use std::sync::atomic::{AtomicUsize, Ordering};
+mod order;
+mod splice;
+
+/// The next node identity of any list or sequence; identities need uniqueness, not order.
+/// It starts at 1 so that no identity is 0, the value of a native null pointer.
+static NEXT_NODE_SERIAL: AtomicUsize = AtomicUsize::new(1);
+
+/// One node: the native links as slot indices, the node identity and the item.
+struct LinkedSlot<T> {
+    previous: SlotLink,
+    next: SlotLink,
+    serial: usize,
+    value: T,
+}
+
+/// The node chain of one list or sequence; `LinkedSlots::<i32>::default()`.
+pub(super) struct LinkedSlots<T> {
+    slots: Vec<LinkedSlot<T>>,
+    serials: HashMap<usize, usize>,
+    first: SlotLink,
+    last: SlotLink,
+}
+
+impl<T> Default for LinkedSlots<T> {
+    fn default() -> Self {
+        Self {
+            slots: Vec::new(),
+            serials: HashMap::new(),
+            first: None,
+            last: None,
+        }
+    }
+}
+
+impl<T> LinkedSlots<T> {
+    pub(super) fn len(&self) -> usize {
+        self.slots.len()
+    }
+    pub(super) fn first(&self) -> SlotLink {
+        self.first
+    }
+    pub(super) fn last(&self) -> SlotLink {
+        self.last
+    }
+    pub(super) fn next(&self, slot: usize) -> SlotLink {
+        self.slots[slot].next
+    }
+    pub(super) fn previous(&self, slot: usize) -> SlotLink {
+        self.slots[slot].previous
+    }
+    pub(super) fn serial(&self, slot: usize) -> usize {
+        self.slots[slot].serial
+    }
+    /// The slot of a live node of this chain, `None` for a removed or foreign node.
+    pub(super) fn slot_of(&self, serial: usize) -> SlotLink {
+        self.serials.get(&serial).copied()
+    }
+    pub(super) fn value(&self, slot: usize) -> &T {
+        &self.slots[slot].value
+    }
+    pub(super) fn value_mut(&mut self, slot: usize) -> &mut T {
+        &mut self.slots[slot].value
+    }
+    /// Links a new node after `anchor`, or at the front for `None`; returns its slot.
+    pub(super) fn insert_after(&mut self, anchor: SlotLink, value: T) -> usize {
+        let serial = NEXT_NODE_SERIAL.fetch_add(1, Ordering::Relaxed);
+        self.link_after(anchor, serial, value)
+    }
+    /// Links a new node before `anchor`, or at the back for `None`; returns its slot.
+    pub(super) fn insert_before(&mut self, anchor: SlotLink, value: T) -> usize {
+        let after = anchor.map_or(self.last, |slot| self.previous(slot));
+        self.insert_after(after, value)
+    }
+    /// Unlinks a node and returns its item; the item is dropped by the caller, after the
+    /// chain is consistent again.
+    pub(super) fn remove(&mut self, slot: usize) -> T {
+        self.unlink(slot);
+        let removed = self.slots.swap_remove(slot);
+        self.serials.remove(&removed.serial);
+        if slot < self.slots.len() {
+            self.repoint(slot);
+        }
+        removed.value
+    }
+    /// Native Reverse: every node swaps its two links, and the ends swap.
+    pub(super) fn reverse(&mut self) {
+        for slot in &mut self.slots {
+            std::mem::swap(&mut slot.previous, &mut slot.next);
+        }
+        std::mem::swap(&mut self.first, &mut self.last);
+    }
+    // Inserts a node with a known identity between `anchor` and its successor.
+    fn link_after(&mut self, anchor: SlotLink, serial: usize, value: T) -> usize {
+        let next = anchor.map_or(self.first, |slot| self.next(slot));
+        let slot = self.slots.len();
+        self.slots.push(LinkedSlot {
+            previous: anchor,
+            next,
+            serial,
+            value,
+        });
+        self.serials.insert(serial, slot);
+        self.point_neighbours_at(slot);
+        slot
+    }
+    // Native unlink: the neighbours (or the ends) skip the node.
+    fn unlink(&mut self, slot: usize) {
+        let LinkedSlot { previous, next, .. } = self.slots[slot];
+        match previous {
+            Some(previous) => self.slots[previous].next = next,
+            None => self.first = next,
+        }
+        match next {
+            Some(next) => self.slots[next].previous = previous,
+            None => self.last = previous,
+        }
+    }
+    // The last slot moved into `slot`: its neighbours, the ends and its identity follow it.
+    fn repoint(&mut self, slot: usize) {
+        self.point_neighbours_at(slot);
+        self.serials.insert(self.slots[slot].serial, slot);
+    }
+    // Every link that names the node's place (neighbour links or the ends) names `slot`.
+    fn point_neighbours_at(&mut self, slot: usize) {
+        let LinkedSlot { previous, next, .. } = self.slots[slot];
+        match previous {
+            Some(previous) => self.slots[previous].next = Some(slot),
+            None => self.first = Some(slot),
+        }
+        match next {
+            Some(next) => self.slots[next].previous = Some(slot),
+            None => self.last = Some(slot),
+        }
+    }
+}
