+impl<T> LinkedSlots<T> {
+    /// The slots from first to last along the `next` links.
+    pub(in crate::ncollection) fn chain_order(&self) -> Vec<usize> {
+        let mut order = Vec::with_capacity(self.len());
+        let mut slot = self.first;
+        while let Some(current) = slot {
+            order.push(current);
+            slot = self.next(current);
+        }
+        order
+    }
+    /// Empties the chain and returns its items in chain order, so the caller drops them in the
+    /// native destruction order (first to last).
+    pub(in crate::ncollection) fn take_in_order(&mut self) -> Vec<T> {
+        let order = self.chain_order();
+        let slots = std::mem::take(&mut self.slots);
+        self.serials.clear();
+        self.first = None;
+        self.last = None;
+        let mut by_slot: Vec<Option<T>> = slots.into_iter().map(|slot| Some(slot.value)).collect();
+        order
+            .into_iter()
+            .filter_map(|slot| by_slot[slot].take())
+            .collect()
+    }
+    /// Disjoint exclusive borrows of every item in chain order, with their identities.
+    pub(in crate::ncollection) fn ordered_mut(&mut self) -> Vec<OrderedItemMut<'_, T>> {
+        let order = self.chain_order();
+        let mut by_slot: Vec<Option<OrderedItemMut<'_, T>>> = self
+            .slots
+            .iter_mut()
+            .map(|slot| {
+                Some(OrderedItemMut {
+                    serial: slot.serial,
+                    value: &mut slot.value,
+                })
+            })
+            .collect();
+        order
+            .into_iter()
+            .filter_map(|slot| by_slot[slot].take())
+            .collect()
+    }
+}
diff --git a/crates/tkernel/src/ncollection/linked_slots/splice.rs b/crates/tkernel/src/ncollection/linked_slots/splice.rs
new file mode 100644
index 000000000..07967626e
--- /dev/null
+++ b/crates/tkernel/src/ncollection/linked_slots/splice.rs
@@ -0,0 +1,48 @@
+//! Native splices relink nodes from one chain into another; here the nodes move between slot
+//! vectors and keep their identities, so cursors that name them follow them.
+use super::{LinkedSlots, SlotLink};
+
+impl<T> LinkedSlots<T> {
+    /// Moves the donor nodes `from..=to` (in donor chain order) after `anchor`, or to the front
+    /// for `None`; returns the slot of the last moved node. `to` must follow or equal `from`.
+    pub(in crate::ncollection) fn splice_after(
+        &mut self,
+        anchor: SlotLink,
+        donor: &mut Self,
+        from: usize,
+        to: usize,
+    ) -> SlotLink {
+        let mut anchor = anchor;
+        for serial in donor.range_serials(from, to) {
+            let slot = donor.slot_of(serial);
+            anchor = slot.map(|slot| self.adopt_after(anchor, donor, slot));
+        }
+        anchor
+    }
+    /// Moves every donor node after `anchor` (or to the front for `None`).
+    pub(in crate::ncollection) fn splice_all_after(&mut self, anchor: SlotLink, donor: &mut Self) {
+        if let (Some(from), Some(to)) = (donor.first, donor.last) {
+            self.splice_after(anchor, donor, from, to);
+        }
+    }
+    /// Exchanges every node and both ends with `other`; `first.exchange(&mut second)`.
+    pub(in crate::ncollection) fn exchange(&mut self, other: &mut Self) {
+        std::mem::swap(self, other);
+    }
+    // The identities of the donor range, read before any slot moves.
+    fn range_serials(&self, from: usize, to: usize) -> Vec<usize> {
+        let mut serials = Vec::new();
+        let mut slot = Some(from);
+        while let Some(current) = slot {
+            serials.push(self.serial(current));
+            slot = (current != to).then(|| self.next(current)).flatten();
+        }
+        serials
+    }
+    // Takes one node out of the donor and links it, with its identity, after `anchor`.
+    fn adopt_after(&mut self, anchor: SlotLink, donor: &mut Self, slot: usize) -> usize {
+        let serial = donor.serial(slot);
+        let value = donor.remove(slot);
+        self.link_after(anchor, serial, value)
+    }
+}
diff --git a/crates/tkernel/src/ncollection/list/observation.rs b/crates/tkernel/src/ncollection/list/observation.rs
new file mode 100644
index 000000000..218a5fb25
--- /dev/null
+++ b/crates/tkernel/src/ncollection/list/observation.rs
@@ -0,0 +1,87 @@
+//! A published copy of the native BaseList fields, readable while an item destructor runs.
+//!
+//! The list publishes its size and end identities after every edit. Remove and Clear publish
+//! the native intermediate values around the destructor (Remove: the new head but the old tail
+//! and size; Clear: the old fields until every destructor has run). The copy is created on the
+//! first `observer()` call, so a list that nobody observes never publishes.
+use super::List;
+use std::sync::{Arc, Mutex, OnceLock, PoisonError};
+
+/// The native fields an observer reads: `myLength`, `myFirst` and `myLast` identities.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub(super) struct ListMetadata {
+    pub(super) size: usize,
+    pub(super) first: Option<usize>,
+    pub(super) last: Option<usize>,
+}
+
+/// The owner side of the published copy; it stays with the list across exchanges and moves.
+#[derive(Default)]
+pub(super) struct ListShadow {
+    shared: OnceLock<Arc<Mutex<ListMetadata>>>,
+}
+
+/// Read-only access to an owner's actual native metadata, including during item Drop.
+/// Example: `let observer = list.observer(); assert_eq!(observer.size(), list.len())`.
+/// Node identities are opaque and may name already destroyed nodes during native Clear.
+#[derive(Clone)]
+pub struct ListObserver {
+    shared: Arc<Mutex<ListMetadata>>,
+}
+
+impl ListShadow {
+    /// Replaces the published fields; a no-op until someone observes the list.
+    pub(super) fn publish(&self, metadata: ListMetadata) {
+        if let Some(shared) = self.shared.get() {
+            *shared.lock().unwrap_or_else(PoisonError::into_inner) = metadata;
+        }
+    }
+    fn observer(&self, current: ListMetadata) -> ListObserver {
+        let shared = self
+            .shared
+            .get_or_init(|| Arc::new(Mutex::new(current)))
+            .clone();
+        ListObserver { shared }
+    }
+}
+
+impl<T> List<T> {
+    /// Creates a handle to the owner's native metadata; `let observer = list.observer()`.
+    pub fn observer(&self) -> ListObserver {
+        self.shadow.observer(self.metadata())
+    }
+    /// The current native fields of this list.
+    pub(super) fn metadata(&self) -> ListMetadata {
+        ListMetadata {
+            size: self.len(),
+            first: self.node_serial(self.chain.first()),
+            last: self.node_serial(self.chain.last()),
+        }
+    }
+    /// Publishes the current fields for observers.
+    pub(super) fn publish(&self) {
+        self.shadow.publish(self.metadata());
+    }
+}
+
+impl ListObserver {
+    fn read(&self) -> ListMetadata {
+        *self.shared.lock().unwrap_or_else(PoisonError::into_inner)
+    }
+    /// Reads native Size, including its intermediate destructor value; `observer.size()`.
+    pub fn size(&self) -> usize {
+        self.read().size
+    }
+    /// Reads native head-pointer emptiness independently of Size; `observer.is_empty()`.
+    pub fn is_empty(&self) -> bool {
+        self.read().first.is_none()
+    }
+    /// Reads opaque head identity; `observer.first_node()`.
+    pub fn first_node(&self) -> Option<usize> {
+        self.read().first
+    }
+    /// Reads opaque tail identity; `observer.last_node()`.
+    pub fn last_node(&self) -> Option<usize> {
+        self.read().last
+    }
+}
