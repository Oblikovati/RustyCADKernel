  "behavior_changes": [
    {
      "method": "NCollection_SparseArrayBase::exchange",
      "cpp_id": "1c718f3a18f5e2f444d41984aaf6faf659cc7f04d3ab41bffbe7ab5ec9b30317",
      "before": "Whole-owner swap moved Rc state allocations; saved size/table observers became bound to the other object. Stored destructor trace was 80:1,90:1,.",
      "after": "Swap protected state values in place and transfer allocator handle; saved metadata addresses remain bound to each object while blocks, callback and geometry move. Native/Rust trace is 80:2,90:1,.",
      "native_rows": [
        "identity 1 1 1 1",
        "contents 2 1 12 9 1 1",
        "clear_phase 80:2,90:1, 0 1",
        "drop_phase 80:2,90:1,",
        "round_trip 1 2 1 1",
        "self 1 1 1 10"
      ]
    },
    {
      "surface": "SparseArrayBase::with_allocator Rust extension",
      "before": "allocate_optimal_raw/free_raw omitted layout alignment and incremental leases. AccAllocator(256), item_size4, block_size4: table32 bytes, block25 bytes rounded to28 by 4-byte allocator, block address offset modulo8=4; native usize header needs8. Miri reported invalid aligned access at publish_slot. Incremental reset(false) was allowed while sparse table/block allocations remained live.",
      "after": "Use existing allocator_api2::Allocator Layout path, requesting max(usize,pointer) header/table alignment, with matching original byte size on deallocation. Existing aligned arena allocation and incremental acquire/release provide ownership and reset protection. Native block logical byte count remains unchanged.",
      "public_reproducer_contract": "with_allocator is safe; population requires unsafe set_value with valid i32 source and callbacks. No safe typed facade accepts injected sparse allocators, so this is not described as an entirely safe initialization reproducer. Once valid objects exist, safe resource reset and base reads previously exposed missing lease protection.",
      "error_paths": "Failed allocation publishes no table and invokes no item callback. Constructor panic retains unpublished storage until clear/drop; no item destruction, allocator allocations/leases released exactly once.",
      "native_credit": false
    }
  ],
