+++ b/crates/tkbool/src/top_ope_brep_ds/data_structure/curve_explorer.rs
@@ -0,0 +1,161 @@
+// Rust translation of TopOpeBRepDS_CurveExplorer.hxx/.cxx at
+// OCCT 3d097a0328e71b826377d4814ab05ec3c3d23871.
+// Copyright (c) 1995-1999 Matra Datavision
+// Copyright (c) 1999-2014 OPEN CASCADE SAS
+// Licensed under LGPL-2.1 with the OCCT exception; see licenses/.
+
+use super::{TopOpeBRepDSCurve, TopOpeBRepDSDataStructure};
+
+enum CurveExplorerSource<'a> {
+    Shared(&'a TopOpeBRepDSDataStructure),
+    Exclusive(&'a mut TopOpeBRepDSDataStructure),
+}
+
+impl CurveExplorerSource<'_> {
+    fn as_ref(&self) -> &TopOpeBRepDSDataStructure {
+        match self {
+            Self::Shared(curves) => curves,
+            Self::Exclusive(curves) => curves,
+        }
+    }
+}
+
+/// Traverses bound curve indices, optionally retaining only kept curves.
+/// The borrow keeps returned curves tied to their source; counting exhausts the cursor.
+/// `let mut explorer = TopOpeBRepDSCurveExplorer::new(&curves, true);`
+pub struct TopOpeBRepDSCurveExplorer<'a> {
+    curves: Option<CurveExplorerSource<'a>>,
+    index: i32,
+    maximum: i32,
+    found: bool,
+    find_keep: bool,
+    empty_curve: TopOpeBRepDSCurve,
+}
+
+impl Default for TopOpeBRepDSCurveExplorer<'_> {
+    fn default() -> Self {
+        Self {
+            curves: None,
+            index: 1,
+            maximum: 0,
+            found: false,
+            find_keep: false,
+            empty_curve: TopOpeBRepDSCurve::default(),
+        }
+    }
+}
+
+impl<'a> TopOpeBRepDSCurveExplorer<'a> {
+    /// Starts at the first matching bound index; `TopOpeBRepDSCurveExplorer::new(&ds, true)`.
+    pub fn new(curves: &'a TopOpeBRepDSDataStructure, find_keep: bool) -> Self {
+        let mut explorer = Self::default();
+        explorer.init(curves, find_keep);
+        explorer
+    }
+
+    /// Restarts against a source and filter; `explorer.init(&ds, false)`.
+    pub fn init(&mut self, curves: &'a TopOpeBRepDSDataStructure, find_keep: bool) {
+        self.curves = Some(CurveExplorerSource::Shared(curves));
+        self.restart(find_keep);
+    }
+
+    /// Allows source edits between steps without detached pointers; `Self::new_mut(&mut ds, true)`.
+    pub fn new_mut(curves: &'a mut TopOpeBRepDSDataStructure, find_keep: bool) -> Self {
+        let mut explorer = Self {
+            curves: Some(CurveExplorerSource::Exclusive(curves)),
+            ..Self::default()
+        };
+        explorer.restart(find_keep);
+        explorer
+    }
+
+    /// Returns editable source for an exclusive explorer; `explorer.source_mut()?.remove_curve(2)`.
+    /// Shared and unbound explorers return `None`.
+    pub fn source_mut(&mut self) -> Option<&mut TopOpeBRepDSDataStructure> {
+        match self.curves.as_mut()? {
+            CurveExplorerSource::Exclusive(curves) => Some(curves),
+            CurveExplorerSource::Shared(_) => None,
+        }
+    }
+
+    fn restart(&mut self, find_keep: bool) {
+        self.index = 1;
+        self.maximum = self
+            .source()
+            .map_or(0, TopOpeBRepDSDataStructure::nb_curves);
+        self.find_keep = find_keep;
+        self.find();
+    }
+
+    /// Reports whether a matching curve is current; `assert!(explorer.more())`.
+    pub fn more(&self) -> bool {
+        self.found
+    }
+
+    /// Advances past holes and, when requested, discarded curves; `explorer.next()`.
+    pub fn next(&mut self) {
+        self.index += 1;
+        self.find();
+    }
+
+    /// Returns the current curve or an empty curve after exhaustion; `explorer.curve()`.
+    pub fn curve(&self) -> &TopOpeBRepDSCurve {
+        if !self.found {
+            return &self.empty_curve;
+        }
+        self.source()
+            .map_or(&self.empty_curve, |curves| curves.curve(self.index))
+    }
+
+    /// Tests binding independently of Keep and the traversal limit; `explorer.is_curve(4)`.
+    pub fn is_curve(&self, index: i32) -> bool {
+        self.source()
+            .is_some_and(|curves| curves.my_curves.is_bound(&index))
+    }
+
+    /// Requires both a bound curve and its Keep flag; `explorer.is_curve_keep(4)`.
+    pub fn is_curve_keep(&self, index: i32) -> bool {
+        self.is_curve(index) && self.curve_at(index).keep()
+    }
+
+    /// Looks up a bound curve regardless of the filter; `explorer.curve_at(4)`.
+    pub fn curve_at(&self, index: i32) -> &TopOpeBRepDSCurve {
+        // The native explorer's fallback is separate from DataStructure::ChangeCurve's
+        // mutable fallback, which callers can overwrite through an unknown index.
+        self.source()
+            .and_then(|curves| curves.my_curves.seek(&index))
+            .map_or(&self.empty_curve, |entry| &entry.my_curve)
+    }
+
+    /// Recounts from index one and leaves the explorer exhausted; `explorer.nb_curve()`.
+    pub fn nb_curve(&mut self) -> i32 {
+        self.restart(self.find_keep);
+        let mut count: i32 = 0;
+        while self.more() {
+            count += 1;
+            self.next();
+        }
+        count
+    }
+
+    /// Returns the cursor index, including past-the-end indices; `explorer.index()`.
+    pub fn index(&self) -> i32 {
+        self.index
+    }
+
+    fn source(&self) -> Option<&TopOpeBRepDSDataStructure> {
+        self.curves.as_ref().map(CurveExplorerSource::as_ref)
+    }
+
+    fn find(&mut self) {
+        self.found = false;
+        while self.index <= self.maximum {
+            self.found =
+                self.is_curve(self.index) && (!self.find_keep || self.is_curve_keep(self.index));
+            if self.found {
+                return;
+            }
+            self.index += 1;
+        }
+    }
+}
