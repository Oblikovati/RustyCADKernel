+//! Rust port of the OCCT TKV3d toolkit: selection, presentation, interactive objects and the
+//! 3D viewer, over the Graphic3d driver interfaces of TKService.
+//!
+//! - [`ais`]: interactive objects and the interactive context.
+//! - [`prs3d`]: the aspects and the drawer of presentations and the presentation tools.
+//! - [`prs_mgr`]: presentable objects, their presentations and the presentation manager.
+//! - [`select3d`]: the sensitive entities.
+//! - [`select_basics`]: the pick result and the abstract selecting volume.
+//! - [`select_mgr`]: selection modes, owners, selecting volumes and the selectors.
+//! - [`v3d`]: the viewer, its views, lights, grids and trihedron.
+//!
+//! The design rules, including how the viewer reaches the Vulkan 1.3 driver through the
+//! Graphic3d interfaces only, are in `docs/v3d-design.md`.
+pub mod ais;
+pub mod prs3d;
+pub mod prs_mgr;
+pub mod select3d;
+pub mod select_basics;
+pub mod select_mgr;
+pub mod v3d;
diff --git a/crates/tkv3d/src/prs3d/arrow.rs b/crates/tkv3d/src/prs3d/arrow.rs
new file mode 100644
index 000000000..98dd2caf9
--- /dev/null
+++ b/crates/tkv3d/src/prs3d/arrow.rs
@@ -0,0 +1,177 @@
+//! `Prs3d_Arrow`: arrow heads as segment cones or shaded tube-and-cone triangles.
+use super::tool_quadric::{prs3d_quadric_triangles_nb, prs3d_quadric_vertices_nb};
+use super::{Prs3dToolCylinder, Prs3dToolDisk, Prs3dToolQuadric};
+use rustycad_tkernel::standard::{Failure, Handle};
+use rustycad_tkmath::gp::{Axis1, Axis3, Direction3, Point3, Transform3, Vector3, Xyz, dx, dy, dz};
+use rustycad_tkservice::graphic3d::{
+    GRAPHIC3D_ARRAY_FLAGS_VERTEX_NORMAL, Graphic3dArrayOfSegments, Graphic3dArrayOfTriangles,
+    Graphic3dGroup, Graphic3dGroupMembers as _,
+};
+use std::f64::consts::PI;
+
+/// The package class `Prs3d_Arrow`.
+pub struct Prs3dArrow;
+
+/// The reference direction: the axis along which `dir` has its smallest component.
+fn least_aligned_axis(dir: &Direction3) -> Direction3 {
+    let (x, y, z) = (dir.x().abs(), dir.y().abs(), dir.z().abs());
+    if x <= y && x <= z {
+        dx()
+    } else if y <= z && y <= x {
+        dy()
+    } else {
+        dz()
+    }
+}
+
+/// The transformation from the frame at `location` along `direction` to the global frame.
+fn frame_to_global(location: Point3, direction: Direction3) -> Result<Transform3, Failure> {
+    let system = Axis3::from_normal(location, direction)?;
+    let mut trsf = Transform3::default();
+    trsf.set_transformation_between(system, Axis3::default());
+    Ok(trsf)
+}
+
+impl Prs3dArrow {
+    /// `DrawShaded`: a tube along the axis capped by a cone with its base disk, as triangles
+    /// with normals; null when both parts are empty.
+    /// Example: `Prs3dArrow::draw_shaded(&axis, 0.1, 10.0, 0.3, 1.0, 12)?`.
+    pub fn draw_shaded(
+        axis: &Axis1,
+        tube_radius: f64,
+        axis_length: f64,
+        cone_radius: f64,
+        cone_length: f64,
+        nb_facettes: i32,
+    ) -> Result<Handle<Graphic3dArrayOfTriangles>, Failure> {
+        let tube_length = 0.0f64.max(axis_length - cone_length);
+        let has_tube = tube_radius > 0.0 && tube_length > 0.0;
+        let has_cone = cone_radius > 0.0 && cone_length > 0.0;
+        let nb_tris_tube = if has_tube {
+            prs3d_quadric_triangles_nb(nb_facettes, 1)
+        } else {
+            0
+        };
+        let nb_tris_cone = if has_cone {
+            2 * prs3d_quadric_triangles_nb(nb_facettes, 1)
+        } else {
+            0
+        };
+        let nb_tris = nb_tris_tube + nb_tris_cone;
+        if nb_tris == 0 {
+            return Ok(Handle::default());
+        }
+        let mut max_vertexs = 0;
+        if nb_tris_tube > 0 {
+            max_vertexs += prs3d_quadric_vertices_nb(nb_facettes, 1, true);
+        }
+        if nb_tris_cone > 0 {
+            max_vertexs += 2 * prs3d_quadric_vertices_nb(nb_facettes, 1, true);
+        }
+        let array = Graphic3dArrayOfTriangles::new(
+            max_vertexs,
+            nb_tris * 3,
+            GRAPHIC3D_ARRAY_FLAGS_VERTEX_NORMAL,
+        )?;
+        let mut array = Handle::new(array);
+        if nb_tris_tube != 0 {
+            let trsf = frame_to_global(axis.location(), axis.direction())?;
+            Prs3dToolCylinder::new(tube_radius, tube_radius, tube_length, nb_facettes, 1)
+                .fill_array(&mut array, &trsf)?;
+        }
+        if nb_tris_cone != 0 {
+            let d = axis.direction();
+            let offset = Vector3::new(
+                d.x() * tube_length,
+                d.y() * tube_length,
+                d.z() * tube_length,
+            );
+            let trsf = frame_to_global(axis.location().translated(offset), d)?;
+            Prs3dToolDisk::new(0.0, cone_radius, nb_facettes, 1).fill_array(&mut array, &trsf)?;
+            Prs3dToolCylinder::new(cone_radius, 0.0, cone_length, nb_facettes, 1)
+                .fill_array(&mut array, &trsf)?;
+        }
+        Ok(array)
+    }
+    /// `DrawSegments`: a cone of segments from the tip at `location` back along `dir`.
+    /// Example: `Prs3dArrow::draw_segments(&tip, &dir, 0.2, 1.0, 15)?`.
+    pub fn draw_segments(
+        location: &Point3,
+        dir: &Direction3,
+        angle: f64,
+        length: f64,
+        nb_segments: i32,
+    ) -> Result<Handle<Graphic3dArrayOfSegments>, Failure> {
+        let segments = Graphic3dArrayOfSegments::new(nb_segments + 1, 2 * (2 * nb_segments), 0)?;
+        let center: Xyz = location.xyz() + dir.xyz() * (-length);
+        let xyz_i = dir.crossed(least_aligned_axis(dir))?;
+        let xyz_j = dir.xyz().crossed(xyz_i.xyz());
+        segments.add_vertex_pnt(location)?;
+        let tg = angle.tan();
+        for vert in 1..=nb_segments {
+            let step = 2.0 * PI / f64::from(nb_segments) * f64::from(vert - 1);
+            let (cos, sin) = (step.cos(), step.sin());
+            let point = Point3::new(
+                center.x() + (cos * xyz_i.x() + sin * xyz_j.x()) * length * tg,
+                center.y() + (cos * xyz_i.y() + sin * xyz_j.y()) * length * tg,
+                center.z() + (cos * xyz_i.z() + sin * xyz_j.z()) * length * tg,
+            );
+            segments.add_vertex_pnt(&point)?;
+        }
+        add_cone_edges(&segments, nb_segments + 1)?;
+        Ok(Handle::new(segments))
+    }
+    /// `Draw`: adds a 15-segment arrow cone to a group.
+    /// Example: `Prs3dArrow::draw(&group, &tip, &dir, 0.2, 1.0)?`.
+    pub fn draw(
+        group: &Handle<dyn Graphic3dGroup>,
+        location: &Point3,
+        direction: &Direction3,
+        angle: f64,
+        length: f64,
+    ) -> Result<(), Failure> {
+        let primitives = Self::draw_segments(location, direction, angle, length, 15)?;
+        if let Some(group) = group.get() {
+            group.add_primitive_array(&primitives.cast(), true);
+        }
+        Ok(())
+    }
+}
+
+/// The edges of the arrow cone: tip to each contour vertex, then the contour loop.
+fn add_cone_edges(segments: &Graphic3dArrayOfSegments, nb_vertices: i32) -> Result<(), Failure> {
+    let first_contour = 2;
+    for vert in first_contour..=nb_vertices {
+        segments.add_edge(1)?;
+        segments.add_edge(vert)?;
+    }
+    segments.add_edge(nb_vertices)?;
+    segments.add_edge(first_contour)?;
+    for vert in first_contour..nb_vertices {
+        segments.add_edge(vert)?;
+        segments.add_edge(vert + 1)?;
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn segments_cone_layout() {
+        let segments =
+            Prs3dArrow::draw_segments(&Point3::new(0.0, 0.0, 1.0), &dz(), 0.2, 1.0, 4).unwrap();
+        assert_eq!(segments.vertex_number(), 5);
+        assert_eq!(segments.edge_number(), 16);
+    }
+
+    #[test]
+    fn shaded_arrow_parts() {
+        let axis = Axis1::new(Point3::new(0.0, 0.0, 0.0), dz());
+        let both = Prs3dArrow::draw_shaded(&axis, 0.1, 10.0, 0.3, 1.0, 6).unwrap();
+        assert_eq!(both.vertex_number(), 3 * 14);
+        let none = Prs3dArrow::draw_shaded(&axis, 0.0, 1.0, 0.0, 1.0, 6).unwrap();
+        assert!(none.is_null());
+    }
+}
diff --git a/crates/tkv3d/src/prs3d/arrow_aspect.rs b/crates/tkv3d/src/prs3d/arrow_aspect.rs
new file mode 100644
index 000000000..be687f2e8
--- /dev/null
+++ b/crates/tkv3d/src/prs3d/arrow_aspect.rs
@@ -0,0 +1,145 @@
+//! `Prs3d_ArrowAspect`: the angle, length and line attributes of arrows.
+use super::basic_aspect::{Prs3dBasicAspect, dump_graphic_aspects};
+use super::prs3d_invalid_angle;
+use rustycad_tkernel::quantity::{Color, NamedColor};
+use rustycad_tkernel::standard::dump::DumpStream;
+use rustycad_tkernel::standard::{Failure, Handle, SharedState, StandardTransient};
+use rustycad_tkservice::aspect::AspectTypeOfLine;
+use rustycad_tkservice::graphic3d::{Graphic3dAspectLine3d, Graphic3dAspectsMembers as _};
+use rustycad_tkservice::json_dump::{class_begin, field_real};
+use std::f64::consts::PI;
+use std::io;
+
+/// The arrow geometry fields.
+#[derive(Clone, Copy)]
+struct Prs3dArrowShape {
+    angle: f64,
+    length: f64,
+    is_zoomable: bool,
+}
+
+/// The attributes of arrows.
+///
+/// Native quirk: the `(angle, length)` and `(aspect)` constructors leave `myIsZoomable`
+/// uninitialized; the port uses `true`, the value of the default constructor.
+/// Example: `let arrow = Prs3dArrowAspect::new()?; arrow.set_angle(0.2)?;`.
+pub struct Prs3dArrowAspect {
+    transient: StandardTransient,
+    arrow_aspect: SharedState<Handle<Graphic3dAspectLine3d>>,
+    shape: SharedState<Prs3dArrowShape>,
+}
+rustycad_tkernel::impl_transient!(Prs3dArrowAspect, "Prs3d_ArrowAspect", dyn Prs3dBasicAspect, transient,
+    interfaces: [dyn Prs3dBasicAspect]);
+
+/// The white solid line of the arrow constructors.
+fn white_line() -> Result<Handle<Graphic3dAspectLine3d>, Failure> {
+    let line = Graphic3dAspectLine3d::new(
+        Color::named(NamedColor::WHITE),
+        AspectTypeOfLine::Solid,
+        1.0,
+    )?;
+    Ok(Handle::new(line))
+}
+
+impl Prs3dArrowAspect {
+    /// The default: a white arrow of 10 degrees and length 1, zoomable; `Prs3dArrowAspect::new()?`.
+    pub fn new() -> Result<Self, Failure> {
+        Self::with_angle_and_length(PI / 180.0 * 10.0, 1.0)
+    }
+    /// A white arrow of an angle and length, unchecked; `Prs3dArrowAspect::with_angle_and_length(0.2, 5.0)?`.
+    pub fn with_angle_and_length(angle: f64, length: f64) -> Result<Self, Failure> {
+        Ok(Self::build(white_line()?, angle, length))
+    }
+    /// An arrow of 10 degrees and length 1 over an existing line aspect.
+    /// Example: `Prs3dArrowAspect::from_aspect(line)`.
+    pub fn from_aspect(aspect: Handle<Graphic3dAspectLine3d>) -> Self {
+        Self::build(aspect, PI / 180.0 * 10.0, 1.0)
+    }
+    fn build(aspect: Handle<Graphic3dAspectLine3d>, angle: f64, length: f64) -> Self {
+        Self {
+            transient: StandardTransient::default(),
+            arrow_aspect: SharedState::new(aspect),
+            shape: SharedState::new(Prs3dArrowShape {
+                angle,
+                length,
+                is_zoomable: true,
+            }),
+        }
+    }
+    /// Sets the angle; outside `(0, PI/2)` raises `Prs3d_InvalidAngle`. `arrow.set_angle(0.3)?`.
+    pub fn set_angle(&self, angle: f64) -> Result<(), Failure> {
+        if angle <= 0.0 || angle >= PI / 2.0 {
+            return Err(prs3d_invalid_angle(&format!(
+                "Prs3d_ArrowAspect::SetAngle() - angle out of range: {angle}; expected (0, PI/2)"
+            )));
+        }
+        self.shape.write().angle = angle;
+        Ok(())
+    }
+    /// The angle; `arrow.angle()`.
+    pub fn angle(&self) -> f64 {
+        self.shape.read().angle
+    }
+    /// Sets the length; `arrow.set_length(5.0)`.
+    pub fn set_length(&self, length: f64) {
+        self.shape.write().length = length;
+    }
+    /// The length; `arrow.length()`.
+    pub fn length(&self) -> f64 {
+        self.shape.read().length
+    }
+    /// Sets whether the arrow scales with the view; `arrow.set_zoomable(false)`.
+    pub fn set_zoomable(&self, is_zoomable: bool) {
+        self.shape.write().is_zoomable = is_zoomable;
+    }
+    /// Whether the arrow scales with the view; `arrow.is_zoomable()`.
+    pub fn is_zoomable(&self) -> bool {
+        self.shape.read().is_zoomable
+    }
+    /// Sets the color of the line aspect; `arrow.set_color(red)`.
+    pub fn set_color(&self, color: Color) {
+        if let Some(line) = self.aspect().get() {
+            line.set_interior_color(color);
+        }
+    }
+    /// The line aspect; `arrow.aspect()`.
+    pub fn aspect(&self) -> Handle<Graphic3dAspectLine3d> {
+        self.arrow_aspect.read().clone()
+    }
+    /// Replaces the line aspect; `arrow.set_aspect(line)`.
+    pub fn set_aspect(&self, aspect: Handle<Graphic3dAspectLine3d>) {
+        *self.arrow_aspect.write() = aspect;
+    }
+}
+
+impl Prs3dBasicAspect for Prs3dArrowAspect {
+    fn dump_json(&self, stream: &mut DumpStream, depth: i32) -> io::Result<()> {
+        class_begin(stream, "Prs3d_ArrowAspect")?;
+        dump_graphic_aspects(stream, depth, "myArrowAspect.get()", &self.aspect())?;
+        let shape = *self.shape.read();
+        field_real(stream, "myAngle", shape.angle)?;
+        field_real(stream, "myLength", shape.length)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn angle_range_is_checked() {
+        let arrow = Prs3dArrowAspect::new().unwrap();
+        assert_eq!(arrow.angle(), PI / 180.0 * 10.0);
+        assert!(arrow.is_zoomable());
+        let error = arrow.set_angle(PI / 2.0).unwrap_err();
+        assert_eq!(error.exception_type(), "Prs3d_InvalidAngle");
+        assert!(arrow.set_angle(0.0).is_err());
+        arrow.set_angle(0.5).unwrap();
+        arrow.set_length(3.0);
+        arrow.set_zoomable(false);
+        assert_eq!(
+            (arrow.angle(), arrow.length(), arrow.is_zoomable()),
+            (0.5, 3.0, false)
+        );
+    }
+}
diff --git a/crates/tkv3d/src/prs3d/basic_aspect.rs b/crates/tkv3d/src/prs3d/basic_aspect.rs
new file mode 100644
index 000000000..c96213528
--- /dev/null
+++ b/crates/tkv3d/src/prs3d/basic_aspect.rs
@@ -0,0 +1,60 @@
+//! `Prs3d_BasicAspect`, the abstract root of the Prs3d aspects, and the shared helpers of the
+//! aspect classes.
+use rustycad_tkernel::standard::dump::DumpStream;
+use rustycad_tkernel::standard::{Handle, StandardTransient, Transient};
+use rustycad_tkservice::graphic3d::Graphic3dAspectsSource;
+use rustycad_tkservice::json_dump::field_dumped;
+use std::io;
+
+/// An aspect of a presentation; every aspect class dumps itself.
+pub trait Prs3dBasicAspect: Transient {
+    /// `DumpJson`; `aspect.dump_json(&mut stream, -1)?`.
+    fn dump_json(&self, stream: &mut DumpStream, depth: i32) -> io::Result<()>;
+}
+rustycad_tkernel::impl_transient_interface!(
+    dyn Prs3dBasicAspect,
+    "Prs3d_BasicAspect",
+    StandardTransient
+);
+
+/// The native `*theTarget->Aspect() = *theSource->Aspect()`: copies every Graphic3d_Aspects
+/// field of `source` into `target`. The source is read before the target is locked, so the
+/// same object on both sides is a no-op instead of a deadlock.
+/// Example: `prs3d_copy_aspects(&*own.aspect(), &*linked.aspect())`.
+pub fn prs3d_copy_aspects(
+    target: &dyn Graphic3dAspectsSource,
+    source: &dyn Graphic3dAspectsSource,
+) {
+    let fields = source.aspects_base().fields.snapshot();
+    *target.aspects_base().fields.write() = fields;
+}
+
+/// `OCCT_DUMP_FIELD_VALUES_DUMPED` of an optional nested aspect: skipped for a null handle.
+pub(crate) fn dump_aspect_field<
+    T: Prs3dBasicAspect + rustycad_tkernel::standard::RuntimeTyped + ?Sized,
+>(
+    stream: &mut DumpStream,
+    depth: i32,
+    field: &str,
+    aspect: &Handle<T>,
+) -> io::Result<()> {
+    let Some(aspect) = aspect.get() else {
+        return Ok(());
+    };
+    field_dumped(stream, depth, field, &|o, d| aspect.dump_json(o, d))
+}
+
+/// `OCCT_DUMP_FIELD_VALUES_DUMPED` of an optional Graphic3d aspects handle.
+pub(crate) fn dump_graphic_aspects<
+    T: Graphic3dAspectsSource + rustycad_tkernel::standard::RuntimeTyped + ?Sized,
+>(
+    stream: &mut DumpStream,
+    depth: i32,
+    field: &str,
+    aspect: &Handle<T>,
+) -> io::Result<()> {
+    let Some(aspect) = aspect.get() else {
+        return Ok(());
+    };
+    field_dumped(stream, depth, field, &|o, d| aspect.dump_json(o, d))
+}
diff --git a/crates/tkv3d/src/prs3d/bnd_box.rs b/crates/tkv3d/src/prs3d/bnd_box.rs
new file mode 100644
index 000000000..206051d03
--- /dev/null
+++ b/crates/tkv3d/src/prs3d/bnd_box.rs
@@ -0,0 +1,176 @@
+//! `Prs3d_BndBox`: the twelve edges of an axis-aligned or oriented bounding box.
+use super::Prs3dDrawer;
+use rustycad_tkernel::standard::{Failure, Handle};
+use rustycad_tkmath::bnd::{BoundingBox3, OrientedBoundingBox};
+use rustycad_tkmath::gp::Point3;
+use rustycad_tkservice::aspect::AspectTypeOfLine;
+use rustycad_tkservice::graphic3d::{
+    Graphic3dArrayOfSegments, Graphic3dAspectLine3d, Graphic3dAspectsMembers as _,
+    Graphic3dGroupMembers as _, Graphic3dStructureMembers as _, Graphic3dStructureSource,
+};
+
+/// The package class `Prs3d_BndBox`.
+pub struct Prs3dBndBox;
+
+/// The corners of an axis-aligned box in the native order (X fastest, then Y, then Z).
+fn box_corners(bnd_box: &BoundingBox3) -> Result<[Point3; 8], Failure> {
+    let (min, max) = (bnd_box.corner_min()?, bnd_box.corner_max()?);
+    Ok([
+        Point3::new(min.x(), min.y(), min.z()),
+        Point3::new(max.x(), min.y(), min.z()),
+        Point3::new(min.x(), max.y(), min.z()),
+        Point3::new(max.x(), max.y(), min.z()),
+        Point3::new(min.x(), min.y(), max.z()),
+        Point3::new(max.x(), min.y(), max.z()),
+        Point3::new(min.x(), max.y(), max.z()),
+        Point3::new(max.x(), max.y(), max.z()),
+    ])
+}
+
+impl Prs3dBndBox {
+    /// `fillSegments`: appends the eight corners and the twelve edges between them.
+    /// Example: `Prs3dBndBox::fill_corner_segments(&segments, &corners)?`.
+    pub fn fill_corner_segments(
+        segments: &Graphic3dArrayOfSegments,
+        corners: &[Point3; 8],
+    ) -> Result<(), Failure> {
+        let from = segments.vertex_number();
+        for corner in corners {
+            segments.add_vertex_pnt(corner)?;
+        }
+        let edges = [
+            (1, 2),
+            (3, 4),
+            (5, 6),
+            (7, 8),
+            (1, 3),
+            (2, 4),
+            (5, 7),
+            (6, 8),
+            (1, 5),
+            (2, 6),
+            (3, 7),
+            (4, 8),
+        ];
+        for (a, b) in edges {
+            segments.add_edges2(from + a, from + b)?;
+        }
+        Ok(())
+    }
+    /// `FillSegments(segments, Bnd_Box)`: appends the box edges unless the box is void.
+    /// Example: `Prs3dBndBox::fill_box_segments_into(&segments, &bounds)?`.
+    pub fn fill_box_segments_into(
+        segments: &Graphic3dArrayOfSegments,
+        bnd_box: &BoundingBox3,
+    ) -> Result<(), Failure> {
+        if bnd_box.is_void() {
+            return Ok(());
+        }
+        Self::fill_corner_segments(segments, &box_corners(bnd_box)?)
+    }
+    /// `FillSegments(segments, Bnd_OBB)`: appends the box edges unless the box is void.
+    /// Example: `Prs3dBndBox::fill_obb_segments_into(&segments, &obb)?`.
+    pub fn fill_obb_segments_into(
+        segments: &Graphic3dArrayOfSegments,
+        obb: &OrientedBoundingBox,
+    ) -> Result<(), Failure> {
+        match obb.vertices() {
+            Some(corners) if !obb.is_void() => Self::fill_corner_segments(segments, &corners),
+            _ => Ok(()),
+        }
+    }
+    /// `FillSegments(Bnd_Box)`: a new array of the box edges, null for a void box.
+    /// Example: `Prs3dBndBox::fill_box_segments(&bounds)?`.
+    pub fn fill_box_segments(
+        bnd_box: &BoundingBox3,
+    ) -> Result<Handle<Graphic3dArrayOfSegments>, Failure> {
+        if bnd_box.is_void() {
+            return Ok(Handle::default());
+        }
+        let segments = Graphic3dArrayOfSegments::new(8, 12 * 2, 0)?;
+        Self::fill_box_segments_into(&segments, bnd_box)?;
+        Ok(Handle::new(segments))
+    }
+    /// `FillSegments(Bnd_OBB)`: a new array of the box edges, null for a void box.
+    /// Example: `Prs3dBndBox::fill_obb_segments(&obb)?`.
+    pub fn fill_obb_segments(
+        obb: &OrientedBoundingBox,
+    ) -> Result<Handle<Graphic3dArrayOfSegments>, Failure> {
+        if obb.is_void() {
+            return Ok(Handle::default());
+        }
+        let segments = Graphic3dArrayOfSegments::new(8, 12 * 2, 0)?;
+        Self::fill_obb_segments_into(&segments, obb)?;
+        Ok(Handle::new(segments))
+    }
+    /// `Add(prs, Bnd_Box, drawer)`: the box edges in the current group, dot-dashed in the
+    /// drawer's line color and width. Example: `Prs3dBndBox::add_box(&prs, &bounds, &drawer)?`.
+    pub fn add_box(
+        prs: &Handle<dyn Graphic3dStructureSource>,
+        bnd_box: &BoundingBox3,
+        drawer: &Handle<Prs3dDrawer>,
+    ) -> Result<(), Failure> {
+        if bnd_box.is_void() {
+            return Ok(());
+        }
+        let segments = Self::fill_box_segments(bnd_box)?;
+        add_segments(prs, drawer, &segments)
+    }
+    /// `Add(prs, Bnd_OBB, drawer)`; `Prs3dBndBox::add_obb(&prs, &obb, &drawer)?`.
+    pub fn add_obb(
+        prs: &Handle<dyn Graphic3dStructureSource>,
+        obb: &OrientedBoundingBox,
+        drawer: &Handle<Prs3dDrawer>,
+    ) -> Result<(), Failure> {
+        if obb.is_void() {
+            return Ok(());
+        }
+        let segments = Self::fill_obb_segments(obb)?;
+        add_segments(prs, drawer, &segments)
+    }
+}
+
+/// The current group of `prs` gets a dot-dash aspect of the drawer's line aspect and the segments.
+fn add_segments(
+    prs: &Handle<dyn Graphic3dStructureSource>,
+    drawer: &Handle<Prs3dDrawer>,
+    segments: &Handle<Graphic3dArrayOfSegments>,
+) -> Result<(), Failure> {
+    let (Some(structure), Some(drawer)) = (prs.get(), drawer.get()) else {
+        return Ok(());
+    };
+    let group = structure.current_group()?;
+    let Some(group) = group.get() else {
+        return Ok(());
+    };
+    let line = drawer.line_aspect().aspect();
+    let (color, width) = line
+        .get()
+        .map_or_else(Default::default, |l| (l.interior_color(), l.width()));
+    let aspect = Graphic3dAspectLine3d::new(color, AspectTypeOfLine::Dotdash, f64::from(width))?;
+    group.set_group_primitives_aspect(&Handle::new(aspect).cast());
+    group.add_primitive_array(&segments.cast(), true);
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn box_segments_have_eight_corners_and_twelve_edges() {
+        let bounds = BoundingBox3::new(Point3::new(0.0, 0.0, 0.0), Point3::new(1.0, 2.0, 3.0));
+        let segments = Prs3dBndBox::fill_box_segments(&bounds).unwrap();
+        assert_eq!((segments.vertex_number(), segments.edge_number()), (8, 24));
+        assert!(
+            Prs3dBndBox::fill_box_segments(&BoundingBox3::default())
+                .unwrap()
+                .is_null()
+        );
+        assert!(
+            Prs3dBndBox::fill_obb_segments(&OrientedBoundingBox::default())
+                .unwrap()
+                .is_null()
+        );
+    }
+}
diff --git a/crates/tkv3d/src/prs3d/datum_aspect.rs b/crates/tkv3d/src/prs3d/datum_aspect.rs
new file mode 100644
index 000000000..3e0c608e9
--- /dev/null
+++ b/crates/tkv3d/src/prs3d/datum_aspect.rs
@@ -0,0 +1,376 @@
+//! `Prs3d_DatumAspect`: the line, shading, text, point and arrow aspects and the attributes
+//! of a datum (trihedron) presentation.
+use super::basic_aspect::{Prs3dBasicAspect, dump_aspect_field, prs3d_copy_aspects};
+use super::{
+    Prs3dArrowAspect, Prs3dDatumAttribute, Prs3dDatumAxes, Prs3dDatumParts, Prs3dLineAspect,
+    Prs3dPointAspect, Prs3dShadingAspect, Prs3dTextAspect,
+};
+use rustycad_tkernel::quantity::{Color, NamedColor};
+use rustycad_tkernel::standard::dump::DumpStream;
+use rustycad_tkernel::standard::{Failure, Handle, SharedState, StandardTransient};
+use rustycad_tkservice::aspect::{AspectTypeOfFacingModel, AspectTypeOfLine, AspectTypeOfMarker};
+use rustycad_tkservice::graphic3d::Graphic3dAspectsMembers as _;
+use rustycad_tkservice::json_dump::{class_begin, field_integer};
+use std::io;
+
+/// The settable fields of a datum aspect.
+#[derive(Clone)]
+struct Prs3dDatumState {
+    text_aspects: [Handle<Prs3dTextAspect>; Prs3dDatumParts::NB],
+    point_aspect: Handle<Prs3dPointAspect>,
+    arrow_aspect: Handle<Prs3dArrowAspect>,
+    attributes: [f64; Prs3dDatumAttribute::NB],
+    axes: Prs3dDatumAxes,
+    to_draw_labels: bool,
+    to_draw_arrows: bool,
+}
+
+/// The attributes of a datum presentation.
+///
+/// Example: `let datum = Prs3dDatumAspect::new()?; datum.set_axis_length(10.0, 20.0, 30.0);`.
+pub struct Prs3dDatumAspect {
+    transient: StandardTransient,
+    shaded_aspects: [Handle<Prs3dShadingAspect>; Prs3dDatumParts::NB],
+    line_aspects: [Handle<Prs3dLineAspect>; Prs3dDatumParts::NB],
+    state: SharedState<Prs3dDatumState>,
+}
+rustycad_tkernel::impl_transient!(Prs3dDatumAspect, "Prs3d_DatumAspect", dyn Prs3dBasicAspect, transient,
+    interfaces: [dyn Prs3dBasicAspect]);
+
+/// The default axis length, the same as in the interactive context.
+const DEFAULT_AXIS_LENGTH: f64 = 100.0;
+
+/// The default attributes: three axes of 100 and the shading proportions.
+fn default_attributes() -> [f64; Prs3dDatumAttribute::NB] {
+    let mut attributes = [0.0; Prs3dDatumAttribute::NB];
+    attributes[Prs3dDatumAttribute::XAxisLength as usize] = DEFAULT_AXIS_LENGTH;
+    attributes[Prs3dDatumAttribute::YAxisLength as usize] = DEFAULT_AXIS_LENGTH;
+    attributes[Prs3dDatumAttribute::ZAxisLength as usize] = DEFAULT_AXIS_LENGTH;
+    attributes[Prs3dDatumAttribute::ShadingTubeRadiusPercent as usize] = 0.02;
+    attributes[Prs3dDatumAttribute::ShadingConeRadiusPercent as usize] = 0.04;
+    attributes[Prs3dDatumAttribute::ShadingConeLengthPercent as usize] = 0.1;
+    attributes[Prs3dDatumAttribute::ShadingOriginRadiusPercent as usize] = 0.015;
+    attributes[Prs3dDatumAttribute::ShadingNumberOfFacettes as usize] = 12.0;
+    attributes
+}
+
+/// The part aspects of the constructor: a line (none for the origin) and a shading aspect
+/// per drawn part, in the arrow color for the arrows.
+type PartAspects = (
+    [Handle<Prs3dShadingAspect>; Prs3dDatumParts::NB],
+    [Handle<Prs3dLineAspect>; Prs3dDatumParts::NB],
+);
+
+fn part_aspects(default_color: Color, arrow_color: Color) -> Result<PartAspects, Failure> {
+    let mut shaded: [Handle<Prs3dShadingAspect>; Prs3dDatumParts::NB] = Default::default();
+    let mut lines: [Handle<Prs3dLineAspect>; Prs3dDatumParts::NB] = Default::default();
+    for part in Prs3dDatumParts::DRAWN {
+        let is_arrow = (Prs3dDatumParts::XArrow..=Prs3dDatumParts::ZArrow).contains(&part);
+        let color = if is_arrow { arrow_color } else { default_color };
+        if part != Prs3dDatumParts::Origin {
+            let line = Prs3dLineAspect::new(color, AspectTypeOfLine::Solid, 1.0)?;
+            lines[part as usize] = Handle::new(line);
+        }
+        let shading = Prs3dShadingAspect::new()?;
+        shading.set_color(color, AspectTypeOfFacingModel::BothSide)?;
+        shaded[part as usize] = Handle::new(shading);
+    }
+    Ok((shaded, lines))
+}
+
+impl Prs3dDatumAspect {
+    /// The default: three light steel blue axes of length 100 with labels and arrows.
+    /// Example: `Prs3dDatumAspect::new()?`.
+    pub fn new() -> Result<Self, Failure> {
+        let default_color = Color::named(NamedColor::LIGHTSTEELBLUE4);
+        let point_aspect = Prs3dPointAspect::new(AspectTypeOfMarker::Empty, default_color, 1.0)?;
+        let arrow_aspect = Handle::new(Prs3dArrowAspect::new()?);
+        let arrow_color = arrow_aspect.aspect().interior_color();
+        let (shaded_aspects, line_aspects) = part_aspects(default_color, arrow_color)?;
+        let mut text_aspects: [Handle<Prs3dTextAspect>; Prs3dDatumParts::NB] = Default::default();
+        for part in [
+            Prs3dDatumParts::XAxis,
+            Prs3dDatumParts::YAxis,
+            Prs3dDatumParts::ZAxis,
+        ] {
+            text_aspects[part as usize] = Handle::new(Prs3dTextAspect::new());
+        }
+        let state = Prs3dDatumState {
+            text_aspects,
+            point_aspect: Handle::new(point_aspect),
+            arrow_aspect,
+            attributes: default_attributes(),
+            axes: Prs3dDatumAxes::XYZAxes,
+            to_draw_labels: true,
+            to_draw_arrows: true,
+        };
+        Ok(Self {
+            transient: StandardTransient::default(),
+            shaded_aspects,
+            line_aspects,
+            state: SharedState::new(state),
+        })
+    }
+    /// The line aspect of a part (null for the origin and `None`); `datum.line_aspect(Prs3dDatumParts::XAxis)`.
+    pub fn line_aspect(&self, part: Prs3dDatumParts) -> Handle<Prs3dLineAspect> {
+        self.line_aspects[part as usize].clone()
+    }
+    /// The shading aspect of a part; `datum.shading_aspect(Prs3dDatumParts::Origin)`.
+    pub fn shading_aspect(&self, part: Prs3dDatumParts) -> Handle<Prs3dShadingAspect> {
+        self.shaded_aspects[part as usize].clone()
+    }
+    /// The text aspect of an axis (null for other parts); `datum.text_aspect(Prs3dDatumParts::YAxis)`.
+    pub fn text_aspect(&self, part: Prs3dDatumParts) -> Handle<Prs3dTextAspect> {
+        self.state.read().text_aspects[part as usize].clone()
+    }
+    /// Sets one text aspect for the three axes; `datum.set_text_aspect(text)`.
+    pub fn set_text_aspect(&self, aspect: Handle<Prs3dTextAspect>) {
+        let mut state = self.state.write();
+        for part in [
+            Prs3dDatumParts::XAxis,
+            Prs3dDatumParts::YAxis,
+            Prs3dDatumParts::ZAxis,
+        ] {
+            state.text_aspects[part as usize] = aspect.clone();
+        }
+    }
+    /// The deprecated `TextAspect()`: the X axis text aspect; `datum.text_aspect_x()`.
+    pub fn text_aspect_x(&self) -> Handle<Prs3dTextAspect> {
+        self.text_aspect(Prs3dDatumParts::XAxis)
+    }
+    /// The origin point aspect; `datum.point_aspect()`.
+    pub fn point_aspect(&self) -> Handle<Prs3dPointAspect> {
+        self.state.read().point_aspect.clone()
+    }
+    /// Sets the origin point aspect; `datum.set_point_aspect(point)`.
+    pub fn set_point_aspect(&self, aspect: Handle<Prs3dPointAspect>) {
+        self.state.write().point_aspect = aspect;
+    }
+    /// The arrow aspect; `datum.arrow_aspect()`.
+    pub fn arrow_aspect(&self) -> Handle<Prs3dArrowAspect> {
+        self.state.read().arrow_aspect.clone()
+    }
+    /// Sets the arrow aspect; `datum.set_arrow_aspect(arrow)`.
+    pub fn set_arrow_aspect(&self, aspect: Handle<Prs3dArrowAspect>) {
+        self.state.write().arrow_aspect = aspect;
+    }
+    /// Whether a part is drawn with the current axes and arrow flag; `datum.draw_datum_part(Prs3dDatumParts::XOYAxis)`.
+    pub fn draw_datum_part(&self, part: Prs3dDatumParts) -> bool {
+        let state = self.state.read();
+        datum_part_drawn(state.axes as i32, state.to_draw_arrows, part)
+    }
+    /// Sets the drawn axes; `datum.set_draw_datum_axes(Prs3dDatumAxes::XYAxes)`.
+    pub fn set_draw_datum_axes(&self, axes: Prs3dDatumAxes) {
+        self.state.write().axes = axes;
+    }
+    /// The drawn axes; `datum.datum_axes()`.
+    pub fn datum_axes(&self) -> Prs3dDatumAxes {
+        self.state.read().axes
+    }
+    /// An attribute value; `datum.attribute(Prs3dDatumAttribute::XAxisLength)`.
+    pub fn attribute(&self, kind: Prs3dDatumAttribute) -> f64 {
+        self.state.read().attributes[kind as usize]
+    }
+    /// Sets an attribute value; `datum.set_attribute(Prs3dDatumAttribute::ShadingNumberOfFacettes, 24.0)`.
+    pub fn set_attribute(&self, kind: Prs3dDatumAttribute, value: f64) {
+        self.state.write().attributes[kind as usize] = value;
+    }
+    /// The length of an axis part, 0 for the other parts; `datum.axis_length(Prs3dDatumParts::ZAxis)`.
+    pub fn axis_length(&self, part: Prs3dDatumParts) -> f64 {
+        let kind = match part {
+            Prs3dDatumParts::XAxis => Prs3dDatumAttribute::XAxisLength,
+            Prs3dDatumParts::YAxis => Prs3dDatumAttribute::YAxisLength,
+            Prs3dDatumParts::ZAxis => Prs3dDatumAttribute::ZAxisLength,
+            _ => return 0.0,
+        };
+        self.attribute(kind)
+    }
+    /// Sets the three axis lengths; `datum.set_axis_length(1.0, 2.0, 3.0)`.
+    pub fn set_axis_length(&self, l1: f64, l2: f64, l3: f64) {
+        let mut state = self.state.write();
+        state.attributes[Prs3dDatumAttribute::XAxisLength as usize] = l1;
+        state.attributes[Prs3dDatumAttribute::YAxisLength as usize] = l2;
+        state.attributes[Prs3dDatumAttribute::ZAxisLength as usize] = l3;
+    }
+    /// Whether labels are drawn; `datum.to_draw_labels()`.
+    pub fn to_draw_labels(&self) -> bool {
+        self.state.read().to_draw_labels
+    }
+    /// Sets whether labels are drawn; `datum.set_draw_labels(false)`.
+    pub fn set_draw_labels(&self, to_draw: bool) {
+        self.state.write().to_draw_labels = to_draw;
+    }
+    /// `SetToDrawLabels`, the same as `SetDrawLabels`; `datum.set_to_draw_labels(false)`.
+    pub fn set_to_draw_labels(&self, to_draw: bool) {
+        self.set_draw_labels(to_draw);
+    }
+    /// Whether arrows are drawn; `datum.to_draw_arrows()`.
+    pub fn to_draw_arrows(&self) -> bool {
+        self.state.read().to_draw_arrows
+    }
+    /// Sets whether arrows are drawn; `datum.set_draw_arrows(false)`.
+    pub fn set_draw_arrows(&self, to_draw: bool) {
+        self.state.write().to_draw_arrows = to_draw;
+    }
+    /// `ArrowPartForAxis`: the arrow part of an axis or arrow part, else `None`.
+    /// Example: `Prs3dDatumAspect::arrow_part_for_axis(Prs3dDatumParts::YAxis) == Prs3dDatumParts::YArrow`.
+    pub fn arrow_part_for_axis(part: Prs3dDatumParts) -> Prs3dDatumParts {
+        match part {
+            Prs3dDatumParts::XArrow | Prs3dDatumParts::XAxis => Prs3dDatumParts::XArrow,
+            Prs3dDatumParts::YArrow | Prs3dDatumParts::YAxis => Prs3dDatumParts::YArrow,
+            Prs3dDatumParts::ZArrow | Prs3dDatumParts::ZAxis => Prs3dDatumParts::ZArrow,
+            _ => Prs3dDatumParts::None,
+        }
+    }
+    /// `CopyAspectsFrom`: the flags and the Graphic3d aspects of every sub-aspect.
+    /// Example: `datum.copy_aspects_from(&other)`.
+    pub fn copy_aspects_from(&self, other: &Prs3dDatumAspect) {
+        let source = other.state.read().clone();
+        let target = {
+            let mut state = self.state.write();
+            state.to_draw_arrows = source.to_draw_arrows;
+            state.to_draw_labels = source.to_draw_labels;
+            state.clone()
+        };
+        prs3d_copy_aspects(
+            &*target.point_aspect.aspect(),
+            &*source.point_aspect.aspect(),
+        );
+        prs3d_copy_aspects(
+            &*target.arrow_aspect.aspect(),
+            &*source.arrow_aspect.aspect(),
+        );
+        for part in [
+            Prs3dDatumParts::XAxis,
+            Prs3dDatumParts::YAxis,
+            Prs3dDatumParts::ZAxis,
+        ] {
+            let index = part as usize;
+            prs3d_copy_aspects(
+                &*target.text_aspects[index].aspect(),
+                &*source.text_aspects[index].aspect(),
+            );
+        }
+        for part in Prs3dDatumParts::DRAWN {
+            self.copy_part_aspects(other, part as usize);
+        }
+    }
+    fn copy_part_aspects(&self, other: &Prs3dDatumAspect, index: usize) {
+        if let (Some(line), Some(source)) = (
+            self.line_aspects[index].get(),
+            other.line_aspects[index].get(),
+        ) {
+            prs3d_copy_aspects(&*line.aspect(), &*source.aspect());
+        }
+        if let (Some(shading), Some(source)) = (
+            self.shaded_aspects[index].get(),
+            other.shaded_aspects[index].get(),
+        ) {
+            prs3d_copy_aspects(&*shading.aspect(), &*source.aspect());
+        }
+    }
+}
+
+/// `DrawDatumPart` over the axes mask and the arrow flag.
+fn datum_part_drawn(axes: i32, to_draw_arrows: bool, part: Prs3dDatumParts) -> bool {
+    let has = |mask: Prs3dDatumAxes| axes & mask as i32 != 0;
+    match part {
+        Prs3dDatumParts::Origin => true,
+        Prs3dDatumParts::XAxis => has(Prs3dDatumAxes::XAxis),
+        Prs3dDatumParts::XArrow => has(Prs3dDatumAxes::XAxis) && to_draw_arrows,
+        Prs3dDatumParts::YAxis => has(Prs3dDatumAxes::YAxis),
+        Prs3dDatumParts::YArrow => has(Prs3dDatumAxes::YAxis) && to_draw_arrows,
+        Prs3dDatumParts::ZAxis => has(Prs3dDatumAxes::ZAxis),
+        Prs3dDatumParts::ZArrow => has(Prs3dDatumAxes::ZAxis) && to_draw_arrows,
+        Prs3dDatumParts::XOYAxis => has(Prs3dDatumAxes::XAxis) && has(Prs3dDatumAxes::YAxis),
+        Prs3dDatumParts::YOZAxis => has(Prs3dDatumAxes::YAxis) && has(Prs3dDatumAxes::ZAxis),
+        Prs3dDatumParts::XOZAxis => has(Prs3dDatumAxes::XAxis) && has(Prs3dDatumAxes::ZAxis),
+        Prs3dDatumParts::None => false,
+    }
+}
+
+impl Prs3dBasicAspect for Prs3dDatumAspect {
+    fn dump_json(&self, stream: &mut DumpStream, depth: i32) -> io::Result<()> {
+        class_begin(stream, "Prs3d_DatumAspect")?;
+        let state = self.state.read().clone();
+        dump_aspect_field(stream, depth, "myPointAspect.get()", &state.point_aspect)?;
+        dump_aspect_field(stream, depth, "myArrowAspect.get()", &state.arrow_aspect)?;
+        for aspect in &self.shaded_aspects {
+            dump_aspect_field(stream, depth, "aShadingAspect.get()", aspect)?;
+        }
+        for aspect in &self.line_aspects {
+            dump_aspect_field(stream, depth, "aLineAspect.get()", aspect)?;
+        }
+        for aspect in &state.text_aspects[1..=3] {
+            dump_aspect_field(stream, depth, "aTextAspect.get()", aspect)?;
+        }
+        field_integer(stream, "myAxes", state.axes as i32)?;
+        field_integer(stream, "myToDrawLabels", i32::from(state.to_draw_labels))?;
+        field_integer(stream, "myToDrawArrows", i32::from(state.to_draw_arrows))
+    }
+}
