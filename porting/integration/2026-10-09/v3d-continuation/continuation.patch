index 000000000..8fca6aa41
--- /dev/null
+++ b/crates/tkv3d/src/prs_mgr/presentable_style.rs
@@ -0,0 +1,225 @@
+//! The native bodies of the `PrsMgr_PresentableObject` virtual members for the bounding box,
+//! the material, the transparency, the polygon offsets and `UnsetAttributes`.
+use super::{PrsMgrPresentableObject, PrsMgrPresentation};
+use crate::prs3d::{Prs3dDrawer, Prs3dShadingAspect};
+use rustycad_tkernel::standard::{Failure, Handle};
+use rustycad_tkmath::bnd::BoundingBox3;
+use rustycad_tkservice::aspect::AspectTypeOfFacingModel;
+use rustycad_tkservice::graphic3d::{
+    Graphic3dAspectsMembers as _, Graphic3dAspectsRenderMembers as _, Graphic3dMaterialAspect,
+    Graphic3dNameOfMaterial, Graphic3dPresentationAttributesMembers as _,
+    Graphic3dPresentationAttributesSource as _, Graphic3dStructureMembers as _,
+};
+
+/// Copies the driver box of a presentation into `bounds`, or makes `bounds` void when the
+/// driver box is invalid.
+fn presentation_box(prs: &Handle<PrsMgrPresentation>, bounds: &mut BoundingBox3) {
+    let Some(cstructure) = prs.get().map(|p| p.cstructure()).filter(|c| !c.is_null()) else {
+        return;
+    };
+    let bvh = cstructure.cstructure_base().fields.read().bnd_box;
+    if !bvh.is_valid() {
+        bounds.set_void();
+        return;
+    }
+    let (min, max) = (bvh.corner_min(), bvh.corner_max());
+    bounds.update_bounds([min.x, min.y, min.z], [max.x, max.y, max.z]);
+}
+
+/// `PrsMgr_PresentableObject::BoundingBox`; `prs_mgr_bounding_box(&*object, &mut bounds)`.
+pub fn prs_mgr_bounding_box<O: PrsMgrPresentableObject + ?Sized>(
+    object: &O,
+    bounds: &mut BoundingBox3,
+) {
+    let fields = object.presentable_base().read();
+    let mode = fields.drawer.display_mode();
+    if mode != -1 {
+        if let Some(prs) = fields
+            .presentations
+            .iter()
+            .find(|p| p.get().is_some_and(|v| v.mode() == mode))
+        {
+            presentation_box(prs, bounds);
+        }
+        return;
+    }
+    if let Some(first) = fields.presentations.first() {
+        presentation_box(first, bounds);
+        return;
+    }
+    for child in fields.children.iter().filter_map(Handle::get) {
+        let mut child_box = BoundingBox3::default();
+        child.bounding_box(&mut child_box);
+        bounds.add_box(&child_box);
+    }
+}
+
+/// The shading aspect of the drawer (own or linked).
+fn shading_of(drawer: &Handle<Prs3dDrawer>) -> Handle<Prs3dShadingAspect> {
+    drawer
+        .get()
+        .map(Prs3dDrawer::shading_aspect)
+        .unwrap_or_default()
+}
+
+/// `PrsMgr_PresentableObject::Material`: the name of the front material; a drawer without
+/// shading aspect gives the default material name. Example: `prs_mgr_material(&*object)`.
+pub fn prs_mgr_material<O: PrsMgrPresentableObject + ?Sized>(
+    object: &O,
+) -> Graphic3dNameOfMaterial {
+    let shading = shading_of(&object.presentable_base().read().drawer);
+    let material = shading
+        .get()
+        .map(|s| s.material(AspectTypeOfFacingModel::FrontSide))
+        .unwrap_or_default();
+    material.name()
+}
+
+/// `PrsMgr_PresentableObject::SetMaterial`; `prs_mgr_set_material(&*object, &material)?`.
+pub fn prs_mgr_set_material<O: PrsMgrPresentableObject + ?Sized>(
+    object: &O,
+    material: &Graphic3dMaterialAspect,
+) -> Result<(), Failure> {
+    let drawer = object.presentable_base().read().drawer;
+    drawer.setup_own_shading_aspect(&Handle::default())?;
+    if let Some(shading) = shading_of(&drawer).get() {
+        shading.set_material(material, AspectTypeOfFacingModel::BothSide);
+    }
+    object.presentable_base().fields.write().has_own_material = true;
+    Ok(())
+}
+
+/// The own color and transparency flags of an object.
+fn color_and_transparency<O: PrsMgrPresentableObject + ?Sized>(object: &O) -> (bool, bool) {
+    let fields = object.presentable_base().read();
+    (fields.has_own_color, fields.drawer.transparency() > 0.005)
+}
+
+/// `PrsMgr_PresentableObject::UnsetMaterial`: restores the link material and re-applies the
+/// own color and transparency, or forgets the own shading aspect.
+/// Example: `prs_mgr_unset_material(&*object)?`.
+pub fn prs_mgr_unset_material<O: PrsMgrPresentableObject + ?Sized>(
+    object: &O,
+) -> Result<(), Failure> {
+    let fields = object.presentable_base().read();
+    if !fields.has_own_material {
+        return Ok(());
+    }
+    let (has_color, is_transparent) = color_and_transparency(object);
+    let drawer = fields.drawer;
+    if !(has_color || is_transparent) {
+        drawer.set_shading_aspect(Handle::default());
+        object.presentable_base().fields.write().has_own_material = false;
+        return Ok(());
+    }
+    let link_shading = shading_of(&drawer.link());
+    if let (Some(own), Some(link)) = (
+        shading_of(&drawer).get(),
+        link_shading.get().filter(|_| drawer.has_link()),
+    ) {
+        own.set_material(
+            &link.aspect().back_material(),
+            AspectTypeOfFacingModel::BothSide,
+        );
+    }
+    if has_color {
+        object.set_color(drawer.color());
+    }
+    // The native code asks IsTransparent() again after the (virtual) SetColor.
+    if color_and_transparency(object).1 {
+        object.set_transparency(f64::from(drawer.transparency()))?;
+    }
+    object.presentable_base().fields.write().has_own_material = false;
+    Ok(())
+}
+
+/// Sets the transparency of both materials of the drawer shading aspect.
+fn set_materials_transparency(drawer: &Handle<Prs3dDrawer>, value: f32) -> Result<(), Failure> {
+    let Some(shading) = shading_of(drawer).get().map(Prs3dShadingAspect::aspect) else {
+        return Ok(());
+    };
+    shading.change_front_material(|m| m.set_transparency(value))?;
+    shading.change_back_material(|m| m.set_transparency(value))
+}
+
+/// `PrsMgr_PresentableObject::SetTransparency`; a value outside [0, 1] raises the
+/// `Standard_OutOfRange` of the material. Example: `prs_mgr_set_transparency(&*object, 0.6)?`.
+pub fn prs_mgr_set_transparency<O: PrsMgrPresentableObject + ?Sized>(
+    object: &O,
+    value: f64,
+) -> Result<(), Failure> {
+    let drawer = object.presentable_base().read().drawer;
+    drawer.setup_own_shading_aspect(&Handle::default())?;
+    set_materials_transparency(&drawer, value as f32)?;
+    drawer.set_transparency(value as f32);
+    Ok(())
+}
+
+/// `PrsMgr_PresentableObject::UnsetTransparency`; `prs_mgr_unset_transparency(&*object)?`.
+pub fn prs_mgr_unset_transparency<O: PrsMgrPresentableObject + ?Sized>(
+    object: &O,
+) -> Result<(), Failure> {
+    let fields = object.presentable_base().read();
+    if fields.has_own_color || fields.has_own_material {
+        set_materials_transparency(&fields.drawer, 0.0)?;
+    } else {
+        fields.drawer.set_shading_aspect(Handle::default());
+    }
+    fields.drawer.set_transparency(0.0);
+    Ok(())
+}
+
+/// `PrsMgr_PresentableObject::HasPolygonOffsets`: false with an own shading aspect or the
+/// link's one. Example: `prs_mgr_has_polygon_offsets(&*object)`.
+pub fn prs_mgr_has_polygon_offsets<O: PrsMgrPresentableObject + ?Sized>(object: &O) -> bool {
+    let drawer = object.presentable_base().read().drawer;
+    let shares_link = drawer.has_link() && shading_of(&drawer) == shading_of(&drawer.link());
+    !(drawer.has_own_shading_aspect() || shares_link)
+}
+
+/// `PrsMgr_PresentableObject::PolygonOffsets`; `prs_mgr_polygon_offsets(&*object)`.
+pub fn prs_mgr_polygon_offsets<O: PrsMgrPresentableObject + ?Sized>(
+    object: &O,
+) -> Option<(i32, f32, f32)> {
+    if !object.has_polygon_offsets() {
+        return None;
+    }
+    let drawer = object.presentable_base().read().drawer;
+    shading_of(&drawer)
+        .get()
+        .map(|s| s.aspect().polygon_offsets())
+}
+
+/// `PrsMgr_PresentableObject::SetPolygonOffsets`; `prs_mgr_set_polygon_offsets(&*object, 1, 1.0, 0.0)?`.
+pub fn prs_mgr_set_polygon_offsets<O: PrsMgrPresentableObject + ?Sized>(
+    object: &O,
+    mode: i32,
+    factor: f32,
+    units: f32,
+) -> Result<(), Failure> {
+    let drawer = object.presentable_base().read().drawer;
+    drawer.setup_own_shading_aspect(&Handle::default())?;
+    if let Some(shading) = shading_of(&drawer).get() {
+        shading.aspect().set_polygon_offsets(mode, factor, units);
+    }
+    super::PrsMgrPresentableObjectMembers::synchronize_aspects(object);
+    Ok(())
+}
+
+/// `PrsMgr_PresentableObject::UnsetAttributes`: a new drawer keeping the link, no own color,
+/// material or width, no transparency. Example: `prs_mgr_unset_attributes(&*object)`.
+pub fn prs_mgr_unset_attributes<O: PrsMgrPresentableObject + ?Sized>(object: &O) {
+    let old = object.presentable_base().read().drawer;
+    let drawer = Prs3dDrawer::new();
+    if old.has_link() {
+        drawer.set_link(&old.link());
+    }
+    drawer.set_transparency(0.0);
+    let mut fields = object.presentable_base().fields.write();
+    fields.drawer = Handle::new(drawer);
+    (
+        fields.has_own_color,
+        fields.has_own_material,
+        fields.own_width,
+    ) = (false, false, 0.0);
+}
diff --git a/crates/tkv3d/src/prs_mgr/presentable_updates.rs b/crates/tkv3d/src/prs_mgr/presentable_updates.rs
new file mode 100644
index 000000000..ce9508252
--- /dev/null
+++ b/crates/tkv3d/src/prs_mgr/presentable_updates.rs
@@ -0,0 +1,102 @@
+//! The update members of `PrsMgr_PresentableObject` that go through the presentation manager:
+//! `UpdatePresentations`, the deprecated `Update` and `ToBeUpdated(list)`, `recomputeComputed`
+//! and `replaceAspects`.
+use super::{PrsMgrPresentableObject, PrsMgrPresentableObjectMembers, PrsMgrPresentation};
+use rustycad_tkernel::standard::{Failure, Handle};
+use rustycad_tkservice::graphic3d::{
+    Graphic3dAspectsReplaceMap, Graphic3dStructureMembers as _, Graphic3dStructureSource as _,
+};
+
+/// The update members of a presentable object.
+pub trait PrsMgrPresentableObjectUpdates: PrsMgrPresentableObjectMembers {
+    /// `UpdatePresentations`: recomputes the presentations to update that are displayed or
+    /// highlighted (or all of them when asked); true when one was recomputed.
+    /// Example: `object.update_presentations(false)?`.
+    fn update_presentations(&self, to_include_hidden: bool) -> Result<bool, Failure> {
+        let this = self.presentable_base().this();
+        let mut has_updates = false;
+        for prs in self.presentations().iter().filter_map(Handle::get) {
+            if !prs.must_be_updated() || !(to_include_hidden || prs.is_shown_by_manager(&this)) {
+                continue;
+            }
+            has_updates = true;
+            prs.presentation_manager().update(&this, prs.mode())?;
+        }
+        Ok(has_updates)
+    }
+    /// `Update(toIncludeHidden)` (deprecated): `SetToUpdate()` then `UpdatePresentations`.
+    /// Example: `object.update_all(false)?`.
+    fn update_all(&self, to_include_hidden: bool) -> Result<(), Failure> {
+        self.set_to_update_all();
+        self.update_presentations(to_include_hidden).map(|_| ())
+    }
+    /// `Update(mode, toClearOther)` (deprecated): recomputes a shown presentation of the mode
+    /// (or flags it), and forgets the other presentations when asked.
+    /// Example: `object.update_mode(0, false)?`.
+    fn update_mode(&self, mode: i32, to_clear_other: bool) -> Result<(), Failure> {
+        let this = self.presentable_base().this();
+        let mut kept: Vec<Handle<PrsMgrPresentation>> = Vec::new();
+        for handle in self.presentations() {
+            let Some(prs) = handle.get() else {
+                kept.push(handle.clone());
+                continue;
+            };
+            if prs.mode() == mode {
+                update_one(self, &this, prs, mode)?;
+            } else if to_clear_other {
+                // The native removal destroys the last reference, whose destructor erases.
+                prs.erase();
+                continue;
+            }
+            kept.push(handle.clone());
+        }
+        self.presentable_base().fields.write().presentations = kept;
+        Ok(())
+    }
+    /// `ToBeUpdated(list)` (deprecated): the distinct modes of the presentations to update.
+    /// Example: `object.to_be_updated_modes()`.
+    fn to_be_updated_modes(&self) -> Vec<i32> {
+        let mut modes = Vec::new();
+        for prs in self.presentations().iter().filter_map(Handle::get) {
+            if prs.must_be_updated() && !modes.contains(&prs.mode()) {
+                modes.push(prs.mode());
+            }
+        }
+        modes
+    }
+    /// `recomputeComputed`: recomputes the computed structures of every presentation.
+    /// Example: `object.recompute_computed()`.
+    fn recompute_computed(&self) {
+        self.presentations()
+            .iter()
+            .filter_map(Handle::get)
+            .for_each(|p| p.re_compute());
+    }
+    /// `replaceAspects`: replaces aspects in the groups of every presentation; nothing for an
+    /// empty map. Example: `object.replace_aspects(&map)`.
+    fn replace_aspects(&self, map: &Graphic3dAspectsReplaceMap) {
+        if map.is_empty() {
+            return;
+        }
+        for group in self.all_groups() {
+            group.replace_aspects(map);
+        }
+    }
+}
+impl<T: PrsMgrPresentableObjectMembers + ?Sized> PrsMgrPresentableObjectUpdates for T {}
+
+/// One presentation of `Update(mode, ...)`: recomputed when shown, else flagged.
+fn update_one<O: PrsMgrPresentableObject + ?Sized>(
+    object: &O,
+    this: &Handle<dyn PrsMgrPresentableObject>,
+    prs: &PrsMgrPresentation,
+    mode: i32,
+) -> Result<(), Failure> {
+    if prs.is_shown_by_manager(this) {
+        prs.presentation_manager().update(this, mode)?;
+        prs.set_update_status(false);
+    } else {
+        object.set_to_update(prs.mode());
+    }
+    Ok(())
+}
diff --git a/crates/tkv3d/src/prs_mgr/presentation.rs b/crates/tkv3d/src/prs_mgr/presentation.rs
new file mode 100644
index 000000000..0362a5e6d
--- /dev/null
+++ b/crates/tkv3d/src/prs_mgr/presentation.rs
@@ -0,0 +1,291 @@
+//! `PrsMgr_Presentation`: the structure of one display mode of a presentable object, made by a
+//! presentation manager. It refers to its object weakly (a raw pointer natively).
+use super::{
+    PrsMgrPresentableObject, PrsMgrPresentableObjectMembers as _, PrsMgrPresentationManager,
+    PrsMgrTypeOfPresentation3d,
+};
+use crate::prs3d::Prs3dDrawer;
+use rustycad_tkernel::message::{Gravity, Message};
+use rustycad_tkernel::standard::dump::DumpStream;
+use rustycad_tkernel::standard::{Failure, Handle, SharedState, StandardTransient, WeakHandle};
+use rustycad_tkernel::tcollection::AsciiString;
+use rustycad_tkservice::graphic3d::{
+    Graphic3dCamera, Graphic3dStructure, Graphic3dStructureBase, Graphic3dStructureDisplay as _,
+    Graphic3dStructureMembers as _, Graphic3dStructureNetwork as _, Graphic3dStructureSource,
+    Graphic3dTypeOfConnection, Graphic3dTypeOfStructure, graphic3d_structure_bind,
+    graphic3d_structure_clear, graphic3d_structure_display, graphic3d_structure_dump_json,
+    graphic3d_structure_erase,
+};
+use rustycad_tkservice::json_dump::{base_class, class_begin, field_integer, field_pointer};
+use std::io;
+
+/// The native `BeforeHighlightState`: what `Unhighlight` restores.
+#[repr(i32)]
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum BeforeHighlightState {
+    Empty = 0,
+    Hidden = 1,
+    Visible = 2,
+}
+
+/// The mutable fields of a presentation.
+#[derive(Clone, Copy)]
+struct PresentationState {
+    before_highlight_state: BeforeHighlightState,
+    must_be_updated: bool,
+}
+
+/// The structure of one display mode of a presentable object.
+///
+/// Example: `let prs = manager.presentation(&object, 0, true, &Handle::default())?;`.
+pub struct PrsMgrPresentation {
+    transient: StandardTransient,
+    base: Graphic3dStructureBase,
+    presentation_manager: Handle<PrsMgrPresentationManager>,
+    presentable_object: SharedState<WeakHandle<dyn PrsMgrPresentableObject>>,
+    mode: i32,
+    state: SharedState<PresentationState>,
+}
+rustycad_tkernel::impl_transient!(PrsMgrPresentation, "PrsMgr_Presentation", dyn Graphic3dStructureSource, transient,
+    interfaces: [dyn Graphic3dStructureSource]);
+
+impl PrsMgrPresentation {
+    /// The presentation of `object` in `mode` (protected natively; the manager makes it): a
+    /// computed visual for a projector-dependent object, the object as owner and its mutable
+    /// flag. Example: `PrsMgrPresentation::new(&manager, &object, 0)?`.
+    pub fn new(
+        manager: &Handle<PrsMgrPresentationManager>,
+        object: &Handle<dyn PrsMgrPresentableObject>,
+        mode: i32,
+    ) -> Result<Handle<Self>, Failure> {
+        let structure_manager = manager
+            .get()
+            .map(PrsMgrPresentationManager::structure_manager)
+            .unwrap_or_default();
+        let prs = Handle::new(Self {
+            transient: StandardTransient::default(),
+            base: Graphic3dStructureBase::new(&structure_manager, &Handle::default())?,
+            presentation_manager: manager.clone(),
+            presentable_object: SharedState::new(object.downgrade()),
+            mode,
+            state: SharedState::new(PresentationState {
+                before_highlight_state: BeforeHighlightState::Empty,
+                must_be_updated: false,
+            }),
+        });
+        graphic3d_structure_bind(&prs.clone().cast());
+        if let Some(value) = object.get() {
+            if value.type_of_presentation3d() == PrsMgrTypeOfPresentation3d::ProjectorDependent {
+                prs.set_visual(Graphic3dTypeOfStructure::Computed);
+            }
+            prs.set_owner(&object.clone().cast());
+            prs.set_mutable(value.is_mutable());
+        }
+        Ok(prs)
+    }
+    /// `Presentation` (deprecated): the presentation itself; `prs.presentation()`.
+    pub fn presentation(&self) -> &Self {
+        self
+    }
+    /// `PresentationManager`; `prs.presentation_manager()`.
+    pub fn presentation_manager(&self) -> Handle<PrsMgrPresentationManager> {
+        self.presentation_manager.clone()
+    }
+    /// `SetUpdateStatus`; `prs.set_update_status(true)`.
+    pub fn set_update_status(&self, update_status: bool) {
+        self.state.write().must_be_updated = update_status;
+    }
+    /// `MustBeUpdated`; `prs.must_be_updated()`.
+    pub fn must_be_updated(&self) -> bool {
+        self.state.read().must_be_updated
+    }
+    /// `Mode`; `prs.mode()`.
+    pub fn mode(&self) -> i32 {
+        self.mode
+    }
+    /// The presentable object, null once it is gone; `prs.presentable_object()`.
+    pub fn presentable_object(&self) -> Handle<dyn PrsMgrPresentableObject> {
+        self.presentable_object.read().upgrade()
+    }
+    /// Forgets the object (its destructor clears `myPresentableObject`).
+    pub(crate) fn forget_presentable_object(&self) {
+        *self.presentable_object.write() = WeakHandle::default();
+    }
+    /// Whether the manager shows `object` in the mode of this presentation (displayed or
+    /// highlighted), the test of `ToBeUpdated` and `UpdatePresentations`.
+    pub(crate) fn is_shown_by_manager(&self, object: &Handle<dyn PrsMgrPresentableObject>) -> bool {
+        self.presentation_manager.get().is_some_and(|m| {
+            m.is_displayed(object, self.mode) || m.is_highlighted(object, self.mode)
+        })
+    }
+    /// The native `Graphic3d_Structure::IsDisplayed`: stuck in the scene graph.
+    fn is_stuck(&self) -> bool {
+        self.cstructure()
+            .get()
+            .is_some_and(|c| c.cstructure_base().fields.read().stick)
+    }
+    /// `display` (protected): displays a structure not yet stuck (as a highlight structure
+    /// when asked), or makes a hidden one visible. Example: `prs.display_for(false)`.
+    pub fn display_for(&self, is_highlight: bool) {
+        if !self.is_stuck() {
+            self.set_is_for_highlight(is_highlight);
+            graphic3d_structure_display(self);
+        } else if !self.is_visible() {
+            self.set_visible(true);
+        }
+    }
+    /// The display state before a highlight.
+    fn current_state(&self) -> BeforeHighlightState {
+        if !self.is_stuck() {
+            BeforeHighlightState::Empty
+        } else if !self.is_visible() {
+            BeforeHighlightState::Hidden
+        } else {
+            BeforeHighlightState::Visible
+        }
+    }
+    /// `Highlight`: remembers the display state, displays and highlights with the style.
+    /// Example: `prs.highlight_with(&style)`.
+    pub fn highlight_with(&self, style: &Handle<Prs3dDrawer>) {
+        if !self.is_highlighted() {
+            self.state.write().before_highlight_state = self.current_state();
+        }
+        self.display_for(true);
+        rustycad_tkservice::graphic3d::Graphic3dStructureDisplay::highlight(
+            self,
+            &style.clone().cast(),
+            true,
+        );
+    }
+    /// `Unhighlight`: unhighlights and restores the display state before the highlight.
+    /// Example: `prs.unhighlight_restore()`.
+    pub fn unhighlight_restore(&self) {
+        rustycad_tkservice::graphic3d::Graphic3dStructureDisplay::unhighlight(self);
+        let before = self.state.read().before_highlight_state;
+        match before {
+            BeforeHighlightState::Visible => {}
+            BeforeHighlightState::Hidden => self.set_visible(false),
+            BeforeHighlightState::Empty => graphic3d_structure_erase(self),
+        }
+    }
+    /// The display mode `Compute` passes: this presentation's mode when the object lists it, else 0.
+    fn listed_mode(&self, object: &dyn PrsMgrPresentableObject) -> i32 {
+        let listed = object.presentations();
+        let this = self.structure_base().this();
+        listed
+            .iter()
+            .find(|p| p.object_address() == this.object_address())
+            .map_or(0, |_| self.mode)
+    }
+}
+
+/// Reports a failure of a virtual member whose native signature returns nothing.
+fn report_failure(member: &str, failure: &Failure) {
+    let text = format!(
+        "PrsMgr_Presentation::{member}: {} {}",
+        failure.exception_type(),
+        failure.message()
+    );
+    Message::send_text(&AsciiString::from(text.as_str()), Gravity::Fail);
+}
+
+impl Graphic3dStructureSource for PrsMgrPresentation {
+    fn structure_base(&self) -> &Graphic3dStructureBase {
+        &self.base
+    }
+    /// `Display`: displays the presentation, remembered as visible.
+    fn display(&self) {
+        self.display_for(false);
+        self.state.write().before_highlight_state = BeforeHighlightState::Visible;
+    }
+    /// `Erase`: erases, clears, disconnects and removes the structure.
+    fn erase(&self) {
+        if self.is_deleted() {
+            return;
+        }
+        graphic3d_structure_erase(self);
+        graphic3d_structure_clear(self, true);
+        self.disconnect_all(Graphic3dTypeOfConnection::Descendant);
+        self.remove();
+    }
+    /// `Clear`: flags the update, clears the groups and disconnects the descendants.
+    fn clear(&self, with_destruction: bool) {
+        self.set_update_status(true);
+        if self.is_deleted() {
+            return;
+        }
+        graphic3d_structure_clear(self, with_destruction);
+        self.disconnect_all(Graphic3dTypeOfConnection::Descendant);
+    }
+    /// `IsDisplayed`: stuck in the scene graph and visible.
+    fn is_displayed(&self) -> bool {
+        self.is_stuck() && self.is_visible()
+    }
+    /// `Compute`: the object computes this presentation; a failure is reported as a fail message.
+    fn compute(&self) {
+        let object = self.presentable_object();
+        let Some(value) = object.get() else {
+            return;
+        };
+        let this: Handle<dyn Graphic3dStructureSource> = self.structure_base().this();
+        if let Err(failure) =
+            value.compute(&self.presentation_manager, &this, self.listed_mode(value))
+        {
+            report_failure("Compute", &failure);
+        }
+    }
+    /// `computeHLR`: a new structure when none is given, cleared, then the object's hidden
+    /// line computation; a failure is reported as a fail message.
+    fn compute_hlr(
+        &self,
+        projector: &Handle<Graphic3dCamera>,
+        structure: &mut Handle<dyn Graphic3dStructureSource>,
+    ) {
+        if structure.is_null() {
+            let manager = self
+                .presentation_manager
+                .get()
+                .map(PrsMgrPresentationManager::structure_manager)
+                .unwrap_or_default();
+            match Graphic3dStructure::new(&manager, &Handle::default()) {
+                Ok(created) => *structure = created.cast(),
+                Err(failure) => return report_failure("computeHLR", &failure),
+            }
+        }
+        if let Some(target) = structure.get() {
+            target.clear(true);
+        }
+        let object = self.presentable_object();
+        let Some(value) = object.get() else {
+            return;
+        };
+        if let Err(failure) = value.compute_hlr(projector, &self.transformation(), structure) {
+            report_failure("computeHLR", &failure);
+        }
+    }
+    /// `RecomputeTransformation`: the object's; `prs.recompute_transformation(&camera)`.
+    fn recompute_transformation(&self, projector: &Handle<Graphic3dCamera>) {
+        if let Some(value) = self.presentable_object().get() {
+            value.recompute_transformation(projector);
+        }
+    }
+    fn dump_json(&self, stream: &mut DumpStream, depth: i32) -> io::Result<()> {
+        class_begin(stream, "PrsMgr_Presentation")?;
+        base_class(stream, depth, &|s, d| {
+            graphic3d_structure_dump_json(self, s, d)
+        })?;
+        field_pointer(
+            stream,
+            "myPresentableObject",
+            self.presentable_object().object_address() as usize,
+        )?;
+        let state = *self.state.read();
+        field_integer(
+            stream,
+            "myBeforeHighlightState",
+            state.before_highlight_state as i32,
+        )?;
+        field_integer(stream, "myMode", self.mode)?;
+        field_integer(stream, "myMustBeUpdated", i32::from(state.must_be_updated))
+    }
+}
diff --git a/crates/tkv3d/src/prs_mgr/presentation_immediate.rs b/crates/tkv3d/src/prs_mgr/presentation_immediate.rs
new file mode 100644
index 000000000..155bd9536
--- /dev/null
+++ b/crates/tkv3d/src/prs_mgr/presentation_immediate.rs
@@ -0,0 +1,288 @@
+//! The immediate mode members of `PrsMgr_PresentationManager`: the immediate lists, the
+//! highlight `Color` and the transformation of the highlight shadows.
+use super::{
+    PrsMgrDisplayStatus, PrsMgrPresentableObject, PrsMgrPresentableObjectMembers as _,
+    PrsMgrPresentationManager,
+};
+use crate::prs3d::{Prs3dDrawer, Prs3dPresentationShadow};
+use crate::v3d::{V3dView, V3dViewer};
+use rustycad_tkernel::standard::{Failure, Handle};
+use rustycad_tkmath::toploc::Datum3;
+use rustycad_tkservice::graphic3d::{
+    Graphic3dCStructureMembers as _, Graphic3dCView, Graphic3dCViewMembers as _,
+    Graphic3dCViewStructures as _, Graphic3dStructureDisplay as _, Graphic3dStructureMembers as _,
+    Graphic3dStructureSource, Graphic3dViewAffinity, Graphic3dZLayerId,
+};
+
+/// The driver views of the active views of a viewer.
+fn active_cviews(viewer: &Handle<V3dViewer>) -> Vec<Handle<dyn Graphic3dCView>> {
+    let views = viewer
+        .get()
+        .map(V3dViewer::active_views)
+        .unwrap_or_default();
+    views
+        .iter()
+        .filter_map(Handle::get)
+        .map(V3dView::view)
+        .collect()
+}
+
+/// A highlighted shadow of `parent` in `layer` with the parent's clipping planes (`Color`
+/// and `displayImmediate`).
+fn highlight_shadow(
+    manager: &Handle<rustycad_tkservice::graphic3d::Graphic3dStructureManager>,
+    parent: &Handle<dyn Graphic3dStructureSource>,
+    layer: Graphic3dZLayerId,
+    style: &Handle<dyn rustycad_tkservice::graphic3d::Graphic3dPresentationAttributesSource>,
+) -> Result<Handle<Prs3dPresentationShadow>, Failure> {
+    let shadow = Prs3dPresentationShadow::new(manager, parent)?;
+    shadow.set_z_layer(layer);
+    shadow.set_clip_planes(&parent.get().map(|p| p.clip_planes()).unwrap_or_default());
+    shadow.set_is_for_highlight(true);
+    shadow.highlight(style, true);
+    Ok(shadow)
+}
+
+/// Shows a shadow in one view only, as visible there as its parent (`displayImmediate`).
+fn show_in_view(shadow: &Prs3dPresentationShadow, view: &dyn Graphic3dCView) {
+    if !shadow.is_displayed() {
+        let affinity = Graphic3dViewAffinity::default();
+        affinity.set_visible(false);
+        if let Some(cstructure) = shadow.cstructure().get() {
+            cstructure.cstructure_base().fields.write().view_affinity = Handle::new(affinity);
+        }
+        shadow.display();
+    }
+    let view_id = view.identification();
+    let parent = shadow.parent_affinity();
+    let is_parent_visible = parent.get().is_none_or(|a| a.is_visible(view_id));
+    let affinity = shadow
+        .cstructure()
+        .get()
+        .map(|c| c.cstructure_base().fields.read().view_affinity.clone());
+    if let Some(affinity) = affinity.as_ref().and_then(Handle::get) {
+        affinity.set_view_visible(view_id, is_parent_visible);
+    }
+}
+
+/// Sets the transformation of the shadows of the parent structure `ref_id`.
+fn update_prs_transformation(
+    list: &[Handle<dyn Graphic3dStructureSource>],
+    ref_id: i32,
+    trsf: &Handle<Datum3>,
+) {
+    for prs in list {
+        let shadow: Handle<Prs3dPresentationShadow> = Handle::down_cast(prs);
+        let Some(shadow) = shadow.get().filter(|s| s.parent_id() == ref_id) else {
+            continue;
+        };
+        if let Some(cstructure) = shadow.cstructure().get() {
+            cstructure.set_transformation(trsf);
+        }
+    }
+}
+
+impl PrsMgrPresentationManager {
+    /// `IsImmediateModeOn`; `manager.is_immediate_mode_on()`.
+    pub fn is_immediate_mode_on(&self) -> bool {
+        self.immediate.read().mode_on > 0
+    }
+    /// `BeginImmediateDraw`: enters the immediate mode (nested), clearing the lists on entry.
+    /// Example: `manager.begin_immediate_draw()`.
+    pub fn begin_immediate_draw(&self) {
+        let level = {
+            let mut state = self.immediate.write();
+            state.mode_on += 1;
+            state.mode_on
+        };
+        if level <= 1 {
+            self.clear_immediate_draw();
+        }
+    }
+    /// `ClearImmediateDraw`: erases and forgets the immediate structures; `manager.clear_immediate_draw()`.
+    pub fn clear_immediate_draw(&self) {
+        let state = {
+            let mut own = self.immediate.write();
+            let copy = own.clone();
+            own.list.clear();
+            own.view_dependent_list.clear();
+            copy
+        };
+        state
+            .list
+            .iter()
+            .chain(&state.view_dependent_list)
+            .filter_map(Handle::get)
+            .for_each(|p| p.erase());
+    }
+    /// `AddToImmediateList`: queues a structure once, in immediate mode only.
+    /// Example: `manager.add_to_immediate_list(&prs)`.
+    pub fn add_to_immediate_list(&self, prs: &Handle<dyn Graphic3dStructureSource>) {
+        let mut state = self.immediate.write();
+        if state.mode_on < 1 || state.list.iter().any(|p| p == prs) {
+            return;
+        }
+        state.list.push(prs.clone());
+    }
+    /// `EndImmediateDraw`: leaves the immediate mode, displaying the queue in the active views
+    /// of the viewer when the outermost level ends. Example: `manager.end_immediate_draw(&viewer)?`.
+    pub fn end_immediate_draw(&self, viewer: &Handle<V3dViewer>) -> Result<(), Failure> {
+        let level = {
+            let mut state = self.immediate.write();
+            state.mode_on -= 1;
+            state.mode_on
+        };
+        if level > 0 {
+            return Ok(());
+        }
+        self.display_immediate(viewer)
+    }
+    /// `RedrawImmediate`: erases and displays the queue again; `manager.redraw_immediate(&viewer)?`.
+    pub fn redraw_immediate(&self, viewer: &Handle<V3dViewer>) -> Result<(), Failure> {
+        let state = self.immediate.read().clone();
+        if state.list.is_empty() {
+            return Ok(());
+        }
+        state
+            .list
+            .iter()
+            .chain(&state.view_dependent_list)
+            .filter_map(Handle::get)
+            .for_each(|p| p.erase());
+        self.immediate.write().view_dependent_list.clear();
+        self.display_immediate(viewer)
+    }
+    /// `displayImmediate` (private): a plain structure is displayed; a highlight shadow is
+    /// shown per view, replaced by a shadow of the view's computed structure when the view
+    /// computes its parent.
+    fn display_immediate(&self, viewer: &Handle<V3dViewer>) -> Result<(), Failure> {
+        for cview in active_cviews(viewer) {
+            let Some(view) = cview.get() else { continue };
+            let list = self.immediate.read().list.clone();
+            for prs in list.iter().filter(|p| !p.is_null()) {
+                self.display_immediate_in(view, prs)?;
+            }
+        }
+        Ok(())
+    }
+    /// One structure of `displayImmediate` in one view.
+    fn display_immediate_in(
+        &self,
+        view: &dyn Graphic3dCView,
+        prs: &Handle<dyn Graphic3dStructureSource>,
+    ) -> Result<(), Failure> {
+        let mut shadow: Handle<Prs3dPresentationShadow> = Handle::down_cast(prs);
+        let Some(current) = shadow.get() else {
+            if let Some(value) = prs.get() {
+                value.display();
+            }
+            return Ok(());
+        };
+        let computed = view.is_computed(current.parent_id());
+        if !computed.is_null() {
+            let style = prs.get().map(|p| p.highlight_style()).unwrap_or_default();
+            shadow = highlight_shadow(
+                &self.structure_manager(),
+                &computed,
+                current.get_z_layer(),
+                &style,
+            )?;
+            self.immediate
+                .write()
+                .view_dependent_list
+                .push(shadow.clone().cast());
+        }
+        if let Some(value) = shadow.get() {
+            show_in_view(value, view);
+        }
+        Ok(())
+    }
+    /// `Color`: highlights the presentation of the mode with a style (non-erased children
+    /// first), in immediate mode as a highlight shadow in `immediate_layer_id`.
+    /// Example: `manager.color(&object, &style, 0, &Handle::default(), GRAPHIC3D_ZLAYER_ID_TOPMOST)?`.
+    pub fn color(
+        &self,
+        object: &Handle<dyn PrsMgrPresentableObject>,
+        style: &Handle<Prs3dDrawer>,
+        mode: i32,
+        sel_obj: &Handle<dyn PrsMgrPresentableObject>,
+        immediate_layer_id: Graphic3dZLayerId,
+    ) -> Result<(), Failure> {
+        let Some(value) = object.get() else {
+            return Ok(());
+        };
+        if value.to_propagate_visual_state() {
+            for child in value.children() {
+                if child
+                    .get()
+                    .is_some_and(|c| c.display_status() != PrsMgrDisplayStatus::Erased)
+                {
+                    self.color(&child, style, mode, &Handle::default(), immediate_layer_id)?;
+                }
+            }
+        }
+        if !value.has_own_presentations() {
+            return Ok(());
+        }
+        let prs = self.presentation(object, mode, true, sel_obj)?;
+        if prs
+            .get()
+            .is_some_and(super::PrsMgrPresentation::must_be_updated)
+        {
+            self.update(object, mode)?;
+        }
+        if !self.is_immediate_mode_on() {
+            if let Some(prs) = prs.get() {
+                prs.highlight_with(style);
+            }
+            return Ok(());
+        }
+        let shadow = highlight_shadow(
+            &self.structure_manager(),
+            &prs.cast(),
+            immediate_layer_id,
+            &style.clone().cast(),
+        )?;
+        self.add_to_immediate_list(&shadow.cast());
+        Ok(())
+    }
+    /// `UpdateHighlightTrsf`: gives the local transformation of `object` to the highlight
+    /// shadows of its presentation (or of `sel_obj`'s), also in the views that compute it.
+    /// Example: `manager.update_highlight_trsf(&viewer, &object, 0, &Handle::default())?`.
+    pub fn update_highlight_trsf(
+        &self,
+        viewer: &Handle<V3dViewer>,
+        object: &Handle<dyn PrsMgrPresentableObject>,
+        mode: i32,
+        sel_obj: &Handle<dyn PrsMgrPresentableObject>,
+    ) -> Result<(), Failure> {
+        let Some(value) = object.get() else {
+            return Ok(());
+        };
+        let owner = if sel_obj.is_null() { object } else { sel_obj };
+        let prs = self.presentation(owner, mode, false, &Handle::default())?;
+        let Some(prs) = prs.get() else {
+            return Ok(());
+        };
+        let trsf = value.local_transformation_geom();
+        let parent_id = prs.cstructure().get().map_or(0, |c| c.identification());
+        let state = self.immediate.read().clone();
+        update_prs_transformation(&state.list, parent_id, &trsf);
+        if state.view_dependent_list.is_empty() {
+            return Ok(());
+        }
+        for cview in active_cviews(viewer) {
+            let computed = cview
+                .get()
+                .map(|v| v.is_computed(parent_id))
+                .unwrap_or_default();
+            if let Some(id) = computed
+                .get()
+                .and_then(|c| c.cstructure().get().map(|s| s.identification()))
+            {
+                update_prs_transformation(&state.view_dependent_list, id, &trsf);
+            }
+        }
+        Ok(())
+    }
+}
