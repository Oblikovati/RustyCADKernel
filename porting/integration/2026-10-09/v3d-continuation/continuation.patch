+//! `SelectMgr_SelectableObject`: a presentable object with selection modes (v3d-design.md
+//! section 6). The abstract class is the [`SelectMgrSelectableObject`] trait (a sub-trait of
+//! [`PrsMgrPresentableObject`]) over [`SelectMgrSelectableObjectBase`]. Its overrides of the
+//! presentable virtual members are the `select_mgr_*` functions, which a concrete type puts in
+//! its `PrsMgrPresentableObject` implementation with [`select_mgr_presentable_overrides`].
+use super::{
+    SelectMgrEntityOwnerSource, SelectMgrSelection, SelectMgrTypeOfBvhUpdate, SelectMgrTypeOfUpdate,
+};
+use crate::prs_mgr::{
+    PrsMgrPresentableObject, PrsMgrPresentableObjectMembers as _, PrsMgrPresentationManager,
+    prs_mgr_presentable_dump_json, prs_mgr_set_z_layer, prs_mgr_update_clipping,
+    prs_mgr_update_transformation,
+};
+use crate::prs3d::Prs3dDrawer;
+use crate::select3d::Select3DSensitiveEntityMembers as _;
+use rustycad_tkernel::standard::dump::DumpStream;
+use rustycad_tkernel::standard::exceptions::not_implemented;
+use rustycad_tkernel::standard::{Failure, Handle, SharedState};
+use rustycad_tkmath::toploc::Location;
+use rustycad_tkservice::graphic3d::{
+    Graphic3dStructureMembers as _, Graphic3dStructureSource, Graphic3dZLayerId,
+};
+use rustycad_tkservice::json_dump::{base_class, class_begin, field_dumped, field_integer};
+use std::io;
+
+/// The protected fields of `SelectMgr_SelectableObject`.
+#[derive(Clone)]
+pub struct SelectMgrSelectableObjectFields {
+    /// `myselections`.
+    pub selections: Vec<Handle<SelectMgrSelection>>,
+    /// `mySelectionPrs`.
+    pub selection_prs: Handle<dyn Graphic3dStructureSource>,
+    /// `myHilightPrs`.
+    pub hilight_prs: Handle<dyn Graphic3dStructureSource>,
+    /// `myGlobalSelMode`.
+    pub global_sel_mode: i32,
+    /// `myAutoHilight`.
+    pub auto_hilight: bool,
+}
+
+/// The selection state every selectable object embeds (next to its presentable base).
+pub struct SelectMgrSelectableObjectBase {
+    /// The protected fields.
+    pub fields: SharedState<SelectMgrSelectableObjectFields>,
+}
+
+impl Default for SelectMgrSelectableObjectBase {
+    /// The constructor state: no selection, global mode 0, auto-highlighted.
+    fn default() -> Self {
+        let fields = SelectMgrSelectableObjectFields {
+            selections: Vec::new(),
+            selection_prs: Handle::default(),
+            hilight_prs: Handle::default(),
+            global_sel_mode: 0,
+            auto_hilight: true,
+        };
+        Self {
+            fields: SharedState::new(fields),
+        }
+    }
+}
+
+impl SelectMgrSelectableObjectBase {
+    /// A copy of the fields; `base.read()`.
+    pub fn read(&self) -> SelectMgrSelectableObjectFields {
+        self.fields.read().clone()
+    }
+}
+
+impl Drop for SelectMgrSelectableObjectBase {
+    /// The destructor clears every selection.
+    fn drop(&mut self) {
+        let selections = self.fields.read().selections.clone();
+        selections
+            .iter()
+            .filter_map(Handle::get)
+            .for_each(SelectMgrSelection::clear);
+    }
+}
+
+/// A presentable object with selection modes; the default bodies are the native ones.
+pub trait SelectMgrSelectableObject: PrsMgrPresentableObject {
+    /// The embedded selection state; `object.selectable_base()`.
+    fn selectable_base(&self) -> &SelectMgrSelectableObjectBase;
+    /// `ComputeSelection` (pure virtual): fills the selection of a mode with sensitive entities.
+    /// Example: `object.compute_selection(&selection, 0)?`.
+    fn compute_selection(
+        &self,
+        selection: &Handle<SelectMgrSelection>,
+        mode: i32,
+    ) -> Result<(), Failure>;
+    /// `AcceptShapeDecomposition`: false by default; `object.accept_shape_decomposition()`.
+    fn accept_shape_decomposition(&self) -> bool {
+        false
+    }
+    /// `UpdateTransformations`: the owners of the selection take the object location.
+    /// Example: `object.update_transformations(&selection)`.
+    fn update_transformations(&self, selection: &Handle<SelectMgrSelection>) {
+        let location = Location::new(self.transformation());
+        for entity in selection
+            .get()
+            .map(SelectMgrSelection::entities)
+            .unwrap_or_default()
+            .iter()
+            .filter_map(Handle::get)
+        {
+            let owner = entity
+                .base_sensitive()
+                .get()
+                .map(|s| s.owner_id())
+                .unwrap_or_default();
+            if let Some(owner) = owner.get() {
+                owner.set_location(&location);
+            }
+        }
+    }
+    /// `HilightSelected`: raises `Standard_NotImplemented` by default.
+    /// Example: `object.hilight_selected(&manager, &owners)?`.
+    fn hilight_selected(
+        &self,
+        manager: &Handle<PrsMgrPresentationManager>,
+        owners: &[Handle<dyn SelectMgrEntityOwnerSource>],
+    ) -> Result<(), Failure> {
+        let _ = (manager, owners);
+        Err(not_implemented(
+            "SelectMgr_SelectableObject::HilightSelected",
+        ))
+    }
+    /// `ClearSelected`: clears the selection presentation; `object.clear_selected()`.
+    fn clear_selected(&self) {
+        if let Some(prs) = self.selectable_base().read().selection_prs.get() {
+            prs.clear(true);
+        }
+    }
+    /// `ClearDynamicHighlight`: clears the immediate draw of the manager; `object.clear_dynamic_highlight(&manager)`.
+    fn clear_dynamic_highlight(&self, manager: &Handle<PrsMgrPresentationManager>) {
+        if let Some(manager) = manager.get() {
+            manager.clear_immediate_draw();
+        }
+    }
+    /// `HilightOwnerWithColor`: raises `Standard_NotImplemented` by default.
+    /// Example: `object.hilight_owner_with_color(&manager, &style, &owner)?`.
+    fn hilight_owner_with_color(
+        &self,
+        manager: &Handle<PrsMgrPresentationManager>,
+        style: &Handle<Prs3dDrawer>,
+        owner: &Handle<dyn SelectMgrEntityOwnerSource>,
+    ) -> Result<(), Failure> {
+        let _ = (manager, style, owner);
+        Err(not_implemented(
+            "SelectMgr_SelectableObject::HilightOwnerWithColor",
+        ))
+    }
+    /// `IsAutoHilight`; `object.is_auto_hilight()`.
+    fn is_auto_hilight(&self) -> bool {
+        self.selectable_base().read().auto_hilight
+    }
+    /// `SetAutoHilight`; `object.set_auto_hilight(false)`.
+    fn set_auto_hilight(&self, auto_hilight: bool) {
+        self.selectable_base().fields.write().auto_hilight = auto_hilight;
+    }
+    /// `ErasePresentations`: erases the selection and highlight presentations, and forgets
+    /// them when asked. Example: `object.erase_presentations(true)`.
+    fn erase_presentations(&self, to_remove: bool) {
+        let fields = self.selectable_base().read();
+        for prs in [&fields.selection_prs, &fields.hilight_prs]
+            .into_iter()
+            .filter_map(Handle::get)
+        {
+            prs.erase();
+            if to_remove {
+                prs.clear(true);
+            }
+        }
+        if to_remove {
+            let mut own = self.selectable_base().fields.write();
+            (own.selection_prs, own.hilight_prs) = (Handle::default(), Handle::default());
+        }
+    }
+    /// `GlobalSelOwner`: the owner of the first entity of the global selection mode.
+    /// Example: `object.global_sel_owner()`.
+    fn global_sel_owner(&self) -> Handle<dyn SelectMgrEntityOwnerSource> {
+        let mode = self.selectable_base().read().global_sel_mode;
+        let selection = select_mgr_selection_of(self, mode);
+        let first = selection
+            .get()
+            .and_then(|s| s.entities().first().cloned())
+            .unwrap_or_default();
+        first
+            .get()
+            .and_then(|e| e.base_sensitive().get().map(|s| s.owner_id()))
+            .unwrap_or_default()
+    }
+    /// `GetAssemblyOwner`: null by default; `object.get_assembly_owner()`.
+    fn get_assembly_owner(&self) -> Handle<dyn SelectMgrEntityOwnerSource> {
+        Handle::default()
+    }
+    /// `updateSelection` (protected): flags the selection of the mode (all for -1) for a full update.
+    /// Example: `object.update_selection_internal(-1)`.
+    fn update_selection_internal(&self, mode: i32) {
+        for selection in self
+            .selectable_base()
+            .read()
+            .selections
+            .iter()
+            .filter_map(Handle::get)
+        {
+            if mode == -1 || selection.mode() == mode {
+                selection.set_update_status(SelectMgrTypeOfUpdate::Full);
+                if mode != -1 {
+                    return;
+                }
+            }
+        }
+    }
+}
+rustycad_tkernel::impl_transient_interface!(
+    dyn SelectMgrSelectableObject,
+    "SelectMgr_SelectableObject",
+    dyn PrsMgrPresentableObject
+);
+
+/// `Selection(mode)`: the selection of a mode, null for -1 or an unknown mode.
+/// Example: `select_mgr_selection_of(&*object, 0)`.
+pub fn select_mgr_selection_of<O: SelectMgrSelectableObject + ?Sized>(
+    object: &O,
+    mode: i32,
+) -> Handle<SelectMgrSelection> {
+    if mode == -1 {
+        return Handle::default();
+    }
+    let selections = object.selectable_base().read().selections;
+    selections
+        .into_iter()
+        .find(|s| s.get().is_some_and(|v| v.mode() == mode))
+        .unwrap_or_default()
+}
+
+/// Flags every selection for a partial update.
+fn flag_partial<O: SelectMgrSelectableObject + ?Sized>(
+    object: &O,
+    bvh: Option<SelectMgrTypeOfBvhUpdate>,
+) {
+    for selection in object
+        .selectable_base()
+        .read()
+        .selections
+        .iter()
+        .filter_map(Handle::get)
+    {
+        selection.set_update_status(SelectMgrTypeOfUpdate::Partial);
+        if let Some(status) = bvh {
+            selection.update_bvh_status(status);
+        }
+    }
+}
+
+/// `SelectMgr_SelectableObject::ResetTransformation`; `select_mgr_reset_transformation(&*object)?`.
+pub fn select_mgr_reset_transformation<O: SelectMgrSelectableObject + ?Sized>(
+    object: &O,
+) -> Result<(), Failure> {
+    flag_partial(object, Some(SelectMgrTypeOfBvhUpdate::None));
+    object.set_local_transformation_datum(&Handle::default())
+}
+
+/// `SelectMgr_SelectableObject::UpdateTransformation`: the presentable update, then the
+/// selection and highlight presentations follow. Example: `select_mgr_update_transformation(&*object)?`.
+pub fn select_mgr_update_transformation<O: SelectMgrSelectableObject + ?Sized>(
+    object: &O,
+) -> Result<(), Failure> {
+    flag_partial(object, None);
+    prs_mgr_update_transformation(object)?;
+    let (fields, trsf) = (
+        object.selectable_base().read(),
+        object.transformation_geom(),
+    );
+    for prs in [&fields.selection_prs, &fields.hilight_prs]
+        .into_iter()
+        .filter_map(Handle::get)
+    {
+        prs.set_transformation(&trsf);
+    }
+    Ok(())
+}
+
+/// `SelectMgr_SelectableObject::SetZLayer`: the presentable layer, the selection and
+/// highlight presentations and the owners. Example: `select_mgr_set_z_layer(&*object, layer)`.
+pub fn select_mgr_set_z_layer<O: SelectMgrSelectableObject + ?Sized>(
+    object: &O,
+    layer_id: Graphic3dZLayerId,
+) {
+    prs_mgr_set_z_layer(object, layer_id);
+    let fields = object.selectable_base().read();
+    for prs in [&fields.selection_prs, &fields.hilight_prs]
+        .into_iter()
+        .filter_map(Handle::get)
+    {
+        prs.set_z_layer(layer_id);
+    }
+    for selection in fields.selections.iter().filter_map(Handle::get) {
+        for entity in selection.entities().iter().filter_map(Handle::get) {
+            let owner = entity
+                .base_sensitive()
+                .get()
+                .map(|s| s.owner_id())
+                .unwrap_or_default();
+            if let Some(owner) = owner.get() {
+                owner.set_z_layer(layer_id);
+            }
+        }
+    }
+}
+
+/// `SelectMgr_SelectableObject::UpdateClipping`; `select_mgr_update_clipping(&*object)`.
+pub fn select_mgr_update_clipping<O: SelectMgrSelectableObject + ?Sized>(object: &O) {
+    prs_mgr_update_clipping(object);
+    let (fields, planes) = (object.selectable_base().read(), object.clip_planes());
+    for prs in [&fields.selection_prs, &fields.hilight_prs]
+        .into_iter()
+        .filter_map(Handle::get)
+    {
+        prs.set_clip_planes(&planes);
+    }
+}
+
+/// `SelectMgr_SelectableObject::DumpJson`; `select_mgr_selectable_dump_json(&*object, &mut stream, -1)?`.
+pub fn select_mgr_selectable_dump_json<O: SelectMgrSelectableObject + ?Sized>(
+    object: &O,
+    stream: &mut DumpStream,
+    depth: i32,
+) -> io::Result<()> {
+    class_begin(stream, "SelectMgr_SelectableObject")?;
+    base_class(stream, depth, &|s, d| {
+        prs_mgr_presentable_dump_json(object, s, d)
+    })?;
+    let fields = object.selectable_base().read();
+    if let Some(prs) = fields.selection_prs.get() {
+        field_dumped(stream, depth, "mySelectionPrs.get()", &|s, d| {
+            prs.dump_json(s, d)
+        })?;
+    }
+    if let Some(prs) = fields.hilight_prs.get() {
+        field_dumped(stream, depth, "myHilightPrs.get()", &|s, d| {
+            prs.dump_json(s, d)
+        })?;
+    }
+    for selection in fields.selections.iter().filter_map(Handle::get) {
+        field_dumped(stream, depth, "aSelection.get()", &|s, d| {
+            selection.dump_json(s, d)
+        })?;
+    }
+    field_integer(stream, "myGlobalSelMode", fields.global_sel_mode)?;
+    field_integer(stream, "myAutoHilight", i32::from(fields.auto_hilight))
+}
+
+/// The `PrsMgrPresentableObject` overrides of `SelectMgr_SelectableObject`, to put in the
+/// presentable implementation of a selectable type:
+/// `impl PrsMgrPresentableObject for MyObject { ...; select_mgr_presentable_overrides!(); }`.
+#[macro_export]
+macro_rules! select_mgr_presentable_overrides {
+    () => {
+        fn reset_transformation(&self) -> Result<(), rustycad_tkernel::standard::Failure> {
+            $crate::select_mgr::select_mgr_reset_transformation(self)
+        }
+        fn update_transformation(&self) -> Result<(), rustycad_tkernel::standard::Failure> {
+            $crate::select_mgr::select_mgr_update_transformation(self)
+        }
+        fn set_z_layer(&self, layer_id: rustycad_tkservice::graphic3d::Graphic3dZLayerId) {
+            $crate::select_mgr::select_mgr_set_z_layer(self, layer_id);
+        }
+        fn update_clipping(&self) {
+            $crate::select_mgr::select_mgr_update_clipping(self);
+        }
+        fn dump_json(
+            &self,
+            stream: &mut rustycad_tkernel::standard::dump::DumpStream,
+            depth: i32,
+        ) -> std::io::Result<()> {
+            $crate::select_mgr::select_mgr_selectable_dump_json(self, stream, depth)
+        }
+    };
+}
diff --git a/crates/tkv3d/src/select_mgr/selection.rs b/crates/tkv3d/src/select_mgr/selection.rs
new file mode 100644
index 000000000..9d103d16f
--- /dev/null
+++ b/crates/tkv3d/src/select_mgr/selection.rs
@@ -0,0 +1,285 @@
+//! `SelectMgr_SensitiveEntity` and `SelectMgr_Selection`: the sensitive entities of one
+//! selection mode of a selectable object, with their activity and update states.
+use super::{
+    SelectMgrEntityOwnerSource, SelectMgrStateOfSelection, SelectMgrTypeOfBvhUpdate,
+    SelectMgrTypeOfUpdate,
+};
+use crate::select3d::{Select3DSensitiveEntity, Select3DSensitiveEntityMembers as _};
+use rustycad_tkernel::standard::dump::DumpStream;
+use rustycad_tkernel::standard::exceptions::null_object;
+use rustycad_tkernel::standard::{Failure, Handle, SharedState, StandardTransient};
+use rustycad_tkservice::json_dump::{class_begin, field_dumped, field_integer};
+use std::io;
+
+/// A sensitive entity of a selection with its activity flag.
+///
+/// Example: `let entity = SelectMgrSensitiveEntity::new(&sensitive); entity.set_active_for_selection();`.
+pub struct SelectMgrSensitiveEntity {
+    transient: StandardTransient,
+    sensitive: SharedState<Handle<dyn Select3DSensitiveEntity>>,
+    is_active_for_selection: SharedState<bool>,
+}
+rustycad_tkernel::impl_transient!(
+    SelectMgrSensitiveEntity,
+    "SelectMgr_SensitiveEntity",
+    StandardTransient,
+    transient
+);
+
+impl SelectMgrSensitiveEntity {
+    /// The entity of a sensitive, inactive; `SelectMgrSensitiveEntity::new(&sensitive)`.
+    pub fn new(entity: &Handle<dyn Select3DSensitiveEntity>) -> Self {
+        Self {
+            transient: StandardTransient::default(),
+            sensitive: SharedState::new(entity.clone()),
+            is_active_for_selection: SharedState::new(false),
+        }
+    }
+    /// `Clear`: clears and forgets the sensitive; `entity.clear()`.
+    pub fn clear(&self) {
+        let sensitive = std::mem::take(&mut *self.sensitive.write());
+        if let Some(value) = sensitive.get() {
+            value.clear();
+        }
+    }
+    /// `BaseSensitive`: the sensitive, null once cleared; `entity.base_sensitive()`.
+    pub fn base_sensitive(&self) -> Handle<dyn Select3DSensitiveEntity> {
+        self.sensitive.read().clone()
+    }
+    /// `IsActiveForSelection`; `entity.is_active_for_selection()`.
+    pub fn is_active_for_selection(&self) -> bool {
+        *self.is_active_for_selection.read()
+    }
+    /// `ResetSelectionActiveStatus`; `entity.reset_selection_active_status()`.
+    pub fn reset_selection_active_status(&self) {
+        *self.is_active_for_selection.write() = false;
+    }
+    /// `SetActiveForSelection`; `entity.set_active_for_selection()`.
+    pub fn set_active_for_selection(&self) {
+        *self.is_active_for_selection.write() = true;
+    }
+    /// `DumpJson`; `entity.dump_json(&mut stream, -1)?`.
+    pub fn dump_json(&self, stream: &mut DumpStream, depth: i32) -> io::Result<()> {
+        class_begin(stream, "SelectMgr_SensitiveEntity")?;
+        if let Some(sensitive) = self.base_sensitive().get() {
+            field_dumped(stream, depth, "mySensitive.get()", &|s, d| {
+                sensitive.dump_json(s, d)
+            })?;
+        }
+        field_integer(
+            stream,
+            "myIsActiveForSelection",
+            i32::from(self.is_active_for_selection()),
+        )
+    }
+}
+
+/// The mutable fields of a selection.
+#[derive(Clone)]
+struct SelectionState {
+    entities: Vec<Handle<SelectMgrSensitiveEntity>>,
+    update_status: SelectMgrTypeOfUpdate,
+    selection_state: SelectMgrStateOfSelection,
+    bvh_update_status: SelectMgrTypeOfBvhUpdate,
+    sens_factor: i32,
+    is_custom_sens: bool,
+}
+
+/// The sensitive entities of one selection mode.
+///
+/// Example: `let selection = SelectMgrSelection::new(0); selection.add(&sensitive)?;`.
+pub struct SelectMgrSelection {
+    transient: StandardTransient,
+    mode: i32,
+    state: SharedState<SelectionState>,
+}
+rustycad_tkernel::impl_transient!(
+    SelectMgrSelection,
+    "SelectMgr_Selection",
+    StandardTransient,
+    transient
+);
+
+impl SelectMgrSelection {
+    /// An empty selection of a mode; `SelectMgrSelection::new(0)`.
+    pub fn new(mode_idx: i32) -> Self {
+        let state = SelectionState {
+            entities: Vec::new(),
+            // The native constructor leaves myUpdateStatus uninitialized; the port starts at 0 (Full).
+            update_status: SelectMgrTypeOfUpdate::Full,
+            selection_state: SelectMgrStateOfSelection::Unknown,
+            bvh_update_status: SelectMgrTypeOfBvhUpdate::None,
+            sens_factor: 2,
+            is_custom_sens: false,
+        };
+        Self {
+            transient: StandardTransient::default(),
+            mode: mode_idx,
+            state: SharedState::new(state),
+        }
+    }
+    /// `Destroy`: the sensitives forget their owner and the sensitivity is reset to 2.
+    /// Example: `selection.destroy()`.
+    pub fn destroy(&self) {
+        for sensitive in self
+            .entities()
+            .iter()
+            .filter_map(Handle::get)
+            .map(SelectMgrSensitiveEntity::base_sensitive)
+        {
+            if let Some(value) = sensitive.get() {
+                value.set(&Handle::default());
+            }
+        }
+        self.state.write().sens_factor = 2;
+    }
+    /// `Add`: a new entity of the sensitive, active when the selection is activated, with the
+    /// custom sensitivity (or raising the selection's); a null sensitive raises
+    /// `Standard_NullObject`. Example: `selection.add(&sensitive)?`.
+    pub fn add(&self, sensitive: &Handle<dyn Select3DSensitiveEntity>) -> Result<(), Failure> {
+        let Some(value) = sensitive.get() else {
+            return Err(null_object(
+                "Null sensitive entity is added to the selection; expected a sensitive entity",
+            ));
+        };
+        let entity = Handle::new(SelectMgrSensitiveEntity::new(sensitive));
+        let (activated, custom, factor) = {
+            let mut state = self.state.write();
+            state.entities.push(entity.clone());
+            (
+                state.selection_state == SelectMgrStateOfSelection::Activated,
+                state.is_custom_sens,
+                state.sens_factor,
+            )
+        };
+        if activated && !entity.is_active_for_selection() {
+            entity.set_active_for_selection();
+        }
+        if custom {
+            return value.set_sensitivity_factor(factor);
+        }
+        let mut state = self.state.write();
+        state.sens_factor = state.sens_factor.max(value.sensitivity_factor());
+        Ok(())
+    }
+    /// `Clear`: clears and forgets every entity; `selection.clear()`.
+    pub fn clear(&self) {
+        let entities = std::mem::take(&mut self.state.write().entities);
+        entities
+            .iter()
+            .filter_map(Handle::get)
+            .for_each(SelectMgrSensitiveEntity::clear);
+    }
+    /// `IsEmpty`; `selection.is_empty()`.
+    pub fn is_empty(&self) -> bool {
+        self.state.read().entities.is_empty()
+    }
+    /// `Mode`; `selection.mode()`.
+    pub fn mode(&self) -> i32 {
+        self.mode
+    }
+    /// `Entities`; `selection.entities()`.
+    pub fn entities(&self) -> Vec<Handle<SelectMgrSensitiveEntity>> {
+        self.state.read().entities.clone()
+    }
+    /// `ChangeEntities`: edits the entities; `selection.change_entities(&mut |e| e.clear())`.
+    pub fn change_entities(
+        &self,
+        edit: &mut dyn FnMut(&mut Vec<Handle<SelectMgrSensitiveEntity>>),
+    ) {
+        edit(&mut self.state.write().entities);
+    }
+    /// `UpdateStatus()`; `selection.update_status()`.
+    pub fn update_status(&self) -> SelectMgrTypeOfUpdate {
+        self.state.read().update_status
+    }
+    /// `UpdateStatus(status)`; `selection.set_update_status(SelectMgrTypeOfUpdate::Full)`.
+    pub fn set_update_status(&self, status: SelectMgrTypeOfUpdate) {
+        self.state.write().update_status = status;
+    }
+    /// `UpdateBVHStatus`; `selection.update_bvh_status(SelectMgrTypeOfBvhUpdate::Add)`.
+    pub fn update_bvh_status(&self, status: SelectMgrTypeOfBvhUpdate) {
+        self.state.write().bvh_update_status = status;
+    }
+    /// `BVHUpdateStatus`; `selection.bvh_update_status()`.
+    pub fn bvh_update_status(&self) -> SelectMgrTypeOfBvhUpdate {
+        self.state.read().bvh_update_status
+    }
+    /// `GetSelectionState`; `selection.get_selection_state()`.
+    pub fn get_selection_state(&self) -> SelectMgrStateOfSelection {
+        self.state.read().selection_state
+    }
+    /// `SetSelectionState`; `selection.set_selection_state(SelectMgrStateOfSelection::Activated)`.
+    pub fn set_selection_state(&self, state: SelectMgrStateOfSelection) {
+        self.state.write().selection_state = state;
+    }
+    /// `Sensitivity`; `selection.sensitivity()`.
+    pub fn sensitivity(&self) -> i32 {
+        self.state.read().sens_factor
+    }
+    /// `SetSensitivity`: a custom sensitivity given to every sensitive; a negative value raises
+    /// `Standard_ProgramError` at the first sensitive. Example: `selection.set_sensitivity(4)?`.
+    pub fn set_sensitivity(&self, new_sens: i32) -> Result<(), Failure> {
+        {
+            let mut state = self.state.write();
+            (state.sens_factor, state.is_custom_sens) = (new_sens, true);
+        }
+        for sensitive in self
+            .entities()
+            .iter()
+            .filter_map(Handle::get)
+            .map(SelectMgrSensitiveEntity::base_sensitive)
+        {
+            if let Some(value) = sensitive.get() {
+                value.set_sensitivity_factor(new_sens)?;
+            }
+        }
+        Ok(())
+    }
+    /// `DumpJson`: the distinct owners, the entities and the states.
+    /// Example: `selection.dump_json(&mut stream, -1)?`.
+    pub fn dump_json(&self, stream: &mut DumpStream, depth: i32) -> io::Result<()> {
+        class_begin(stream, "SelectMgr_Selection")?;
+        let state = self.state.read().clone();
+        let mut owners: Vec<Handle<dyn SelectMgrEntityOwnerSource>> = Vec::new();
+        for sensitive in state
+            .entities
+            .iter()
+            .filter_map(Handle::get)
+            .map(SelectMgrSensitiveEntity::base_sensitive)
+        {
+            let Some(value) = sensitive.get() else {
+                continue;
+            };
+            let owner = value.owner_id();
+            if owners
+                .iter()
+                .any(|o| o.object_address() == owner.object_address())
+            {
+                continue;
+            }
+            if let Some(o) = owner.get() {
+                field_dumped(stream, depth, "anOwner.get()", &|s, d| o.dump_json(s, d))?;
+            }
+            owners.push(owner);
+        }
+        for entity in state.entities.iter().filter_map(Handle::get) {
+            field_dumped(stream, depth, "anEntity.get()", &|s, d| {
+                entity.dump_json(s, d)
+            })?;
+        }
+        field_integer(stream, "myMode", self.mode)?;
+        field_integer(stream, "mySelectionState", state.selection_state as i32)?;
+        field_integer(stream, "mySensFactor", state.sens_factor)?;
+        field_integer(stream, "myUpdateStatus", state.update_status as i32)?;
+        field_integer(stream, "myBVHUpdateStatus", state.bvh_update_status as i32)?;
+        field_integer(stream, "myIsCustomSens", i32::from(state.is_custom_sens))
+    }
+}
+
+impl Drop for SelectMgrSelection {
+    /// The destructor calls `Destroy`.
+    fn drop(&mut self) {
+        self.destroy();
+    }
+}
diff --git a/crates/tkv3d/src/select_mgr/view_clip_range.rs b/crates/tkv3d/src/select_mgr/view_clip_range.rs
new file mode 100644
index 000000000..541ee52b5
--- /dev/null
+++ b/crates/tkv3d/src/select_mgr/view_clip_range.rs
@@ -0,0 +1,154 @@
+//! `SelectMgr_ViewClipRange`: the depth ranges along the picking ray that the clipping planes
+//! keep (the unclipped range) or cut (the chains' sub-ranges).
+use rustycad_tkernel::precision::angular;
+use rustycad_tkernel::standard::Failure;
+use rustycad_tkernel::standard::dump::DumpStream;
+use rustycad_tkernel::standard::real::{real_first, real_last};
+use rustycad_tkmath::bnd::Range1;
+use rustycad_tkmath::gp::{Axis1, Point3};
+use rustycad_tkservice::graphic3d::Graphic3dSequenceOfHClipPlane;
+use rustycad_tkservice::json_dump::{class_begin, field_dumped};
+use std::io;
+
+/// The range `[RealFirst, RealLast]`.
+fn whole_range() -> Range1 {
+    // The bounds are ordered, so the constructor check cannot fail.
+    Range1::new(real_first(), real_last()).unwrap_or_default()
+}
+
+/// The clipped and unclipped depths of a picking ray.
+///
+/// Example: `let mut range = SelectMgrViewClipRange::default(); range.is_clipped(1.0);`.
+#[derive(Clone, Debug, PartialEq)]
+pub struct SelectMgrViewClipRange {
+    clip_ranges: Vec<Range1>,
+    unclip_range: Range1,
+}
+
+impl Default for SelectMgrViewClipRange {
+    /// `SelectMgr_ViewClipRange()`: void (nothing clipped).
+    fn default() -> Self {
+        Self {
+            clip_ranges: Vec::new(),
+            unclip_range: whole_range(),
+        }
+    }
+}
+
+impl SelectMgrViewClipRange {
+    /// `IsClipped`: out of the unclipped range or inside a clipped one; `range.is_clipped(2.0)`.
+    pub fn is_clipped(&self, depth: f64) -> bool {
+        self.unclip_range.is_out(depth) || self.clip_ranges.iter().any(|r| !r.is_out(depth))
+    }
+    /// `GetNearestDepth`: the nearest unclipped depth of a range, None when it is clipped.
+    /// Example: `range.get_nearest_depth(&depths)`.
+    pub fn get_nearest_depth(&self, range: &Range1) -> Option<f64> {
+        let mut depth = 0.0;
+        self.get_nearest_depth_into(range, &mut depth)
+            .then_some(depth)
+    }
+    /// Preserves the native output argument even on failure or a void query.
+    /// Example: `let found = clip.get_nearest_depth_into(&query, &mut depth);`.
+    pub fn get_nearest_depth_into(&self, range: &Range1, depth: &mut f64) -> bool {
+        if !self.unclip_range.is_void() && self.unclip_range.is_out_range(*range) {
+            return false;
+        }
+        range.get_min(depth);
+        if !self.unclip_range.is_void() && self.unclip_range.is_out(*depth) {
+            self.unclip_range.get_min(depth);
+        }
+        let Some(common) = self.common_clip_range(*depth) else {
+            return true;
+        };
+        common.get_max(depth);
+        !range.is_out(*depth)
+    }
+    // OCCT 3d097a0 merges once in insertion order, rather than computing a fixed point.
+    fn common_clip_range(&self, depth: f64) -> Option<Range1> {
+        let mut common = *self.clip_ranges.iter().find(|r| !r.is_out(depth))?;
+        for clip in &self.clip_ranges {
+            if !common.is_out_range(*clip) {
+                common.add_range(*clip);
+            }
+        }
+        Some(common)
+    }
+    /// `SetVoid`: nothing clipped; `range.set_void()`.
+    pub fn set_void(&mut self) {
+        self.clip_ranges.clear();
+        self.unclip_range = whole_range();
+    }
+    /// `AddClippingPlanes`: the active planes cut the ray into the unclipped range and, for
+    /// each chain, a clipped sub-range. Example: `range.add_clipping_planes(&planes, &ray)?`.
+    pub fn add_clipping_planes(
+        &mut self,
+        planes: &Graphic3dSequenceOfHClipPlane,
+        pick_ray: &Axis1,
+    ) -> Result<(), Failure> {
+        for handle in planes.items() {
+            let Some(plane) = handle.get().filter(|p| p.is_on()) else {
+                continue;
+            };
+            let mut sub_range = whole_range();
+            let mut chain = handle.clone();
+            while let Some(current) = chain.get() {
+                if let Some((dist, dot)) = plane_distance(current.to_plane(), pick_ray)? {
+                    self.trim(plane.is_chain(), &mut sub_range, dist, dot);
+                }
+                let next = current.chain_next_plane();
+                chain = next;
+            }
+            if !sub_range.is_void() && plane.is_chain() {
+                self.clip_ranges.push(sub_range);
+            }
+        }
+        Ok(())
+    }
+    /// Trims the unclipped range (a plane) or the chain sub-range at a ray distance.
+    fn trim(&mut self, is_chain: bool, sub_range: &mut Range1, dist_to_pln: f64, dot: f64) {
+        match (is_chain, dot < 0.0) {
+            (false, true) => self.unclip_range.trim_to(dist_to_pln),
+            (false, false) => self.unclip_range.trim_from(dist_to_pln),
+            (true, true) => sub_range.trim_from(dist_to_pln),
+            (true, false) => sub_range.trim_to(dist_to_pln),
+        }
+    }
+    /// `ChangeUnclipRange`; `range.change_unclip_range().trim_to(5.0)`.
+    pub fn change_unclip_range(&mut self) -> &mut Range1 {
+        &mut self.unclip_range
+    }
+    /// `AddClipSubRange`; `range.add_clip_sub_range(sub)`.
+    pub fn add_clip_sub_range(&mut self, range: Range1) {
+        self.clip_ranges.push(range);
+    }
+    /// `DumpJson`: the clipped ranges and the unclipped one; `range.dump_json(&mut stream, -1)?`.
+    pub fn dump_json(&self, stream: &mut DumpStream, depth: i32) -> io::Result<()> {
+        class_begin(stream, "SelectMgr_ViewClipRange")?;
+        for clip in &self.clip_ranges {
+            field_dumped(stream, depth, "&aClipRange", &|s, _| clip.dump_json(s))?;
+        }
+        let unclip = self.unclip_range;
+        field_dumped(stream, depth, "&myUnclipRange", &|s, _| unclip.dump_json(s))
+    }
+}
+
+/// The signed ray distance to a plane and the ray-normal dot product (1 for a parallel ray,
+/// at RealLast); None for a parallel ray on the clipped side.
+fn plane_distance(
+    plane: rustycad_tkmath::gp::Plane3,
+    pick_ray: &Axis1,
+) -> Result<Option<(f64, f64)>, Failure> {
+    let ray_dir = pick_ray.direction().xyz();
+    let near = pick_ray.location();
+    let [_, _, _, d] = plane.coefficients()?;
+    let plane_dir = plane.axis().direction().xyz();
+    let dot = ray_dir.dot(plane_dir);
+    let distance = -near.xyz().dot(plane_dir) - d;
+    if dot.abs() < angular() {
+        return Ok((distance >= 0.0).then_some((real_last(), 1.0)));
+    }
+    let param = distance / dot;
+    let point = Point3::from(near.xyz() + ray_dir * param);
+    let dist = point.distance(&near);
+    Ok(Some((if param < 0.0 { -dist } else { dist }, dot)))
+}
diff --git a/crates/tkv3d/src/v3d/circular_grid.rs b/crates/tkv3d/src/v3d/circular_grid.rs
