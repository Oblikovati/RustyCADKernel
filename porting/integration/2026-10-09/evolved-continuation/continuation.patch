+#include <BRepLib_MakeFace.hxx>
+
+void bl_evolved_history(const BRepFill_Evolved& evolved, const TopoDS_Shape& spine,
+                        const TopoDS_Shape& profile) {
+  NCollection_IndexedMap<TopoDS_Shape, TopTools_ShapeMapHasher> spines, profiles;
+  TopExp::MapShapes(spine, spines); TopExp::MapShapes(profile, profiles);
+  for (int i = 1; i <= spines.Extent(); ++i)
+    for (int j = 1; j <= profiles.Extent(); ++j) {
+      const auto& generated = evolved.GeneratedShapes(spines(i), profiles(j));
+      ga_int(generated.Size());
+      for (const auto& shape : generated) { ga_int(shape.ShapeType()); ga_int(shape.Orientation()); }
+    }
+}
+
+void bl_evolved_result(const BRepFill_Evolved& evolved) {
+  ga_flag(evolved.IsDone());
+  GA_TRY(bl_evolved_digest(evolved.Shape()))
+  GA_TRY(bl_evolved_digest(evolved.Top()))
+  GA_TRY(bl_evolved_digest(evolved.Bottom()))
+}
+
+void bl_bf_evolved_empty_case(std::istream&) {
+  BRepFill_Evolved evolved;
+  bl_evolved_result(evolved);
+  ga_int(evolved.GeneratedShapes(TopoDS_Shape(), TopoDS_Shape()).Size());
+  ga_end();
+}
+
+void bl_bf_evolved_case(std::istream& input) {
+  GaReader r{input};
+  try {
+    TpShapes table = tp_shapes(r);
+    const auto spine = TopoDS::Wire(table.shapes.at(r.integer()));
+    const auto profile = TopoDS::Wire(table.shapes.at(r.integer()));
+    const bool face = r.flag(), solid = r.flag(), constructor = r.flag();
+    const auto join = static_cast<GeomAbs_JoinType>(r.integer());
+    const gp_Pnt origin=r.pnt(); const gp_Dir normal=r.dir(), xdir=r.dir();
+    const gp_Ax3 axes(origin,normal,xdir);
+    BRepFill_Evolved evolved;
+    if (face) {
+      const auto spineFace = BRepLib_MakeFace(spine, true).Face();
+      if (constructor) evolved = BRepFill_Evolved(spineFace, profile, axes, join, solid);
+      else evolved.Perform(spineFace, profile, axes, join, solid);
+    } else {
+      if (constructor) evolved = BRepFill_Evolved(spine, profile, axes, join, solid);
+      else evolved.Perform(spine, profile, axes, join, solid);
+    }
+    bl_evolved_result(evolved); ga_int(evolved.JoinType());
+    bl_evolved_history(evolved, spine, profile);
+  } catch (const Standard_Failure& error) { std::cout << error.ExceptionType() << ' '; }
+  ga_end();
+}
diff --git a/tools/oracle/tkbool_probe_curve_explorer.cxx b/tools/oracle/tkbool_probe_curve_explorer.cxx
new file mode 100644
index 000000000..fa4a2cf42
--- /dev/null
+++ b/tools/oracle/tkbool_probe_curve_explorer.cxx
@@ -0,0 +1,65 @@
+// Behavioral oracle for TopOpeBRepDS_CurveExplorer at pinned OCCT 3d097a0.
+// Input: count gap keep-mask only-kept query-index. Gaps follow the first curve.
+#include <TopOpeBRepDS_CurveExplorer.hxx>
+#include <TopOpeBRepDS_DataStructure.hxx>
+#include <TopOpeBRepDS_Curve.hxx>
+
+static void bl_explorer_curve(const TopOpeBRepDS_Curve& curve) {
+  ga_int(curve.DSIndex());
+  ga_flag(curve.Keep());
+  ga_real(curve.Tolerance());
+  ga_flag(curve.Curve().IsNull());
+}
+
+static void bl_explorer_walk(TopOpeBRepDS_CurveExplorer& explorer) {
+  for (; explorer.More(); explorer.Next()) {
+    ga_int(explorer.Index());
+    bl_explorer_curve(explorer.Curve());
+  }
+  ga_int(explorer.Index());
+  bl_explorer_curve(explorer.Curve());
+  ga_int(explorer.NbCurve());
+  ga_flag(explorer.More());
+  ga_int(explorer.Index());
+}
+
+static void bl_explorer_source(TopOpeBRepDS_DataStructure& curves, int count, int gap, int mask) {
+  for (int slot = 0; slot < count; ++slot) {
+    if (slot == 1) curves.ChangeNbCurves(curves.NbCurves() + gap);
+    TopOpeBRepDS_Curve curve;
+    curve.Tolerance(0.25 * (slot + 1));
+    curve.ChangeKeep((mask & (1 << slot)) != 0);
+    curves.AddCurve(curve);
+  }
+  curves.ChangeCurve(-1).Tolerance(12.0);
+}
+
+static void bl_curve_explorer_case(std::istream& input) {
+  GaReader reader{input};
+  const int count = reader.integer(), gap = reader.integer(), mask = reader.integer();
+  const bool onlyKept = reader.integer() != 0;
+  const int query = reader.integer();
+  TopOpeBRepDS_DataStructure curves;
+  bl_explorer_source(curves, count, gap, mask);
+  TopOpeBRepDS_CurveExplorer explorer(curves, onlyKept);
+  ga_flag(explorer.IsCurve(query)); ga_flag(explorer.IsCurveKeep(query));
+  bl_explorer_curve(explorer.Curve(query)); bl_explorer_walk(explorer);
+  explorer.Init(curves, !onlyKept); bl_explorer_walk(explorer); ga_end();
+}
+
+static void bl_curve_explorer_mutation_case(std::istream& input) {
+  GaReader reader{input};
+  const int gap = reader.integer();
+  TopOpeBRepDS_DataStructure curves;
+  bl_explorer_source(curves, 2, gap, 1);
+  TopOpeBRepDS_CurveExplorer explorer(curves, true);
+  curves.ChangeKeepCurve(2 + gap, true);
+  TopOpeBRepDS_Curve added;
+  const int index = curves.AddCurve(added);
+  ga_flag(explorer.IsCurve(index)); bl_explorer_curve(explorer.Curve(index));
+  bl_explorer_walk(explorer);
+  explorer.Init(curves, true); curves.Init(); curves.ChangeCurve(-1).Tolerance(12.0);
+  ga_flag(explorer.More()); bl_explorer_curve(explorer.Curve());
+  bl_explorer_curve(explorer.Curve(1)); explorer.Next();
+  ga_flag(explorer.More()); ga_int(explorer.Index()); ga_end();
+}
diff --git a/tools/oracle/tkbool_probe_evolved_digest.cxx b/tools/oracle/tkbool_probe_evolved_digest.cxx
new file mode 100644
index 000000000..b90c26ca2
--- /dev/null
+++ b/tools/oracle/tkbool_probe_evolved_digest.cxx
@@ -0,0 +1,83 @@
+// Address-independent BRepFill_Evolved digest. Native Quilt and DataMap traversal
+// changes between executions; retain exact sampled geometry and oriented incidence
+// while sorting siblings and p-curve representations. A free shell may reverse as
+// a whole depending on its seed face. In a solid, consume the shell orientation
+// into its face incidences, retaining the physically significant total orientation.
+#include <algorithm>
+using BlEvolvedKey = std::vector<uint64_t>;
+void bl_key_point(BlEvolvedKey& key, const gp_Pnt& p) {
+  key.insert(key.end(), {ga_bits(p.X()), ga_bits(p.Y()), ga_bits(p.Z())});
+}
+void bl_key_type(BlEvolvedKey& key, const occ::handle<Standard_Transient>& value) {
+  std::string name = value.IsNull() ? "null" : value->DynamicType()->Name();
+  key.push_back(name.size()); for (unsigned char c : name) key.push_back(c);
+}
+void bl_key_children(BlEvolvedKey& key, std::vector<BlEvolvedKey> children) {
+  std::sort(children.begin(), children.end()); key.push_back(children.size());
+  for (const auto& child : children) { key.push_back(child.size()); key.insert(key.end(), child.begin(), child.end()); }
+}
+BlEvolvedKey bl_key_pcurves(const TopoDS_Edge& edge) {
+  std::vector<BlEvolvedKey> rows;
+  for (int i = 1;; ++i) {
+    occ::handle<Geom2d_Curve> curve; occ::handle<Geom_Surface> surface;
+    TopLoc_Location location; double first=0., last=0.;
+    BRep_Tool::CurveOnSurface(edge, curve, surface, location, first, last, i);
+    if (curve.IsNull()) break;
+    BlEvolvedKey row{uint64_t(location.IsIdentity()), ga_bits(first), ga_bits(last)};
+    bl_key_type(row, surface); bl_key_type(row, curve);
+    for (double u : {first, last, 0.5*(first+last)}) {
+      gp_Pnt2d p=curve->Value(u); row.insert(row.end(), {ga_bits(p.X()), ga_bits(p.Y())});
+    }
+    rows.push_back(row);
+  }
+  BlEvolvedKey key; bl_key_children(key, rows); return key;
+}
+void bl_key_edge(BlEvolvedKey& key, const TopoDS_Edge& edge) {
+  key.insert(key.end(), {ga_bits(BRep_Tool::Tolerance(edge)), uint64_t(BRep_Tool::SameParameter(edge)),
+                        uint64_t(BRep_Tool::SameRange(edge)), uint64_t(BRep_Tool::Degenerated(edge))});
+  double first=0., last=0.; auto curve=BRep_Tool::Curve(edge, first, last);
+  bl_key_type(key, curve);
+  if (!curve.IsNull()) {
+    key.insert(key.end(), {ga_bits(first), ga_bits(last)});
+    for (double u : {first, last, 0.5*(first+last)}) bl_key_point(key, curve->Value(u));
+  }
+  auto pcurves=bl_key_pcurves(edge); key.insert(key.end(), pcurves.begin(), pcurves.end());
+}
+void bl_key_face(BlEvolvedKey& key, const TopoDS_Face& face) {
+  key.insert(key.end(), {ga_bits(BRep_Tool::Tolerance(face)), uint64_t(BRep_Tool::NaturalRestriction(face))});
+  auto surface=BRep_Tool::Surface(face); bl_key_type(key, surface);
+  if (surface.IsNull()) return;
+  bl_key_point(key, surface->Value(0.25, 0.5));
+  gp_Pnt point; gp_Vec du,dv; surface->D1(0.3,0.7,point,du,dv);
+  bl_key_point(key, point); bl_key_point(key, gp_Pnt(du.XYZ())); bl_key_point(key, gp_Pnt(dv.XYZ()));
+}
+BlEvolvedKey bl_evolved_key(const TopoDS_Shape& shape, bool inSolid=false) {
+  if (shape.IsNull()) return {UINT64_MAX};
+  BlEvolvedKey key{uint64_t(shape.ShapeType()), uint64_t(shape.Closed()), uint64_t(shape.Location().IsIdentity())};
+  bool solid=inSolid || shape.ShapeType()==TopAbs_SOLID;
+  std::vector<BlEvolvedKey> children, reversed;
+  for (TopoDS_Iterator it(shape, solid && shape.ShapeType()==TopAbs_SHELL, true); it.More(); it.Next()) {
+    auto child=bl_evolved_key(it.Value(),solid);
+    if (shape.ShapeType()==TopAbs_EDGE) child.push_back(ga_bits(BRep_Tool::Parameter(TopoDS::Vertex(it.Value()),TopoDS::Edge(shape))));
+    child.insert(child.begin(),solid && it.Value().ShapeType()==TopAbs_SHELL ? 0 : uint64_t(it.Value().Orientation())); children.push_back(child);
+    child[0]=uint64_t(TopAbs::Reverse(it.Value().Orientation())); reversed.push_back(child);
+  }
+  BlEvolvedKey incidence; bl_key_children(incidence,children);
+  if (!solid && shape.ShapeType()==TopAbs_SHELL) {
+    BlEvolvedKey reverse; bl_key_children(reverse,reversed); incidence=std::min(incidence,reverse);
+  }
+  key.insert(key.end(),incidence.begin(),incidence.end());
+  if (shape.ShapeType()==TopAbs_VERTEX) { bl_key_point(key,BRep_Tool::Pnt(TopoDS::Vertex(shape))); key.push_back(ga_bits(BRep_Tool::Tolerance(TopoDS::Vertex(shape)))); }
+  if (shape.ShapeType()==TopAbs_EDGE) bl_key_edge(key,TopoDS::Edge(shape));
+  if (shape.ShapeType()==TopAbs_FACE) bl_key_face(key,TopoDS::Face(shape));
+  return key;
+}
+void bl_evolved_digest(const TopoDS_Shape& shape) {
+  auto key=bl_evolved_key(shape);
+  ga_int(key.size()); for (auto value:key) std::cout<<value<<' ';
+  for (int kind=0;kind<8;++kind) {
+    NCollection_IndexedMap<TopoDS_Shape,TopTools_ShapeMapHasher> shapes;
+    if (!shape.IsNull()) TopExp::MapShapes(shape,static_cast<TopAbs_ShapeEnum>(kind),shapes);
+    ga_int(shapes.Extent());
+  }
+}
diff --git a/tools/oracle/tkbool_probe_interference_tool.cxx b/tools/oracle/tkbool_probe_interference_tool.cxx
new file mode 100644
index 000000000..f8502f19a
--- /dev/null
+++ b/tools/oracle/tkbool_probe_interference_tool.cxx
@@ -0,0 +1,63 @@
+// Factory/aliasing oracle for TopOpeBRepDS_InterferenceTool at OCCT 3d097a0.
+#include <TopOpeBRepDS_InterferenceTool.hxx>
+#include <TopOpeBRepDS_CurvePointInterference.hxx>
+#include <TopOpeBRepDS_EdgeVertexInterference.hxx>
+#include <TopOpeBRepDS_FaceEdgeInterference.hxx>
+#include <TopOpeBRepDS_SurfaceCurveInterference.hxx>
+#include <Geom2d_Line.hxx>
+using BlInterferenceTool = TopOpeBRepDS_InterferenceTool;
+
+static void bl_interference_fields(const occ::handle<TopOpeBRepDS_Interference>& interference) {
+  ga_text(interference->DynamicType()->Name());
+  ga_int(interference->SupportType()); ga_int(interference->Support());
+  ga_int(interference->GeometryType()); ga_int(interference->Geometry());
+  bl_transition(interference->Transition());
+}
+
+static void bl_interference_curves(const TopOpeBRepDS_Transition& transition, int support, int geometry, double parameter) {
+  auto edge = BlInterferenceTool::MakeEdgeInterference(transition, TopOpeBRepDS_EDGE, support, TopOpeBRepDS_VERTEX, geometry, parameter);
+  auto curve = BlInterferenceTool::MakeCurveInterference(transition, TopOpeBRepDS_CURVE, support, TopOpeBRepDS_POINT, geometry, parameter);
+  bl_interference_fields(edge); ga_real(BlInterferenceTool::Parameter(edge));
+  bl_interference_fields(curve); ga_real(BlInterferenceTool::Parameter(curve));
+  auto copy = BlInterferenceTool::DuplicateCurvePointInterference(curve);
+  bl_interference_fields(copy); ga_flag(copy != curve);
+  auto alias = curve;
+  BlInterferenceTool::Parameter(curve, parameter + 1.0);
+  ga_real(BlInterferenceTool::Parameter(alias)); ga_real(BlInterferenceTool::Parameter(copy));
+}
+
+static void bl_interference_surfaces(const TopOpeBRepDS_Transition& transition, int support, int geometry, bool hasCurve) {
+  occ::handle<Geom2d_Curve> pcurve;
+  if (hasCurve) pcurve = new Geom2d_Line(gp_Pnt2d(1, 2), gp_Dir2d(1, 0));
+  auto face = BlInterferenceTool::MakeFaceCurveInterference(transition, support, geometry, pcurve);
+  bl_interference_fields(face);
+  auto typed = occ::down_cast<TopOpeBRepDS_SurfaceCurveInterference>(face);
+  ga_flag(typed->PCurve() == pcurve); ga_flag(typed->PCurve().IsNull());
+  if (!pcurve.IsNull()) ga_pnt2d(typed->PCurve()->Value(0.5));
+  bl_interference_fields(BlInterferenceTool::MakeSolidSurfaceInterference(transition, support, geometry));
+}
+
+static void bl_interference_shapes(const TopOpeBRepDS_Transition& transition, int support, int geometry,
+                                   double parameter, TopOpeBRepDS_Config config, bool bound) {
+  auto edge = BlInterferenceTool::MakeEdgeVertexInterference(transition, support, geometry, bound, config, parameter);
+  bl_interference_fields(edge);
+  auto vertex = occ::down_cast<TopOpeBRepDS_EdgeVertexInterference>(edge);
+  ga_flag(vertex->GBound()); ga_int(vertex->Config()); ga_real(vertex->Parameter());
+  auto face = BlInterferenceTool::MakeFaceEdgeInterference(transition, support, geometry, bound, config);
+  bl_interference_fields(face);
+  auto typed = occ::down_cast<TopOpeBRepDS_FaceEdgeInterference>(face);
+  ga_flag(typed->GBound()); ga_int(typed->Config());
+}
+
+static void bl_interference_tool_case(std::istream& input) {
+  GaReader reader{input};
+  TopOpeBRepDS_Transition transition((TopAbs_Orientation)reader.integer());
+  transition.IndexBefore(11); transition.IndexAfter(13);
+  const int support = reader.integer(), geometry = reader.integer();
+  const double parameter = reader.real();
+  const auto config = (TopOpeBRepDS_Config)reader.integer();
+  const bool bound = reader.integer() != 0;
+  bl_interference_curves(transition, support, geometry, parameter);
+  bl_interference_surfaces(transition, support, geometry, bound);
+  bl_interference_shapes(transition, support, geometry, parameter, config, bound); ga_end();
+}
diff --git a/tools/oracle/tkbool_probe_point_explorer.cxx b/tools/oracle/tkbool_probe_point_explorer.cxx
new file mode 100644
index 000000000..d6cf28b76
--- /dev/null
+++ b/tools/oracle/tkbool_probe_point_explorer.cxx
@@ -0,0 +1,55 @@
+// PointExplorer oracle at OCCT 3d097a0. Empty points have an uninitialized
+// native tolerance, so only bound points contribute a tolerance token.
+#include <TopOpeBRepDS_PointExplorer.hxx>
+
+static void bl_explorer_point(const TopOpeBRepDS_Point& point) {
+  ga_pnt(point.Point());
+  ga_flag(point.Keep());
+}
+
+static void bl_point_source(TopOpeBRepDS_DataStructure& source, int count, int mask) {
+  for (int slot = 0; slot < count; ++slot) {
+    TopOpeBRepDS_Point point(gp_Pnt(slot + 1, 2, 3), 0.25 * (slot + 1));
+    point.ChangeKeep((mask & (1 << slot)) != 0);
+    source.AddPoint(point);
+  }
+}
+
+static void bl_point_walk(TopOpeBRepDS_PointExplorer& explorer) {
+  for (; explorer.More(); explorer.Next()) {
+    ga_int(explorer.Index()); bl_explorer_point(explorer.Point());
+    ga_real(explorer.Point().Tolerance());
+  }
+  ga_int(explorer.Index()); bl_explorer_point(explorer.Point());
+  ga_int(explorer.NbPoint()); ga_flag(explorer.More()); ga_int(explorer.Index());
+}
+
+static void bl_point_explorer_case(std::istream& input) {
+  GaReader reader{input};
+  const int count = reader.integer(), mask = reader.integer();
+  const bool kept = reader.integer() != 0;
+  const int query = reader.integer();
+  TopOpeBRepDS_DataStructure source;
+  bl_point_source(source, count, mask);
+  TopOpeBRepDS_PointExplorer explorer;
+  ga_flag(explorer.More()); ga_int(explorer.Index()); bl_explorer_point(explorer.Point());
+  explorer.Next(); ga_int(explorer.Index());
+  explorer.Init(source, kept);
+  ga_flag(explorer.IsPoint(query)); ga_flag(explorer.IsPointKeep(query));
+  bl_explorer_point(explorer.Point(query)); bl_point_walk(explorer);
+  explorer.Init(source, !kept); bl_point_walk(explorer); ga_end();
+}
+
+static void bl_point_explorer_mutation_case(std::istream&) {
+  TopOpeBRepDS_DataStructure source;
+  bl_point_source(source, 2, 1);
+  TopOpeBRepDS_PointExplorer explorer(source, true);
+  source.ChangeKeepPoint(2, true);
+  source.AddPoint(TopOpeBRepDS_Point(gp_Pnt(3, 2, 3), 0.75));
+  ga_flag(explorer.IsPoint(3)); bl_explorer_point(explorer.Point(3));
+  bl_point_walk(explorer);
+  explorer.Init(source, true); source.Init();
+  ga_flag(explorer.More()); GA_TRY(bl_explorer_point(explorer.Point()))
+  bl_explorer_point(explorer.Point(1)); explorer.Next();
+  ga_flag(explorer.More()); ga_int(explorer.Index()); ga_end();
+}
diff --git a/tools/tkbool_corpus_brepfill_evolved.py b/tools/tkbool_corpus_brepfill_evolved.py
new file mode 100644
index 000000000..b0ffb6fdd
--- /dev/null
+++ b/tools/tkbool_corpus_brepfill_evolved.py
@@ -0,0 +1,47 @@
+"""BRepFill_Evolved wire/face, constructor/Perform and shell/solid comparisons."""
+from __future__ import annotations
+from tkbool_corpus_brepfill_advanced_evolved import SPINES
+from tkbool_corpus_brepfill_generator import polyline_wire, circle_wire
+from tktopalgo_shape_program import ShapeProgram, num
+
+PROFILES = {
+    'vertical': ([(0., 0., 0.), (0., 0., 1.)], False),
+    'outward': ([(0., 0., 0.), (0., -0.5, 1.)], False),
+    'inward': ([(0., 0., 0.), (0., 0.5, 1.)], False),
+    'bent': ([(0., 0., 0.), (0., 0., 1.), (0., 0.5, 1.5)], False),
+    'planar': ([(0., 0., 0.), (0., 0.5, 0.)], False),
+    'triangle': ([(0., 0., 0.), (0., 0.5, 0.), (0., 0., 1.)], True),
+}
+
+
+def evolved_request(spine: str, profile: str, face: int, solid: int,
+                    constructor: int, join: int = 0, moved: bool = False) -> str:
+    """Make one independent request; e.g. evolved_request('square', 'vertical', 0, 1, 0)."""
+    program = ShapeProgram()
+    spine_index = (circle_wire(program, (0., 0., 0.), 4.) if spine == 'circle'
+                   else polyline_wire(program, SPINES[spine], True))
+    points, closed = PROFILES[profile]
+    axes = (0., 0., 0., 0., 0., 1., 1., 0., 0.)
+    if moved:
+        points = [(3. + y, -2. + z, 5. + x) for x, y, z in points]
+        axes = (3., -2., 5., 0., 1., 0., 0., 0., 1.)
+    profile_index = polyline_wire(program, points, closed)
+    return (f'bf_evolved {program.tokens()} {spine_index} {profile_index} '
+            f'{face} {solid} {constructor} {join} '+ ' '.join(map(num, axes)))
+
+
+def append_evolved_requests(requests: list[str]) -> None:
+    """Cover every branch of the public facade and each kind of profile part."""
+    requests.append('bf_evolved_empty')
+    for spine in sorted(SPINES):
+        for profile in sorted(PROFILES):
+            for face in (0, 1):
+                for solid in (0, 1):
+                    requests.append(evolved_request(spine, profile, face, solid, 0))
+    for face in (0, 1):
+        for join in (0, 1, 2):
+            requests.append(evolved_request('square', 'vertical', face, 1, 1, join))
+    for profile in ('vertical', 'planar', 'outward'):
+        for face in (0, 1):
+            requests.append(evolved_request('circle', profile, face, 1, 1))
+            requests.append(evolved_request('square', profile, face, 1, 0, moved=True))
