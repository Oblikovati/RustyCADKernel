diff --git a/crates/vulkan/src/backend/mod.rs b/crates/vulkan/src/backend/mod.rs
index 9aaba8ed3..1b98b6485 100644
--- a/crates/vulkan/src/backend/mod.rs
+++ b/crates/vulkan/src/backend/mod.rs
@@ -34,6 +34,7 @@ impl VulkanRenderer {
     }
 }
 mod buffer;
+mod memory_selection;
 mod frame;
 mod image;
 mod pipeline;
@@ -42,10 +43,22 @@ mod record;
 mod submission;
 impl RenderBackend for VulkanRenderer {
     fn render(&mut self, frame: &RenderFrame) -> Result<FrameCapture, RenderError> {
+        let start = std::time::Instant::now();
         let resources = frame::FrameResources::new(&self.runtime, frame, &self.pipeline)?;
+        let allocated = start.elapsed();
         let commands = submission::CommandSubmission::new(&self.runtime)?;
         record::record_frame(&self.runtime, commands.command, &resources, frame);
+        let recorded = start.elapsed();
         commands.finish()?;
-        resources.capture()
+        let submitted = start.elapsed();
+        let result = resources.capture();
+        let captured = start.elapsed();
+        drop(commands);
+        drop(resources);
+        let ended = start.elapsed();
+        let phases = [allocated, recorded-allocated, submitted-recorded, captured-submitted, ended-captured]
+            .map(|duration| duration.as_secs_f64()*1000.);
+        println!("{{\"diagnostic\":\"DEBUG-martensite-backend-phases\",\"phases_ms\":{phases:?}}}");
+        result
     }
 }
