+        Prs3dIsoAspect,
+        "UIsoAspect"
+    );
+    drawer_aspect_members!(
+        v_iso_aspect,
+        set_v_iso_aspect,
+        has_own_v_iso_aspect,
+        v_iso_aspect,
+        Prs3dIsoAspect,
+        "VIsoAspect"
+    );
+    drawer_aspect_members!(
+        wire_aspect,
+        set_wire_aspect,
+        has_own_wire_aspect,
+        wire_aspect,
+        Prs3dLineAspect,
+        "WireAspect"
+    );
+    drawer_aspect_members!(
+        point_aspect,
+        set_point_aspect,
+        has_own_point_aspect,
+        point_aspect,
+        Prs3dPointAspect,
+        "PointAspect"
+    );
+    drawer_aspect_members!(
+        line_aspect,
+        set_line_aspect,
+        has_own_line_aspect,
+        line_aspect,
+        Prs3dLineAspect,
+        "LineAspect"
+    );
+    drawer_aspect_members!(
+        text_aspect,
+        set_text_aspect,
+        has_own_text_aspect,
+        text_aspect,
+        Prs3dTextAspect,
+        "TextAspect"
+    );
+    drawer_aspect_members!(
+        shading_aspect,
+        set_shading_aspect,
+        has_own_shading_aspect,
+        shading_aspect,
+        Prs3dShadingAspect,
+        "ShadingAspect"
+    );
+    drawer_aspect_members!(
+        seen_line_aspect,
+        set_seen_line_aspect,
+        has_own_seen_line_aspect,
+        seen_line_aspect,
+        Prs3dLineAspect,
+        "SeenLineAspect"
+    );
+    drawer_aspect_members!(
+        plane_aspect,
+        set_plane_aspect,
+        has_own_plane_aspect,
+        plane_aspect,
+        Prs3dPlaneAspect,
+        "PlaneAspect"
+    );
+    drawer_aspect_members!(
+        arrow_aspect,
+        set_arrow_aspect,
+        has_own_arrow_aspect,
+        arrow_aspect,
+        Prs3dArrowAspect,
+        "ArrowAspect"
+    );
+    drawer_aspect_members!(
+        hidden_line_aspect,
+        set_hidden_line_aspect,
+        has_own_hidden_line_aspect,
+        hidden_line_aspect,
+        Prs3dLineAspect,
+        "HiddenLineAspect"
+    );
+    drawer_aspect_members!(
+        vector_aspect,
+        set_vector_aspect,
+        has_own_vector_aspect,
+        vector_aspect,
+        Prs3dLineAspect,
+        "VectorAspect"
+    );
+    drawer_aspect_members!(
+        datum_aspect,
+        set_datum_aspect,
