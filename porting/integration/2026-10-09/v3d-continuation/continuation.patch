@@ -0,0 +1,124 @@
+//! `Prs3d_PointAspect`: the marker attributes of points.
+use super::basic_aspect::{Prs3dBasicAspect, dump_graphic_aspects};
+use rustycad_tkernel::ncollection::HArray1;
+use rustycad_tkernel::quantity::Color;
+use rustycad_tkernel::standard::dump::DumpStream;
+use rustycad_tkernel::standard::{Failure, Handle, SharedState, StandardTransient};
+use rustycad_tkservice::aspect::AspectTypeOfMarker;
+use rustycad_tkservice::graphic3d::{
+    Graphic3dAspectMarker3d, Graphic3dAspectsMembers as _, Graphic3dMarkerImage,
+};
+use rustycad_tkservice::json_dump::class_begin;
+use std::io;
+
+/// The marker attributes of point presentations.
+///
+/// Example: `let aspect = Prs3dPointAspect::new(AspectTypeOfMarker::Plus, yellow, 1.0)?;`.
+pub struct Prs3dPointAspect {
+    transient: StandardTransient,
+    aspect: SharedState<Handle<Graphic3dAspectMarker3d>>,
+}
+rustycad_tkernel::impl_transient!(Prs3dPointAspect, "Prs3d_PointAspect", dyn Prs3dBasicAspect, transient,
+    interfaces: [dyn Prs3dBasicAspect]);
+
+impl Prs3dPointAspect {
+    /// A marker of a type, color and scale; a scale <= 0 raises `Standard_OutOfRange`.
+    /// Example: `Prs3dPointAspect::new(AspectTypeOfMarker::Star, red, 2.0)?`.
+    pub fn new(kind: AspectTypeOfMarker, color: Color, scale: f64) -> Result<Self, Failure> {
+        let aspect = Graphic3dAspectMarker3d::new(kind, color, scale)?;
+        Ok(Self::from_aspect(Handle::new(aspect)))
+    }
+    /// A user marker from a bitmap texture; `Prs3dPointAspect::with_texture(red, 8, 8, bits)`.
+    pub fn with_texture(
+        color: Color,
+        width: i32,
+        height: i32,
+        texture: Handle<HArray1<u8>>,
+    ) -> Self {
+        let aspect = Graphic3dAspectMarker3d::from_bitmap(color, width, height, texture);
+        Self::from_aspect(Handle::new(aspect))
+    }
+    /// Wraps an existing Graphic3d aspect; `Prs3dPointAspect::from_aspect(aspect)`.
+    pub fn from_aspect(aspect: Handle<Graphic3dAspectMarker3d>) -> Self {
+        Self {
+            transient: StandardTransient::default(),
+            aspect: SharedState::new(aspect),
+        }
+    }
+    /// Sets the marker color; `aspect.set_color(red)`.
+    pub fn set_color(&self, color: Color) {
+        if let Some(aspect) = self.aspect().get() {
+            aspect.set_interior_color(color);
+        }
+    }
+    /// Sets the marker type; `aspect.set_type_of_marker(AspectTypeOfMarker::Ring1)`.
+    pub fn set_type_of_marker(&self, kind: AspectTypeOfMarker) {
+        if let Some(aspect) = self.aspect().get() {
+            aspect.set_marker_kind(kind);
+        }
+    }
+    /// Sets the scale (narrowed to float); a scale <= 0 raises `Standard_OutOfRange`.
+    /// Example: `aspect.set_scale(3.0)?`.
+    pub fn set_scale(&self, scale: f64) -> Result<(), Failure> {
+        match self.aspect().get() {
+            Some(aspect) => aspect.set_scale_f64(scale),
+            None => Ok(()),
+        }
+    }
+    /// The Graphic3d aspect; `aspect.aspect()`.
+    pub fn aspect(&self) -> Handle<Graphic3dAspectMarker3d> {
+        self.aspect.read().clone()
+    }
+    /// Replaces the Graphic3d aspect; `aspect.set_aspect(other)`.
+    pub fn set_aspect(&self, aspect: Handle<Graphic3dAspectMarker3d>) {
+        *self.aspect.write() = aspect;
+    }
+    /// `GetTextureSize`: `(width, height)` of the marker image; `aspect.get_texture_size()`.
+    pub fn get_texture_size(&self) -> (i32, i32) {
+        self.aspect()
+            .get()
+            .map_or((0, 0), Graphic3dAspectMarker3d::get_texture_size)
+    }
+    /// `GetTexture`: the marker image; `aspect.get_texture()`.
+    pub fn get_texture(&self) -> Handle<Graphic3dMarkerImage> {
+        self.aspect()
+            .get()
+            .map_or_else(Handle::default, Graphic3dAspectMarker3d::get_marker_image)
+    }
+}
+
+impl Prs3dBasicAspect for Prs3dPointAspect {
+    fn dump_json(&self, stream: &mut DumpStream, depth: i32) -> io::Result<()> {
+        class_begin(stream, "Prs3d_PointAspect")?;
+        dump_graphic_aspects(stream, depth, "myAspect.get()", &self.aspect())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use rustycad_tkernel::quantity::NamedColor;
+
+    #[test]
+    fn marker_setters_and_texture() {
+        let aspect = Prs3dPointAspect::new(
+            AspectTypeOfMarker::Plus,
+            Color::named(NamedColor::YELLOW),
+            1.0,
+        )
+        .unwrap();
+        aspect.set_type_of_marker(AspectTypeOfMarker::Star);
+        aspect.set_scale(2.0).unwrap();
+        aspect.set_color(Color::named(NamedColor::RED));
+        let graphic = aspect.aspect();
+        assert_eq!(graphic.marker_kind(), AspectTypeOfMarker::Star);
+        assert_eq!(graphic.scale(), 2.0);
+        assert!(aspect.set_scale(-1.0).is_err());
+        assert_eq!(aspect.get_texture_size(), (0, 0));
+        assert!(aspect.get_texture().is_null());
+        let bits = Handle::new(HArray1::<u8>::with_bounds(1, 8).unwrap());
+        bits.change_array1().init(0xFF);
+        let textured = Prs3dPointAspect::with_texture(Color::named(NamedColor::RED), 8, 8, bits);
+        assert_eq!(textured.get_texture_size(), (8, 8));
+    }
+}
diff --git a/crates/tkv3d/src/prs3d/presentation_shadow.rs b/crates/tkv3d/src/prs3d/presentation_shadow.rs
new file mode 100644
index 000000000..404c11c7d
--- /dev/null
+++ b/crates/tkv3d/src/prs3d/presentation_shadow.rs
@@ -0,0 +1,81 @@
+//! `Prs3d_PresentationShadow`: a structure that shares the groups of a parent structure (its
+//! shadow link) and remembers the parent's identifier and view affinity.
+use rustycad_tkernel::standard::dump::DumpStream;
+use rustycad_tkernel::standard::exceptions::null_object;
+use rustycad_tkernel::standard::{Failure, Handle, StandardTransient};
+use rustycad_tkservice::graphic3d::{
+    Graphic3dStructureBase, Graphic3dStructureManager, Graphic3dStructureMembers as _,
+    Graphic3dStructureSource, Graphic3dViewAffinity, graphic3d_structure_bind,
+    graphic3d_structure_dump_json,
+};
+use rustycad_tkservice::json_dump::{base_class, class_begin, field_dumped, field_integer};
+use std::io;
+
+/// A shadow of a presentation, for highlighting it in another structure manager.
+///
+/// Example: `let shadow = Prs3dPresentationShadow::new(&manager, &prs)?; shadow.parent_id();`.
+pub struct Prs3dPresentationShadow {
+    transient: StandardTransient,
+    base: Graphic3dStructureBase,
+    parent_affinity: Handle<Graphic3dViewAffinity>,
+    parent_struct_id: i32,
+}
+rustycad_tkernel::impl_transient!(Prs3dPresentationShadow, "Prs3d_PresentationShadow", dyn Graphic3dStructureSource, transient,
+    interfaces: [dyn Graphic3dStructureSource]);
+
+impl Prs3dPresentationShadow {
+    /// The shadow of `prs` in a structure manager; a null or removed parent is refused
+    /// (natively a null dereference). Example: `Prs3dPresentationShadow::new(&manager, &prs)?`.
+    pub fn new(
+        viewer: &Handle<Graphic3dStructureManager>,
+        prs: &Handle<dyn Graphic3dStructureSource>,
+    ) -> Result<Handle<Self>, Failure> {
+        let Some(parent) = prs.get() else {
+            return Err(null_object(
+                "Prs3d_PresentationShadow: null parent presentation; expected a structure",
+            ));
+        };
+        let base = Graphic3dStructureBase::new(viewer, prs)?;
+        let affinity = parent
+            .cstructure()
+            .get()
+            .map(|c| c.cstructure_base().fields.read().view_affinity.clone())
+            .unwrap_or_default();
+        let shadow = Handle::new(Self {
+            transient: StandardTransient::default(),
+            base,
+            parent_affinity: affinity,
+            parent_struct_id: parent.identification(),
+        });
+        graphic3d_structure_bind(&shadow.clone().cast());
+        Ok(shadow)
+    }
+    /// The identifier of the parent structure; `shadow.parent_id()`.
+    pub fn parent_id(&self) -> i32 {
+        self.parent_struct_id
+    }
+    /// The view affinity of the parent's driver structure; `shadow.parent_affinity()`.
+    pub fn parent_affinity(&self) -> Handle<Graphic3dViewAffinity> {
+        self.parent_affinity.clone()
+    }
+}
+
+impl Graphic3dStructureSource for Prs3dPresentationShadow {
+    fn structure_base(&self) -> &Graphic3dStructureBase {
+        &self.base
+    }
+    /// `CalculateBoundBox`: nothing; the shadow keeps the bounds of the shared groups.
+    fn calculate_bound_box(&self) {}
+    fn dump_json(&self, stream: &mut DumpStream, depth: i32) -> io::Result<()> {
+        class_begin(stream, "Prs3d_PresentationShadow")?;
+        base_class(stream, depth, &|s, d| {
+            graphic3d_structure_dump_json(self, s, d)
+        })?;
+        if let Some(affinity) = self.parent_affinity.get() {
+            field_dumped(stream, depth, "myParentAffinity.get()", &|s, d| {
+                affinity.dump_json(s, d)
+            })?;
+        }
+        field_integer(stream, "myParentStructId", self.parent_struct_id)
+    }
+}
diff --git a/crates/tkv3d/src/prs3d/root.rs b/crates/tkv3d/src/prs3d/root.rs
new file mode 100644
index 000000000..d5dac331b
--- /dev/null
+++ b/crates/tkv3d/src/prs3d/root.rs
@@ -0,0 +1,103 @@
+//! `Prs3d_Root` (the deprecated group helpers of the presentation algorithms) and the
+//! `Prs3d_Point` template (a point presentation over a point tool).
+use super::Prs3dDrawer;
+use rustycad_tkernel::standard::{Failure, Handle};
+use rustycad_tkservice::graphic3d::{
+    Graphic3dArrayOfPoints, Graphic3dGroup, Graphic3dGroupMembers as _,
+    Graphic3dStructureMembers as _, Graphic3dStructureSource,
+};
+use std::marker::PhantomData;
+
+/// The deprecated base of the presentation algorithms.
+pub struct Prs3dRoot;
+
+impl Prs3dRoot {
+    /// Deprecated `CurrentGroup`: the presentation's current group.
+    /// Example: `Prs3dRoot::current_group(&prs)?`.
+    pub fn current_group(
+        prs: &Handle<dyn Graphic3dStructureSource>,
+    ) -> Result<Handle<dyn Graphic3dGroup>, Failure> {
+        prs.get()
+            .map_or_else(|| Ok(Handle::default()), |s| s.current_group())
+    }
+    /// Deprecated `NewGroup`: a new group of the presentation; `Prs3dRoot::new_group(&prs)?`.
+    pub fn new_group(
+        prs: &Handle<dyn Graphic3dStructureSource>,
+    ) -> Result<Handle<dyn Graphic3dGroup>, Failure> {
+        prs.get()
+            .map_or_else(|| Ok(Handle::default()), |s| s.new_group())
+    }
+}
+
+/// The `PointTool` parameter of `Prs3d_Point`: reads the coordinates of a point type.
+pub trait Prs3dPointTool<P> {
+    /// `PointTool::Coord(point, x, y, z)`; `Tool::coord(&p)`.
+    fn coord(point: &P) -> (f64, f64, f64);
+}
+
+/// The `Prs3d_Point<AnyPoint, PointTool>` template: draws and matches one point.
+///
+/// Example: `Prs3dPoint::<MyPoint, MyTool>::add(&prs, &point, &drawer)?`.
+pub struct Prs3dPoint<P, T: Prs3dPointTool<P>> {
+    marker: PhantomData<(P, T)>,
+}
+
+impl<P, T: Prs3dPointTool<P>> Prs3dPoint<P, T> {
+    /// The private `DrawPoint`: one point primitive in the group.
+    fn draw_point(point: &P, group: &dyn Graphic3dGroup) -> Result<(), Failure> {
+        let (x, y, z) = T::coord(point);
+        let points = Graphic3dArrayOfPoints::new(1, 0)?;
+        points.add_vertex_f64(x, y, z)?;
+        group.add_primitive_array(&Handle::new(points).cast(), true);
+        Ok(())
+    }
+    /// `Add`: the point in the current group with the drawer's point aspect.
+    /// Example: `Prs3dPoint::<P, T>::add(&prs, &point, &drawer)?`.
+    pub fn add(
+        prs: &Handle<dyn Graphic3dStructureSource>,
+        point: &P,
+        drawer: &Handle<Prs3dDrawer>,
+    ) -> Result<(), Failure> {
+        let (Some(structure), Some(drawer)) = (prs.get(), drawer.get()) else {
+            return Ok(());
+        };
+        let group = structure.current_group()?;
+        let Some(group) = group.get() else {
+            return Ok(());
+        };
+        if let Some(aspect) = drawer.point_aspect().get() {
+            group.set_primitives_aspect(&aspect.aspect().cast());
+        }
+        Self::draw_point(point, group)
+    }
+    /// `Match`: whether the point is within `distance` of `(x, y, z)`.
+    /// Example: `Prs3dPoint::<P, T>::matches(&point, 0.0, 0.0, 0.0, 1.0)`.
+    pub fn matches(point: &P, x: f64, y: f64, z: f64, distance: f64) -> bool {
+        let (px, py, pz) = T::coord(point);
+        ((x - px) * (x - px) + (y - py) * (y - py) + (z - pz) * (z - pz)).sqrt() <= distance
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use rustycad_tkmath::gp::Point3;
+
+    struct GpPointTool;
+    impl Prs3dPointTool<Point3> for GpPointTool {
+        fn coord(point: &Point3) -> (f64, f64, f64) {
+            (point.x(), point.y(), point.z())
+        }
+    }
+
+    #[test]
+    fn match_uses_euclidean_distance() {
+        let point = Point3::new(1.0, 1.0, 1.0);
+        assert!(Prs3dPoint::<Point3, GpPointTool>::matches(
+            &point, 1.0, 1.0, 2.0, 1.0
+        ));
+        assert!(!Prs3dPoint::<Point3, GpPointTool>::matches(
+            &point, 1.0, 1.0, 2.5, 1.0
+        ));
+    }
+}
diff --git a/crates/tkv3d/src/prs3d/shading_aspect.rs b/crates/tkv3d/src/prs3d/shading_aspect.rs
new file mode 100644
index 000000000..beb5683af
--- /dev/null
+++ b/crates/tkv3d/src/prs3d/shading_aspect.rs
@@ -0,0 +1,255 @@
+//! `Prs3d_ShadingAspect`: the fill area attributes of shaded presentations.
+use super::basic_aspect::{Prs3dBasicAspect, dump_graphic_aspects};
+use rustycad_tkernel::quantity::{Color, ColorRgba};
+use rustycad_tkernel::standard::dump::DumpStream;
+use rustycad_tkernel::standard::{Failure, Handle, SharedState, StandardTransient};
+use rustycad_tkservice::aspect::{AspectInteriorStyle, AspectTypeOfFacingModel, AspectTypeOfLine};
+use rustycad_tkservice::graphic3d::{
+    Graphic3dAspectFillArea3d, Graphic3dAspectsMembers as _, Graphic3dAspectsRenderMembers as _,
+    Graphic3dMaterialAspect, Graphic3dNameOfMaterial, Graphic3dTypeOfMaterial,
+};
+use rustycad_tkservice::json_dump::class_begin;
+use std::io;
+
+/// The shading attributes of a presentation.
+///
+/// Example: `let aspect = Prs3dShadingAspect::new()?; aspect.set_color(red, AspectTypeOfFacingModel::BothSide)?;`.
+pub struct Prs3dShadingAspect {
+    transient: StandardTransient,
+    aspect: SharedState<Handle<Graphic3dAspectFillArea3d>>,
+}
+rustycad_tkernel::impl_transient!(Prs3dShadingAspect, "Prs3d_ShadingAspect", dyn Prs3dBasicAspect, transient,
+    interfaces: [dyn Prs3dBasicAspect]);
+
+/// Whether a facing model touches the front side.
+fn touches_front(model: AspectTypeOfFacingModel) -> bool {
+    matches!(
+        model,
+        AspectTypeOfFacingModel::FrontSide | AspectTypeOfFacingModel::BothSide
+    )
+}
+
+/// Whether a facing model touches the back side.
+fn touches_back(model: AspectTypeOfFacingModel) -> bool {
+    matches!(
+        model,
+        AspectTypeOfFacingModel::BackSide | AspectTypeOfFacingModel::BothSide
+    )
+}
+
+impl Prs3dShadingAspect {
+    /// The default: a solid interior of the brass ambient color with brass materials.
+    /// Example: `Prs3dShadingAspect::new()?`.
+    pub fn new() -> Result<Self, Failure> {
+        let material = Graphic3dMaterialAspect::new(Graphic3dNameOfMaterial::Brass);
+        let color = material.ambient_color();
+        let aspect = Graphic3dAspectFillArea3d::new(
+            AspectInteriorStyle::Solid,
+            color,
+            color,
+            AspectTypeOfLine::Solid,
+            1.0,
+            material.clone(),
+            material,
+        )?;
+        Ok(Self::from_aspect(Handle::new(aspect)))
+    }
+    /// Wraps an existing Graphic3d aspect; `Prs3dShadingAspect::from_aspect(aspect)`.
+    pub fn from_aspect(aspect: Handle<Graphic3dAspectFillArea3d>) -> Self {
+        Self {
+            transient: StandardTransient::default(),
+            aspect: SharedState::new(aspect),
+        }
+    }
+    /// `SetColor`: the material and interior colors of the chosen sides; a one-sided change
+    /// turns material distinction on. Example: `aspect.set_color(red, AspectTypeOfFacingModel::BothSide)?`.
+    pub fn set_color(&self, color: Color, model: AspectTypeOfFacingModel) -> Result<(), Failure> {
+        let aspect = self.aspect();
+        let Some(fill) = aspect.get() else {
+            return Ok(());
+        };
+        if model != AspectTypeOfFacingModel::BothSide {
+            fill.set_distinguish(true);
+        }
+        if touches_front(model) {
+            let mut material = fill.front_material();
+            material.set_color(color)?;
+            fill.set_front_material(material);
+            fill.set_interior_color(color);
+        }
+        if touches_back(model) {
+            let mut material = fill.back_material();
+            material.set_color(color)?;
+            fill.set_back_material(material);
+            fill.set_back_interior_color(color);
+        }
+        Ok(())
+    }
+    /// `Color`: the interior color of an `Aspect` material, else the material color.
+    /// Example: `aspect.color(AspectTypeOfFacingModel::FrontSide)`.
+    pub fn color(&self, model: AspectTypeOfFacingModel) -> Color {
+        let aspect = self.aspect();
+        let Some(fill) = aspect.get() else {
+            return Color::default();
+        };
+        let (material, interior) = if model == AspectTypeOfFacingModel::BackSide {
+            (fill.back_material(), fill.back_interior_color())
+        } else {
+            (fill.front_material(), fill.interior_color())
+        };
+        if material.material_type() == Graphic3dTypeOfMaterial::Aspect {
+            interior
+        } else {
+            material.color()
+        }
+    }
+    /// `SetMaterial` of the chosen sides; `aspect.set_material(&gold, AspectTypeOfFacingModel::FrontSide)`.
+    pub fn set_material(&self, material: &Graphic3dMaterialAspect, model: AspectTypeOfFacingModel) {
+        let aspect = self.aspect();
+        let Some(fill) = aspect.get() else {
+            return;
+        };
+        if model != AspectTypeOfFacingModel::BothSide {
+            fill.set_distinguish(true);
+        }
+        if touches_front(model) {
+            fill.set_front_material(material.clone());
+        }
+        if touches_back(model) {
+            fill.set_back_material(material.clone());
+        }
+    }
+    /// `Material` of a side (the front one for both sides); `aspect.material(AspectTypeOfFacingModel::BackSide)`.
+    pub fn material(&self, model: AspectTypeOfFacingModel) -> Graphic3dMaterialAspect {
+        let aspect = self.aspect();
+        let Some(fill) = aspect.get() else {
+            return Graphic3dMaterialAspect::default();
+        };
+        if model == AspectTypeOfFacingModel::BackSide {
+            fill.back_material()
+        } else {
+            fill.front_material()
+        }
+    }
+    /// `SetTransparency` of the materials and interior alphas of the chosen sides; a value
+    /// outside [0, 1] raises `Graphic3d_MaterialDefinitionError`.
+    /// Example: `aspect.set_transparency(0.5, AspectTypeOfFacingModel::BothSide)?`.
+    pub fn set_transparency(
+        &self,
+        value: f64,
+        model: AspectTypeOfFacingModel,
+    ) -> Result<(), Failure> {
+        let aspect = self.aspect();
+        let Some(fill) = aspect.get() else {
+            return Ok(());
+        };
+        if model != AspectTypeOfFacingModel::BothSide {
+            fill.set_distinguish(true);
+        }
+        let alpha = 1.0f32 - value as f32;
+        if touches_front(model) {
+            let mut material = fill.front_material();
+            material.set_transparency(value as f32)?;
+            fill.set_front_material(material);
+            fill.set_interior_color_rgba(ColorRgba::from_rgb(fill.interior_color(), alpha));
+        }
+        if touches_back(model) {
+            let mut material = fill.back_material();
+            material.set_transparency(value as f32)?;
+            fill.set_back_material(material);
+            fill.set_back_interior_color_rgba(ColorRgba::from_rgb(
+                fill.back_interior_color(),
+                alpha,
+            ));
+        }
+        Ok(())
+    }
+    /// `Transparency` of a side's material; `aspect.transparency(AspectTypeOfFacingModel::FrontSide)`.
+    pub fn transparency(&self, model: AspectTypeOfFacingModel) -> f64 {
+        f64::from(self.material(model).transparency())
+    }
+    /// `ToUseVertexColorForBackFaces`; `aspect.to_use_vertex_color_for_back_faces()`.
+    pub fn to_use_vertex_color_for_back_faces(&self) -> bool {
+        self.aspect()
+            .get()
+            .is_some_and(|fill| fill.to_use_vertex_color_for_back_faces())
+    }
+    /// `SetUseVertexColorForBackFaces`; `aspect.set_use_vertex_color_for_back_faces(true)`.
+    pub fn set_use_vertex_color_for_back_faces(&self, to_use: bool) {
+        if let Some(fill) = self.aspect().get() {
+            fill.set_use_vertex_color_for_back_faces(to_use);
+        }
+    }
+    /// The Graphic3d aspect; `aspect.aspect()`.
+    pub fn aspect(&self) -> Handle<Graphic3dAspectFillArea3d> {
+        self.aspect.read().clone()
+    }
+    /// Replaces the Graphic3d aspect; `aspect.set_aspect(other)`.
+    pub fn set_aspect(&self, aspect: Handle<Graphic3dAspectFillArea3d>) {
+        *self.aspect.write() = aspect;
+    }
+}
+
+impl Prs3dBasicAspect for Prs3dShadingAspect {
+    fn dump_json(&self, stream: &mut DumpStream, depth: i32) -> io::Result<()> {
+        class_begin(stream, "Prs3d_ShadingAspect")?;
+        dump_graphic_aspects(stream, depth, "myAspect.get()", &self.aspect())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use rustycad_tkernel::quantity::NamedColor;
+
+    #[test]
+    fn one_sided_color_turns_distinction_on() {
+        let aspect = Prs3dShadingAspect::new().unwrap();
+        assert!(!aspect.aspect().distinguish());
+        aspect
+            .set_color(
+                Color::named(NamedColor::RED),
+                AspectTypeOfFacingModel::BackSide,
+            )
+            .unwrap();
+        assert!(aspect.aspect().distinguish());
+        assert_eq!(
+            aspect.aspect().back_interior_color(),
+            Color::named(NamedColor::RED)
+        );
+    }
+
+    #[test]
+    fn transparency_updates_material_and_alpha() {
+        let aspect = Prs3dShadingAspect::new().unwrap();
+        aspect
+            .set_transparency(0.25, AspectTypeOfFacingModel::BothSide)
+            .unwrap();
+        assert_eq!(
+            aspect.transparency(AspectTypeOfFacingModel::FrontSide),
+            0.25
+        );
+        assert_eq!(aspect.transparency(AspectTypeOfFacingModel::BackSide), 0.25);
+        assert_eq!(aspect.aspect().interior_color_rgba().alpha(), 0.75);
+        assert!(
+            aspect
+                .set_transparency(2.0, AspectTypeOfFacingModel::FrontSide)
+                .is_err()
+        );
+    }
+
+    #[test]
+    fn material_selection_by_side() {
+        let aspect = Prs3dShadingAspect::new().unwrap();
+        let gold = Graphic3dMaterialAspect::new(Graphic3dNameOfMaterial::Gold);
+        aspect.set_material(&gold, AspectTypeOfFacingModel::FrontSide);
+        assert_eq!(
+            aspect.material(AspectTypeOfFacingModel::FrontSide).name(),
+            gold.name()
+        );
+        assert_ne!(
+            aspect.material(AspectTypeOfFacingModel::BackSide).name(),
+            gold.name()
+        );
+    }
+}
diff --git a/crates/tkv3d/src/prs3d/text.rs b/crates/tkv3d/src/prs3d/text.rs
new file mode 100644
index 000000000..34d80e235
--- /dev/null
+++ b/crates/tkv3d/src/prs3d/text.rs
@@ -0,0 +1,81 @@
+//! `Prs3d_Text`: adds a text with a text aspect to a group.
+use super::Prs3dTextAspect;
+use rustycad_tkernel::ncollection::String8;
+use rustycad_tkernel::standard::Handle;
+use rustycad_tkernel::tcollection::ExtendedString;
+use rustycad_tkmath::gp::{Axis2, Point3};
+use rustycad_tkservice::graphic3d::{Graphic3dGroup, Graphic3dText};
+
+/// The package class `Prs3d_Text`.
+pub struct Prs3dText;
+
+/// The UTF-8 text of `TCollection_ExtendedString::ToExtString()`, read up to its first NUL as
+/// the native `NCollection_String` constructor does.
+fn text_of(text: &ExtendedString) -> String8 {
+    let mut units = text.as_utf16().to_vec();
+    units.push(0);
+    String8::from_unicode_units(&units, -1)
+}
+
+/// A new text of the aspect's height and justification, after setting the group aspect.
+fn new_text(
+    group: &dyn Graphic3dGroup,
+    aspect: &Prs3dTextAspect,
+    text: &ExtendedString,
+) -> Handle<Graphic3dText> {
+    group.set_primitives_aspect(&aspect.aspect().cast());
+    let graphic = Graphic3dText::new(aspect.height() as f32);
+    graphic.set_text(&text_of(text));
+    Handle::new(graphic)
+}
+
+/// Sets the alignments and adds the text to the group.
+fn finish_text(group: &dyn Graphic3dGroup, aspect: &Prs3dTextAspect, text: &Handle<Graphic3dText>) {
+    if let Some(graphic) = text.get() {
+        graphic.set_horizontal_alignment(aspect.horizontal_justification());
+        graphic.set_vertical_alignment(aspect.vertical_justification());
+    }
+    group.add_text(text, true);
+}
+
+impl Prs3dText {
+    /// `Draw(group, aspect, text, attachmentPoint)`: a screen-aligned text at a point; null
+    /// when the group or the aspect is null (natively a null dereference).
+    /// Example: `Prs3dText::draw(&group, &aspect, &ExtendedString::new("A"), &p)`.
+    pub fn draw(
+        group: &Handle<dyn Graphic3dGroup>,
+        aspect: &Handle<Prs3dTextAspect>,
+        text: &ExtendedString,
+        attachment_point: &Point3,
+    ) -> Handle<Graphic3dText> {
+        let (Some(group), Some(aspect)) = (group.get(), aspect.get()) else {
+            return Handle::default();
+        };
+        let graphic = new_text(group, aspect, text);
+        if let Some(value) = graphic.get() {
+            value.set_position(attachment_point);
+        }
+        finish_text(group, aspect, &graphic);
+        graphic
+    }
+    /// `Draw(group, aspect, text, orientation, hasOwnAnchor)`: a text in a plane.
+    /// Example: `Prs3dText::draw_oriented(&group, &aspect, &text, &axes, true)`.
+    pub fn draw_oriented(
+        group: &Handle<dyn Graphic3dGroup>,
+        aspect: &Handle<Prs3dTextAspect>,
+        text: &ExtendedString,
+        orientation: &Axis2,
+        has_own_anchor: bool,
+    ) -> Handle<Graphic3dText> {
+        let (Some(group), Some(aspect)) = (group.get(), aspect.get()) else {
+            return Handle::default();
+        };
+        let graphic = new_text(group, aspect, text);
+        if let Some(value) = graphic.get() {
+            value.set_orientation(orientation);
+            value.set_own_anchor_point(has_own_anchor);
+        }
+        finish_text(group, aspect, &graphic);
+        graphic
+    }
+}
diff --git a/crates/tkv3d/src/prs3d/text_aspect.rs b/crates/tkv3d/src/prs3d/text_aspect.rs
new file mode 100644
index 000000000..53e7c5649
--- /dev/null
+++ b/crates/tkv3d/src/prs3d/text_aspect.rs
@@ -0,0 +1,189 @@
+//! `Prs3d_TextAspect`: the text attributes of a presentation.
+use super::basic_aspect::{Prs3dBasicAspect, dump_graphic_aspects};
+use rustycad_tkernel::quantity::{Color, NamedColor};
+use rustycad_tkernel::standard::dump::DumpStream;
+use rustycad_tkernel::standard::{Handle, SharedState, StandardTransient};
+use rustycad_tkernel::tcollection::AsciiString;
+use rustycad_tkservice::aspect::{AspectTypeOfDisplayText, AspectTypeOfStyleText};
+use rustycad_tkservice::graphic3d::{
+    Graphic3dAspectText3d, Graphic3dAspectsMembers as _, Graphic3dAspectsTextMembers as _,
+    Graphic3dHorizontalTextAlignment, Graphic3dTextPath, Graphic3dVerticalTextAlignment,
+};
+use rustycad_tkservice::json_dump::{class_begin, field_integer, field_real};
+use std::io;
+
+/// `Font_NOF_SERIF`, the font of the default text aspect.
+const FONT_NOF_SERIF: &str = "serif";
+
+/// The fields of a text aspect besides the Graphic3d aspect.
+#[derive(Clone, Copy)]
+struct Prs3dTextLayout {
+    height: f64,
+    horizontal: Graphic3dHorizontalTextAlignment,
+    vertical: Graphic3dVerticalTextAlignment,
+    orientation: Graphic3dTextPath,
+}
+
+impl Default for Prs3dTextLayout {
+    /// Height 16, left, bottom, rightwards.
+    fn default() -> Self {
+        Self {
+            height: 16.0,
+            horizontal: Graphic3dHorizontalTextAlignment::Left,
+            vertical: Graphic3dVerticalTextAlignment::Bottom,
+            orientation: Graphic3dTextPath::Right,
+        }
+    }
+}
+
+/// The text attributes of a presentation.
+///
+/// Example: `let aspect = Prs3dTextAspect::new(); aspect.set_height(12.0);`.
+pub struct Prs3dTextAspect {
+    transient: StandardTransient,
+    text_aspect: SharedState<Handle<Graphic3dAspectText3d>>,
+    layout: SharedState<Prs3dTextLayout>,
+}
+rustycad_tkernel::impl_transient!(Prs3dTextAspect, "Prs3d_TextAspect", dyn Prs3dBasicAspect, transient,
+    interfaces: [dyn Prs3dBasicAspect]);
+
+impl Default for Prs3dTextAspect {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+impl Prs3dTextAspect {
+    /// The default: yellow serif text of height 16; `Prs3dTextAspect::new()`.
+    pub fn new() -> Self {
+        let aspect = Graphic3dAspectText3d::new(
+            Color::named(NamedColor::YELLOW),
+            Some(FONT_NOF_SERIF),
+            1.0,
+            0.0,
+            AspectTypeOfStyleText::Normal,
+            AspectTypeOfDisplayText::Normal,
+        );
+        Self::from_aspect(Handle::new(aspect))
+    }
+    /// Wraps an existing Graphic3d text aspect; `Prs3dTextAspect::from_aspect(aspect)`.
+    pub fn from_aspect(aspect: Handle<Graphic3dAspectText3d>) -> Self {
+        Self {
+            transient: StandardTransient::default(),
+            text_aspect: SharedState::new(aspect),
+            layout: SharedState::new(Prs3dTextLayout::default()),
+        }
+    }
+    /// Sets the text color; `aspect.set_color(red)`.
+    pub fn set_color(&self, color: Color) {
+        if let Some(text) = self.aspect().get() {
+            text.set_interior_color(color);
+        }
+    }
+    /// Sets the font; `aspect.set_font("Arial")`.
+    pub fn set_font(&self, font: &str) {
+        if let Some(text) = self.aspect().get() {
+            text.set_font(&AsciiString::from(font));
+        }
+    }
+    /// Sets the height; `aspect.set_height(12.0)`.
+    pub fn set_height(&self, height: f64) {
+        self.layout.write().height = height;
+    }
+    /// Sets the angle of the Graphic3d aspect (narrowed to float); `aspect.set_angle(30.0)`.
+    pub fn set_angle(&self, angle: f64) {
+        if let Some(text) = self.aspect().get() {
+            text.set_text_angle_f64(angle);
+        }
+    }
+    /// The height; `aspect.height()`.
+    pub fn height(&self) -> f64 {
+        self.layout.read().height
+    }
+    /// The angle of the Graphic3d aspect; `aspect.angle()`.
+    pub fn angle(&self) -> f64 {
+        self.aspect()
+            .get()
+            .map_or(0.0, |text| f64::from(text.text_angle()))
+    }
+    /// Sets the horizontal justification; `aspect.set_horizontal_justification(Graphic3dHorizontalTextAlignment::Center)`.
+    pub fn set_horizontal_justification(&self, justification: Graphic3dHorizontalTextAlignment) {
+        self.layout.write().horizontal = justification;
+    }
+    /// Sets the vertical justification; `aspect.set_vertical_justification(Graphic3dVerticalTextAlignment::Top)`.
+    pub fn set_vertical_justification(&self, justification: Graphic3dVerticalTextAlignment) {
+        self.layout.write().vertical = justification;
+    }
+    /// Sets the orientation; `aspect.set_orientation(Graphic3dTextPath::Up)`.
+    pub fn set_orientation(&self, orientation: Graphic3dTextPath) {
+        self.layout.write().orientation = orientation;
+    }
+    /// The horizontal justification; `aspect.horizontal_justification()`.
+    pub fn horizontal_justification(&self) -> Graphic3dHorizontalTextAlignment {
+        self.layout.read().horizontal
+    }
+    /// The vertical justification; `aspect.vertical_justification()`.
+    pub fn vertical_justification(&self) -> Graphic3dVerticalTextAlignment {
+        self.layout.read().vertical
+    }
+    /// The orientation; `aspect.orientation()`.
+    pub fn orientation(&self) -> Graphic3dTextPath {
+        self.layout.read().orientation
+    }
+    /// The Graphic3d aspect; `aspect.aspect()`.
+    pub fn aspect(&self) -> Handle<Graphic3dAspectText3d> {
+        self.text_aspect.read().clone()
+    }
+    /// Replaces the Graphic3d aspect; `aspect.set_aspect(other)`.
+    pub fn set_aspect(&self, aspect: Handle<Graphic3dAspectText3d>) {
+        *self.text_aspect.write() = aspect;
+    }
+}
+
+impl Prs3dBasicAspect for Prs3dTextAspect {
+    fn dump_json(&self, stream: &mut DumpStream, depth: i32) -> io::Result<()> {
+        class_begin(stream, "Prs3d_TextAspect")?;
+        dump_graphic_aspects(stream, depth, "myTextAspect.get()", &self.aspect())?;
+        let layout = *self.layout.read();
+        field_real(stream, "myHeight", layout.height)?;
+        field_integer(
+            stream,
+            "myHorizontalJustification",
+            layout.horizontal as i32,
+        )?;
+        field_integer(stream, "myVerticalJustification", layout.vertical as i32)?;
+        field_integer(stream, "myOrientation", layout.orientation as i32)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn defaults_and_setters() {
+        let aspect = Prs3dTextAspect::new();
+        assert_eq!(aspect.height(), 16.0);
+        assert_eq!(aspect.aspect().font().as_bytes(), b"serif");
+        aspect.set_font("Arial");
+        aspect.set_angle(30.0);
+        aspect.set_height(10.0);
+        aspect.set_horizontal_justification(Graphic3dHorizontalTextAlignment::Center);
+        aspect.set_vertical_justification(Graphic3dVerticalTextAlignment::Top);
+        aspect.set_orientation(Graphic3dTextPath::Up);
+        assert_eq!(aspect.aspect().font().as_bytes(), b"Arial");
+        assert_eq!(aspect.angle(), 30.0);
+        assert_eq!(
+            aspect.horizontal_justification(),
+            Graphic3dHorizontalTextAlignment::Center
+        );
+        assert_eq!(
+            aspect.vertical_justification(),
+            Graphic3dVerticalTextAlignment::Top
+        );
+        assert_eq!(aspect.orientation(), Graphic3dTextPath::Up);
+        let mut stream = DumpStream::default();
+        aspect.dump_json(&mut stream, 0).unwrap();
+        assert!(stream.text().ends_with("\"Height\": 10, \"HorizontalJustification\": 1, \"VerticalJustification\": 2, \"Orientation\": 0"));
+    }
+}
diff --git a/crates/tkv3d/src/prs3d/tool_quadric.rs b/crates/tkv3d/src/prs3d/tool_quadric.rs
new file mode 100644
index 000000000..6aac17435
--- /dev/null
+++ b/crates/tkv3d/src/prs3d/tool_quadric.rs
@@ -0,0 +1,201 @@
+//! `Prs3d_ToolQuadric`: the triangulation of a parametric quadric over a grid of slices (U)
+//! and stacks (V). The abstract class is a trait; the concrete tools (cylinder, disk,
+//! sphere, torus, sector) implement `vertex` and `normal`.
+use rustycad_tkernel::standard::{Failure, Handle};
+use rustycad_tkmath::gp::{Direction3, Point3, Transform3};
+use rustycad_tkmath::poly::{Triangle, Triangulation};
+use rustycad_tkservice::graphic3d::{
+    GRAPHIC3D_ARRAY_FLAGS_VERTEX_NORMAL, Graphic3dArrayOfTriangles,
+};
+
+/// `Prs3d_ToolQuadric::TrianglesNb(slices, stacks)`; `prs3d_quadric_triangles_nb(12, 1) == 24`.
+pub fn prs3d_quadric_triangles_nb(slices_nb: i32, stacks_nb: i32) -> i32 {
+    slices_nb * stacks_nb * 2
+}
+
+/// `Prs3d_ToolQuadric::VerticesNb(slices, stacks, indexed)`: the grid nodes when indexed, else
+/// three per triangle; `prs3d_quadric_vertices_nb(12, 1, true) == 26`.
+pub fn prs3d_quadric_vertices_nb(slices_nb: i32, stacks_nb: i32, is_indexed: bool) -> i32 {
+    if is_indexed {
+        (slices_nb + 1) * (stacks_nb + 1)
+    } else {
+        prs3d_quadric_triangles_nb(slices_nb, stacks_nb) * 3
+    }
+}
+
+/// A parametric quadric tool; `vertex` and `normal` are the native pure virtuals, the provided
+/// members are the native non-virtual ones.
+pub trait Prs3dToolQuadric {
+    /// `mySlicesNb`: the slices along U.
+    fn slices_nb(&self) -> i32;
+    /// `myStacksNb`: the stacks along V.
+    fn stacks_nb(&self) -> i32;
+    /// `Vertex(U, V)` in the local frame; `tool.vertex(0.5, 0.5)`.
+    fn vertex(&self, u: f64, v: f64) -> Point3;
+    /// `Normal(U, V)`; a null normal raises `Standard_ConstructionError` (the `gp_Dir` constructor).
+    /// Example: `tool.normal(0.5, 0.5)?`.
+    fn normal(&self, u: f64, v: f64) -> Result<Direction3, Failure>;
+    /// `TrianglesNb()`; `tool.triangles_nb()`.
+    fn triangles_nb(&self) -> i32 {
+        prs3d_quadric_triangles_nb(self.slices_nb(), self.stacks_nb())
+    }
+    /// `VerticesNb(indexed)`; `tool.vertices_nb(true)`.
+    fn vertices_nb(&self, is_indexed: bool) -> i32 {
+        prs3d_quadric_vertices_nb(self.slices_nb(), self.stacks_nb(), is_indexed)
+    }
+    /// `FillArray(array, trsf)`: creates an indexed array with normals when null, then adds the
+    /// grid vertices (with triangle edges when the array has edges, else six vertices per
+    /// cell). Example: `tool.fill_array(&mut array, &trsf)?`.
+    fn fill_array(
+        &self,
+        array: &mut Handle<Graphic3dArrayOfTriangles>,
+        trsf: &Transform3,
+    ) -> Result<(), Failure> {
+        if array.is_null() {
+            let created = Graphic3dArrayOfTriangles::new(
+                self.vertices_nb(true),
+                self.triangles_nb() * 3,
+                GRAPHIC3D_ARRAY_FLAGS_VERTEX_NORMAL,
+            )?;
+            *array = Handle::new(created);
+        }
+        let Some(triangles) = array.get() else {
+            return Ok(());
+        };
+        if triangles.edge_number_allocated() > 0 {
+            fill_indexed(self, triangles, trsf)
+        } else {
+            fill_unindexed(self, triangles, trsf)
+        }
+    }
+    /// `CreateTriangulation(trsf)`: a new array filled by `FillArray`; `tool.create_triangulation(&trsf)?`.
+    fn create_triangulation(
+        &self,
+        trsf: &Transform3,
+    ) -> Result<Handle<Graphic3dArrayOfTriangles>, Failure> {
+        let mut array = Handle::default();
+        self.fill_array(&mut array, trsf)?;
+        Ok(array)
+    }
+    /// `CreatePolyTriangulation(trsf)`: the grid nodes and triangles as a `Poly_Triangulation`.
+    /// Example: `tool.create_poly_triangulation(&trsf)?`.
+    fn create_poly_triangulation(
+        &self,
+        trsf: &Transform3,
+    ) -> Result<Handle<Triangulation>, Failure> {
+        let triangulation =
+            Triangulation::with_sizes(self.vertices_nb(true), self.triangles_nb(), false, false)?;
+        let (slices, stacks) = (self.slices_nb(), self.stacks_nb());
+        let step_u = 1.0 / f64::from(slices);
+        // The native V step is a float; its products are float too.
+        let step_v = 1.0f32 / stacks as f32;
+        let mut index = 0;
+        for u in 0..=slices {
+            let param_u = f64::from(u) * step_u;
+            for v in 0..=stacks {
+                let param_v = v as f32 * step_v;
+                let vert_id = u * (stacks + 1) + (v + 1);
+                triangulation.set_node(
+                    vert_id,
+                    self.vertex(param_u, f64::from(param_v)).transformed(*trsf),
+                )?;
+                if u != 0 && v != 0 {
+                    index += 1;
+                    triangulation.set_triangle(
+                        index,
+                        Triangle::new(vert_id, vert_id - stacks - 2, vert_id - 1),
+                    )?;
+                    index += 1;
+                    triangulation.set_triangle(
+                        index,
+                        Triangle::new(vert_id - stacks - 2, vert_id, vert_id - stacks - 1),
+                    )?;
+                }
+            }
+        }
+        Ok(Handle::new(triangulation))
+    }
+    /// The deprecated `FillArray(array, triangulation, trsf)`: both representations.
+    /// Example: `tool.fill_array_and_triangulation(&mut array, &mut triangulation, &trsf)?`.
+    fn fill_array_and_triangulation(
+        &self,
+        array: &mut Handle<Graphic3dArrayOfTriangles>,
+        triangulation: &mut Handle<Triangulation>,
+        trsf: &Transform3,
+    ) -> Result<(), Failure> {
+        *array = self.create_triangulation(trsf)?;
+        *triangulation = self.create_poly_triangulation(trsf)?;
+        Ok(())
+    }
+}
+
+/// The native float parameter steps of `FillArray` (`1.0f / n`, widened to double).
+fn float_steps(slices: i32, stacks: i32) -> (f64, f64) {
+    (
+        f64::from(1.0f32 / slices as f32),
+        f64::from(1.0f32 / stacks as f32),
+    )
+}
+
+/// Adds the transformed vertex and normal at `(u, v)`.
+fn add_node<T: Prs3dToolQuadric + ?Sized>(
+    tool: &T,
+    array: &Graphic3dArrayOfTriangles,
+    trsf: &Transform3,
+    u: f64,
+    v: f64,
+) -> Result<i32, Failure> {
+    let vertex = tool.vertex(u, v).transformed(*trsf);
+    let normal = tool.normal(u, v)?.transformed(*trsf);
+    array.add_vertex_pnt_normal(&vertex, &normal)
+}
+
+/// The indexed branch of `FillArray`: one vertex per grid node, two triangles per cell.
+fn fill_indexed<T: Prs3dToolQuadric + ?Sized>(
+    tool: &T,
+    array: &Graphic3dArrayOfTriangles,
+    trsf: &Transform3,
+) -> Result<(), Failure> {
+    let (slices, stacks) = (tool.slices_nb(), tool.stacks_nb());
+    let (step_u, step_v) = float_steps(slices, stacks);
+    for u in 0..=slices {
+        let param_u = f64::from(u) * step_u;
+        for v in 0..=stacks {
+            add_node(tool, array, trsf, param_u, f64::from(v) * step_v)?;
+            if u != 0 && v != 0 {
+                let id = array.vertex_number();
+                array.add_triangle_edges(id, id - stacks - 2, id - 1)?;
+                array.add_triangle_edges(id - stacks - 2, id, id - stacks - 1)?;
+            }
+        }
+    }
+    Ok(())
+}
+
+/// The non-indexed branch of `FillArray`: six vertices per cell.
+fn fill_unindexed<T: Prs3dToolQuadric + ?Sized>(
+    tool: &T,
+    array: &Graphic3dArrayOfTriangles,
+    trsf: &Transform3,
+) -> Result<(), Failure> {
+    let (slices, stacks) = (tool.slices_nb(), tool.stacks_nb());
+    let (step_u, step_v) = float_steps(slices, stacks);
+    for u in 0..slices {
+        let param_u = f64::from(u) * step_u;
+        for v in 0..stacks {
+            let param_v = f64::from(v) * step_v;
+            let corners = [
+                (param_u, param_v),
+                (param_u + step_u, param_v),
+                (param_u + step_u, param_v + step_v),
+                (param_u + step_u, param_v + step_v),
+                (param_u, param_v + step_v),
+                (param_u, param_v),
+            ];
+            for (cu, cv) in corners {
+                add_node(tool, array, trsf, cu, cv)?;
+            }
+        }
+    }
+    Ok(())
+}
diff --git a/crates/tkv3d/src/prs3d/tools.rs b/crates/tkv3d/src/prs3d/tools.rs
new file mode 100644
index 000000000..e82b2156b
--- /dev/null
+++ b/crates/tkv3d/src/prs3d/tools.rs
@@ -0,0 +1,470 @@
+//! The concrete quadric tools: `Prs3d_ToolCylinder`, `Prs3d_ToolDisk`, `Prs3d_ToolSphere`,
+//! `Prs3d_ToolTorus` and `Prs3d_ToolSector`.
+use super::Prs3dToolQuadric;
+use rustycad_tkernel::standard::{Failure, Handle};
+use rustycad_tkmath::gp::{Direction3, Point3, StandardDirection3, Transform3};
+use rustycad_tkservice::graphic3d::Graphic3dArrayOfTriangles;
+use std::f64::consts::PI;
+
+/// `Create`: a new array filled by a tool.
+fn create_with<T: Prs3dToolQuadric>(
+    tool: &T,
+    trsf: &Transform3,
+) -> Result<Handle<Graphic3dArrayOfTriangles>, Failure> {
+    let mut array = Handle::default();
+    tool.fill_array(&mut array, trsf)?;
+    Ok(array)
+}
+
+/// A cylinder or cone along Z from the bottom radius at 0 to the top radius at the height.
+///
+/// Example: `Prs3dToolCylinder::new(1.0, 0.5, 2.0, 12, 1).create_triangulation(&trsf)?`.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Prs3dToolCylinder {
+    bottom_radius: f64,
+    top_radius: f64,
+    height: f64,
+    slices_nb: i32,
+    stacks_nb: i32,
+}
+
+impl Prs3dToolCylinder {
+    /// A cylinder tool; `Prs3dToolCylinder::new(1.0, 1.0, 2.0, 12, 1)`.
+    pub fn new(bottom_rad: f64, top_rad: f64, height: f64, nb_slices: i32, nb_stacks: i32) -> Self {
+        Self {
+            bottom_radius: bottom_rad,
+            top_radius: top_rad,
+            height,
+            slices_nb: nb_slices,
+            stacks_nb: nb_stacks,
+        }
+    }
+    /// `Create`: the triangles of a cylinder; `Prs3dToolCylinder::create(1.0, 1.0, 2.0, 12, 1, &trsf)?`.
+    pub fn create(
+        bottom_rad: f64,
+        top_rad: f64,
+        height: f64,
+        nb_slices: i32,
+        nb_stacks: i32,
+        trsf: &Transform3,
+    ) -> Result<Handle<Graphic3dArrayOfTriangles>, Failure> {
+        create_with(
+            &Self::new(bottom_rad, top_rad, height, nb_slices, nb_stacks),
+            trsf,
+        )
+    }
+}
+
+impl Prs3dToolQuadric for Prs3dToolCylinder {
+    fn slices_nb(&self) -> i32 {
+        self.slices_nb
+    }
+    fn stacks_nb(&self) -> i32 {
+        self.stacks_nb
+    }
+    fn vertex(&self, u: f64, v: f64) -> Point3 {
+        let angle = u * PI * 2.0;
+        let radius = self.bottom_radius + (self.top_radius - self.bottom_radius) * v;
+        Point3::new(angle.cos() * radius, angle.sin() * radius, v * self.height)
+    }
+    fn normal(&self, u: f64, _v: f64) -> Result<Direction3, Failure> {
+        let angle = u * PI * 2.0;
+        Direction3::new(
+            angle.cos() * self.height,
+            angle.sin() * self.height,
+            self.bottom_radius - self.top_radius,
+        )
+    }
+}
+
+/// A flat ring (a disk for a zero inner radius) in the XY plane, facing -Z.
+///
+/// Example: `let mut disk = Prs3dToolDisk::new(0.0, 1.0, 12, 1); disk.set_angle_range(0.0, PI);`.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Prs3dToolDisk {
+    inner_radius: f64,
+    outer_radius: f64,
+    start_angle: f64,
+    end_angle: f64,
+    slices_nb: i32,
+    stacks_nb: i32,
+}
+
+impl Prs3dToolDisk {
+    /// A full disk tool; `Prs3dToolDisk::new(0.5, 1.0, 12, 1)`.
+    pub fn new(inner_radius: f64, outer_radius: f64, nb_slices: i32, nb_stacks: i32) -> Self {
+        Self {
+            inner_radius,
+            outer_radius,
+            start_angle: 0.0,
+            end_angle: PI * 2.0,
+            slices_nb: nb_slices,
+            stacks_nb: nb_stacks,
+        }
+    }
+    /// Sets the counterclockwise angle range; `disk.set_angle_range(0.0, PI)`.
+    pub fn set_angle_range(&mut self, start_angle: f64, end_angle: f64) {
+        (self.start_angle, self.end_angle) = (start_angle, end_angle);
+    }
+    /// `Create`: the triangles of a full disk; `Prs3dToolDisk::create(0.0, 1.0, 12, 1, &trsf)?`.
+    pub fn create(
+        inner_radius: f64,
+        outer_radius: f64,
+        nb_slices: i32,
+        nb_stacks: i32,
+        trsf: &Transform3,
+    ) -> Result<Handle<Graphic3dArrayOfTriangles>, Failure> {
+        create_with(
+            &Self::new(inner_radius, outer_radius, nb_slices, nb_stacks),
+            trsf,
+        )
+    }
+}
+
+impl Prs3dToolQuadric for Prs3dToolDisk {
+    fn slices_nb(&self) -> i32 {
+        self.slices_nb
+    }
+    fn stacks_nb(&self) -> i32 {
+        self.stacks_nb
+    }
+    fn vertex(&self, u: f64, v: f64) -> Point3 {
+        let angle = self.start_angle + u * (self.end_angle - self.start_angle);
+        let radius = self.inner_radius + (self.outer_radius - self.inner_radius) * v;
+        Point3::new(angle.cos() * radius, angle.sin() * radius, 0.0)
+    }
+    fn normal(&self, _u: f64, _v: f64) -> Result<Direction3, Failure> {
+        Ok(Direction3::from(StandardDirection3::NegZ))
+    }
+}
+
+/// A sphere centered at the origin.
+///
+/// Example: `Prs3dToolSphere::create(1.0, 12, 6, &trsf)?`.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Prs3dToolSphere {
+    radius: f64,
+    slices_nb: i32,
+    stacks_nb: i32,
+}
+
+impl Prs3dToolSphere {
+    /// A sphere tool; `Prs3dToolSphere::new(1.0, 12, 6)`.
+    pub fn new(radius: f64, nb_slices: i32, nb_stacks: i32) -> Self {
+        Self {
+            radius,
+            slices_nb: nb_slices,
+            stacks_nb: nb_stacks,
+        }
+    }
+    /// `Create`: the triangles of a sphere; `Prs3dToolSphere::create(1.0, 12, 6, &trsf)?`.
+    pub fn create(
+        radius: f64,
+        nb_slices: i32,
+        nb_stacks: i32,
+        trsf: &Transform3,
+    ) -> Result<Handle<Graphic3dArrayOfTriangles>, Failure> {
+        create_with(&Self::new(radius, nb_slices, nb_stacks), trsf)
+    }
+}
+
+impl Prs3dToolQuadric for Prs3dToolSphere {
+    fn slices_nb(&self) -> i32 {
+        self.slices_nb
+    }
+    fn stacks_nb(&self) -> i32 {
+        self.stacks_nb
+    }
+    fn vertex(&self, u: f64, v: f64) -> Point3 {
+        let (a_u, a_v) = (u * PI * 2.0, v * PI);
+        Point3::new(
+            self.radius * a_u.cos() * a_v.sin(),
+            -self.radius * a_u.sin() * a_v.sin(),
+            self.radius * a_v.cos(),
+        )
+    }
+    fn normal(&self, u: f64, v: f64) -> Result<Direction3, Failure> {
+        let (a_u, a_v) = (u * PI * 2.0, v * PI);
+        Direction3::new(a_u.cos() * a_v.sin(), -a_u.sin() * a_v.sin(), a_v.cos())
+    }
+}
+
+/// A torus (or a segment of it) around Z.
+///
+/// Example: `Prs3dToolTorus::new(2.0, 0.5, 0.0, PI * 2.0, PI * 2.0, 24, 12)`.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Prs3dToolTorus {
+    major_radius: f64,
+    minor_radius: f64,
+    angle: f64,
+    v_min: f64,
+    v_max: f64,
+    slices_nb: i32,
+    stacks_nb: i32,
+}
+
+impl Prs3dToolTorus {
+    /// The general torus tool (`init`): a ring segment `[angle1, angle2]` of a pipe segment
+    /// `angle`; `Prs3dToolTorus::new(2.0, 0.5, 0.0, PI, PI * 2.0, 24, 12)`.
+    pub fn new(
+        major_rad: f64,
+        minor_rad: f64,
+        angle1: f64,
+        angle2: f64,
+        angle: f64,
+        nb_slices: i32,
+        nb_stacks: i32,
+    ) -> Self {
+        Self {
+            major_radius: major_rad,
+            minor_radius: minor_rad,
+            angle,
+            v_min: angle1,
+            v_max: angle2,
+            slices_nb: nb_slices,
+            stacks_nb: nb_stacks,
+        }
+    }
+    /// A full torus; `Prs3dToolTorus::full(2.0, 0.5, 24, 12)`.
+    pub fn full(major_rad: f64, minor_rad: f64, nb_slices: i32, nb_stacks: i32) -> Self {
+        Self::new(
+            major_rad,
+            minor_rad,
+            0.0,
+            PI * 2.0,
+            PI * 2.0,
+            nb_slices,
+            nb_stacks,
+        )
+    }
+    /// A pipe segment of `angle`; `Prs3dToolTorus::with_angle(2.0, 0.5, PI, 24, 12)`.
+    pub fn with_angle(
+        major_rad: f64,
+        minor_rad: f64,
+        angle: f64,
+        nb_slices: i32,
+        nb_stacks: i32,
+    ) -> Self {
+        Self::new(
+            major_rad,
+            minor_rad,
+            0.0,
+            PI * 2.0,
+            angle,
+            nb_slices,
+            nb_stacks,
+        )
+    }
+    /// A ring segment `[angle1, angle2]` of a full pipe; `Prs3dToolTorus::with_ring(2.0, 0.5, 0.0, PI, 24, 12)`.
+    pub fn with_ring(
+        major_rad: f64,
+        minor_rad: f64,
+        angle1: f64,
+        angle2: f64,
+        nb_slices: i32,
+        nb_stacks: i32,
+    ) -> Self {
+        Self::new(
+            major_rad,
+            minor_rad,
+            angle1,
+            angle2,
+            PI * 2.0,
+            nb_slices,
+            nb_stacks,
+        )
+    }
+    /// `Create` of the general torus; `Prs3dToolTorus::create(2.0, 0.5, 0.0, PI, PI, 24, 12, &trsf)?`.
+    #[allow(clippy::too_many_arguments)]
+    pub fn create(
+        major_rad: f64,
+        minor_rad: f64,
+        angle1: f64,
+        angle2: f64,
+        angle: f64,
+        nb_slices: i32,
+        nb_stacks: i32,
+        trsf: &Transform3,
+    ) -> Result<Handle<Graphic3dArrayOfTriangles>, Failure> {
+        create_with(
+            &Self::new(
+                major_rad, minor_rad, angle1, angle2, angle, nb_slices, nb_stacks,
+            ),
+            trsf,
+        )
+    }
+    /// `Create` of a full torus; `Prs3dToolTorus::create_full(2.0, 0.5, 24, 12, &trsf)?`.
+    pub fn create_full(
+        major_rad: f64,
+        minor_rad: f64,
+        nb_slices: i32,
+        nb_stacks: i32,
+        trsf: &Transform3,
+    ) -> Result<Handle<Graphic3dArrayOfTriangles>, Failure> {
+        Self::create(
+            major_rad,
+            minor_rad,
+            0.0,
+            PI * 2.0,
+            PI * 2.0,
+            nb_slices,
+            nb_stacks,
+            trsf,
+        )
+    }
+    /// `Create` of a pipe segment; `Prs3dToolTorus::create_with_angle(2.0, 0.5, PI, 24, 12, &trsf)?`.
+    pub fn create_with_angle(
+        major_rad: f64,
+        minor_rad: f64,
+        angle: f64,
+        nb_slices: i32,
+        nb_stacks: i32,
+        trsf: &Transform3,
+    ) -> Result<Handle<Graphic3dArrayOfTriangles>, Failure> {
+        Self::create(
+            major_rad,
+            minor_rad,
+            0.0,
+            PI * 2.0,
+            angle,
+            nb_slices,
+            nb_stacks,
+            trsf,
+        )
+    }
+    /// `Create` of a ring segment; `Prs3dToolTorus::create_with_ring(2.0, 0.5, 0.0, PI, 24, 12, &trsf)?`.
+    #[allow(clippy::too_many_arguments)]
+    pub fn create_with_ring(
+        major_rad: f64,
+        minor_rad: f64,
+        angle1: f64,
+        angle2: f64,
+        nb_slices: i32,
+        nb_stacks: i32,
+        trsf: &Transform3,
+    ) -> Result<Handle<Graphic3dArrayOfTriangles>, Failure> {
+        Self::create(
+            major_rad,
+            minor_rad,
+            angle1,
+            angle2,
+            PI * 2.0,
+            nb_slices,
+            nb_stacks,
+            trsf,
+        )
+    }
+}
+
+impl Prs3dToolQuadric for Prs3dToolTorus {
+    fn slices_nb(&self) -> i32 {
+        self.slices_nb
+    }
+    fn stacks_nb(&self) -> i32 {
+        self.stacks_nb
+    }
+    fn vertex(&self, u: f64, v: f64) -> Point3 {
+        let a_u = u * self.angle;
+        let a_v = self.v_min + v * (self.v_max - self.v_min);
+        Point3::new(
+            (self.major_radius + self.minor_radius * a_v.cos()) * a_u.cos(),
+            (self.major_radius + self.minor_radius * a_v.cos()) * a_u.sin(),
+            self.minor_radius * a_v.sin(),
+        )
+    }
+    fn normal(&self, u: f64, v: f64) -> Result<Direction3, Failure> {
+        let a_u = u * self.angle;
+        let a_v = self.v_min + v * (self.v_max - self.v_min);
+        Direction3::new(a_u.cos() * a_v.cos(), a_u.sin() * a_v.cos(), a_v.sin())
+    }
+}
+
+/// A quarter disk sector in the XY plane, facing -Z.
+///
+/// Example: `Prs3dToolSector::create(1.0, 12, 1, &trsf)?`.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Prs3dToolSector {
+    radius: f64,
+    slices_nb: i32,
+    stacks_nb: i32,
+}
+
+impl Prs3dToolSector {
+    /// A sector tool; `Prs3dToolSector::new(1.0, 12, 1)`.
+    pub fn new(radius: f64, nb_slices: i32, nb_stacks: i32) -> Self {
+        Self {
+            radius,
+            slices_nb: nb_slices,
+            stacks_nb: nb_stacks,
+        }
+    }
+    /// `Create`: the triangles of a sector; `Prs3dToolSector::create(1.0, 12, 1, &trsf)?`.
+    pub fn create(
+        radius: f64,
+        nb_slices: i32,
+        nb_stacks: i32,
+        trsf: &Transform3,
+    ) -> Result<Handle<Graphic3dArrayOfTriangles>, Failure> {
+        create_with(&Self::new(radius, nb_slices, nb_stacks), trsf)
+    }
+}
+
+impl Prs3dToolQuadric for Prs3dToolSector {
+    fn slices_nb(&self) -> i32 {
+        self.slices_nb
+    }
+    fn stacks_nb(&self) -> i32 {
+        self.stacks_nb
+    }
+    fn vertex(&self, u: f64, v: f64) -> Point3 {
+        let angle = u * PI / 2.0;
+        let radius = self.radius * v;
+        Point3::new(angle.cos() * radius, angle.sin() * radius, 0.0)
+    }
+    fn normal(&self, _u: f64, _v: f64) -> Result<Direction3, Failure> {
+        Ok(Direction3::from(StandardDirection3::NegZ))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn counts_and_grid_layout() {
+        let cylinder = Prs3dToolCylinder::new(1.0, 1.0, 2.0, 4, 2);
+        assert_eq!(cylinder.triangles_nb(), 16);
+        assert_eq!(cylinder.vertices_nb(true), 15);
+        assert_eq!(cylinder.vertices_nb(false), 48);
+        let array = cylinder
+            .create_triangulation(&Transform3::default())
+            .unwrap();
+        assert_eq!(array.vertex_number(), 15);
+        assert_eq!(array.edge_number(), 48);
+        let poly = cylinder
+            .create_poly_triangulation(&Transform3::default())
+            .unwrap();
+        assert_eq!((poly.nb_nodes(), poly.nb_triangles()), (15, 16));
+    }
+
+    #[test]
+    fn null_normals_raise() {
+        let flat = Prs3dToolCylinder::new(1.0, 1.0, 0.0, 4, 1);
+        assert!(flat.create_triangulation(&Transform3::default()).is_err());
+        let disk = Prs3dToolDisk::create(0.0, 1.0, 4, 1, &Transform3::default()).unwrap();
+        assert_eq!(disk.vertex_number(), 10);
+    }
+
+    #[test]
+    fn sphere_torus_and_sector_vertices() {
+        let sphere = Prs3dToolSphere::new(2.0, 4, 2);
+        assert_eq!(sphere.vertex(0.0, 0.0), Point3::new(0.0, -0.0, 2.0));
+        let torus = Prs3dToolTorus::full(2.0, 0.5, 4, 4);
+        assert_eq!(torus.vertex(0.0, 0.0), Point3::new(2.5, 0.0, 0.0));
+        let sector = Prs3dToolSector::new(1.0, 2, 1);
+        assert_eq!(sector.vertex(0.0, 1.0), Point3::new(1.0, 0.0, 0.0));
+        assert!(
+            Prs3dToolTorus::create_with_angle(2.0, 0.5, PI, 4, 4, &Transform3::default()).is_ok()
+        );
+    }
+}
