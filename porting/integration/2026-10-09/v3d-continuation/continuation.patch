+    Nb = 6,
+}
+
+/// `Prs3d_TypeOfHLR`: the hidden line removal algorithm.
+#[repr(i32)]
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub enum Prs3dTypeOfHlr {
