+//! `PrsMgr_PresentationManager`: displays, erases, highlights and updates the presentations of
+//! presentable objects in a structure manager. The members that act on an object propagate to
+//! its children when the object propagates its visual state, as natively. The immediate mode
+//! members are in presentation_immediate.rs.
+use super::{
+    PrsMgrDisplayStatus, PrsMgrPresentableObject, PrsMgrPresentableObjectMembers as _,
+    PrsMgrPresentation,
+};
+use rustycad_tkernel::standard::{Failure, Handle, SharedState, StandardTransient, WeakHandle};
+use rustycad_tkmath::toploc::Datum3;
+use rustycad_tkservice::graphic3d::{
+    Graphic3dDisplayPriority, Graphic3dStructureDisplay as _, Graphic3dStructureManager,
+    Graphic3dStructureMembers as _, Graphic3dStructureNetwork as _, Graphic3dStructureSource,
+    Graphic3dTypeOfConnection, Graphic3dZLayerId,
+};
+
+/// The immediate mode state of a manager (`myImmediateModeOn` and the immediate lists).
+#[derive(Clone, Default)]
+pub(crate) struct ImmediateState {
+    pub(crate) mode_on: i32,
+    pub(crate) list: Vec<Handle<dyn Graphic3dStructureSource>>,
+    pub(crate) view_dependent_list: Vec<Handle<dyn Graphic3dStructureSource>>,
+}
+
+/// The manager of the presentations of a structure manager.
+///
+/// Example: `let manager = PrsMgrPresentationManager::new(&viewer.structure_manager()); manager.display(&object, 0)?;`.
+pub struct PrsMgrPresentationManager {
+    transient: StandardTransient,
+    structure_manager: Handle<Graphic3dStructureManager>,
+    this: SharedState<WeakHandle<PrsMgrPresentationManager>>,
+    pub(crate) immediate: SharedState<ImmediateState>,
+}
+rustycad_tkernel::impl_transient!(
+    PrsMgrPresentationManager,
+    "PrsMgr_PresentationManager",
+    StandardTransient,
+    transient
+);
+
+/// The children of an object when it propagates its visual state, else none.
+fn propagated_children(
+    object: &dyn PrsMgrPresentableObject,
+) -> Vec<Handle<dyn PrsMgrPresentableObject>> {
+    if object.to_propagate_visual_state() {
+        object.children()
+    } else {
+        Vec::new()
+    }
+}
+
+impl PrsMgrPresentationManager {
+    /// A manager of the presentations of a structure manager.
+    /// Example: `PrsMgrPresentationManager::new(&viewer.structure_manager())`.
+    pub fn new(structure_manager: &Handle<Graphic3dStructureManager>) -> Handle<Self> {
+        let manager = Handle::new(Self {
+            transient: StandardTransient::default(),
+            structure_manager: structure_manager.clone(),
+            this: SharedState::new(WeakHandle::default()),
+            immediate: SharedState::new(ImmediateState::default()),
+        });
+        *manager.this.write() = manager.downgrade();
+        manager
+    }
+    /// The handle of the manager; `manager.this()`.
+    pub fn this(&self) -> Handle<PrsMgrPresentationManager> {
+        self.this.read().upgrade()
+    }
+    /// `StructureManager`; `manager.structure_manager()`.
+    pub fn structure_manager(&self) -> Handle<Graphic3dStructureManager> {
+        self.structure_manager.clone()
+    }
+    /// Whether a presentation belongs to this manager.
+    fn owns(&self, prs: &PrsMgrPresentation) -> bool {
+        prs.presentation_manager().object_address() == (self as *const Self).cast()
+    }
+    /// `Display`: the presentation of the mode (created and updated on demand) is displayed or,
+    /// in immediate mode, queued; an object without own presentations computes itself;
+    /// non-erased children follow. Example: `manager.display(&object, 0)?`.
+    pub fn display(
+        &self,
+        object: &Handle<dyn PrsMgrPresentableObject>,
+        mode: i32,
+    ) -> Result<(), Failure> {
+        let Some(value) = object.get() else {
+            return Ok(());
+        };
+        if value.has_own_presentations() {
+            let prs = self.presentation(object, mode, true, &Handle::default())?;
+            if prs.get().is_some_and(PrsMgrPresentation::must_be_updated) {
+                self.update(object, mode)?;
+            }
+            if self.immediate.read().mode_on > 0 {
+                self.add_to_immediate_list(&prs.cast());
+            } else if let Some(prs) = prs.get() {
+                prs.display();
+            }
+        } else {
+            value.compute(&self.this(), &Handle::default(), mode)?;
+        }
+        for child in propagated_children(value) {
+            if child
+                .get()
+                .is_some_and(|c| c.display_status() != PrsMgrDisplayStatus::Erased)
+            {
+                self.display(&child, mode)?;
+            }
+        }
+        Ok(())
+    }
+    /// `Erase`: the children first, then the presentation of the mode of this manager (all
+    /// of them for mode -1) is erased and forgotten. Example: `manager.erase(&object, 0)`.
+    pub fn erase(&self, object: &Handle<dyn PrsMgrPresentableObject>, mode: i32) {
+        let Some(value) = object.get() else {
+            return;
+        };
+        propagated_children(value)
+            .iter()
+            .for_each(|child| self.erase(child, mode));
+        let mut kept = Vec::new();
+        let mut done = false;
+        for handle in value.presentations() {
+            let matches = handle
+                .get()
+                .is_some_and(|p| (mode == p.mode() || mode == -1) && self.owns(p));
+            if done || !matches {
+                kept.push(handle);
+                continue;
+            }
+            if let Some(prs) = handle.get() {
+                prs.erase();
+            }
+            done = mode != -1;
+        }
+        value.presentable_base().fields.write().presentations = kept;
+    }
+    /// `Clear`: clears the presentation of the mode; `manager.clear(&object, 0)`.
+    pub fn clear(&self, object: &Handle<dyn PrsMgrPresentableObject>, mode: i32) {
+        let Some(value) = object.get() else {
+            return;
+        };
+        propagated_children(value)
+            .iter()
+            .for_each(|child| self.clear(child, mode));
+        if let Some(prs) = self.existing(object, mode).get() {
+            prs.clear(true);
+        }
+    }
+    /// `SetVisibility`: shows or hides the presentation of the mode (hiding every child,
+    /// showing the non-erased ones). Example: `manager.set_visibility(&object, 0, false)`.
+    pub fn set_visibility(
+        &self,
+        object: &Handle<dyn PrsMgrPresentableObject>,
+        mode: i32,
+        value: bool,
+    ) {
+        let Some(own) = object.get() else {
+            return;
+        };
+        for child in propagated_children(own) {
+            if !value
+                || child
+                    .get()
+                    .is_some_and(|c| c.display_status() != PrsMgrDisplayStatus::Erased)
+            {
+                self.set_visibility(&child, mode, value);
+            }
+        }
+        if !own.has_own_presentations() {
+            return;
+        }
+        if let Some(prs) = self.existing(object, mode).get() {
+            prs.set_visible(value);
+        }
+    }
+    /// `Unhighlight`: unhighlights the highlighted presentations of this manager.
+    /// Example: `manager.unhighlight(&object)`.
+    pub fn unhighlight(&self, object: &Handle<dyn PrsMgrPresentableObject>) {
+        let Some(value) = object.get() else {
+            return;
+        };
+        propagated_children(value)
+            .iter()
+            .for_each(|child| self.unhighlight(child));
+        for prs in value.presentations().iter().filter_map(Handle::get) {
+            if self.owns(prs) && prs.is_highlighted() {
+                prs.unhighlight_restore();
+            }
+        }
+    }
+    /// `SetDisplayPriority`; `manager.set_display_priority(&object, 0, Graphic3dDisplayPriority::Above)?`.
+    pub fn set_display_priority(
+        &self,
+        object: &Handle<dyn PrsMgrPresentableObject>,
+        mode: i32,
+        priority: Graphic3dDisplayPriority,
+    ) -> Result<(), Failure> {
+        let Some(value) = object.get() else {
+            return Ok(());
+        };
+        for child in propagated_children(value) {
+            self.set_display_priority(&child, mode, priority)?;
+        }
+        match self.existing(object, mode).get() {
+            Some(prs) => prs.set_display_priority(priority),
+            None => Ok(()),
+        }
+    }
+    /// `DisplayPriority`: the first valid priority of the children, else the presentation's,
+    /// else `INVALID`. Example: `manager.display_priority(&object, 0)`.
+    pub fn display_priority(
+        &self,
+        object: &Handle<dyn PrsMgrPresentableObject>,
+        mode: i32,
+    ) -> Graphic3dDisplayPriority {
+        let Some(value) = object.get() else {
+            return Graphic3dDisplayPriority::Invalid;
+        };
+        for child in propagated_children(value) {
+            let priority = self.display_priority(&child, mode);
+            if priority != Graphic3dDisplayPriority::Invalid {
+                return priority;
+            }
+        }
+        self.existing(object, mode)
+            .get()
+            .map_or(Graphic3dDisplayPriority::Invalid, |p| p.display_priority())
+    }
+    /// `SetZLayer`: the layer of the object (and of its children); `manager.set_z_layer(&object, layer)`.
+    pub fn set_z_layer(
+        &self,
+        object: &Handle<dyn PrsMgrPresentableObject>,
+        layer_id: Graphic3dZLayerId,
+    ) {
+        let Some(value) = object.get() else {
+            return;
+        };
+        propagated_children(value)
+            .iter()
+            .for_each(|child| self.set_z_layer(child, layer_id));
+        if value.has_own_presentations() {
+            value.set_z_layer(layer_id);
+        }
+    }
+    /// `GetZLayer`: the object layer; `manager.get_z_layer(&object)`.
+    pub fn get_z_layer(&self, object: &Handle<dyn PrsMgrPresentableObject>) -> Graphic3dZLayerId {
+        object.get().map_or(
+            rustycad_tkservice::graphic3d::GRAPHIC3D_ZLAYER_ID_UNKNOWN,
+            |o| o.z_layer(),
+        )
+    }
+    /// `IsDisplayed`: a displayed child or presentation of the mode; `manager.is_displayed(&object, 0)`.
+    pub fn is_displayed(&self, object: &Handle<dyn PrsMgrPresentableObject>, mode: i32) -> bool {
+        let Some(value) = object.get() else {
+            return false;
+        };
+        propagated_children(value)
+            .iter()
+            .any(|child| self.is_displayed(child, mode))
+            || self
+                .existing(object, mode)
+                .get()
+                .is_some_and(|p| p.is_displayed())
+    }
+    /// `IsHighlighted`: a highlighted child or presentation of the mode; `manager.is_highlighted(&object, 0)`.
+    pub fn is_highlighted(&self, object: &Handle<dyn PrsMgrPresentableObject>, mode: i32) -> bool {
+        let Some(value) = object.get() else {
+            return false;
+        };
+        propagated_children(value)
+            .iter()
+            .any(|child| self.is_highlighted(child, mode))
+            || self
+                .existing(object, mode)
+                .get()
+                .is_some_and(|p| p.is_highlighted())
+    }
+    /// `Update`: the children, then the presentation of the mode is cleared and filled again.
+    /// Example: `manager.update(&object, 0)?`.
+    pub fn update(
+        &self,
+        object: &Handle<dyn PrsMgrPresentableObject>,
+        mode: i32,
+    ) -> Result<(), Failure> {
+        let Some(value) = object.get() else {
+            return Ok(());
+        };
+        for child in value.children() {
+            self.update(&child, mode)?;
+        }
+        let prs = self.existing(object, mode);
+        if let Some(structure) = prs.get() {
+            structure.clear(true);
+            value.fill(&self.this(), &prs, mode)?;
+            structure.set_update_status(false);
+        }
+        Ok(())
+    }
+    /// `HasPresentation`: an own presentation of the mode in this manager.
+    /// Example: `manager.has_presentation(&object, 0)`.
+    pub fn has_presentation(
+        &self,
+        object: &Handle<dyn PrsMgrPresentableObject>,
+        mode: i32,
+    ) -> bool {
+        object.get().is_some_and(|o| o.has_own_presentations())
+            && !self.existing(object, mode).is_null()
+    }
+    /// The presentation of the mode in this manager, null without.
+    fn existing(
+        &self,
+        object: &Handle<dyn PrsMgrPresentableObject>,
+        mode: i32,
+    ) -> Handle<PrsMgrPresentation> {
+        let Some(value) = object.get() else {
+            return Handle::default();
+        };
+        value
+            .presentations()
+            .into_iter()
+            .find(|p| p.get().is_some_and(|v| v.mode() == mode && self.owns(v)))
+            .unwrap_or_default()
+    }
+    /// `Presentation`: the presentation of the mode, or a new one (in the object's layer, with
+    /// the view affinity of `sel_obj` or the object, filled) when asked.
+    /// Example: `manager.presentation(&object, 0, true, &Handle::default())?`.
+    pub fn presentation(
+        &self,
+        object: &Handle<dyn PrsMgrPresentableObject>,
+        mode: i32,
+        to_create: bool,
+        sel_obj: &Handle<dyn PrsMgrPresentableObject>,
+    ) -> Result<Handle<PrsMgrPresentation>, Failure> {
+        let found = self.existing(object, mode);
+        let Some(value) = object.get().filter(|_| found.is_null() && to_create) else {
+            return Ok(found);
+        };
+        let prs = PrsMgrPresentation::new(&self.this(), object, mode)?;
+        prs.set_z_layer(value.z_layer());
+        let affinity = sel_obj
+            .get()
+            .map_or_else(|| value.view_affinity(), |s| s.view_affinity());
+        if let Some(cstructure) = prs.cstructure().get() {
+            cstructure.cstructure_base().fields.write().view_affinity = affinity;
+        }
+        value
+            .presentable_base()
+            .fields
+            .write()
+            .presentations
+            .push(prs.clone());
+        value.fill(&self.this(), &prs, mode)?;
+        prs.set_update_status(false);
+        Ok(prs)
+    }
+    /// `RemovePresentation` (protected): forgets the presentation of the mode; true when found.
+    /// Example: `manager.remove_presentation(&object, 0)`.
+    pub fn remove_presentation(
+        &self,
+        object: &Handle<dyn PrsMgrPresentableObject>,
+        mode: i32,
+    ) -> bool {
+        let Some(value) = object.get() else {
+            return false;
+        };
+        let presentations = value.presentations();
+        let Some(index) = presentations
+            .iter()
+            .position(|p| p.get().is_some_and(|v| v.mode() == mode && self.owns(v)))
+        else {
+            return false;
+        };
+        value
+            .presentable_base()
+            .fields
+            .write()
+            .presentations
+            .remove(index);
+        true
+    }
+    /// `Connect`: connects the presentations of two objects (created on demand).
+    /// Example: `manager.connect(&object, &other, 0, 0)?`.
+    pub fn connect(
+        &self,
+        object: &Handle<dyn PrsMgrPresentableObject>,
+        other: &Handle<dyn PrsMgrPresentableObject>,
+        mode: i32,
+        other_mode: i32,
+    ) -> Result<(), Failure> {
+        let prs = self.presentation(object, mode, true, &Handle::default())?;
+        let other_prs = self.presentation(other, other_mode, true, &Handle::default())?;
+        if let Some(prs) = prs.get() {
+            prs.connect(
+                &other_prs.cast(),
+                Graphic3dTypeOfConnection::Descendant,
+                false,
+            );
+        }
+        Ok(())
+    }
+    /// `Transform`: the transformation of the presentation of the mode; a missing presentation
+    /// raises `Standard_NullObject` (a null dereference natively). Example: `manager.transform(&object, &trsf, 0)?`.
+    pub fn transform(
+        &self,
+        object: &Handle<dyn PrsMgrPresentableObject>,
+        trsf: &Handle<Datum3>,
+        mode: i32,
+    ) -> Result<(), Failure> {
+        let prs = self.existing(object, mode);
+        let Some(prs) = prs.get() else {
+            return Err(rustycad_tkernel::standard::exceptions::null_object(
+                &format!(
+                    "PrsMgr_PresentationManager::Transform: no presentation of mode {mode}; expected a displayed mode"
+                ),
+            ));
+        };
+        prs.set_transformation(trsf);
+        Ok(())
+    }
+}
diff --git a/crates/tkv3d/src/select3d/bvh_index_buffer.rs b/crates/tkv3d/src/select3d/bvh_index_buffer.rs
new file mode 100644
index 000000000..9f480c8cc
--- /dev/null
+++ b/crates/tkv3d/src/select3d/bvh_index_buffer.rs
@@ -0,0 +1,83 @@
+//! `Select3D_BVHIndexBuffer`: a `Graphic3d_Buffer` of unsigned element indexes, each with a
+//! patch size when patches are enabled.
+use rustycad_tkernel::ncollection::BaseAllocator;
+use rustycad_tkernel::standard::{Failure, SharedState, StandardTransient};
+use rustycad_tkservice::graphic3d::{
+    Graphic3dBufferBase, Graphic3dBufferMembers as _, Graphic3dBufferSource,
+};
+
+/// The size of one index (`sizeof(unsigned int)`).
+const INDEX_SIZE: usize = 4;
+
+/// The BVH index buffer of a primitive array.
+///
+/// Example: `let buffer = Select3DBvhIndexBuffer::new(Graphic3dBufferBase::default_allocator())?; buffer.init(4, false)?;`.
+pub struct Select3DBvhIndexBuffer {
+    transient: StandardTransient,
+    base: Graphic3dBufferBase,
+    has_patches: SharedState<bool>,
+}
+rustycad_tkernel::impl_transient!(Select3DBvhIndexBuffer, "Select3D_BVHIndexBuffer", dyn Graphic3dBufferSource, transient,
+    interfaces: [dyn Graphic3dBufferSource]);
+
+impl Graphic3dBufferSource for Select3DBvhIndexBuffer {
+    fn buffer_base(&self) -> &Graphic3dBufferBase {
+        &self.base
+    }
+}
+
+impl Select3DBvhIndexBuffer {
+    /// An empty buffer over an allocator; `Select3DBvhIndexBuffer::new(allocator)?`.
+    pub fn new(allocator: BaseAllocator) -> Result<Self, Failure> {
+        Ok(Self {
+            transient: StandardTransient::default(),
+            base: Graphic3dBufferBase::new(allocator)?,
+            has_patches: SharedState::new(false),
+        })
+    }
+    /// `HasPatches`; `buffer.has_patches()`.
+    pub fn has_patches(&self) -> bool {
+        *self.has_patches.read()
+    }
+    /// `Init`: `nb_elems` indexes (with their patch sizes when asked); false when the
+    /// allocation fails. Example: `buffer.init(8, true)?`.
+    pub fn init(&self, nb_elems: i32, has_patches: bool) -> Result<bool, Failure> {
+        self.release()?;
+        *self.has_patches.write() = has_patches;
+        let stride = INDEX_SIZE * if has_patches { 2 } else { 1 };
+        let mut state = self.base.state.write();
+        (state.stride, state.nb_elements, state.nb_attributes) = (stride as i32, nb_elems, 0);
+        if nb_elems != 0
+            && !state
+                .data
+                .allocate(stride.wrapping_mul(nb_elems as usize))?
+        {
+            drop(state);
+            self.release()?;
+            return Ok(false);
+        }
+        Ok(true)
+    }
+    /// `Index`: the index at a position (0 past the bytes); `buffer.index(0)`.
+    pub fn index(&self, index: i32) -> i32 {
+        self.read_at::<u32>(self.element_offset(index)).unwrap_or(0) as i32
+    }
+    /// `PatchSize`: the patch size at a position, 1 without patches; `buffer.patch_size(0)`.
+    pub fn patch_size(&self, index: i32) -> i32 {
+        if !self.has_patches() {
+            return 1;
+        }
+        self.read_at::<u32>(self.element_offset(index) + INDEX_SIZE)
+            .unwrap_or(0) as i32
+    }
+    /// `SetIndex(index, value)`; `buffer.set_index(0, 5)`.
+    pub fn set_index(&self, index: i32, value: i32) {
+        self.write_at(self.element_offset(index), value as u32);
+    }
+    /// `SetIndex(index, value, patchSize)`; `buffer.set_index_patch(0, 5, 2)`.
+    pub fn set_index_patch(&self, index: i32, value: i32, patch_size: i32) {
+        let offset = self.element_offset(index);
+        self.write_at(offset, value as u32);
+        self.write_at(offset + INDEX_SIZE, patch_size as u32);
+    }
+}
diff --git a/crates/tkv3d/src/select3d/interior_point_set.rs b/crates/tkv3d/src/select3d/interior_point_set.rs
new file mode 100644
index 000000000..3faf073e5
--- /dev/null
+++ b/crates/tkv3d/src/select3d/interior_point_set.rs
@@ -0,0 +1,255 @@
+//! `Select3D_InteriorSensitivePointSet`: the interior of a polygon split into planar convex
+//! parts (sensitive polys) kept in a BVH tree.
+use super::{
+    Select3DBndBox3d, Select3DSensitiveEntity, Select3DSensitiveEntityBase, Select3DSensitivePoly,
+    Select3DSensitiveSet, Select3DSensitiveSetBase, Select3DTypeOfSensitivity,
+    select3d_set_build_bvh, select3d_set_dump_json, select3d_set_matches,
+};
+use crate::select_basics::{SelectBasicsPickResult, SelectBasicsSelectingVolumeManager};
+use crate::select_mgr::SelectMgrEntityOwnerSource;
+use rustycad_tkernel::ncollection::{Array1, Vec3};
+use rustycad_tkernel::precision::confusion;
+use rustycad_tkernel::standard::dump::DumpStream;
+use rustycad_tkernel::standard::{Failure, Handle, SharedState, StandardTransient};
+use rustycad_tkmath::gp::{Point3, Xyz};
+use rustycad_tkservice::json_dump::{base_class, class_begin, field_dumped};
+use std::io;
+
+/// The plane of a planar part (`Select3D_Plane`): `ax + by + cz + d`, unset at first.
+#[derive(Clone, Copy, Default)]
+struct PartPlane {
+    plane: [f64; 4],
+    is_initialized: bool,
+}
+
+impl PartPlane {
+    /// `Contains`: the signed plane value below `Precision::Confusion` (no absolute value natively).
+    fn contains(&self, point: &Point3) -> bool {
+        let [a, b, c, d] = self.plane;
+        self.is_initialized && a * point.x() + b * point.y() + c * point.z() + d < confusion()
+    }
+    /// `MakePlane`: the plane of three points (an unnormalized normal).
+    fn make(&mut self, p1: &Point3, p2: &Point3, p3: &Point3) {
+        let (v1, v2) = (p2.xyz() - p1.xyz(), p3.xyz() - p1.xyz());
+        let dir = v1.crossed(v2);
+        let d = dir.dot(p1.xyz().reversed());
+        (self.plane, self.is_initialized) = ([dir.x(), dir.y(), dir.z(), d], true);
+    }
+}
+
+/// The planar parts of the point sequence, as the native constructor splits them.
+fn planar_parts(
+    owner: &Handle<dyn SelectMgrEntityOwnerSource>,
+    points: &[Point3],
+) -> Result<Vec<Handle<Select3DSensitivePoly>>, Failure> {
+    let mut parts = Vec::new();
+    let mut plane = PartPlane::default();
+    let upper = points.len() as i32 - 1;
+    let (mut start, mut end) = (0i32, 0i32);
+    let part = |from: i32, to: i32, bvh: bool| -> Result<Handle<Select3DSensitivePoly>, Failure> {
+        Ok(Handle::new(Select3DSensitivePoly::new(
+            owner,
+            &points[from as usize..=to as usize],
+            bvh,
+        )?))
+    };
+    for iter in 0..=upper {
+        let p3 = points[iter as usize];
+        let (p1, p2) = if iter >= 2 {
+            (points[iter as usize - 2], points[iter as usize - 1])
+        } else {
+            (Point3::default(), Point3::default())
+        };
+        if iter - start == 2 && !plane.is_initialized {
+            plane.make(&p1, &p2, &p3);
+            (start, end) = (iter - 2, iter);
+            if end == upper {
+                parts.push(part(start, end, false)?);
+            }
+        } else if plane.is_initialized {
+            let angle = (p1.xyz() - p2.xyz()).dot(p3.xyz() - p2.xyz());
+            if !plane.contains(&p3) || angle > confusion() {
+                parts.push(part(start, iter - 1, true)?);
+                (start, end) = (iter, iter);
+                plane.is_initialized = false;
+            } else {
+                end += 1;
+                if end == upper {
+                    parts.push(part(start, end, true)?);
+                }
+            }
+        }
+    }
+    Ok(parts)
+}
+
+/// The mutable state: the BVH order of the parts.
+struct PointSetState {
+    polygons_idxs: Vec<i32>,
+}
+
+/// The interior of a polygon as planar parts.
+///
+/// Example: `let set = Select3DInteriorSensitivePointSet::new(&owner, &points)?;`.
+pub struct Select3DInteriorSensitivePointSet {
+    transient: StandardTransient,
+    entity: Select3DSensitiveEntityBase,
+    set: Select3DSensitiveSetBase,
+    planar_polygons: Vec<Handle<Select3DSensitivePoly>>,
+    state: SharedState<PointSetState>,
+    cog: Point3,
+    bnd_box: Select3DBndBox3d,
+}
+rustycad_tkernel::impl_transient!(Select3DInteriorSensitivePointSet, "Select3D_InteriorSensitivePointSet", dyn Select3DSensitiveSet, transient,
+    interfaces: [dyn Select3DSensitiveEntity, dyn Select3DSensitiveSet]);
+
+impl Select3DInteriorSensitivePointSet {
+    /// The set of the points: the planar parts, the center and the box; no point gives a
+    /// division by zero natively (a NaN center here). Example: `Select3DInteriorSensitivePointSet::new(&owner, &points)?`.
+    pub fn new(
+        owner: &Handle<dyn SelectMgrEntityOwnerSource>,
+        points: &[Point3],
+    ) -> Result<Self, Failure> {
+        let mut sum = Xyz::new(0.0, 0.0, 0.0);
+        let mut bnd_box = Select3DBndBox3d::default();
+        for point in points {
+            sum += point.xyz();
+            bnd_box.add(&Vec3::new(point.x(), point.y(), point.z()));
+        }
+        let planar_polygons = planar_parts(owner, points)?;
+        let polygons_idxs = (0..planar_polygons.len() as i32).collect();
+        Ok(Self {
+            transient: StandardTransient::default(),
+            entity: Select3DSensitiveEntityBase::new(owner),
+            set: Select3DSensitiveSetBase::default(),
+            planar_polygons,
+            state: SharedState::new(PointSetState { polygons_idxs }),
+            cog: Point3::from(sum / points.len() as f64),
+            bnd_box,
+        })
+    }
+    /// `GetPoints`: the points of the parts without the shared last points; the array has the
+    /// size of all the part points, its tail left at the origin as natively. Example: `set.get_points()`.
+    pub fn get_points(&self) -> Vec<Point3> {
+        let size: i32 = self
+            .planar_polygons
+            .iter()
+            .map(|p| p.core.nb_sub_elements())
+            .sum();
+        let mut output = vec![Point3::default(); size.max(0) as usize];
+        let mut index = 0;
+        let count = self.planar_polygons.len();
+        for (polyg_idx, polygon) in self.planar_polygons.iter().enumerate() {
+            let points = polygon.points_3d();
+            let kept = if polyg_idx + 1 < count {
+                points.len().saturating_sub(1)
+            } else {
+                points.len()
+            };
+            for point in points.into_iter().take(kept) {
+                output[index] = point;
+                index += 1;
+            }
+        }
+        output
+    }
+    /// The part at a BVH index.
+    fn part(&self, idx: i32) -> Option<Handle<Select3DSensitivePoly>> {
+        let polyg_idx = *self.state.read().polygons_idxs.get(idx as usize)?;
+        self.planar_polygons.get(polyg_idx as usize).cloned()
+    }
+}
+
+impl Select3DSensitiveEntity for Select3DInteriorSensitivePointSet {
+    fn sensitive_base(&self) -> &Select3DSensitiveEntityBase {
+        &self.entity
+    }
+    fn matches(
+        &self,
+        manager: &dyn SelectBasicsSelectingVolumeManager,
+        pick_result: &mut SelectBasicsPickResult,
+    ) -> Result<bool, Failure> {
+        select3d_set_matches(self, manager, pick_result, false)
+    }
+    fn nb_sub_elements(&self) -> i32 {
+        self.planar_polygons.len() as i32
+    }
+    fn bounding_box(&self) -> Select3DBndBox3d {
+        self.bnd_box
+    }
+    fn center_of_geometry(&self) -> Point3 {
+        self.cog
+    }
+    fn bvh(&self) -> Result<(), Failure> {
+        select3d_set_build_bvh(self)
+    }
+    fn to_build_bvh(&self) -> bool {
+        self.set.is_dirty()
+    }
+    fn clear(&self) {}
+    fn dump_json(&self, stream: &mut DumpStream, depth: i32) -> io::Result<()> {
+        class_begin(stream, "Select3D_InteriorSensitivePointSet")?;
+        base_class(stream, depth, &|s, d| select3d_set_dump_json(self, s, d))?;
+        let bounds = self.bnd_box;
+        field_dumped(stream, depth, "&myBndBox", &|s, _| bounds.dump_json(s))
+    }
+}
+
+impl Select3DSensitiveSet for Select3DInteriorSensitivePointSet {
+    fn set_base(&self) -> &Select3DSensitiveSetBase {
+        &self.set
+    }
+    fn size(&self) -> i32 {
+        self.planar_polygons.len() as i32
+    }
+    fn element_box(&self, idx: i32) -> Select3DBndBox3d {
+        self.part(idx)
+            .map(|p| p.core.bounding_box())
+            .unwrap_or_default()
+    }
+    /// `Center`: natively the coordinate `theAxis - 1` of the part center, so axis 0 raises
+    /// `Standard_OutOfRange` and the axes 1 and 2 read X and Y.
+    fn center(&self, idx: i32, axis: i32) -> Result<f64, Failure> {
+        let cog = self
+            .part(idx)
+            .map(|p| p.core.center_of_geometry())
+            .unwrap_or_default();
+        cog.coord(axis - 1)
+    }
+    fn swap(&self, idx1: i32, idx2: i32) {
+        self.state
+            .write()
+            .polygons_idxs
+            .swap(idx1 as usize, idx2 as usize);
+    }
+    /// `overlapsElement`: the interior polygon test of the part points.
+    fn overlaps_element(
+        &self,
+        pick_result: &mut SelectBasicsPickResult,
+        manager: &dyn SelectBasicsSelectingVolumeManager,
+        elem_idx: i32,
+        _is_full_inside: bool,
+    ) -> Result<bool, Failure> {
+        let Some(part) = self.part(elem_idx) else {
+            return Ok(false);
+        };
+        let points = part.points_3d();
+        manager.overlaps_polygon(
+            &Array1::from_shared(&points, 1),
+            Select3DTypeOfSensitivity::Interior as i32,
+            pick_result,
+        )
+    }
+    fn element_is_inside(
+        &self,
+        manager: &dyn SelectBasicsSelectingVolumeManager,
+        elem_idx: i32,
+        is_full_inside: bool,
+    ) -> Result<bool, Failure> {
+        let mut dummy = SelectBasicsPickResult::default();
+        self.overlaps_element(&mut dummy, manager, elem_idx, is_full_inside)
+    }
+    fn distance_to_cog(&self, manager: &dyn SelectBasicsSelectingVolumeManager) -> f64 {
+        manager.dist_to_geometry_center(&self.cog)
+    }
+}
