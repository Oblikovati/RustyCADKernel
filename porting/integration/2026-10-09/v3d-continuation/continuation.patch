+//! `V3d_Trihedron`: the screen-corner axes of a view, drawn by its own structure with
+//! trihedron transform persistence.
+use super::computed_structure::{V3dComputedStructure, V3dStructureComputer};
+use super::{V3dTypeOfAxe, V3dView};
+use crate::prs3d::{Prs3dBasicAspect as _, Prs3dShadingAspect, Prs3dTextAspect};
+use rustycad_tkernel::ncollection::Vec2;
+use rustycad_tkernel::precision::confusion;
+use rustycad_tkernel::quantity::{Color, NamedColor};
+use rustycad_tkernel::standard::dump::DumpStream;
+use rustycad_tkernel::standard::{Failure, Handle, SharedState, StandardTransient, WeakHandle};
+use rustycad_tkernel::tcollection::AsciiString;
+use rustycad_tkservice::aspect::{
+    AspectInteriorStyle, AspectTypeOfFacingModel, AspectTypeOfTriedronPosition,
+};
+use rustycad_tkservice::graphic3d::{
+    GRAPHIC3D_ZLAYER_ID_TOPMOST, Graphic3dAspectsMembers as _, Graphic3dAspectsRenderMembers as _,
+    Graphic3dCViewMembers as _, Graphic3dDisplayPriority, Graphic3dMaterialAspect,
+    Graphic3dStructureDisplay as _, Graphic3dStructureMembers as _, Graphic3dStructureSource,
+    Graphic3dTransModeFlags, Graphic3dTransformPers, Graphic3dTransformPersMembers as _,
+    Graphic3dTransformPersSource as _, Graphic3dTypeOfMaterial, Graphic3dViewAffinity,
+};
+use rustycad_tkservice::json_dump::{class_begin, field_dumped, field_integer, field_real};
+use std::io;
+
+/// `THE_INTERNAL_SCALE_FACTOR`.
+pub(super) const INTERNAL_SCALE_FACTOR: f64 = 500.0;
+/// `THE_CYLINDER_LENGTH` (a float natively).
+pub(super) const CYLINDER_LENGTH: f32 = 0.75;
+/// `THE_CIRCLE_SERMENTS_NB`.
+pub(super) const CIRCLE_SEGMENTS_NB: i32 = 24;
+/// `Font_NOF_ASCII_MONO`.
+const FONT_ASCII_MONO: &str = "Courier";
+
+/// The mutable fields of the trihedron.
+#[derive(Clone)]
+pub(super) struct TrihedronState {
+    pub(super) labels: [AsciiString; 3],
+    pub(super) structure: Handle<dyn Graphic3dStructureSource>,
+    pub(super) scale: f64,
+    pub(super) ratio: f64,
+    pub(super) diameter: f64,
+    pub(super) nb_facettes: i32,
+    pub(super) is_wireframe: bool,
+    pub(super) to_compute: bool,
+}
+
+/// The trihedron of a view.
+///
+/// Example: `let trihedron = V3dTrihedron::new()?; trihedron.set_scale(0.1); trihedron.display(&view)?;`.
+pub struct V3dTrihedron {
+    transient: StandardTransient,
+    pub(super) sphere_shading_aspect: Handle<Prs3dShadingAspect>,
+    pub(super) text_aspects: [Handle<Prs3dTextAspect>; 3],
+    pub(super) arrow_shading_aspects: [Handle<Prs3dShadingAspect>; 3],
+    transform_pers: Handle<Graphic3dTransformPers>,
+    this: SharedState<WeakHandle<V3dTrihedron>>,
+    pub(super) state: SharedState<TrihedronState>,
+}
+rustycad_tkernel::impl_transient!(V3dTrihedron, "V3d_Trihedron", StandardTransient, transient,
+    interfaces: [dyn V3dStructureComputer]);
+
+/// The material of the trihedron shading: no specular, aspect color.
+fn shading_material() -> Graphic3dMaterialAspect {
+    let mut material = Graphic3dMaterialAspect::default();
+    material.set_specular_color(Color::named(NamedColor::BLACK));
+    material.set_material_type(Graphic3dTypeOfMaterial::Aspect);
+    material
+}
+
+/// A solid, textured shading aspect of a color with the trihedron material.
+fn trihedron_shading(color: Color) -> Result<Handle<Prs3dShadingAspect>, Failure> {
+    let shading = Prs3dShadingAspect::new()?;
+    if let Some(fill) = shading.aspect().get() {
+        fill.set_texture_map_on(true);
+        fill.set_interior_style(AspectInteriorStyle::Solid);
+    }
+    shading.set_material(&shading_material(), AspectTypeOfFacingModel::BothSide);
+    shading.set_color(color, AspectTypeOfFacingModel::BothSide)?;
+    Ok(Handle::new(shading))
+}
+
+/// A Courier label aspect of height 16, left and bottom aligned.
+fn trihedron_text() -> Handle<Prs3dTextAspect> {
+    let text = Prs3dTextAspect::new();
+    text.set_font(FONT_ASCII_MONO);
+    text.set_height(16.0);
+    text.set_horizontal_justification(
+        rustycad_tkservice::graphic3d::Graphic3dHorizontalTextAlignment::Left,
+    );
+    text.set_vertical_justification(
+        rustycad_tkservice::graphic3d::Graphic3dVerticalTextAlignment::Bottom,
+    );
+    Handle::new(text)
+}
+
+impl V3dTrihedron {
+    /// A trihedron at the lower-left corner: red, green and blue arrows and white origin.
+    /// Example: `V3dTrihedron::new()?`.
+    pub fn new() -> Result<Handle<Self>, Failure> {
+        let pers = Graphic3dTransformPers::with_corner(
+            Graphic3dTransModeFlags::TRIEDRON_PERS,
+            AspectTypeOfTriedronPosition::LEFT_LOWER,
+            Vec2::new(0, 0),
+        )?;
+        let colors = [NamedColor::RED, NamedColor::GREEN, NamedColor::BLUE];
+        let arrows = [
+            trihedron_shading(Color::named(colors[0]))?,
+            trihedron_shading(Color::named(colors[1]))?,
+            trihedron_shading(Color::named(colors[2]))?,
+        ];
+        let state = TrihedronState {
+            labels: [
+                AsciiString::from("X"),
+                AsciiString::from("Y"),
+                AsciiString::from("Z"),
+            ],
+            structure: Handle::default(),
+            scale: 1.0,
+            ratio: 0.8,
+            diameter: 0.05,
+            nb_facettes: 12,
+            is_wireframe: false,
+            to_compute: true,
+        };
+        let trihedron = Handle::new(Self {
+            transient: StandardTransient::default(),
+            sphere_shading_aspect: trihedron_shading(Color::named(NamedColor::WHITE))?,
+            text_aspects: [trihedron_text(), trihedron_text(), trihedron_text()],
+            arrow_shading_aspects: arrows,
+            transform_pers: Handle::new(pers),
+            this: SharedState::new(WeakHandle::default()),
+            state: SharedState::new(state),
+        });
+        *trihedron.this.write() = trihedron.downgrade();
+        trihedron.set_position(AspectTypeOfTriedronPosition::LEFT_LOWER)?;
+        Ok(trihedron)
+    }
+    /// `invalidate` (protected): the next display recomputes the structure.
+    /// Example: `trihedron.invalidate()`.
+    pub fn invalidate(&self) {
+        self.state.write().to_compute = true;
+    }
+    /// Whether the axes are drawn as lines; `trihedron.is_wireframe()`.
+    pub fn is_wireframe(&self) -> bool {
+        self.state.read().is_wireframe
+    }
+    /// Switches wireframe drawing (recomputed on change); `trihedron.set_wireframe(true)`.
+    pub fn set_wireframe(&self, as_wireframe: bool) {
+        let mut state = self.state.write();
+        if state.is_wireframe != as_wireframe {
+            (state.to_compute, state.is_wireframe) = (true, as_wireframe);
+        }
+    }
+    /// The transform persistence; `trihedron.transform_persistence()`.
+    pub fn transform_persistence(&self) -> Handle<Graphic3dTransformPers> {
+        self.transform_pers.clone()
+    }
+    /// `SetPosition`: the corner and the offset `scale * 500` along the attached sides.
+    /// Example: `trihedron.set_position(AspectTypeOfTriedronPosition::RIGHT_UPPER)?`.
+    pub fn set_position(&self, position: AspectTypeOfTriedronPosition) -> Result<(), Failure> {
+        let scale = self.state.read().scale;
+        let shift = (scale * INTERNAL_SCALE_FACTOR) as i32;
+        let mut offset = Vec2::new(0, 0);
+        if position.0
+            & (AspectTypeOfTriedronPosition::LEFT.0 | AspectTypeOfTriedronPosition::RIGHT.0)
+            != 0
+        {
+            offset.x = shift;
+        }
+        if position.0
+            & (AspectTypeOfTriedronPosition::TOP.0 | AspectTypeOfTriedronPosition::BOTTOM.0)
+            != 0
+        {
+            offset.y = shift;
+        }
+        if let Some(pers) = self.transform_pers.get() {
+            pers.set_corner_2d(position)?;
+            pers.set_offset_2d(offset)?;
+        }
+        Ok(())
+    }
+    /// The scale; `trihedron.scale()`.
+    pub fn scale(&self) -> f64 {
+        self.state.read().scale
+    }
+    /// Sets the scale (recomputed beyond `Precision::Confusion`); `trihedron.set_scale(0.1)`.
+    pub fn set_scale(&self, scale: f64) {
+        let mut state = self.state.write();
+        if (state.scale - scale).abs() > confusion() {
+            state.to_compute = true;
+        }
+        state.scale = scale;
+    }
+    /// The size ratio; `trihedron.size_ratio()`.
+    pub fn size_ratio(&self) -> f64 {
+        self.state.read().ratio
+    }
+    /// Sets the size ratio; `trihedron.set_size_ratio(0.8)`.
+    pub fn set_size_ratio(&self, ratio: f64) {
+        let mut state = self.state.write();
+        if (state.ratio - ratio).abs() > confusion() {
+            state.to_compute = true;
+        }
+        state.ratio = ratio;
+    }
+    /// The arrow diameter; `trihedron.arrow_diameter()`.
+    pub fn arrow_diameter(&self) -> f64 {
+        self.state.read().diameter
+    }
+    /// Sets the arrow diameter; `trihedron.set_arrow_diameter(0.05)`.
+    pub fn set_arrow_diameter(&self, diameter: f64) {
+        let mut state = self.state.write();
+        if (state.diameter - diameter).abs() > confusion() {
+            state.to_compute = true;
+        }
+        state.diameter = diameter;
+    }
+    /// The facet count of the shaded parts; `trihedron.nb_facets()`.
+    pub fn nb_facets(&self) -> i32 {
+        self.state.read().nb_facettes
+    }
+    /// Sets the facet count; `trihedron.set_nb_facets(12)`.
+    pub fn set_nb_facets(&self, nb_facets: i32) {
+        let mut state = self.state.write();
+        if state.nb_facettes != nb_facets {
+            state.to_compute = true;
+        }
+        state.nb_facettes = nb_facets;
+    }
+    /// The label aspect of an axis; `trihedron.label_aspect(V3dTypeOfAxe::X)`.
+    pub fn label_aspect(&self, axis: V3dTypeOfAxe) -> Handle<Prs3dTextAspect> {
+        self.text_aspects[axis as usize].clone()
+    }
+    /// `SetLabelsColor(x, y, z)`; `trihedron.set_labels_colors(red, green, blue)`.
+    pub fn set_labels_colors(&self, x_color: Color, y_color: Color, z_color: Color) {
+        for (aspect, color) in self.text_aspects.iter().zip([x_color, y_color, z_color]) {
+            aspect.set_color(color);
+        }
+    }
+    /// `SetLabelsColor(color)`: one color for the three labels; `trihedron.set_labels_color(white)`.
+    pub fn set_labels_color(&self, color: Color) {
+        self.set_labels_colors(color, color, color);
+    }
+    /// The arrow aspect of an axis; `trihedron.arrow_aspect(V3dTypeOfAxe::Y)`.
+    pub fn arrow_aspect(&self, axis: V3dTypeOfAxe) -> Handle<Prs3dShadingAspect> {
+        self.arrow_shading_aspects[axis as usize].clone()
+    }
+    /// `SetArrowsColor`; `trihedron.set_arrows_color(red, green, blue)?`.
+    pub fn set_arrows_color(
+        &self,
+        x_color: Color,
+        y_color: Color,
+        z_color: Color,
+    ) -> Result<(), Failure> {
+        for (aspect, color) in self
+            .arrow_shading_aspects
+            .iter()
+            .zip([x_color, y_color, z_color])
+        {
+            if let Some(aspect) = aspect.get() {
+                aspect.set_color(color, AspectTypeOfFacingModel::BothSide)?;
+            }
+        }
+        Ok(())
+    }
+    /// The origin sphere aspect; `trihedron.origin_aspect()`.
+    pub fn origin_aspect(&self) -> Handle<Prs3dShadingAspect> {
+        self.sphere_shading_aspect.clone()
+    }
+    /// The label of an axis; `trihedron.label(V3dTypeOfAxe::Z)`.
+    pub fn label(&self, axis: V3dTypeOfAxe) -> AsciiString {
+        self.state.read().labels[axis as usize].clone()
+    }
+    /// `SetLabels` (recomputed when one changes); `trihedron.set_labels(&x, &y, &z)`.
+    pub fn set_labels(&self, x: &AsciiString, y: &AsciiString, z: &AsciiString) {
+        let mut state = self.state.write();
+        if state.labels[0] != *x || state.labels[1] != *y || state.labels[2] != *z {
+            state.to_compute = true;
+            state.labels = [x.clone(), y.clone(), z.clone()];
+        }
+    }
+    /// `Display`: creates the structure on the first call (topmost layer, visible only in
+    /// the view), recomputes when needed and displays it. Example: `trihedron.display(&view)?`.
+    pub fn display(&self, view: &V3dView) -> Result<(), Failure> {
+        if self.state.read().structure.is_null() {
+            self.create_structure(view)?;
+        }
+        if self.state.read().to_compute {
+            self.compute()?;
+        }
+        if let Some(structure) = self.state.read().structure.get() {
+            structure.display();
+        }
+        Ok(())
+    }
+    fn create_structure(&self, view: &V3dView) -> Result<(), Failure> {
+        let Some(viewer) = view.viewer().get().map(|v| v.structure_manager()) else {
+            return Ok(());
+        };
+        let owner: Handle<dyn V3dStructureComputer> = self.this.read().upgrade().cast();
+        let structure = V3dComputedStructure::create(&viewer, &owner)?;
+        if let Some(value) = structure.get() {
+            value.set_transform_persistence(&self.transform_pers.clone().cast());
+            value.set_z_layer(GRAPHIC3D_ZLAYER_ID_TOPMOST);
+            value.set_display_priority(Graphic3dDisplayPriority::Highlight)?;
+            value.set_infinite_state(true);
+            if let Some(cstructure) = value.cstructure().get() {
+                let affinity = Graphic3dViewAffinity::default();
+                affinity.set_visible(false);
+                affinity.set_view_visible(view.view().identification(), true);
+                cstructure.cstructure_base().fields.write().view_affinity = Handle::new(affinity);
+            }
+        }
+        let mut state = self.state.write();
+        (state.structure, state.to_compute) = (structure, true);
+        Ok(())
+    }
+    /// `Erase`: erases and forgets the structure; `trihedron.erase()`.
+    pub fn erase(&self) {
+        let structure = std::mem::take(&mut self.state.write().structure);
+        if let Some(value) = structure.get() {
+            value.erase();
+        }
+    }
+}
+
+impl V3dStructureComputer for V3dTrihedron {
+    /// `TrihedronStructure::Compute`; the native `void` member reports no failure.
+    fn compute_structure(&self) {
+        let _ = self.compute();
+    }
+}
+
+impl Drop for V3dTrihedron {
+    /// The destructor erases the trihedron.
+    fn drop(&mut self) {
+        self.erase();
+    }
+}
+
+impl V3dTrihedron {
+    /// `DumpJson`; `trihedron.dump_json(&mut stream, -1)?`.
+    pub fn dump_json(&self, stream: &mut DumpStream, depth: i32) -> io::Result<()> {
+        class_begin(stream, "V3d_Trihedron")?;
+        let sphere = &self.sphere_shading_aspect;
+        field_dumped(stream, depth, "mySphereShadingAspect.get()", &|s, d| {
+            sphere.dump_json(s, d)
+        })?;
+        for text in &self.text_aspects {
+            field_dumped(stream, depth, "aTextAspect.get()", &|s, d| {
+                text.dump_json(s, d)
+            })?;
+        }
+        for arrow in &self.arrow_shading_aspects {
+            field_dumped(stream, depth, "anArrowShadinAspect.get()", &|s, d| {
+                arrow.dump_json(s, d)
+            })?;
+        }
+        let state = self.state.read().clone();
+        if let Some(structure) = state.structure.get() {
+            field_dumped(stream, depth, "myStructure.get()", &|s, d| {
+                structure.dump_json(s, d)
+            })?;
+        }
+        let pers = &self.transform_pers;
+        field_dumped(stream, depth, "myTransformPers.get()", &|s, d| {
+            pers.dump_json(s, d)
+        })?;
+        field_real(stream, "myScale", state.scale)?;
+        field_real(stream, "myRatio", state.ratio)?;
+        field_real(stream, "myDiameter", state.diameter)?;
+        field_integer(stream, "myNbFacettes", state.nb_facettes)?;
+        field_integer(stream, "myIsWireframe", i32::from(state.is_wireframe))?;
+        field_integer(stream, "myToCompute", i32::from(state.to_compute))
+    }
+}
diff --git a/crates/tkv3d/src/v3d/trihedron_compute.rs b/crates/tkv3d/src/v3d/trihedron_compute.rs
new file mode 100644
index 000000000..b0e6ac05c
--- /dev/null
+++ b/crates/tkv3d/src/v3d/trihedron_compute.rs
@@ -0,0 +1,173 @@
+//! `V3d_Trihedron::compute`: the origin sphere, the axes and the labels of the trihedron.
+use super::V3dTrihedron;
+use super::trihedron::{
+    CIRCLE_SEGMENTS_NB, CYLINDER_LENGTH, INTERNAL_SCALE_FACTOR, TrihedronState,
+};
+use crate::prs3d::{Prs3dArrow, Prs3dText, Prs3dToolSphere};
+use rustycad_tkernel::standard::{Failure, Handle};
+use rustycad_tkernel::tcollection::ExtendedString;
+use rustycad_tkmath::gp::{Axis1, Point3, Transform3, ox, oy, oz};
+use rustycad_tkservice::graphic3d::{
+    Graphic3dArrayOfPolylines, Graphic3dArrayOfSegments, Graphic3dGroup,
+    Graphic3dGroupMembers as _, Graphic3dStructureDisplay as _, Graphic3dStructureMembers as _,
+    Graphic3dStructureSource,
+};
+use std::f64::consts::PI;
+
+impl V3dTrihedron {
+    /// `compute` (protected): rebuilds the origin, the three axes and the labels of the
+    /// structure. Example: `trihedron.compute()?`.
+    pub fn compute(&self) -> Result<(), Failure> {
+        let state = {
+            let mut state = self.state.write();
+            state.to_compute = false;
+            state.clone()
+        };
+        let Some(structure) = state.structure.get() else {
+            return Ok(());
+        };
+        structure.graphic_clear(false);
+        let geometry = TrihedronGeometry::of(&state);
+        let mut group_iter = 0usize;
+        self.compute_origin(&state.structure, &mut group_iter, &geometry, &state)?;
+        self.compute_axes(&state.structure, &mut group_iter, &geometry, &state)?;
+        let label_group = add_group(&state.structure, &mut group_iter)?;
+        let r = geometry.rayon;
+        let points = [
+            Point3::new(geometry.scale + 2.0 * r, 0.0, -r),
+            Point3::new(r, geometry.scale + 3.0 * r, 2.0 * r),
+            Point3::new(-2.0 * r, 0.5 * r, geometry.scale + 3.0 * r),
+        ];
+        for ((label, aspect), point) in state.labels.iter().zip(&self.text_aspects).zip(&points) {
+            let label = ExtendedString::new(&String::from_utf8_lossy(label.as_bytes()));
+            Prs3dText::draw(&label_group, aspect, &label, point);
+        }
+        Ok(())
+    }
+    fn compute_origin(
+        &self,
+        structure: &Handle<dyn Graphic3dStructureSource>,
+        group_iter: &mut usize,
+        g: &TrihedronGeometry,
+        state: &TrihedronState,
+    ) -> Result<(), Failure> {
+        let group = add_group(structure, group_iter)?;
+        let Some(sphere_group) = group.get() else {
+            return Ok(());
+        };
+        sphere_group.set_closed(!state.is_wireframe);
+        let aspect = self.sphere_shading_aspect.aspect().cast();
+        if state.is_wireframe {
+            let circle = Graphic3dArrayOfPolylines::new(CIRCLE_SEGMENTS_NB + 2, 0, 0, 0)?;
+            let segment = 2.0 * PI / f64::from(CIRCLE_SEGMENTS_NB);
+            for index in (0..=CIRCLE_SEGMENTS_NB).rev() {
+                let angle = f64::from(index) * segment;
+                circle.add_vertex_f64(g.rayon * angle.sin(), g.rayon * angle.cos(), 0.0)?;
+            }
+            let last = f64::from(CIRCLE_SEGMENTS_NB) * segment;
+            circle.add_vertex_f64(g.rayon * last.sin(), g.rayon * last.cos(), 0.0)?;
+            sphere_group.set_group_primitives_aspect(&aspect);
+            sphere_group.add_primitive_array(&Handle::new(circle).cast(), true);
+        } else {
+            let sphere = Prs3dToolSphere::create(
+                g.sphere_radius,
+                state.nb_facettes,
+                state.nb_facettes,
+                &Transform3::default(),
+            )?;
+            sphere_group.set_group_primitives_aspect(&aspect);
+            sphere_group.add_primitive_array(&sphere.cast(), true);
+        }
+        Ok(())
+    }
+    fn compute_axes(
+        &self,
+        structure: &Handle<dyn Graphic3dStructureSource>,
+        group_iter: &mut usize,
+        g: &TrihedronGeometry,
+        state: &TrihedronState,
+    ) -> Result<(), Failure> {
+        let axes: [Axis1; 3] = [ox(), oy(), oz()];
+        for (index, axis) in axes.iter().enumerate() {
+            let group = add_group(structure, group_iter)?;
+            let Some(axis_group) = group.get() else {
+                continue;
+            };
+            axis_group.set_closed(!state.is_wireframe);
+            let aspect = self.arrow_shading_aspects[index].aspect().cast();
+            if state.is_wireframe {
+                let array = Graphic3dArrayOfSegments::new(2, 0, 0)?;
+                array.add_vertex(0.0, 0.0, 0.0)?;
+                let end = axis.direction().xyz() * g.cylinder_length;
+                array.add_vertex_f64(end.x(), end.y(), end.z())?;
+                axis_group.set_group_primitives_aspect(&aspect);
+                axis_group.add_primitive_array(&Handle::new(array).cast(), true);
+            }
+            let tube = if state.is_wireframe {
+                0.0
+            } else {
+                g.cylinder_radius
+            };
+            let triangles = Prs3dArrow::draw_shaded(
+                axis,
+                tube,
+                g.cylinder_length + g.cone_length,
+                g.cone_radius,
+                g.cone_length,
+                state.nb_facettes,
+            )?;
+            axis_group.set_group_primitives_aspect(&aspect);
+            axis_group.add_primitive_array(&triangles.cast(), true);
+        }
+        Ok(())
+    }
+}
+
+/// The sizes of `compute`, in the native operation order.
+struct TrihedronGeometry {
+    scale: f64,
+    cylinder_length: f64,
+    cylinder_radius: f64,
+    cone_radius: f64,
+    cone_length: f64,
+    sphere_radius: f64,
+    rayon: f64,
+}
+
+impl TrihedronGeometry {
+    fn of(state: &TrihedronState) -> Self {
+        let scale = state.scale * state.ratio * INTERNAL_SCALE_FACTOR;
+        let cylinder_length = scale * f64::from(CYLINDER_LENGTH);
+        let cylinder_radius = scale * state.diameter;
+        Self {
+            scale,
+            cylinder_length,
+            cylinder_radius,
+            cone_radius: if state.is_wireframe {
+                cylinder_radius
+            } else {
+                cylinder_radius * 2.0
+            },
+            cone_length: scale * (1.0 - f64::from(CYLINDER_LENGTH)),
+            sphere_radius: cylinder_radius * 2.0,
+            rayon: scale / 30.0,
+        }
+    }
+}
+
+/// `addGroup`: the existing group at the iterator, or a new one.
+fn add_group(
+    structure: &Handle<dyn Graphic3dStructureSource>,
+    group_iter: &mut usize,
+) -> Result<Handle<dyn Graphic3dGroup>, Failure> {
+    let Some(value) = structure.get() else {
+        return Ok(Handle::default());
+    };
+    let groups = value.groups();
+    let index = *group_iter;
+    *group_iter += 1;
+    if let Some(group) = groups.get(index) {
+        return Ok(group.clone());
+    }
+    value.new_group()
+}
diff --git a/crates/tkv3d/src/v3d/view.rs b/crates/tkv3d/src/v3d/view.rs
new file mode 100644
index 000000000..2e191a79c
--- /dev/null
+++ b/crates/tkv3d/src/v3d/view.rs
@@ -0,0 +1,475 @@
+//! `V3d_View`: a view of a viewer, over a driver view (`Graphic3d_CView`) and its camera.
+//!
+//! The driver view is created once and never changes; the camera is the driver view's
+//! (`SetCamera` refuses a null camera, so it is never null). The mutable fields sit in one
+//! `SharedState`; a member reads what it needs, releases the lock, then calls the camera, the
+//! driver view or the viewer. The members are split by topic: view_camera.rs (rotations and
+//! orientation), view_mapping.rs (size, zoom, fit and panning), view_convert.rs (pixel and
+//! view coordinates, queries), view_grid.rs (grids and trihedron), view_render.rs (backgrounds,
+//! lights, clip planes, rendering parameters) and view_dump.rs (image dump and `DumpJson`).
+use super::{V3dTrihedron, V3dTypeOfView, V3dViewer, v3d_bad_value};
+use rustycad_tkernel::ncollection::Vec2;
+use rustycad_tkernel::standard::exceptions::{null_object, program_error};
+use rustycad_tkernel::standard::{Failure, Handle, SharedState, StandardTransient, WeakHandle};
+use rustycad_tkmath::gp::{Axis3, Direction3, Point3, Vector3};
+use rustycad_tkservice::aspect::{
+    AspectGrid, AspectNeutralWindow, AspectRenderingContext, AspectTypeOfTriedronPosition,
+    AspectWindow, AspectWindowMembers as _,
+};
+use rustycad_tkservice::graphic3d::{
+    Graphic3dCLight, Graphic3dCView, Graphic3dCViewMembers as _, Graphic3dCViewSubviews as _,
+    Graphic3dCamera, Graphic3dCameraFocusType, Graphic3dCameraIodType, Graphic3dCameraProjection,
+    Graphic3dGroup, Graphic3dStructureSource, Graphic3dVertex,
+};
+
+/// The mutable fields of a view.
+#[derive(Clone)]
+pub(crate) struct V3dViewState {
+    pub(crate) old_mouse_x: f64,
+    pub(crate) old_mouse_y: f64,
+    pub(crate) cam_start_op_up: Direction3,
+    pub(crate) cam_start_op_dir: Direction3,
+    pub(crate) cam_start_op_eye: Point3,
+    pub(crate) cam_start_op_center: Point3,
+    pub(crate) immediate_update: bool,
+    pub(crate) is_invalidated_immediate: bool,
+    pub(crate) viewer: WeakHandle<V3dViewer>,
+    pub(crate) subviews: Vec<Handle<V3dView>>,
+    pub(crate) parent_view: WeakHandle<V3dView>,
+    pub(crate) active_lights: Vec<Handle<Graphic3dCLight>>,
+    pub(crate) active_lights_cursor: usize,
+    pub(crate) default_view_axis: Direction3,
+    pub(crate) default_view_point: Point3,
+    pub(crate) window: Handle<dyn AspectWindow>,
+    pub(crate) sx: i32,
+    pub(crate) sy: i32,
+    pub(crate) rx: f64,
+    pub(crate) ry: f64,
+    pub(crate) rotate_gravity: Point3,
+    pub(crate) computed_mode: bool,
+    pub(crate) switch_set_front: bool,
+    pub(crate) z_rotation: bool,
+    pub(crate) zoom_at_point_x: i32,
+    pub(crate) zoom_at_point_y: i32,
+    pub(crate) trihedron: Handle<V3dTrihedron>,
+    pub(crate) grid: Handle<dyn AspectGrid>,
+    pub(crate) plane: Axis3,
+    pub(crate) trsf: [[f64; 4]; 4],
+    pub(crate) shader_grid_active: bool,
+    pub(crate) grid_echo_structure: Handle<dyn Graphic3dStructureSource>,
+    pub(crate) grid_echo_group: Handle<dyn Graphic3dGroup>,
+    pub(crate) x_screen_axis: Vector3,
+    pub(crate) y_screen_axis: Vector3,
+    pub(crate) z_screen_axis: Vector3,
+    pub(crate) view_axis: Direction3,
+    pub(crate) gravity_reference_point: Graphic3dVertex,
+    pub(crate) auto_z_fit_is_on: bool,
+    pub(crate) auto_z_fit_scale_factor: f64,
+}
+
+impl V3dViewState {
+    /// The fields before the constructor body. The members that the native constructors
+    /// leave uninitialized (`myOldMouseX/Y`, `sx`, `sy`, `rx`, `ry`, `MyZoomAtPointX/Y`,
+    /// `MyTrsf`) start at zero.
+    fn initial(viewer: &Handle<V3dViewer>) -> Self {
+        Self {
+            old_mouse_x: 0.0,
+            old_mouse_y: 0.0,
+            cam_start_op_up: Direction3::default(),
+            cam_start_op_dir: Direction3::default(),
+            cam_start_op_eye: Point3::default(),
+            cam_start_op_center: Point3::default(),
+            immediate_update: false,
+            is_invalidated_immediate: true,
+            viewer: viewer.downgrade(),
+            subviews: Vec::new(),
+            parent_view: WeakHandle::default(),
+            active_lights: Vec::new(),
+            active_lights_cursor: 0,
+            default_view_axis: Direction3::default(),
+            default_view_point: Point3::default(),
+            window: Handle::default(),
+            sx: 0,
+            sy: 0,
+            rx: 0.0,
+            ry: 0.0,
+            rotate_gravity: Point3::default(),
+            computed_mode: false,
+            switch_set_front: false,
+            z_rotation: false,
+            zoom_at_point_x: 0,
+            zoom_at_point_y: 0,
+            trihedron: Handle::default(),
+            grid: Handle::default(),
+            plane: Axis3::default(),
+            trsf: [[0.0; 4]; 4],
+            shader_grid_active: false,
+            grid_echo_structure: Handle::default(),
+            grid_echo_group: Handle::default(),
+            x_screen_axis: Vector3::default(),
+            y_screen_axis: Vector3::default(),
+            z_screen_axis: Vector3::default(),
+            view_axis: Direction3::default(),
+            gravity_reference_point: Graphic3dVertex::default(),
+            auto_z_fit_is_on: true,
+            auto_z_fit_scale_factor: 1.0,
+        }
+    }
+}
+
+/// A view of a viewer.
+///
+/// Example: `let view = viewer.create_view()?; view.set_window(&window, 0)?; view.fit_all(0.01, true)?;`.
+pub struct V3dView {
+    transient: StandardTransient,
+    pub(crate) view: Handle<dyn Graphic3dCView>,
+    default_camera: Handle<Graphic3dCamera>,
+    this: SharedState<WeakHandle<V3dView>>,
+    pub(crate) state: SharedState<V3dViewState>,
+}
+rustycad_tkernel::impl_transient!(V3dView, "V3d_View", StandardTransient, transient);
+
+/// The driver view of a viewer's driver; a missing viewer or driver is refused.
+fn create_driver_view(viewer: &Handle<V3dViewer>) -> Result<Handle<dyn Graphic3dCView>, Failure> {
+    let Some(viewer_ref) = viewer.get() else {
+        return Err(null_object("V3d_View: null viewer; expected a viewer"));
+    };
+    let driver = viewer_ref.driver();
+    let Some(driver) = driver.get() else {
+        return Err(null_object(
+            "V3d_View: the viewer has no graphic driver; expected a driver",
+        ));
+    };
+    let view = driver.create_view(&viewer_ref.structure_manager())?;
+    if view.is_null() {
+        return Err(null_object(
+            "V3d_View: the driver created no view; expected a driver view",
+        ));
+    }
+    Ok(view)
+}
+
+impl V3dView {
+    fn allocate(
+        viewer: &Handle<V3dViewer>,
+        view: Handle<dyn Graphic3dCView>,
+        default_camera: Graphic3dCamera,
+    ) -> Handle<Self> {
+        let handle = Handle::new(Self {
+            transient: StandardTransient::default(),
+            view,
+            default_camera: Handle::new(default_camera),
+            this: SharedState::new(WeakHandle::default()),
+            state: SharedState::new(V3dViewState::initial(viewer)),
+        });
+        *handle.this.write() = handle.downgrade();
+        handle
+    }
+    /// `V3d_View(viewer, type)`: a view with the viewer's background, rendering parameters,
+    /// projection, size and visualization, registered in the viewer.
+    /// Example: `V3dView::new(&viewer, V3dTypeOfView::Orthographic)?`.
+    pub fn new(viewer: &Handle<V3dViewer>, kind: V3dTypeOfView) -> Result<Handle<Self>, Failure> {
+        let cview = create_driver_view(viewer)?;
+        let viewer_ref = viewer
+            .get()
+            .ok_or_else(|| null_object("V3d_View: null viewer"))?;
+        cview.set_background(&viewer_ref.get_background_color());
+        cview.set_gradient_background(&viewer_ref.get_gradient_background());
+        let params = viewer_ref.default_rendering_params();
+        cview.change_rendering_params(&mut |p| *p = params.clone());
+        let camera = Graphic3dCamera::default();
+        camera.set_fov_y(45.0);
+        camera.set_iod(Graphic3dCameraIodType::Relative, 0.05);
+        camera.set_z_focus(Graphic3dCameraFocusType::Relative, 1.0);
+        let projection = if kind == V3dTypeOfView::Orthographic {
+            Graphic3dCameraProjection::Orthographic
+        } else {
+            Graphic3dCameraProjection::Perspective
+        };
+        camera.set_projection_type(projection);
+        let view = Self::allocate(viewer, cview, Graphic3dCamera::default());
+        view.set_auto_z_fit_mode(true, 1.0)?;
+        view.set_back_facing_model(
+            rustycad_tkservice::graphic3d::Graphic3dTypeOfBackfacingModel::Auto,
+        );
+        view.set_camera(&Handle::new(camera))?;
+        view.set_axis(0.0, 0.0, 0.0, 1.0, 1.0, 1.0)?;
+        view.set_visualization(viewer_ref.default_visualization());
+        view.set_twist(0.0)?;
+        view.set_at(0.0, 0.0, 0.0)?;
+        view.set_proj_orientation(viewer_ref.default_view_proj(), false)?;
+        view.set_size(viewer_ref.default_view_size())?;
+        let z_size = viewer_ref.default_view_size();
+        view.set_z_size(2.0 * z_size)?;
+        view.set_depth(viewer_ref.default_view_size() / 2.0)?;
+        view.set_view_mapping_default();
+        view.set_view_orientation_default();
+        viewer_ref.add_view(&view);
+        view.init();
+        view.state.write().immediate_update = true;
+        Ok(view)
+    }
+    /// `V3d_View(viewer, view)`: a copy of another view's settings and default camera.
+    /// Example: `V3dView::new_copy(&viewer, &other)?`.
+    pub fn new_copy(
+        viewer: &Handle<V3dViewer>,
+        other: &Handle<V3dView>,
+    ) -> Result<Handle<Self>, Failure> {
+        let Some(other_ref) = other.get() else {
+            return Err(null_object("V3d_View: null view to copy; expected a view"));
+        };
+        let cview = create_driver_view(viewer)?;
+        cview.copy_settings(&other_ref.view())?;
+        let default_camera = Graphic3dCamera::from_camera(&other_ref.default_camera());
+        let view = Self::allocate(viewer, cview, default_camera);
+        {
+            let source = other_ref.state.read().clone();
+            let mut state = view.state.write();
+            (state.default_view_point, state.default_view_axis) =
+                (source.default_view_point, source.default_view_axis);
+        }
+        view.set_auto_z_fit_mode(
+            other_ref.auto_z_fit_mode(),
+            other_ref.auto_z_fit_scale_factor(),
+        )?;
+        if let Some(viewer_ref) = viewer.get() {
+            viewer_ref.add_view(&view);
+        }
+        view.init();
+        view.state.write().immediate_update = true;
+        Ok(view)
+    }
+    /// The view itself as a handle (`this`).
+    pub fn this(&self) -> Handle<V3dView> {
+        self.this.read().upgrade()
+    }
+    /// `View`: the driver view; `view.view()`.
+    pub fn view(&self) -> Handle<dyn Graphic3dCView> {
+        self.view.clone()
+    }
+    /// `Viewer`: the viewer, null after `Remove`; `view.viewer()`.
+    pub fn viewer(&self) -> Handle<V3dViewer> {
+        self.state.read().viewer.upgrade()
+    }
+    /// `Window`; `view.window()`.
+    pub fn window(&self) -> Handle<dyn AspectWindow> {
+        self.state.read().window.clone()
+    }
+    /// `DefaultCamera`; `view.default_camera()`.
+    pub fn default_camera(&self) -> Handle<Graphic3dCamera> {
+        self.default_camera.clone()
+    }
+    /// `Camera`: the camera of the driver view; `view.camera()`.
+    pub fn camera(&self) -> Handle<Graphic3dCamera> {
+        self.view.camera()
+    }
+    /// `SetCamera`; a null camera is refused with `Standard_NullObject` (natively it breaks
+    /// every later camera member). Example: `view.set_camera(&camera)?`.
+    pub fn set_camera(&self, camera: &Handle<Graphic3dCamera>) -> Result<(), Failure> {
+        if camera.is_null() {
+            return Err(null_object(
+                "V3d_View::SetCamera: null camera; expected a camera",
+            ));
+        }
+        self.view.set_camera(camera);
+        self.immediate_update()
+    }
+    /// `Init` (private): the computed mode of the viewer.
+    fn init(&self) {
+        let Some(viewer) = self
+            .viewer()
+            .get()
+            .map(|v| (v.computed_mode(), v.default_computed_mode()))
+        else {
+            return;
+        };
+        self.state.write().computed_mode = viewer.0;
+        if !viewer.0 || !viewer.1 {
+            self.set_computed_mode(false);
+        }
+    }
+    /// `SetWindow(window, context)`: attaches a window, activates the view and redraws.
+    /// A subview raises `Standard_ProgramError`. Example: `view.set_window(&window, 0)?`.
+    pub fn set_window(
+        &self,
+        window: &Handle<dyn AspectWindow>,
+        context: AspectRenderingContext,
+    ) -> Result<(), Failure> {
+        if self.view.is_removed() {
+            return Ok(());
+        }
+        if self.is_subview() {
+            return Err(program_error(
+                "V3d_View::SetWindow() called twice; the view is a subview",
+            ));
+        }
+        self.state.write().window = window.clone();
+        self.view.set_window(&Handle::default(), window, context);
+        if let Some(viewer) = self.viewer().get() {
+            viewer.set_view_on_one(&self.this())?;
+        }
+        self.set_ratio();
+        if self.state.read().immediate_update {
+            self.redraw();
+        }
+        Ok(())
+    }
+    /// `SetWindow(parentView, size, corner, offset, margins)`: makes this view a subview of
+    /// the parent (or of the parent's parent) in a virtual 4x4 window.
+    /// Example: `view.set_subview_window(&parent, Vec2::new(0.5, 0.5), corner, Vec2::new(0.0, 0.0), Vec2::new(0, 0))?`.
+    pub fn set_subview_window(
+        &self,
+        parent_view: &Handle<V3dView>,
+        size: Vec2<f64>,
+        corner: AspectTypeOfTriedronPosition,
+        offset: Vec2<f64>,
+        margins: Vec2<i32>,
+    ) -> Result<(), Failure> {
+        if self.view.is_removed() {
+            return Ok(());
+        }
+        let Some(parent_ref) = parent_view.get() else {
+            return Err(null_object(
+                "V3d_View::SetWindow: null parent view; expected a view",
+            ));
+        };
+        let parent = if parent_ref.is_subview() {
+            parent_ref.parent_view()
+        } else {
+            parent_view.clone()
+        };
+        let current = self.state.read().parent_view.upgrade();
+        if parent != current {
+            if !current.is_null() {
+                return Err(program_error(
+                    "V3d_View::SetWindow() called twice; the subview has another parent",
+                ));
+            }
+            self.state.write().parent_view = parent.downgrade();
+            if let Some(parent_ref) = parent.get() {
+                parent_ref.add_subview(&self.this());
+            }
+        }
+        let window = AspectNeutralWindow::default();
+        window.set_virtual(true);
+        window.set_size(4, 4);
+        self.view.set_subview_corner(corner);
+        self.view.set_subview_size(size);
+        self.view.set_subview_offset(offset);
+        self.view.set_subview_margins(margins);
+        let window: Handle<dyn AspectWindow> = Handle::new(window).cast();
+        self.state.write().window = window.clone();
+        let parent_cview = parent.get().map(V3dView::view).unwrap_or_default();
+        self.view.set_window(&parent_cview, &window, 0);
+        if let Some(viewer) = self.viewer().get() {
+            viewer.set_view_on_one(&self.this())?;
+        }
+        self.set_ratio();
+        Ok(())
+    }
+    /// `SetMagnify`: an undefined view takes a window and fits the rectangle of another view.
+    /// Example: `view.set_magnify(&window, &previous, 0, 0, 100, 100)?`.
+    pub fn set_magnify(
+        &self,
+        window: &Handle<dyn AspectWindow>,
+        previous_view: &Handle<V3dView>,
+        x1: i32,
+        y1: i32,
+        x2: i32,
+        y2: i32,
+    ) -> Result<(), Failure> {
+        if self.view.is_removed() || self.view.is_defined() {
+            return Ok(());
+        }
+        let Some(previous) = previous_view.get() else {
+            return Ok(());
+        };
+        let (u1, v1) = previous.convert_to_view(x1, y1)?;
+        let (u2, v2) = previous.convert_to_view(x2, y2)?;
+        self.view.set_window(&Handle::default(), window, 0);
+        self.fit_all_rect(u1, v1, u2, v2)?;
+        if let Some(viewer) = self.viewer().get() {
+            viewer.set_view_on_one(&self.this())?;
+        }
+        self.state.write().window = window.clone();
+        self.set_ratio();
+        self.redraw();
+        self.set_view_mapping_default();
+        Ok(())
+    }
+    /// `Remove`: erases the grid, the shader grid and the trihedron, removes the subviews,
+    /// leaves the viewer and removes the driver view. Example: `view.remove()`.
+    pub fn remove(&self) {
+        let state = self.state.read().clone();
+        if let Some(grid) = state.grid.get() {
+            grid.erase();
+        }
+        if state.shader_grid_active {
+            self.view.grid_erase();
+            self.state.write().shader_grid_active = false;
+        }
+        if let Some(trihedron) = state.trihedron.get() {
+            trihedron.erase();
+        }
+        if let Some(parent) = state.parent_view.upgrade().get() {
+            parent.remove_subview(self);
+            self.state.write().parent_view = WeakHandle::default();
+        }
+        let subviews = std::mem::take(&mut self.state.write().subviews);
+        subviews
+            .iter()
+            .filter_map(Handle::get)
+            .for_each(V3dView::remove);
+        if let Some(viewer) = state.viewer.upgrade().get() {
+            viewer.del_view(self);
+            self.state.write().viewer = WeakHandle::default();
+        }
+        self.view.remove();
+        self.state.write().window = Handle::default();
+    }
+    /// `SetImmediateUpdate`: returns the previous mode; `view.set_immediate_update(false)`.
+    pub fn set_immediate_update(&self, immediate_update: bool) -> bool {
+        std::mem::replace(&mut self.state.write().immediate_update, immediate_update)
+    }
+    /// `ImmediateUpdate` (protected): `Update` when the immediate mode is on.
+    /// Example: `view.immediate_update()?`.
+    pub fn immediate_update(&self) -> Result<(), Failure> {
+        if self.state.read().immediate_update {
+            self.update()?;
+        }
+        Ok(())
+    }
+}
+
+impl Drop for V3dView {
+    /// The destructor detaches the view from its parent, detaches the subviews and removes
+    /// the driver view.
+    fn drop(&mut self) {
+        let state = self.state.read().clone();
+        if let Some(parent) = state.parent_view.upgrade().get() {
+            parent.remove_subview(self);
+        }
+        for subview in state.subviews.iter().filter_map(Handle::get) {
+            {
+                let mut sub_state = subview.state.write();
+                (sub_state.parent_view, sub_state.window) =
+                    (WeakHandle::default(), Handle::default());
+            }
+            subview.view.remove();
+            if let Some(viewer) = subview.viewer().get() {
+                viewer.set_view_off_one(&subview.this());
+            }
+        }
+        if !self.view.is_removed() {
+            self.view.remove();
+        }
+    }
+}
+
+/// `V3d_BadValue_Raise_if` with the offending value.
+pub(crate) fn bad_value_if(condition: bool, message: &str) -> Result<(), Failure> {
+    if condition {
+        return Err(v3d_bad_value(message));
+    }
+    Ok(())
+}
