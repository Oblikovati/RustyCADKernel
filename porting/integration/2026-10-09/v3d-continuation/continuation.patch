diff --git a/crates/tkv3d/src/select3d/point_data.rs b/crates/tkv3d/src/select3d/point_data.rs
new file mode 100644
index 000000000..11216f88c
--- /dev/null
+++ b/crates/tkv3d/src/select3d/point_data.rs
@@ -0,0 +1,99 @@
+//! `Select3D_Pnt` and `Select3D_PointData`: the single-precision points of the sensitive
+//! polygons (a point is rounded to `float` when stored, as natively).
+use rustycad_tkernel::standard::Failure;
+use rustycad_tkernel::standard::exceptions::{construction_error, out_of_range};
+use rustycad_tkernel::standard::real::real_to_short_real;
+use rustycad_tkmath::gp::{Point3, Xyz};
+
+/// `Select3D_Pnt`: a point in single precision.
+#[derive(Clone, Copy, Debug, Default, PartialEq)]
+pub struct Select3DPnt {
+    /// `x`.
+    pub x: f32,
+    /// `y`.
+    pub y: f32,
+    /// `z`.
+    pub z: f32,
+}
+
+impl Select3DPnt {
+    /// `operator=(gp_Pnt)`: the coordinates rounded with `RealToShortReal`.
+    /// Example: `Select3DPnt::from_point(&Point3::new(1.0, 2.0, 3.0))`.
+    pub fn from_point(point: &Point3) -> Self {
+        Self {
+            x: real_to_short_real(point.x()),
+            y: real_to_short_real(point.y()),
+            z: real_to_short_real(point.z()),
+        }
+    }
+    /// `operator gp_Pnt`; `pnt.to_point()`.
+    pub fn to_point(self) -> Point3 {
+        Point3::new(f64::from(self.x), f64::from(self.y), f64::from(self.z))
+    }
+    /// `operator gp_XYZ`; `pnt.to_xyz()`.
+    pub fn to_xyz(self) -> Xyz {
+        Xyz::new(f64::from(self.x), f64::from(self.y), f64::from(self.z))
+    }
+}
+
+/// `Select3D_PointData`: a fixed number of single-precision points.
+///
+/// Example: `let mut data = Select3DPointData::new(3)?; data.set_pnt(0, &p)?;`.
+#[derive(Clone, Debug)]
+pub struct Select3DPointData {
+    points: Vec<Select3DPnt>,
+}
+
+impl Select3DPointData {
+    /// `nb_points` zero points; a count <= 0 raises `Standard_ConstructionError`.
+    /// Example: `Select3DPointData::new(4)?`.
+    pub fn new(nb_points: i32) -> Result<Self, Failure> {
+        if nb_points <= 0 {
+            return Err(construction_error(&format!(
+                "Select3D_PointData: {nb_points} points; expected > 0"
+            )));
+        }
+        Ok(Self {
+            points: vec![Select3DPnt::default(); nb_points as usize],
+        })
+    }
+    /// The checked offset of an index.
+    fn offset(&self, index: i32, member: &str) -> Result<usize, Failure> {
+        usize::try_from(index)
+            .ok()
+            .filter(|&i| i < self.points.len())
+            .ok_or_else(|| {
+                out_of_range(&format!(
+                    "Select3D_PointData::{member}: index {index}; expected 0..{}",
+                    self.points.len()
+                ))
+            })
+    }
+    /// `SetPnt(index, Select3D_Pnt)`; an index out of range raises `Standard_OutOfRange`.
+    /// Example: `data.set_select3d_pnt(0, pnt)?`.
+    pub fn set_select3d_pnt(&mut self, index: i32, value: Select3DPnt) -> Result<(), Failure> {
+        let offset = self.offset(index, "SetPnt")?;
+        self.points[offset] = value;
+        Ok(())
+    }
+    /// `SetPnt(index, gp_Pnt)`: the point rounded to single precision; `data.set_pnt(0, &p)?`.
+    pub fn set_pnt(&mut self, index: i32, value: &Point3) -> Result<(), Failure> {
+        self.set_select3d_pnt(index, Select3DPnt::from_point(value))
+    }
+    /// `Pnt`; an index out of range raises `Standard_OutOfRange`. Example: `data.pnt(0)?`.
+    pub fn pnt(&self, index: i32) -> Result<Select3DPnt, Failure> {
+        Ok(self.points[self.offset(index, "Pnt")?])
+    }
+    /// `Pnt3d`: the point in double precision; `data.pnt3d(0)?`.
+    pub fn pnt3d(&self, index: i32) -> Result<Point3, Failure> {
+        self.pnt(index).map(Select3DPnt::to_point)
+    }
+    /// `Size`; `data.size()`.
+    pub fn size(&self) -> i32 {
+        self.points.len() as i32
+    }
+    /// The points in order (for the dumps and the polygon tests).
+    pub fn points(&self) -> &[Select3DPnt] {
+        &self.points
+    }
+}
diff --git a/crates/tkv3d/src/select3d/primitive_array.rs b/crates/tkv3d/src/select3d/primitive_array.rs
new file mode 100644
index 000000000..79c71c7a5
--- /dev/null
+++ b/crates/tkv3d/src/select3d/primitive_array.rs
@@ -0,0 +1,363 @@
+//! `Select3D_SensitivePrimitiveArray`: the triangles or points of a primitive array (vertex and
+//! index buffers) in a BVH tree, optionally grouped in patches of neighbour elements or split
+//! into sub-arrays. The detection members are in primitive_array_match.rs.
+use super::bvh_index_buffer::Select3DBvhIndexBuffer;
+use super::{Select3DBndBox3d, Select3DSensitiveEntityBase, Select3DSensitiveSetBase};
+use crate::select_mgr::SelectMgrEntityOwnerSource;
+use rustycad_tkernel::ncollection::{Vec2, Vec3};
+use rustycad_tkernel::standard::real::real_last;
+use rustycad_tkernel::standard::short_real::short_real_last;
+use rustycad_tkernel::standard::{Failure, Handle, SharedState, StandardTransient};
+use rustycad_tkernel::tcol_std::HPackedMapOfInteger;
+use rustycad_tkmath::gp::{GeneralTransform3, Point3, Transform3};
+use rustycad_tkmath::toploc::Location;
+use rustycad_tkservice::graphic3d::{
+    Graphic3dBufferBase, Graphic3dBufferMembers as _, Graphic3dBufferSource,
+    Graphic3dIndexBufferMembers as _, Graphic3dIndexBufferSource, Graphic3dTypeOfAttribute,
+    Graphic3dTypeOfData, Graphic3dTypeOfPrimitiveArray,
+};
+
+/// The fields of a primitive array.
+#[derive(Clone)]
+pub(crate) struct PrimArrayState {
+    pub(crate) groups: Option<Vec<Handle<Select3DSensitivePrimitiveArray>>>,
+    pub(crate) verts: Handle<dyn Graphic3dBufferSource>,
+    pub(crate) indices: Handle<dyn Graphic3dIndexBufferSource>,
+    /// `myPosData` as a byte offset in the vertex buffer (None for the null pointer).
+    pub(crate) pos_offset: Option<usize>,
+    pub(crate) pos_stride: usize,
+    pub(crate) prim_type: Graphic3dTypeOfPrimitiveArray,
+    pub(crate) index_lower: i32,
+    pub(crate) index_upper: i32,
+    pub(crate) patch_size_max: i32,
+    pub(crate) patch_distance: f32,
+    pub(crate) is_3d: bool,
+    pub(crate) init_location: Location,
+    pub(crate) cdg3d: Point3,
+    pub(crate) bnd_box: Select3DBndBox3d,
+    pub(crate) inv_init_location: GeneralTransform3,
+    pub(crate) detected_elem_map: Handle<HPackedMapOfInteger>,
+    pub(crate) detected_node_map: Handle<HPackedMapOfInteger>,
+    pub(crate) min_depth_elem: f64,
+    pub(crate) min_depth_node: f64,
+    pub(crate) min_depth_edge: f64,
+    pub(crate) detected_elem: i32,
+    pub(crate) detected_node: i32,
+    pub(crate) detected_edge_node1: i32,
+    pub(crate) detected_edge_node2: i32,
+    pub(crate) to_detect_elem: bool,
+    pub(crate) to_detect_node: bool,
+    pub(crate) to_detect_edge: bool,
+}
+
+/// A sensitive primitive array.
+///
+/// Example: `let sens = Select3DSensitivePrimitiveArray::new(&owner)?; sens.init_triangulation_all(&verts, &indices, &Location::default(), true, 1)?;`.
+pub struct Select3DSensitivePrimitiveArray {
+    transient: StandardTransient,
+    pub(crate) entity: Select3DSensitiveEntityBase,
+    pub(crate) set: Select3DSensitiveSetBase,
+    pub(crate) bvh_indices: Select3DBvhIndexBuffer,
+    pub(crate) state: SharedState<PrimArrayState>,
+}
+rustycad_tkernel::impl_transient!(Select3DSensitivePrimitiveArray, "Select3D_SensitivePrimitiveArray", dyn super::Select3DSensitiveSet, transient,
+    interfaces: [dyn super::Select3DSensitiveEntity, dyn super::Select3DSensitiveSet]);
+
+/// A point of single-precision coordinates.
+pub(crate) fn vec3_to_pnt(v: Vec3<f32>) -> Point3 {
+    Point3::new(f64::from(v.x), f64::from(v.y), f64::from(v.z))
+}
+
+/// A point of single-precision plane coordinates (`z = 0`).
+pub(crate) fn vec2_to_pnt(v: Vec2<f32>) -> Point3 {
+    Point3::new(f64::from(v.x), f64::from(v.y), 0.0)
+}
+
+/// The arguments of `InitTriangulation` and `InitPoints`.
+#[derive(Clone)]
+pub struct Select3DPrimArrayInit {
+    /// The vertex buffer.
+    pub verts: Handle<dyn Graphic3dBufferSource>,
+    /// The index buffer (null to use the vertices in order).
+    pub indices: Handle<dyn Graphic3dIndexBufferSource>,
+    /// The initial location.
+    pub init_loc: Location,
+    /// The first index (inclusive).
+    pub index_lower: i32,
+    /// The last index (inclusive).
+    pub index_upper: i32,
+    /// Whether to compute the bounding box.
+    pub to_eval_min_max: bool,
+    /// The number of sub-arrays (sub-groups).
+    pub nb_groups: i32,
+}
+
+impl Select3DPrimArrayInit {
+    /// The whole index (or vertex) range of the buffers, as the overloads without range.
+    /// Example: `Select3DPrimArrayInit::whole(&verts, &indices, &Location::default(), true, 1)`.
+    pub fn whole(
+        verts: &Handle<dyn Graphic3dBufferSource>,
+        indices: &Handle<dyn Graphic3dIndexBufferSource>,
+        init_loc: &Location,
+        to_eval_min_max: bool,
+        nb_groups: i32,
+    ) -> Self {
+        let upper = match (indices.get(), verts.get()) {
+            (Some(i), _) => i.nb_elements() - 1,
+            (None, Some(v)) => v.nb_elements() - 1,
+            (None, None) => 0,
+        };
+        Self {
+            verts: verts.clone(),
+            indices: indices.clone(),
+            init_loc: init_loc.clone(),
+            index_lower: 0,
+            index_upper: upper,
+            to_eval_min_max,
+            nb_groups,
+        }
+    }
+}
+
+impl Select3DSensitivePrimitiveArray {
+    /// An empty array of an owner: patches of 1, element detection only.
+    /// Example: `Select3DSensitivePrimitiveArray::new(&owner)?`.
+    pub fn new(owner: &Handle<dyn SelectMgrEntityOwnerSource>) -> Result<Self, Failure> {
+        let state = PrimArrayState {
+            groups: None,
+            verts: Handle::default(),
+            indices: Handle::default(),
+            pos_offset: None,
+            pos_stride: usize::MAX,
+            prim_type: Graphic3dTypeOfPrimitiveArray::Undefined,
+            index_lower: 0,
+            index_upper: 0,
+            patch_size_max: 1,
+            patch_distance: short_real_last(),
+            is_3d: false,
+            init_location: Location::default(),
+            cdg3d: Point3::default(),
+            bnd_box: Select3DBndBox3d::default(),
+            inv_init_location: GeneralTransform3::from(Transform3::default()),
+            detected_elem_map: Handle::default(),
+            detected_node_map: Handle::default(),
+            min_depth_elem: real_last(),
+            min_depth_node: real_last(),
+            min_depth_edge: real_last(),
+            detected_elem: -1,
+            detected_node: -1,
+            detected_edge_node1: -1,
+            detected_edge_node2: -1,
+            to_detect_elem: true,
+            to_detect_node: false,
+            to_detect_edge: false,
+        };
+        Ok(Self {
+            transient: StandardTransient::default(),
+            entity: Select3DSensitiveEntityBase::new(owner),
+            set: Select3DSensitiveSetBase::default(),
+            bvh_indices: Select3DBvhIndexBuffer::new(Graphic3dBufferBase::default_allocator())?,
+            state: SharedState::new(state),
+        })
+    }
+    /// A copy of the fields.
+    pub(crate) fn read(&self) -> PrimArrayState {
+        self.state.read().clone()
+    }
+    /// `PatchSizeMax`; `sens.patch_size_max()`.
+    pub fn patch_size_max(&self) -> i32 {
+        self.state.read().patch_size_max
+    }
+    /// `SetPatchSizeMax`; `sens.set_patch_size_max(8)`.
+    pub fn set_patch_size_max(&self, patch_size_max: i32) {
+        self.state.write().patch_size_max = patch_size_max;
+    }
+    /// `PatchDistance`; `sens.patch_distance()`.
+    pub fn patch_distance(&self) -> f32 {
+        self.state.read().patch_distance
+    }
+    /// `SetPatchDistance`; `sens.set_patch_distance(0.5)`.
+    pub fn set_patch_distance(&self, patch_dist_max: f32) {
+        self.state.write().patch_distance = patch_dist_max;
+    }
+    /// `SetMinMax`: the box of the array and of its sub-arrays.
+    /// Example: `sens.set_min_max(0.0, 0.0, 0.0, 1.0, 1.0, 1.0)`.
+    pub fn set_min_max(
+        &self,
+        min_x: f64,
+        min_y: f64,
+        min_z: f64,
+        max_x: f64,
+        max_y: f64,
+        max_z: f64,
+    ) {
+        let bounds = Select3DBndBox3d::from_corners(
+            Vec3::new(min_x, min_y, min_z),
+            Vec3::new(max_x, max_y, max_z),
+        );
+        let groups = {
+            let mut state = self.state.write();
+            state.bnd_box = bounds;
+            state.groups.clone()
+        };
+        for group in groups.unwrap_or_default().iter().filter_map(Handle::get) {
+            group.state.write().bnd_box = bounds;
+        }
+    }
+    /// `ToDetectElements`; `sens.to_detect_elements()`.
+    pub fn to_detect_elements(&self) -> bool {
+        self.state.read().to_detect_elem
+    }
+    /// `SetDetectElements`; `sens.set_detect_elements(false)`.
+    pub fn set_detect_elements(&self, to_detect: bool) {
+        self.state.write().to_detect_elem = to_detect;
+    }
+    /// `ToDetectElementMap`; `sens.to_detect_element_map()`.
+    pub fn to_detect_element_map(&self) -> bool {
+        !self.state.read().detected_elem_map.is_null()
+    }
+    /// `SetDetectElementMap`: a new (or cleared) map, or none; `sens.set_detect_element_map(true)`.
+    pub fn set_detect_element_map(&self, to_detect: bool) {
+        let mut state = self.state.write();
+        state.detected_elem_map = detection_map(&state.detected_elem_map, to_detect);
+    }
+    /// `ToDetectNodes`; `sens.to_detect_nodes()`.
+    pub fn to_detect_nodes(&self) -> bool {
+        self.state.read().to_detect_node
+    }
+    /// `SetDetectNodes`; `sens.set_detect_nodes(true)`.
+    pub fn set_detect_nodes(&self, to_detect: bool) {
+        self.state.write().to_detect_node = to_detect;
+    }
+    /// `ToDetectNodeMap`; `sens.to_detect_node_map()`.
+    pub fn to_detect_node_map(&self) -> bool {
+        !self.state.read().detected_node_map.is_null()
+    }
+    /// `SetDetectNodeMap`; `sens.set_detect_node_map(true)`.
+    pub fn set_detect_node_map(&self, to_detect: bool) {
+        let mut state = self.state.write();
+        state.detected_node_map = detection_map(&state.detected_node_map, to_detect);
+    }
+    /// `ToDetectEdges`; `sens.to_detect_edges()`.
+    pub fn to_detect_edges(&self) -> bool {
+        self.state.read().to_detect_edge
+    }
+    /// `SetDetectEdges`; `sens.set_detect_edges(true)`.
+    pub fn set_detect_edges(&self, to_detect: bool) {
+        self.state.write().to_detect_edge = to_detect;
+    }
+    /// `LastDetectedElement`; `sens.last_detected_element()`.
+    pub fn last_detected_element(&self) -> i32 {
+        self.state.read().detected_elem
+    }
+    /// `LastDetectedElementMap`; `sens.last_detected_element_map()`.
+    pub fn last_detected_element_map(&self) -> Handle<HPackedMapOfInteger> {
+        self.state.read().detected_elem_map.clone()
+    }
+    /// `LastDetectedNode`; `sens.last_detected_node()`.
+    pub fn last_detected_node(&self) -> i32 {
+        self.state.read().detected_node
+    }
+    /// `LastDetectedNodeMap`; `sens.last_detected_node_map()`.
+    pub fn last_detected_node_map(&self) -> Handle<HPackedMapOfInteger> {
+        self.state.read().detected_node_map.clone()
+    }
+    /// `LastDetectedEdgeNode1`; `sens.last_detected_edge_node1()`.
+    pub fn last_detected_edge_node1(&self) -> i32 {
+        self.state.read().detected_edge_node1
+    }
+    /// `LastDetectedEdgeNode2`; `sens.last_detected_edge_node2()`.
+    pub fn last_detected_edge_node2(&self) -> i32 {
+        self.state.read().detected_edge_node2
+    }
+    /// `getPosVec3` (protected): the 3D position of a vertex (zero past the buffer).
+    pub fn get_pos_vec3(&self, index: i32) -> Vec3<f32> {
+        let state = self.state.read();
+        read_position(&state, index).unwrap_or_default()
+    }
+    /// `getPosVec2` (protected): the 2D position of a vertex (zero past the buffer).
+    pub fn get_pos_vec2(&self, index: i32) -> Vec2<f32> {
+        let state = self.state.read();
+        read_position_2d(&state, index).unwrap_or_default()
+    }
+    /// `GetVertex`: the three positions of a triangle; `sens.get_vertex(0)`.
+    pub fn get_vertex(&self, index: i32) -> [Vec3<f32>; 3] {
+        let state = self.state.read();
+        let nodes = tri_indices(&state.indices, index * 3);
+        nodes.map(|n| read_position(&state, n).unwrap_or_default())
+    }
+}
+
+/// `SetDetect*Map`: a cleared map, a new map, or none.
+fn detection_map(
+    current: &Handle<HPackedMapOfInteger>,
+    to_detect: bool,
+) -> Handle<HPackedMapOfInteger> {
+    if !to_detect {
+        return Handle::default();
+    }
+    match current.get() {
+        Some(map) => {
+            map.change_map().clear();
+            current.clone()
+        }
+        None => Handle::new(HPackedMapOfInteger::default()),
+    }
+}
+
+/// The 3D position of a vertex through `myPosData + myPosStride * index`.
+pub(crate) fn read_position(state: &PrimArrayState, index: i32) -> Option<Vec3<f32>> {
+    let offset = state
+        .pos_offset?
+        .wrapping_add(state.pos_stride.wrapping_mul(index as usize));
+    state.verts.get()?.read_at::<Vec3<f32>>(offset)
+}
+
+/// The 2D position of a vertex.
+pub(crate) fn read_position_2d(state: &PrimArrayState, index: i32) -> Option<Vec2<f32>> {
+    let offset = state
+        .pos_offset?
+        .wrapping_add(state.pos_stride.wrapping_mul(index as usize));
+    state.verts.get()?.read_at::<Vec2<f32>>(offset)
+}
+
+/// The position of a vertex as a point (3D or in the plane).
+pub(crate) fn position_point(state: &PrimArrayState, index: i32) -> Point3 {
+    if state.is_3d {
+        vec3_to_pnt(read_position(state, index).unwrap_or_default())
+    } else {
+        vec2_to_pnt(read_position_2d(state, index).unwrap_or_default())
+    }
+}
+
+/// `getTriIndices`: the three vertex indexes of the triangle at an index offset.
+pub(crate) fn tri_indices(
+    indices: &Handle<dyn Graphic3dIndexBufferSource>,
+    offset: i32,
+) -> [i32; 3] {
+    match indices.get() {
+        Some(buffer) => [0, 1, 2].map(|k| buffer.index(offset + k).unwrap_or(0)),
+        None => [offset, offset + 1, offset + 2],
+    }
+}
+
+/// The vertex index of a point at an index offset.
+pub(crate) fn point_index(indices: &Handle<dyn Graphic3dIndexBufferSource>, offset: i32) -> i32 {
+    indices
+        .get()
+        .map_or(offset, |b| b.index(offset).unwrap_or(0))
+}
+
+/// The position attribute of the vertices: its byte offset, stride and dimension (None when
+/// absent or not a 2D, 3D or 4D vector).
+pub(crate) fn position_attribute(
+    verts: &dyn Graphic3dBufferSource,
+) -> Option<(usize, usize, bool)> {
+    let (index, offset, stride) = verts.attribute_data(Graphic3dTypeOfAttribute::Pos)?;
+    let data_type = verts.attribute(index)?.data_type;
+    let is_3d = matches!(
+        data_type,
+        Graphic3dTypeOfData::Vec3 | Graphic3dTypeOfData::Vec4
+    );
+    (is_3d || data_type == Graphic3dTypeOfData::Vec2).then_some((offset, stride, is_3d))
+}
diff --git a/crates/tkv3d/src/select3d/primitive_array_init.rs b/crates/tkv3d/src/select3d/primitive_array_init.rs
new file mode 100644
index 000000000..18448cdf2
--- /dev/null
+++ b/crates/tkv3d/src/select3d/primitive_array_init.rs
@@ -0,0 +1,331 @@
+//! `Select3D_SensitivePrimitiveArray::InitTriangulation`, `InitPoints` and the sub-array
+//! groups (built in order; natively by `OSD_Parallel::For`, with the same result).
+use super::primitive_array::{
+    PrimArrayState, Select3DPrimArrayInit, Select3DSensitivePrimitiveArray, point_index,
+    position_attribute, read_position, read_position_2d, tri_indices, vec3_to_pnt,
+};
+use super::{Select3DBndBox3d, Select3DSensitiveEntity, Select3DSensitiveEntityMembers as _};
+use rustycad_tkernel::ncollection::Vec3;
+use rustycad_tkernel::standard::short_real::short_real_last;
+use rustycad_tkernel::standard::{Failure, Handle};
+use rustycad_tkmath::gp::{GeneralTransform3, Point3, Xyz};
+use rustycad_tkservice::graphic3d::{Graphic3dBufferMembers as _, Graphic3dTypeOfPrimitiveArray};
+
+/// `hasSharedNode`: two triangles share a vertex.
+fn has_shared_node(tri1: &[i32; 3], tri2: &[i32; 3]) -> bool {
+    tri2.iter().any(|n| tri1.contains(n))
+}
+
+/// The element count of an init (triangles or points), and whether it is split into groups.
+struct InitCounts {
+    first: i32,
+    count: i32,
+    has_groups: bool,
+}
+
+impl Select3DSensitivePrimitiveArray {
+    /// The reset at the start of an init: dirty tree, no group, no buffers, the location.
+    fn reset_for_init(
+        &self,
+        prim_type: Graphic3dTypeOfPrimitiveArray,
+        init_loc: &rustycad_tkmath::toploc::Location,
+    ) -> Result<(), Failure> {
+        self.set.mark_dirty();
+        self.bvh_indices.release()?;
+        let mut state = self.state.write();
+        state.groups = None;
+        state.prim_type = prim_type;
+        state.bnd_box.clear();
+        (state.verts, state.indices) = (Handle::default(), Handle::default());
+        (
+            state.index_lower,
+            state.index_upper,
+            state.pos_offset,
+            state.pos_stride,
+        ) = (0, 0, None, usize::MAX);
+        state.is_3d = false;
+        state.init_location = init_loc.clone();
+        Ok(())
+    }
+    /// The checks of an init: vertices with a valid position attribute and an index range
+    /// inside the index (or vertex) buffer; the position is kept as natively.
+    fn check_init(&self, init: &Select3DPrimArrayInit) -> bool {
+        let Some(verts) = init.verts.get().filter(|v| v.nb_elements() != 0) else {
+            return false;
+        };
+        let Some((offset, stride, is_3d)) = position_attribute(verts) else {
+            return false;
+        };
+        {
+            let mut state = self.state.write();
+            (state.pos_offset, state.pos_stride, state.is_3d) = (Some(offset), stride, is_3d);
+        }
+        let (lower, upper) = (init.index_lower, init.index_upper);
+        match init.indices.get() {
+            Some(indices) => {
+                !(lower < 0 || upper >= indices.nb_elements() || indices.nb_elements() == 0)
+            }
+            None => !(lower < 0 || upper >= verts.nb_elements()),
+        }
+    }
+    /// The BVH index buffer and the stored buffers of a checked init; false when the index
+    /// buffer cannot be allocated.
+    fn store_init(
+        &self,
+        init: &Select3DPrimArrayInit,
+        counts: &InitCounts,
+    ) -> Result<bool, Failure> {
+        let patches = !counts.has_groups && self.patch_size_max() > 1;
+        if !self.bvh_indices.init(
+            if counts.has_groups {
+                init.nb_groups
+            } else {
+                counts.count
+            },
+            patches,
+        )? {
+            return Ok(false);
+        }
+        let inverse = GeneralTransform3::from(init.init_loc.transformation().inverted()?);
+        let mut state = self.state.write();
+        (state.verts, state.indices) = (init.verts.clone(), init.indices.clone());
+        (
+            state.index_lower,
+            state.index_upper,
+            state.inv_init_location,
+        ) = (init.index_lower, init.index_upper, inverse);
+        Ok(true)
+    }
+    /// `InitTriangulation`: the triangles of the index range, in patches of neighbours when the
+    /// patch size is above 1, or in sub-arrays; false for invalid buffers or ranges.
+    /// Example: `sens.init_triangulation(&init)?`.
+    pub fn init_triangulation(&self, init: &Select3DPrimArrayInit) -> Result<bool, Failure> {
+        self.reset_for_init(Graphic3dTypeOfPrimitiveArray::Triangles, &init.init_loc)?;
+        self.state.write().cdg3d = Point3::new(0.0, 0.0, 0.0);
+        if !self.check_init(init) {
+            return Ok(false);
+        }
+        let count = (init.index_upper - init.index_lower + 1) / 3;
+        let counts = InitCounts {
+            first: init.index_lower / 3,
+            count,
+            has_groups: init.nb_groups > 1 && count / init.nb_groups > 10,
+        };
+        if count < 1 || !self.store_init(init, &counts)? {
+            return Ok(false);
+        }
+        if counts.has_groups {
+            return self.init_groups(init, (count / init.nb_groups) * 3);
+        }
+        self.index_triangles(&counts);
+        self.finish_init(init.to_eval_min_max);
+        Ok(true)
+    }
+    /// `InitPoints`: the points of the index range, in patches of close points when the patch
+    /// size is above 1, or in sub-arrays. Example: `sens.init_points(&init)?`.
+    pub fn init_points(&self, init: &Select3DPrimArrayInit) -> Result<bool, Failure> {
+        self.reset_for_init(Graphic3dTypeOfPrimitiveArray::Points, &init.init_loc)?;
+        if !self.check_init(init) {
+            return Ok(false);
+        }
+        let count = init.index_upper - init.index_lower + 1;
+        let counts = InitCounts {
+            first: init.index_lower,
+            count,
+            has_groups: init.nb_groups > 1 && count / init.nb_groups > 10,
+        };
+        if count < 1 || !self.store_init(init, &counts)? {
+            return Ok(false);
+        }
+        if counts.has_groups {
+            return self.init_groups(init, count / init.nb_groups);
+        }
+        self.index_points(&counts);
+        self.finish_init(init.to_eval_min_max);
+        Ok(true)
+    }
+    /// The box at the end of an init, when asked.
+    fn finish_init(&self, to_eval_min_max: bool) {
+        if to_eval_min_max {
+            self.compute_bounding_box();
+        }
+    }
+    /// The float center and the BVH indexes (or patches) of the triangles.
+    fn index_triangles(&self, counts: &InitCounts) {
+        let state = self.read();
+        let mut center = Vec3::<f32>::new(0.0, 0.0, 0.0);
+        let mut previous = [-1; 3];
+        let (mut patch_from, mut patch_size) = (0, 0);
+        let patches = self.bvh_indices.has_patches();
+        if patches {
+            self.bvh_indices.set_nb_elements(0);
+        }
+        for iter in 0..counts.count {
+            let mut current = tri_indices(&state.indices, (counts.first + iter) * 3);
+            center += triangle_sum(&state, &current) / 3.0f32;
+            std::mem::swap(&mut current, &mut previous);
+            if !patches {
+                self.bvh_indices.set_index(iter, counts.first + iter);
+                continue;
+            }
+            if patch_size < state.patch_size_max && has_shared_node(&current, &previous) {
+                patch_size += 1;
+                continue;
+            }
+            self.push_patch(counts.first + patch_from, patch_size);
+            (patch_from, patch_size) = (iter, 0);
+        }
+        if patch_size != 0 {
+            self.push_patch(counts.first + patch_from, patch_size);
+        }
+        center /= counts.count as f32;
+        self.state.write().cdg3d = vec3_to_pnt(center);
+    }
+    /// The float center and the BVH indexes (or patches) of the points.
+    fn index_points(&self, counts: &InitCounts) {
+        let state = self.read();
+        let mut center = Vec3::<f32>::new(0.0, 0.0, 0.0);
+        let (mut patch_from, mut patch_size) = (0, 0);
+        let patches = self.bvh_indices.has_patches();
+        if patches {
+            self.bvh_indices.set_nb_elements(0);
+        }
+        let distance = state.patch_distance;
+        let patch_size2 = if distance < short_real_last() {
+            distance * distance
+        } else {
+            distance
+        };
+        let mut previous: Option<Vec3<f32>> = None;
+        for iter in 0..counts.count {
+            let index = point_index(&state.indices, counts.first + iter);
+            let point = point_vec(&state, index);
+            center += point;
+            if !patches {
+                self.bvh_indices.set_index(iter, counts.first + iter);
+                continue;
+            }
+            let last = previous.replace(point);
+            if patch_size < state.patch_size_max
+                && last.is_some_and(|p| (point - p).square_modulus() < patch_size2)
+            {
+                patch_size += 1;
+                continue;
+            }
+            self.push_patch(
+                counts.first + patch_from,
+                if patch_size != 0 { patch_size } else { 1 },
+            );
+            (patch_from, patch_size) = (iter, 0);
+        }
+        if patch_size != 0 {
+            self.push_patch(counts.first + patch_from, patch_size);
+        }
+        center /= counts.count as f32;
+        self.state.write().cdg3d = vec3_to_pnt(center);
+    }
+    /// `SetIndex(NbElements++, index, patchSize)`.
+    fn push_patch(&self, index: i32, patch_size: i32) {
+        let position = self.bvh_indices.nb_elements();
+        self.bvh_indices.set_nb_elements(position + 1);
+        self.bvh_indices
+            .set_index_patch(position, index, patch_size);
+    }
+    /// The sub-arrays of an init split in `nb_groups` ranges of `div_step` indexes, then the
+    /// combined box, the BVH indexes and the mean center; false when a sub-array fails.
+    fn init_groups(&self, init: &Select3DPrimArrayInit, div_step: i32) -> Result<bool, Failure> {
+        let mut groups = Vec::with_capacity(init.nb_groups as usize);
+        let mut failures = 0;
+        for index in 0..init.nb_groups {
+            let (entity, ok) = self.init_group(init, index, div_step)?;
+            groups.push(entity);
+            failures += i32::from(!ok);
+        }
+        self.state.write().groups = Some(groups.clone());
+        if failures != 0 {
+            return Ok(false);
+        }
+        let mut center = Xyz::new(0.0, 0.0, 0.0);
+        for (index, group) in groups.iter().enumerate() {
+            let Some(value) = group.get() else { continue };
+            let group_box = value.bounding_box();
+            self.state.write().bnd_box.combine(&group_box);
+            self.bvh_indices.set_index(index as i32, index as i32);
+            center += value.center_of_geometry().xyz();
+        }
+        self.state.write().cdg3d = Point3::from(center / groups.len() as f64);
+        self.finish_init(init.to_eval_min_max);
+        Ok(true)
+    }
+    /// `Select3D_SensitivePrimitiveArray_InitFunctor`: one sub-array with the settings of this
+    /// array, initialized and with its BVH built; false when its init fails.
+    fn init_group(
+        &self,
+        init: &Select3DPrimArrayInit,
+        index: i32,
+        div_step: i32,
+    ) -> Result<(Handle<Self>, bool), Failure> {
+        let state = self.read();
+        let entity = Handle::new(Self::new(&self.owner_id())?);
+        entity.set_patch_size_max(state.patch_size_max);
+        entity.set_patch_distance(state.patch_distance);
+        entity.set_detect_elements(state.to_detect_elem);
+        entity.set_detect_element_map(!state.detected_elem_map.is_null());
+        entity.set_detect_nodes(state.to_detect_node);
+        entity.set_detect_node_map(!state.detected_node_map.is_null());
+        entity.set_sensitivity_factor(self.sensitivity_factor())?;
+        let lower = state.index_lower + index * div_step;
+        let upper = (lower + div_step - 1).min(state.index_upper);
+        let sub = Select3DPrimArrayInit {
+            index_lower: lower,
+            index_upper: upper,
+            nb_groups: 1,
+            ..init.clone()
+        };
+        let ok = match state.prim_type {
+            Graphic3dTypeOfPrimitiveArray::Points => entity.init_points(&sub)?,
+            Graphic3dTypeOfPrimitiveArray::Triangles => entity.init_triangulation(&sub)?,
+            _ => false,
+        };
+        if ok {
+            entity.bvh()?;
+        }
+        Ok((entity, ok))
+    }
+    /// `computeBoundingBox` (protected): the combined box of the groups, or of every vertex.
+    pub fn compute_bounding_box(&self) {
+        let state = self.read();
+        let mut bounds = Select3DBndBox3d::default();
+        if let Some(groups) = &state.groups {
+            for group in groups.iter().filter_map(Handle::get) {
+                bounds.combine(&group.bounding_box());
+            }
+        } else if let Some(verts) = state.verts.get() {
+            for index in 0..verts.nb_elements() {
+                let p = point_vec(&state, index);
+                bounds.add(&Vec3::new(f64::from(p.x), f64::from(p.y), f64::from(p.z)));
+            }
+        }
+        self.state.write().bnd_box = bounds;
+    }
+}
+
+/// The sum of the three vertices of a triangle in single precision (z = 0 in 2D).
+fn triangle_sum(state: &PrimArrayState, nodes: &[i32; 3]) -> Vec3<f32> {
+    if state.is_3d {
+        let [a, b, c] = nodes.map(|n| read_position(state, n).unwrap_or_default());
+        return a + b + c;
+    }
+    let [a, b, c] = nodes.map(|n| read_position_2d(state, n).unwrap_or_default());
+    let sum = a + b + c;
+    Vec3::new(sum.x, sum.y, 0.0)
+}
+
+/// The single-precision position of a vertex (z = 0 in 2D).
+fn point_vec(state: &PrimArrayState, index: i32) -> Vec3<f32> {
+    if state.is_3d {
+        return read_position(state, index).unwrap_or_default();
+    }
+    let p = read_position_2d(state, index).unwrap_or_default();
+    Vec3::new(p.x, p.y, 0.0)
+}
diff --git a/crates/tkv3d/src/select3d/primitive_array_match.rs b/crates/tkv3d/src/select3d/primitive_array_match.rs
