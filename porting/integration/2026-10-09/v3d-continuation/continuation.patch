+pub enum Prs3dDatumAxes {
+    /// `Prs3d_DatumAxes_XAxis`.
+    XAxis = 0x01,
+    /// `Prs3d_DatumAxes_YAxis`.
+    YAxis = 0x02,
+    /// `Prs3d_DatumAxes_XYAxes`.
+    XYAxes = 0x03,
+    /// `Prs3d_DatumAxes_ZAxis`.
