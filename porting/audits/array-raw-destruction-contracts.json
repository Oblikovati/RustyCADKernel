  "ownership_contract": [
    "Each visited slot is dead, including a slot whose destructor panics; remaining slots stay live.",
    "Caller must know the visited prefix when recovering and must never read or automatically drop dead slots as live T.",
    "Tests use MaybeUninit backing so automatic Vec/array cleanup cannot repeat element destruction.",
    "Direct element Drop includes field destruction during unwinding; panic payload is preserved unchanged.",
    "The helper neither reallocates nor frees the raw backing allocation, though individual destructors may release their own resources."
  ],
  "remaining_limits": [
    "This binds protected destroy, not native Array1 automatic destruction with its noexcept termination semantics.",
    "Destructor reentry invalidating pending objects, conflicting references, invalid pointer ranges and dead-slot reuse are excluded.",
    "Nonempty zero-sized Rust T is rejected before arithmetic; native C++ has no sizeof(T)==0 domain.",
    "Forced alternate U selection and the separate trivially-destructible no-op template are not assigned new credit.",
    "Process abort, double panic/double exception and exact C++ exception ABI are not modeled by the caught single-failure trace.",
    "Native allocation/deallocation hooks and constructor-failure leaks remain open."
  ],
