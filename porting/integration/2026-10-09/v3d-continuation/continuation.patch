+//! The TKV3d probe operations, one module per C++ probe file under tools/oracle.
+pub mod prs3d;
+pub mod v3d;
+
+// The reader and bit printers of the TKGeomAlgo probe, shared so that every toolkit
+// prints the same token stream (tools/oracle/tkv3d_probe.cxx includes
+// tkgeomalgo_probe_common.cxx likewise). Each package uses a subset of them.
+#[allow(dead_code, unused_imports)]
+#[path = "../../../tkgeomalgo/examples/ga_probe/common.rs"]
+pub mod common;
+#[allow(dead_code)]
+#[path = "../../../tkg2d/examples/g2_probe/print.rs"]
+pub mod print;
+// The primitive array printers of the TKService probe (`sv_array_state`), which the native
+// probe includes from tools/oracle/tkservice_probe_array.cxx.
+#[allow(dead_code)]
+#[path = "../../../tkservice/examples/sv_probe/array.rs"]
+pub mod array;
+
+/// Prints the exception type of a failed call, as `GA_TRY(call)` does.
+pub fn tried(result: Result<(), rustycad_tkernel::standard::Failure>) {
+    print::show(result, |()| ());
+}
+
+pub mod selection_helpers;
diff --git a/crates/tkv3d/examples/v3_probe/prs3d.rs b/crates/tkv3d/examples/v3_probe/prs3d.rs
new file mode 100644
index 000000000..587fa4597
--- /dev/null
+++ b/crates/tkv3d/examples/v3_probe/prs3d.rs
@@ -0,0 +1,141 @@
+//! Prs3d numeric parts, the twin of tools/oracle/tkv3d_probe_prs3d.cxx.
+use super::array::array_state;
+use super::common::{Reader, end, flag, int, pnt, real};
+use super::print::show;
+use rustycad_tkernel::ncollection::Vec3;
+use rustycad_tkernel::standard::{Failure, Handle};
+use rustycad_tkmath::bnd::BoundingBox3;
+use rustycad_tkmath::gp::{Axis1, Point3, Transform3, Vector3};
+use rustycad_tkservice::graphic3d::{
+    GRAPHIC3D_ARRAY_FLAGS_VERTEX_NORMAL, Graphic3dArrayOfPrimitives, Graphic3dArrayOfTriangles,
+};
+use rustycad_tkv3d::prs3d::{
+    Prs3d, Prs3dArrow, Prs3dBndBox, Prs3dToolCylinder, Prs3dToolDisk, Prs3dToolQuadric,
+    Prs3dToolSector, Prs3dToolSphere, Prs3dToolTorus,
+};
+
+/// `v3_trsf`: a rotation about an axis through the origin, then a translation part.
+fn read_trsf(r: &mut Reader<'_>) -> Transform3 {
+    let (t, axis, angle) = (r.xyz(), r.dir(), r.real());
+    let mut trsf = Transform3::default();
+    trsf.set_rotation(Axis1::new(Point3::new(0.0, 0.0, 0.0), axis), angle)
+        .expect("probe rotation");
+    trsf.set_translation_part(Vector3::new(t.x(), t.y(), t.z()));
+    trsf
+}
+
+/// `v3_tool`: the tool of a kind with its five parameters.
+fn tool_of(kind: i32, p: [f64; 5], slices: i32, stacks: i32) -> Box<dyn Prs3dToolQuadric> {
+    match kind {
+        0 => Box::new(Prs3dToolCylinder::new(p[0], p[1], p[2], slices, stacks)),
+        1 => {
+            let mut disk = Prs3dToolDisk::new(p[0], p[1], slices, stacks);
+            disk.set_angle_range(p[2], p[3]);
+            Box::new(disk)
+        }
+        2 => Box::new(Prs3dToolSphere::new(p[0], slices, stacks)),
+        3 => Box::new(Prs3dToolTorus::new(
+            p[0], p[1], p[2], p[3], p[4], slices, stacks,
+        )),
+        _ => Box::new(Prs3dToolSector::new(p[0], slices, stacks)),
+    }
+}
+
+/// Prints the array of a handle (the base class view of `sv_array_state`).
+fn state_of<T: rustycad_tkernel::standard::RuntimeTyped>(array: &Handle<T>) {
+    let base: Handle<Graphic3dArrayOfPrimitives> = array.clone().cast();
+    if let Some(base) = base.get() {
+        array_state(base);
+    }
+}
+
+fn poly_triangulation(tool: &dyn Prs3dToolQuadric, trsf: &Transform3) -> Result<(), Failure> {
+    let t = tool.create_poly_triangulation(trsf)?;
+    int(t.nb_nodes());
+    int(t.nb_triangles());
+    for i in 1..=t.nb_nodes() {
+        pnt(t.node(i)?);
+    }
+    for i in 1..=t.nb_triangles() {
+        let (n1, n2, n3) = t.triangle(i)?.get();
+        [n1, n2, n3].into_iter().for_each(int);
+    }
+    Ok(())
+}
+
+/// `v3_quadric Kind P0..P4 Slices Stacks Trsf`.
+pub fn quadric_case(values: &[f64]) {
+    let mut r = Reader::new(values);
+    let kind = r.integer();
+    let p: [f64; 5] = std::array::from_fn(|_| r.real());
+    let (slices, stacks) = (r.integer(), r.integer());
+    let trsf = read_trsf(&mut r);
+    let tool = tool_of(kind, p, slices, stacks);
+    int(tool.triangles_nb());
+    int(tool.vertices_nb(true));
+    int(tool.vertices_nb(false));
+    show(tool.create_triangulation(&trsf), |a| state_of(&a));
+    let filled = Graphic3dArrayOfTriangles::new(
+        tool.vertices_nb(false),
+        0,
+        GRAPHIC3D_ARRAY_FLAGS_VERTEX_NORMAL,
+    )
+    .map(Handle::new)
+    .and_then(|mut b| tool.fill_array(&mut b, &trsf).map(|()| b));
+    show(filled, |b| state_of(&b));
+    show(poly_triangulation(tool.as_ref(), &trsf), |()| ());
+    end();
+}
+
+/// `v3_arrow Loc(3) Dir(3) Angle Length NbSegments Tube AxisLength Cone ConeLength NbFacettes`.
+pub fn arrow_case(values: &[f64]) {
+    let mut r = Reader::new(values);
+    let (location, dir) = (r.pnt(), r.dir());
+    let (angle, length, nb) = (r.real(), r.real(), r.integer());
+    let (tube, axis_length, cone, cone_length) = (r.real(), r.real(), r.real(), r.real());
+    let facettes = r.integer();
+    show(
+        Prs3dArrow::draw_segments(&location, &dir, angle, length, nb),
+        |s| state_of(&s),
+    );
+    let shaded = Prs3dArrow::draw_shaded(
+        &Axis1::new(location, dir),
+        tube,
+        axis_length,
+        cone,
+        cone_length,
+        facettes,
+    );
+    show(shaded, |s| {
+        flag(!s.is_null());
+        state_of(&s);
+    });
+    end();
+}
+
+/// `v3_prs3d Min(3) Max(3) Coef MaxChord Open X Y Z Distance P1(3) P2(3)`.
+pub fn prs3d_case(values: &[f64]) {
+    let mut r = Reader::new(values);
+    let (mn, mx) = (r.pnt(), r.pnt());
+    let (coef, chord, open) = (r.real(), r.real(), r.flag());
+    let (x, y, z, distance) = (r.real(), r.real(), r.real(), r.real());
+    let (p1, p2) = (r.pnt(), r.pnt());
+    let min = Vec3::new(mn.x(), mn.y(), mn.z());
+    let max = Vec3::new(mx.x(), mx.y(), mx.z());
+    real(Prs3d::get_deflection(&min, &max, coef));
+    let mut bounds = BoundingBox3::default();
+    if mn.x() <= mx.x() {
+        bounds.update_bounds(*mn.coordinates(), *mx.coordinates());
+        if open {
+            bounds.open_xmin();
+        }
+    }
+    real(Prs3d::get_deflection_of_box(&bounds, coef, chord));
+    let (found, dist) = Prs3d::match_segment(x, y, z, distance, &p1, &p2);
+    flag(found);
+    real(dist.unwrap_or(-1.0));
+    let segments = Prs3dBndBox::fill_box_segments(&bounds).unwrap_or_default();
+    flag(!segments.is_null());
+    state_of(&segments);
+    end();
+}
diff --git a/crates/tkv3d/examples/v3_probe/selection_helpers.rs b/crates/tkv3d/examples/v3_probe/selection_helpers.rs
new file mode 100644
index 000000000..3dfaf60de
--- /dev/null
+++ b/crates/tkv3d/examples/v3_probe/selection_helpers.rs
@@ -0,0 +1,119 @@
+//! Twin of tools/oracle/tkv3d_probe_selection_helpers.cxx.
+use super::common::{Reader, attempt, captured, end, flag, int, pnt, real};
+use rustycad_tkernel::{
+    ncollection::{Vec3, Vec4},
+    standard::{Failure, Handle},
+};
+use rustycad_tkmath::{bnd::Range1, gp::Axis1};
+use rustycad_tkservice::graphic3d::{
+    Graphic3dCamera, Graphic3dCameraProjection, Graphic3dClipPlane, Graphic3dSequenceOfHClipPlane,
+};
+use rustycad_tkv3d::select_mgr::{SelectMgrFrustumBuilder, SelectMgrViewClipRange};
+
+fn setup_builder(builder: &SelectMgrFrustumBuilder, r: &mut Reader<'_>) -> Result<(), Failure> {
+    let (present, perspective, zero) = (r.flag(), r.flag(), r.flag());
+    let camera = Handle::new(Graphic3dCamera::default());
+    camera.set_projection_type(if perspective {
+        Graphic3dCameraProjection::Perspective
+    } else {
+        Graphic3dCameraProjection::Orthographic
+    });
+    camera.set_zero_to_one_depth(zero);
+    camera.set_z_range(0.1, 100.)?;
+    if present {
+        builder.set_camera(&camera);
+    }
+    builder.set_window_size(r.integer(), r.integer());
+    let (viewport, x, y, w, h) = (r.flag(), r.real(), r.real(), r.real(), r.real());
+    if viewport {
+        builder.set_viewport(x, y, w, h);
+    }
+    flag(builder.camera().object_address() == camera.object_address());
+    Ok(())
+}
+/// Compare projection, viewport invalidation and plane distance; `frustum_builder_case(&values)`.
+pub fn frustum_builder_case(values: &[f64]) {
+    let mut r = Reader::new(values);
+    let builder = SelectMgrFrustumBuilder::new();
+    let (w, h) = builder.window_size();
+    int(w);
+    int(h);
+    flag(builder.camera().is_null());
+    pnt(builder.project_pnt_on_view_plane(1., 2., 0.));
+    attempt(|| setup_builder(&builder, &mut r));
+    let (x, y, z) = (r.real(), r.real(), r.real());
+    let eq = r.xyz();
+    let point = r.xyz();
+    let (w, h) = builder.window_size();
+    int(w);
+    int(h);
+    let point = Vec3::new(point.x(), point.y(), point.z());
+    real(builder.signed_plane_pnt_dist(&Vec3::new(eq.x(), eq.y(), eq.z()), &point));
+    real(builder.signed_plane_pnt_dist(&Vec3::new(0., 0., 0.), &point));
+    pnt(builder.project_pnt_on_view_plane(x, y, z));
+    builder.invalidate_viewport();
+    pnt(builder.project_pnt_on_view_plane(x, y, z));
+    end();
+}
+fn clip_planes(r: &mut Reader<'_>) -> Result<Graphic3dSequenceOfHClipPlane, Failure> {
+    let sequence = Graphic3dSequenceOfHClipPlane::default();
+    let mut previous = Handle::default();
+    for _ in 0..r.integer() {
+        let equation = Vec4::new(r.real(), r.real(), r.real(), r.real());
+        let (on, linked) = (r.flag(), r.flag());
+        let plane = Handle::new(Graphic3dClipPlane::from_equation(equation)?);
+        plane.set_on(on)?;
+        if linked {
+            Graphic3dClipPlane::set_chain_next_plane(&previous, plane.clone())?;
+        } else {
+            sequence.append(plane.clone());
+        }
+        previous = plane;
+    }
+    Ok(sequence)
+}
+fn clip_queries(clip: &mut SelectMgrViewClipRange, r: &mut Reader<'_>) {
+    for _ in 0..r.integer() {
+        let (first, last) = (r.real(), r.real());
+        let mut depth = 123.;
+        let query = if first <= last {
+            Range1::new(first, last).unwrap()
+        } else {
+            Range1::default()
+        };
+        flag(clip.is_clipped(first));
+        flag(clip.is_clipped(last));
+        flag(clip.get_nearest_depth_into(&query, &mut depth));
+        real(depth);
+    }
+    captured(|output| {
+        let mut stream = rustycad_tkernel::standard::dump::DumpStream::default();
+        let result = clip.dump_json(&mut stream, -1);
+        output.push_str(stream.text());
+        result.map_err(|error| Failure::new(&error.to_string()))
+    });
+    clip.set_void();
+    flag(clip.is_clipped(0.));
+}
+/// Compare range/plane chains and failed lookup output; `clip_range_case(&values)`.
+pub fn clip_range_case(values: &[f64]) {
+    let mut r = Reader::new(values);
+    let mut clip = SelectMgrViewClipRange::default();
+    let (empty, first, last) = (r.flag(), r.real(), r.real());
+    *clip.change_unclip_range() = if empty {
+        Range1::default()
+    } else {
+        Range1::new(first, last).unwrap()
+    };
+    for _ in 0..r.integer() {
+        clip.add_clip_sub_range(Range1::new(r.real(), r.real()).unwrap());
+    }
+    attempt(|| {
+        let planes = clip_planes(&mut r)?;
+        let ray = Axis1::new(r.pnt(), r.dir());
+        clip.add_clipping_planes(&planes, &ray)?;
+        clip_queries(&mut clip, &mut r);
+        Ok(())
+    });
+    end();
+}
diff --git a/crates/tkv3d/examples/v3_probe/v3d.rs b/crates/tkv3d/examples/v3_probe/v3d.rs
new file mode 100644
index 000000000..d40a6d160
--- /dev/null
+++ b/crates/tkv3d/examples/v3_probe/v3d.rs
@@ -0,0 +1,161 @@
+//! V3d view camera operations, the twin of tools/oracle/tkv3d_probe_v3d.cxx.
+use super::common::{Reader, end, int, real};
+use super::tried;
+use rustycad_tkernel::standard::{Failure, Handle};
+use rustycad_tkmath::bnd::BoundingBox3;
+use rustycad_tkservice::aspect::{AspectNeutralWindow, AspectWindow};
+use rustycad_tkservice::graphic3d::Graphic3dCameraProjection;
+use rustycad_tkservice::null_driver::NullGraphicDriver;
+use rustycad_tkv3d::v3d::{V3dTypeOfAxe, V3dTypeOfOrientation, V3dView, V3dViewer};
+
+/// `v3_axe`: the axis of an integer code (0 X, 1 Y, otherwise Z).
+fn axe(code: f64) -> V3dTypeOfAxe {
+    match code as i32 {
+        0 => V3dTypeOfAxe::X,
+        1 => V3dTypeOfAxe::Y,
+        _ => V3dTypeOfAxe::Z,
+    }
+}
+
+/// `v3_orientation`: the orientation of an integer code, clamped to the 26 orientations.
+fn orientation(code: f64) -> V3dTypeOfOrientation {
+    V3dTypeOfOrientation::ALL[(code as i32).clamp(0, 25) as usize]
+}
+
+/// Prints three reals.
+fn triple((x, y, z): (f64, f64, f64)) {
+    [x, y, z].into_iter().for_each(real);
+}
+
+/// `v3_view_state`: the camera queries of the view after an operation.
+fn view_state(v: &V3dView, w: i32, h: i32) -> Result<(), Failure> {
+    [v.eye(), v.at(), v.up(), v.proj()]
+        .into_iter()
+        .for_each(triple);
+    real(v.twist());
+    real(v.scale());
+    let (sw, sh) = v.size();
+    [sw, sh, v.z_size(), v.depth()].into_iter().for_each(real);
+    triple(v.axial_scale());
+    real(v.focale());
+    let (xv, yv) = v.convert_to_view(w / 3, h / 4)?;
+    [xv, yv].into_iter().for_each(real);
+    let (xp, yp) = v.convert_view_to_pixels(0.3 * sw, -0.2 * sh)?;
+    [xp, yp].into_iter().for_each(int);
+    triple(v.convert_to_world(w / 5, h / 3)?);
+    v.convert_with_proj(w / 2, h / 5)?
+        .into_iter()
+        .for_each(real);
+    let (px, py) = v.project(1.0, 2.0, 3.0);
+    [px, py].into_iter().for_each(real);
+    triple(v.project3(1.0, 2.0, 3.0));
+    let (xp, yp) = v.convert_world_to_pixels(1.0, 2.0, 3.0)?;
+    [xp, yp].into_iter().for_each(int);
+    real(v.convert_pixel_to_view(17)?);
+    int(v.convert_view_to_pixel(1.5)?);
+    Ok(())
+}
+
+/// The box of operation 18: centered on `(d, d, d)` with half sizes `a`, `b`, `c`.
+fn centered_box(a: f64, b: f64, c: f64, d: f64) -> BoundingBox3 {
+    let mut bounds = BoundingBox3::default();
+    bounds.update_bounds([d - a, d - b, d - c], [d + a, d + b, d + c]);
+    bounds
+}
+
+/// Operations 0 to 20 of `v3_view_op`.
+fn view_op_low(v: &V3dView, code: i32, [a, b, c, d]: [f64; 4]) -> Result<(), Failure> {
+    let [ia, ib, ic, id] = [a as i32, b as i32, c as i32, d as i32];
+    match code {
+        0 => v.set_proj_orientation(orientation(a), b != 0.0),
+        1 => v.set_size(a),
+        2 => v.set_zoom(a, b != 0.0),
+        3 => v.rotate(a, b, c, d != 0.0),
+        4 => v.turn(a, b, c, d != 0.0),
+        5 => v.set_twist(a),
+        6 => v.set_eye(a, b, c),
+        7 => v.set_at(a, b, c),
+        8 => v.set_depth(a),
+        9 => v.set_proj(a, b, c),
+        10 => v.panning(a, b, c, d != 0.0),
+        11 => v.pan(ia, ib, c, d != 0.0),
+        12 => {
+            v.start_zoom_at_point(ia, ib);
+            v.zoom_at_point(ia, ib, ic, id)
+        }
+        13 => v
+            .start_rotation(ia, ib, 0.0)
+            .and_then(|()| v.rotation(ic, id)),
+        14 => v.move_eye(a, b, c, d != 0.0),
+        15 => v.translate(a, b, c, d != 0.0),
+        16 => v.place(ia, ib, c),
+        17 => v.window_fit(ia, ib, ic, id),
+        18 => v.fit_all_box(&centered_box(a, b, c, d), 0.01, false),
+        19 => v.set_scale(a),
+        _ => v.set_axial_scale(a, b, c),
+    }
+}
+
+/// Operations 21 and above of `v3_view_op`.
+fn view_op_high(v: &V3dView, code: i32, [a, b, c, d]: [f64; 4]) -> Result<(), Failure> {
+    let [ia, ib, ic, id] = [a as i32, b as i32, c as i32, d as i32];
+    match code {
+        21 => v.rotate_axe_about(axe(b), a, c, d, 0.0, true),
+        22 => v.set_z_size(a),
+        23 => v.depth_fit_all(a, b),
+        24 => v.fit_all_rect(a, b, c, d),
+        25 => v.axial_scale_drag(ia, ib, axe(c)),
+        26 => v.set_center(ia, ib),
+        27 => v.set_up(a, b, c),
+        28 => v.z_fit_all(a),
+        29 => v.translate_axe(axe(b), a, c != 0.0),
+        30 => v.move_axe(axe(b), a, c != 0.0),
+        31 => v.zoom(ia, ib, ic, id),
+        32 => {
+            v.camera()
+                .set_projection_type(Graphic3dCameraProjection::Perspective);
+            Ok(())
+        }
+        33 => v.set_focale(a),
+        34 => v.reset(false),
+        35 => v.set_front(),
+        36 => v.turn_axe(axe(b), a, c != 0.0),
+        37 => v.rotate_axe(axe(b), a, c != 0.0),
+        38 => v.rotate_about(a, b, c, d, 0.0, 0.0, true),
+        39 => v.window_fit_all(ia, ib, ic, id),
+        _ => v.set_up_orientation(orientation(a)),
+    }
+}
+
+/// A viewer and its view of a `w` x `h` window on the null driver, with the default lights
+/// on; the view only refers to its viewer, so the caller keeps both.
+fn open_view(w: i32, h: i32) -> Result<(Handle<V3dViewer>, Handle<V3dView>), Failure> {
+    let viewer = V3dViewer::new(&NullGraphicDriver::new_handle())?;
+    viewer.set_default_lights()?;
+    viewer.set_light_on()?;
+    let view = viewer.create_view()?;
+    let window = AspectNeutralWindow::default();
+    window.set_size(w, h);
+    let window: Handle<dyn AspectWindow> = Handle::new(window).cast();
+    view.set_window(&window, 0)?;
+    Ok((viewer, view))
+}
+
+/// `v3_view W H N (Code A B C D)*N`.
+pub fn view_case(values: &[f64]) {
+    let mut r = Reader::new(values);
+    let (w, h, n) = (r.integer(), r.integer(), r.integer());
+    let (_viewer, view) = open_view(w, h).expect("probe view on the null driver");
+    for _ in 0..n {
+        let code = r.integer();
+        let args: [f64; 4] = std::array::from_fn(|_| r.real());
+        let op = if code <= 20 {
+            view_op_low(&view, code, args)
+        } else {
+            view_op_high(&view, code, args)
+        };
+        tried(op);
+        tried(view_state(&view, w, h));
+    }
+    end();
+}
