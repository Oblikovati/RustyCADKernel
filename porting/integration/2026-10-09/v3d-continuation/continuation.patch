+}
+
+impl Prs3dDatumParts {
+    /// `Prs3d_DatumParts_NB`: the number of parts.
+    pub const NB: usize = 11;
+    /// Every part from `Origin` to `XOZAxis`, in native order.
+    pub const DRAWN: [Self; 10] = [
+        Self::Origin,
+        Self::XAxis,
+        Self::YAxis,
+        Self::ZAxis,
+        Self::XArrow,
