index 000000000..dcaf92023
--- /dev/null
+++ b/crates/tkbool/src/brep_fill/evolved/mod.rs
@@ -0,0 +1,292 @@
+// Rust translation of ModelingAlgorithms/TKBool/BRepFill/BRepFill_Evolved.hxx/.cxx at
+// 3d097a0328e71b826377d4814ab05ec3c3d23871.
+
+//! `BRepFill_Evolved`: the evolved shape of a planar spine (wire or face) and a profile:
+//! the profile cut at its extrema of distance to the axis Oz, each part swept along the
+//! spine (tubes and revolutions trimmed by the bisectors of the spine, or parallels for
+//! planar and vertical parts), the parts glued by a quilt.
+mod assemble;
+mod elementary;
+mod elementary_arcs;
+mod pipe_revol;
+mod planar_vertical;
+mod profile;
+mod statics;
+mod trim;
+
+use rustycad_tkbrep::brep_tools::{Quilt, WireExplorer};
+use rustycad_tkbrep::topexp::Explorer;
+use rustycad_tkbrep::topods::{self, Face, Shape, Wire};
+use rustycad_tkbrep::toptools::ShapeMapHasher;
+use rustycad_tkernel::ncollection::{DataMap, List};
+use rustycad_tkernel::standard::Failure;
+use rustycad_tkg3d::top_abs::{Orientation, ShapeEnum};
+use rustycad_tkmath::geom_abs::JoinType;
+use rustycad_tkmath::gp::{Axis3, Plane3, Transform3};
+use rustycad_tkmath::toploc::Location;
+use rustycad_tktopalgo::brep_lib::{self, BRepLibMakeFace};
+use rustycad_tktopalgo::brep_mat2d::{BRepMAT2dBisectingLocus, BRepMAT2dExplorer, BRepMAT2dLinkTopoBilo};
+use rustycad_tktopalgo::mat::MatSide;
+use statics::{confusion, side};
+
+/// The shapes generated from a sub-shape of the profile, by profile shape.
+pub type ProfileGenerated = DataMap<Shape, List<Shape>, ShapeMapHasher>;
+/// The generated shapes by spine shape and profile shape (`myMap`).
+pub type EvolvedMap = DataMap<Shape, ProfileGenerated, ShapeMapHasher>;
+/// A map of shapes to shapes (cut parts to their origin).
+pub type ShapeOrigins = DataMap<Shape, Shape, ShapeMapHasher>;
+
+/// The evolved shape of a spine and a profile (`BRepFill_Evolved`); natively the spine
+/// type and join type are uninitialized until Perform (true and Arc here);
+/// `let evo = BRepFillEvolved::from_wire(&spine, &profile, &axe, JoinType::Arc, false)?;`.
+#[derive(Clone)]
+pub struct BRepFillEvolved {
+    my_spine: Face,
+    my_profile: Wire,
+    my_shape: Shape,
+    my_is_done: bool,
+    my_spine_type: bool,
+    my_join_type: JoinType,
+    my_map: EvolvedMap,
+    my_top: Shape,
+    my_bottom: Shape,
+    /// The empty list GeneratedShapes returns (a function static natively).
+    my_empty: List<Shape>,
+}
+
+impl Default for BRepFillEvolved {
+    /// `BRepFill_Evolved()`: not done, face spine.
+    fn default() -> Self {
+        Self {
+            my_spine: Face::default(),
+            my_profile: Wire::default(),
+            my_shape: Shape::default(),
+            my_is_done: false,
+            my_spine_type: true,
+            my_join_type: JoinType::Arc,
+            my_map: EvolvedMap::default(),
+            my_top: Shape::default(),
+            my_bottom: Shape::default(),
+            my_empty: List::default(),
+        }
+    }
+}
+
+/// Standard_NoSuchObject of a missing generated shape (a DataMap Find natively).
+pub(crate) fn no_such(what: &str) -> Failure {
+    Failure::with_type("Standard_NoSuchObject", &format!("BRepFill_Evolved: {what}; expected a bound key"), "BRepFill_Evolved")
+}
+
+/// `myMap(a)(b)`: the generated shapes of the spine shape `a` and profile shape `b`.
+pub(crate) fn find2<'m>(map: &'m EvolvedMap, a: &Shape, b: &Shape) -> Result<&'m List<Shape>, Failure> {
+    map.seek(a).and_then(|m| m.seek(b)).ok_or_else(|| no_such("no shapes generated by this spine and profile shape"))
+}
+
+/// `myMap(a)(b)` changed.
+pub(crate) fn find2_mut<'m>(map: &'m mut EvolvedMap, a: &Shape, b: &Shape) -> Result<&'m mut List<Shape>, Failure> {
+    map.change_seek(a).and_then(|m| m.change_seek(b)).ok_or_else(|| no_such("no shapes generated by this spine and profile shape"))
+}
+
+/// The first shape of a list (Standard_NoSuchObject when empty).
+pub(crate) fn first_of(l: &List<Shape>) -> Result<Shape, Failure> {
+    l.first().cloned().ok_or_else(|| no_such("an empty list of generated shapes"))
+}
+
+impl BRepFillEvolved {
+    /// `BRepFill_Evolved()`; `BRepFillEvolved::new()`.
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    /// `BRepFill_Evolved(Spine, Profile, AxeProf, Join, Solid)` with a wire spine
+    /// (Join natively defaulted to Arc, Solid to false);
+    /// `BRepFillEvolved::from_wire(&spine, &profile, &axe, JoinType::Arc, false)?`.
+    pub fn from_wire(spine: &Wire, profile: &Wire, axe_prof: &Axis3, join: JoinType, solid: bool) -> Result<Self, Failure> {
+        let mut evo = Self::new();
+        evo.perform_wire(spine, profile, axe_prof, join, solid)?;
+        Ok(evo)
+    }
+
+    /// `BRepFill_Evolved(Spine, Profile, AxeProf, Join, Solid)` with a face spine;
+    /// `BRepFillEvolved::from_face(&spine, &profile, &axe, JoinType::Arc, false)?`.
+    pub fn from_face(spine: &Face, profile: &Wire, axe_prof: &Axis3, join: JoinType, solid: bool) -> Result<Self, Failure> {
+        let mut evo = Self::new();
+        evo.perform_face(spine, profile, axe_prof, join, solid)?;
+        Ok(evo)
+    }
+
+    /// `Perform(Spine, Profile, AxeProf, Join, Solid)` with a wire spine: on its planar
+    /// face; `evo.perform_wire(&spine, &profile, &axe, JoinType::Arc, false)?`.
+    pub fn perform_wire(&mut self, spine: &Wire, profile: &Wire, axe_prof: &Axis3, join: JoinType, solid: bool) -> Result<(), Failure> {
+        self.my_spine_type = false;
+        let a_face = BRepLibMakeFace::from_wire(spine, true)?.face()?;
+        self.private_perform(&a_face, profile, axe_prof, join, solid)
+    }
+
+    /// `Perform(Spine, Profile, AxeProf, Join, Solid)` with a face spine;
+    /// `evo.perform_face(&spine, &profile, &axe, JoinType::Arc, false)?`.
+    pub fn perform_face(&mut self, spine: &Face, profile: &Wire, axe_prof: &Axis3, join: JoinType, solid: bool) -> Result<(), Failure> {
+        self.my_spine_type = true;
+        self.private_perform(spine, profile, axe_prof, join, solid)
+    }
+
+    /// The left and right presence of the profile parts.
+    fn sides_present(work_prof: &List<Shape>) -> Result<(bool, bool), Failure> {
+        let (mut ya_left, mut ya_right) = (false, false);
+        for sp in work_prof.iter() {
+            if side(&topods::wire(sp)?, confusion())? < 4 {
+                ya_left = true;
+            } else {
+                ya_right = true;
+            }
+            if ya_left && ya_right {
+                break;
+            }
+        }
+        Ok((ya_left, ya_right))
+    }
+
+    /// The wire of all the edges of the profile parts.
+    fn whole_profile(work_prof: &List<Shape>) -> Result<Wire, Failure> {
+        let bb = rustycad_tkbrep::brep::BRepBuilder::default();
+        let mut wp = Wire::default();
+        bb.make_wire(&mut wp);
+        let mut wp_shape = wp.into_shape();
+        for w in work_prof.iter() {
+            let mut wexp = WireExplorer::with_wire(&topods::wire(w)?)?;
+            while wexp.more() {
+                bb.add(&mut wp_shape, wexp.current().as_ref())?;
+                wexp.next()?;
+            }
+        }
+        topods::wire(&wp_shape)
+    }
+
+    /// The elementary volevo of each profile part on the side `sides` (1..=3 left,
+    /// 4..=6 right) added to `cut_vevo`, on the face `face` with its locus.
+    fn add_side_vevos(&self, face: &Face, work_prof: &List<Shape>, sides: i32, join: JoinType, cut_vevo: &mut Self, glue: &mut Quilt) -> Result<(), Failure> {
+        let mut exp = BRepMAT2dExplorer::new();
+        exp.perform(face)?;
+        let mut locus = BRepMAT2dBisectingLocus::new();
+        locus.compute(&mut exp, 1, MatSide::Left, JoinType::Arc, false)?;
+        let mut link = BRepMAT2dLinkTopoBilo::with_locus(&exp, &locus)?;
+        for sp in work_prof.iter() {
+            let sp = topods::wire(sp)?;
+            let c_side = side(&sp, confusion())?;
+            let mut vevo = Self::new();
+            match c_side - sides {
+                0 => vevo.elementary_perform(face, &sp, &locus, &mut link, join)?,
+                1 => vevo.planar_perform(face, &sp, &locus, &mut link, join)?,
+                2 => vevo.vertical_perform(face, &sp, &locus, &mut link, join)?,
+                _ => {}
+            }
+            cut_vevo.add(&mut vevo, &sp, glue)?;
+        }
+        Ok(())
+    }
+
+    /// The volevos to the right: per wire of the spine, on the plane face of the
+    /// reversed wire.
+    fn add_right_vevos(&self, work_spine: &Face, work_prof: &List<Shape>, join: JoinType, cut_vevo: &mut Self, glue: &mut Quilt) -> Result<(), Failure> {
+        for w in Explorer::new(work_spine.as_ref(), ShapeEnum::Wire, ShapeEnum::Shape)? {
+            let mut b = BRepLibMakeFace::from_plane(Plane3::from_equation(0., 0., 1., 0.)?)?;
+            b.add(&topods::wire(&w.reversed())?)?;
+            let face = b.face()?;
+            self.add_side_vevos(&face, work_prof, 4, join, cut_vevo, glue)?;
+        }
+        Ok(())
+    }
+
+    /// `PrivatePerform(Spine, Profile, AxeProf, Join, Solid)` (private): the spine and the
+    /// profile set in the work space, prepared, swept per part and side, glued, then
+    /// transferred back; Standard_NotImplemented for a join other than Arc.
+    fn private_perform(&mut self, spine: &Face, profile: &Wire, axe_prof: &Axis3, join: JoinType, solid: bool) -> Result<(), Failure> {
+        self.my_spine = topods::face(&spine.as_ref().oriented(Orientation::Forward))?;
+        self.my_profile = topods::wire(&profile.as_ref().oriented(Orientation::Forward))?;
+        self.my_join_type = join;
+        self.my_map.clear(false);
+        if join != JoinType::Arc {
+            return Err(Failure::with_type("Standard_NotImplemented", &format!("BRepFill_Evolved: join type {join:?}; expected Arc"), "BRepFill_Evolved"));
+        }
+        let l_spine = self.find_location(&self.my_spine)?;
+        let mut t = Transform3::default();
+        t.set_transformation_to(*axe_prof);
+        let l_profile = Location::new(t);
+        let (init_ls, init_lp) = (self.my_spine.as_ref().location().clone(), self.my_profile.as_ref().location().clone());
+        self.transform_init_work(&l_spine, &l_profile)?;
+        let (mut work_prof, mut map_prof) = (List::default(), ShapeOrigins::default());
+        self.prepare_profile(&mut work_prof, &mut map_prof)?;
+        let (mut work_spine, mut map_spine) = (Face::default(), ShapeOrigins::default());
+        self.prepare_spine(&mut work_spine, &mut map_spine)?;
+        let (ya_left, ya_right) = Self::sides_present(&work_prof)?;
+        let mut cut_vevo = Self::new();
+        cut_vevo.set_work(&work_spine, &Self::whole_profile(&work_prof)?);
+        let mut glue = Quilt::new();
+        if ya_left {
+            self.add_side_vevos(&work_spine, &work_prof, 1, join, &mut cut_vevo, &mut glue)?;
+        }
+        if ya_right {
+            self.add_right_vevos(&work_spine, &work_prof, join, &mut cut_vevo, &mut glue)?;
+        }
+        if solid {
+            cut_vevo.add_top_and_bottom(&mut glue)?;
+        }
+        cut_vevo.continuity_on_offset_edge(&work_prof)?;
+        *cut_vevo.change_shape() = glue.shells()?;
+        self.transfert(&mut cut_vevo, &map_prof, &map_spine, &l_spine.inverted()?, &init_ls, &init_lp)?;
+        if solid {
+            self.make_solid()?;
+        }
+        brep_lib::update_tolerances(&self.my_shape, false)?;
+        self.my_is_done = true;
+        Ok(())
+    }
+
+    /// `SetWork(Spine, Profile)` (private): the spine and profile as they are.
+    fn set_work(&mut self, sp: &Face, pr: &Wire) {
+        self.my_spine = sp.clone();
+        self.my_profile = pr.clone();
+    }
+
+    /// `IsDone()`; `evo.is_done()`.
+    pub fn is_done(&self) -> bool {
+        self.my_is_done
+    }
+
+    /// `Shape()`: the evolved shape; `evo.shape()`.
+    pub fn shape(&self) -> &Shape {
+        &self.my_shape
+    }
+
+    /// `ChangeShape()` (private).
+    fn change_shape(&mut self) -> &mut Shape {
+        &mut self.my_shape
+    }
+
+    /// `GeneratedShapes(SpineShape, ProfShape)`: the shapes generated by a sub-shape of
+    /// the spine and one of the profile; empty when none;
+    /// `evo.generated_shapes(&spine_edge, &profile_edge)`.
+    pub fn generated_shapes(&self, spine_shape: &Shape, prof_shape: &Shape) -> &List<Shape> {
+        self.my_map.seek(spine_shape).and_then(|m| m.seek(prof_shape)).unwrap_or(&self.my_empty)
+    }
+
+    /// `Generated()` (private): the map of the generated shapes.
+    fn generated(&mut self) -> &mut EvolvedMap {
+        &mut self.my_map
+    }
+
+    /// `JoinType()`; `evo.join_type()`.
+    pub fn join_type(&self) -> JoinType {
+        self.my_join_type
+    }
+
+    /// `Top()`: the top face of a solid result; `evo.top()`.
+    pub fn top(&self) -> &Shape {
+        &self.my_top
+    }
+
+    /// `Bottom()`: the bottom face of a solid result; `evo.bottom()`.
+    pub fn bottom(&self) -> &Shape {
+        &self.my_bottom
+    }
+}
diff --git a/crates/tkbool/src/brep_fill/evolved/pipe_revol.rs b/crates/tkbool/src/brep_fill/evolved/pipe_revol.rs
new file mode 100644
index 000000000..352e497e9
--- /dev/null
+++ b/crates/tkbool/src/brep_fill/evolved/pipe_revol.rs
@@ -0,0 +1,162 @@
+// Rust translation of BRepFill_Evolved::MakePipe, MakeRevol, FindLocation, TransformInitWork
+// and the static PutProfilAt of ModelingAlgorithms/TKBool/BRepFill/BRepFill_Evolved.cxx at
+// 3d097a0328e71b826377d4814ab05ec3c3d23871.
+
+//! The tubes (the profile swept along a spine edge) and the revolutions (the profile
+//! turned around a vertical axis at a spine vertex) of an elementary volevo, and the
+//! placement of the spine in the plane xOy.
+use super::statics::{confusion, edge_vertices, side};
+use super::{BRepFillEvolved, ProfileGenerated};
+use crate::brep_fill::BRepFillPipe;
+use rustycad_tkbrep::brep::BRepTool;
+use rustycad_tkbrep::brep_tools::{BRepToolsModification, Modifier, TrsfModification, WireExplorer};
+use rustycad_tkbrep::topods::{self, Edge, Face, Shape, Vertex, Wire};
+use rustycad_tkernel::ncollection::List;
+use rustycad_tkernel::standard::{Failure, Handle};
+use rustycad_tkg3d::geom::{GeomElementarySurface, GeomPlane};
+use rustycad_tkgeomalgo::geom_fill::GeomFillTrihedron;
+use rustycad_tkg3d::top_abs::{self, Orientation};
+use rustycad_tkmath::gp::{self, Axis1, Axis3, Direction3, Point3, Transform3};
+use rustycad_tkmath::toploc::Location;
+use rustycad_tkprim::brep_sweep::BRepSweepRevol;
+use rustycad_tktopalgo::brep_lib::{BRepLibFindSurface, BRepLibMakeWire};
+use std::f64::consts::PI;
+
+/// `PutProfilAt(ProfRef, AxeRef, E, F, AtStart)` (static): the profile moved from
+/// `axe_ref` to the frame at the start (or end) of the p-curve of `e` on `f`, X along
+/// its tangent in the edge orientation; Standard_ConstructionError without p-curve.
+fn put_profil_at(prof_ref: &Wire, axe_ref: &Axis3, e: &Edge, f: &Face, at_start: bool) -> Result<Wire, Failure> {
+    let pc = BRepTool::curve_on_face(e, f)?;
+    let c2d = pc.pcurve.get().ok_or_else(|| Failure::with_type("Standard_ConstructionError", "ConstructionError in PutProfilAt", "BRepFill_Evolved"))?;
+    let reversed = e.as_ref().orientation() == Orientation::Reversed;
+    // The start of a REVERSED edge is the end of its p-curve.
+    let at_first = at_start != reversed;
+    let (p, d1) = c2d.d1(if at_first { pc.first } else { pc.last })?;
+    let d1 = if reversed { d1.reversed() } else { d1 };
+    let ax = Axis3::new(Point3::new(p.x(), p.y(), 0.), gp::dz(), Direction3::from_vector(rustycad_tkmath::gp::Vector3::new(d1.x(), d1.y(), 0.))?)?;
+    let mut trans = Transform3::default();
+    trans.set_transformation_between(ax, *axe_ref);
+    topods::wire(&prof_ref.as_ref().moved(&Location::new(trans), false)?)
+}
+
+/// The profile turned by pi around Oz for a profile on the right of Oz.
+fn side_location(profile: &Wire) -> Result<Location, Failure> {
+    let mut trsf = Transform3::default();
+    if side(profile, confusion())? > 3 {
+        trsf.set_rotation(gp::oz(), PI)?;
+    }
+    Ok(Location::new(trsf))
+}
+
+impl BRepFillEvolved {
+    /// `MakePipe(SpineEdge, ProfRef)` (private): the tube of the profile (a copy put at
+    /// the start of the edge) along the spine edge, recorded in the map of the edge.
+    pub(super) fn make_pipe(&mut self, se: &Edge, axe_ref: &Axis3) -> Result<(), Failure> {
+        let moved = topods::wire(&self.my_profile.as_ref().moved(&side_location(&self.my_profile)?, false)?)?;
+        let dummy_prof = put_profil_at(&moved, axe_ref, se, &self.my_spine, true)?;
+        // Copy of the profile to avoid the accumulation of locations on the edges of myProfile.
+        let trsf_mod: Handle<dyn BRepToolsModification> = Handle::new(TrsfModification::new(Transform3::default())).cast();
+        let modif = Modifier::with_modification(dummy_prof.as_ref(), &trsf_mod)?;
+        let gen_prof = topods::wire(&modif.modified_shape(dummy_prof.as_ref())?)?;
+        let spine = BRepLibMakeWire::from_edge(se)?.wire()?;
+        let pipe = BRepFillPipe::with_profile(&spine, gen_prof.as_ref(), GeomFillTrihedron::IsCorrectedFrenet, false, false)?;
+        self.my_map.bind(se.as_ref().clone(), ProfileGenerated::default());
+        let mut prof_exp = WireExplorer::with_wire(&self.my_profile)?;
+        let mut gen_exp = WireExplorer::with_wire(&gen_prof)?;
+        let mut first_vertex = true;
+        while prof_exp.more() {
+            let (vf, vl) = edge_vertices(prof_exp.current());
+            let (vfg, vlg) = edge_vertices(gen_exp.current());
+            let m = self.my_map.change_seek(se.as_ref()).ok_or_else(|| super::no_such("the tube of a spine edge"))?;
+            if first_vertex {
+                m.bind(vf.as_ref().clone(), single(pipe.edge(se, &vfg)?.into_shape()));
+                first_vertex = false;
+            }
+            m.bind(vl.as_ref().clone(), single(pipe.edge(se, &vlg)?.into_shape()));
+            m.bind(prof_exp.current().as_ref().clone(), single(pipe.face(se, gen_exp.current())?.into_shape()));
+            prof_exp.next()?;
+            gen_exp.next()?;
+        }
+        Ok(())
+    }
+
+    /// `MakeRevol(SpineEdge, SpineVertex, ProfRef)` (private): the revolution of the
+    /// profile (put at the end of the edge, turned by 1.5 pi so that the seam avoids
+    /// the bisectors) around the vertical axis at the vertex, recorded in its map.
+    pub(super) fn make_revol(&mut self, se: &Edge, v_last: &Vertex, axe_ref: &Axis3) -> Result<(), Failure> {
+        let moved = topods::wire(&self.my_profile.as_ref().moved(&side_location(&self.my_profile)?, false)?)?;
+        let mut gen_prof = put_profil_at(&moved, axe_ref, se, &self.my_spine, false)?.into_shape();
+        let axe_rev = Axis1::new(BRepTool::pnt(v_last)?, gp::dz().reversed());
+        let mut dummy = Transform3::default();
+        dummy.set_rotation(axe_rev, 1.5 * PI)?;
+        gen_prof.move_by(&Location::new(dummy), false)?;
+        let gen_prof = topods::wire(&gen_prof)?;
+        let mut rev = BRepSweepRevol::full(gen_prof.as_ref(), axe_rev, true)?;
+        self.my_map.bind(v_last.as_ref().clone(), ProfileGenerated::default());
+        let mut prof_exp = WireExplorer::with_wire(&self.my_profile)?;
+        let mut gen_exp = WireExplorer::with_wire(&gen_prof)?;
+        let mut first_vertex = true;
+        while prof_exp.more() {
+            let (vf, vl) = edge_vertices(prof_exp.current());
+            let (vfg, vlg) = edge_vertices(gen_exp.current());
+            let or = gen_exp.current().as_ref().orientation();
+            let mut generated: Vec<(Shape, Shape)> = Vec::new();
+            if first_vertex {
+                let rv = rev.shape_of(vfg.as_ref())?;
+                generated.push((vf.as_ref().clone(), rv.oriented(rv.orientation())));
+                first_vertex = false;
+            }
+            let rf = rev.shape_of(gen_exp.current().as_ref())?;
+            generated.push((prof_exp.current().as_ref().clone(), rf.oriented(top_abs::compose(rf.orientation(), or))));
+            let rv = rev.shape_of(vlg.as_ref())?;
+            generated.push((vl.as_ref().clone(), rv.oriented(rv.orientation())));
+            let m = self.my_map.change_seek(v_last.as_ref()).ok_or_else(|| super::no_such("the revolution of a spine vertex"))?;
+            for (key, s) in generated {
+                m.bind(key, single(s));
+            }
+            prof_exp.next()?;
+            gen_exp.next()?;
+        }
+        Ok(())
+    }
+
+    /// `FindLocation(Face)` (private): the location taking the plane of the face (found
+    /// when not a plane; Standard_NoSuchObject when not planar) onto xOy.
+    pub(super) fn find_location(&self, face: &Face) -> Result<Location, Failure> {
+        let (mut s, mut l) = BRepTool::surface_with_location(face)?;
+        if !s.is_kind_name("Geom_Plane") {
+            let fs = BRepLibFindSurface::new(face.as_ref(), -1., true, false)?;
+            if !fs.found() {
+                return Err(Failure::with_type("Standard_NoSuchObject", "BRepFill_Evolved : The Face is not planar", "BRepFill_Evolved"));
+            }
+            (s, l) = (fs.surface(), fs.location());
+        }
+        if !l.is_identity() {
+            s = s.get().ok_or_else(|| Failure::new("FindLocation: null surface"))?.transformed(l.transformation())?.cast();
+        }
+        let p: Handle<GeomPlane> = s.cast();
+        let axis = p.get().ok_or_else(|| Failure::with_type("Standard_NullObject", "BRepFill_Evolved FindLocation: the surface is not a plane", "BRepFill_Evolved"))?.position();
+        let axe_ref = Axis3::new(Point3::new(0., 0., 0.), gp::dz(), gp::dx())?;
+        let mut t = Transform3::default();
+        t.set_transformation_between(axe_ref, axis);
+        Ok(Location::new(t))
+    }
+
+    /// `TransformInitWork(LS, LP)` (private): the spine moved by `ls`, the profile by `lp`.
+    pub(super) fn transform_init_work(&mut self, ls: &Location, lp: &Location) -> Result<(), Failure> {
+        let mut spine = self.my_spine.as_ref().clone();
+        spine.move_by(ls, false)?;
+        self.my_spine = topods::face(&spine)?;
+        let mut profile = self.my_profile.as_ref().clone();
+        profile.move_by(lp, false)?;
+        self.my_profile = topods::wire(&profile)?;
+        Ok(())
+    }
+}
+
+/// A list of one shape.
+fn single(s: Shape) -> List<Shape> {
+    let mut l = List::default();
+    l.append(s);
+    l
+}
diff --git a/crates/tkbool/src/brep_fill/evolved/planar_vertical.rs b/crates/tkbool/src/brep_fill/evolved/planar_vertical.rs
new file mode 100644
index 000000000..0c394ed43
--- /dev/null
+++ b/crates/tkbool/src/brep_fill/evolved/planar_vertical.rs
@@ -0,0 +1,205 @@
+// Rust translation of BRepFill_Evolved::PlanarPerform and VerticalPerform of
+// ModelingAlgorithms/TKBool/BRepFill/BRepFill_Evolved.cxx at
+// 3d097a0328e71b826377d4814ab05ec3c3d23871.
+
+//! The volevos of planar profile parts (faces between the parallels of the spine at the
+//! distances of the edge ends) and of vertical parts (prisms of a parallel).
+use super::statics::{altitud, confusion, distance_to_oz, edge_vertices};
+use super::{BRepFillEvolved, ProfileGenerated, ShapeOrigins};
+use crate::brep_algo::BRepAlgoFaceRestrictor;
+use crate::brep_fill::{BRepFillOffsetAncestors, BRepFillOffsetWire};
+use rustycad_tkbrep::brep::BRepBuilder;
+use rustycad_tkbrep::brep_tools::WireExplorer;
+use rustycad_tkbrep::topexp::Explorer;
+use rustycad_tkbrep::topods::{self, Compound, Edge, Face, Shape, Vertex, Wire};
+use rustycad_tkernel::ncollection::List;
+use rustycad_tkernel::standard::Failure;
+use rustycad_tkg3d::top_abs::{Orientation, ShapeEnum};
+use rustycad_tkmath::geom_abs::JoinType;
+use rustycad_tkmath::gp::{Transform3, Vector3};
+use rustycad_tkmath::toploc::Location;
+use rustycad_tkprim::brep_sweep::BRepSweepPrism;
+use rustycad_tktopalgo::brep_mat2d::{BRepMAT2dBisectingLocus, BRepMAT2dLinkTopoBilo};
+
+/// The bisecting locus and links of the spine.
+pub(super) type Bilo<'a> = (&'a BRepMAT2dBisectingLocus, &'a mut BRepMAT2dLinkTopoBilo);
+
+impl BRepFillEvolved {
+    /// The work data of a volevo: the spine (FORWARD), the profile, an empty map and
+    /// an empty compound.
+    pub(super) fn start_volevo(&mut self, sp: &Face, pr: &Wire) -> Result<(), Failure> {
+        self.my_spine = topods::face(&sp.as_ref().oriented(Orientation::Forward))?;
+        self.my_profile = pr.clone();
+        self.my_map.clear(false);
+        let mut c = Compound::default();
+        BRepBuilder::default().make_compound(&mut c);
+        self.my_shape = c.into_shape();
+        Ok(())
+    }
+
+    /// `l` appended to the generated shapes of (`a`, `b`), bound empty when absent.
+    pub(super) fn append_generated(&mut self, a: &Shape, b: &Shape, l: impl IntoIterator<Item = Shape>) {
+        let inner = self.my_map.try_emplaced(a.clone(), ProfileGenerated::default);
+        let list = inner.try_emplaced(b.clone(), List::default);
+        for s in l {
+            list.append(s);
+        }
+    }
+
+    /// The parallel of the spine at the distance of `v` (computed once per vertex),
+    /// recorded in the map by ancestor and with its ancestors in `off_anc`.
+    fn parallel_at(&mut self, v: &Vertex, offset: f64, alt: f64, bilo: &mut Bilo<'_>, join: JoinType, paral: &mut BRepFillOffsetWire, off_anc: &mut BRepFillOffsetAncestors, map_vp: &mut ShapeOrigins) -> Result<(), Failure> {
+        if map_vp.is_bound(v.as_ref()) {
+            return Ok(());
+        }
+        let spine = self.my_spine.clone();
+        paral.perform_with_bilo(&spine, offset, bilo.0, bilo.1, join, alt)?;
+        off_anc.perform(paral)?;
+        let shape = paral.shape().clone();
+        map_vp.bind(v.as_ref().clone(), shape.clone());
+        for wc in Explorer::new(&shape, ShapeEnum::Edge, ShapeEnum::Shape)? {
+            let gs = off_anc.ancestor(&topods::edge(&wc)?)?.clone();
+            let bound = self.my_map.seek(&gs).is_some_and(|m| m.is_bound(v.as_ref()));
+            if !bound {
+                let generated = paral.generated_shapes(&gs)?.clone();
+                self.my_map.try_emplaced(gs.clone(), ProfileGenerated::default).bind(v.as_ref().clone(), generated);
+            }
+        }
+        Ok(())
+    }
+
+    /// The wires of a parallel added to the face restrictor (reversed when asked).
+    fn add_parallel_wires(rest: &Shape, to_reverse: bool, fr: &mut BRepAlgoFaceRestrictor) -> Result<(), Failure> {
+        if rest.is_null() {
+            return Ok(());
+        }
+        let wires: Vec<Shape> = if rest.shape_type()? == ShapeEnum::Wire {
+            vec![rest.clone()]
+        } else {
+            Explorer::new(rest, ShapeEnum::Wire, ShapeEnum::Shape)?.collect()
+        };
+        for w in wires {
+            fr.add(&topods::wire(&if to_reverse { w.reversed() } else { w })?);
+        }
+        Ok(())
+    }
+
+    /// The faces of one planar profile edge: bounded by the parallels at its ends, set
+    /// at its altitude, recorded by the ancestors of their edges.
+    fn planar_edge(&mut self, e: &Edge, bilo: &mut Bilo<'_>, join: JoinType, paral: &mut BRepFillOffsetWire, map_vp: &mut ShapeOrigins) -> Result<(), Failure> {
+        let mut fr = BRepAlgoFaceRestrictor::new();
+        let mut off_anc = BRepFillOffsetAncestors::new();
+        let (v0, v1) = edge_vertices(e);
+        let alt = altitud(&v0)?;
+        let offset = [distance_to_oz(&v0)?, distance_to_oz(&v1)?];
+        let is_min_v1 = offset[0] < offset[1];
+        for (i, v) in [&v0, &v1].into_iter().enumerate() {
+            self.parallel_at(v, offset[i], alt, bilo, join, paral, &mut off_anc, map_vp)?;
+            let rest = map_vp.seek(v.as_ref()).cloned().unwrap_or_default();
+            let to_reverse = (is_min_v1 && i == 1) || (!is_min_v1 && i == 0);
+            Self::add_parallel_wires(&rest, to_reverse, &mut fr)?;
+        }
+        let mut t = Transform3::default();
+        t.set_translation(Vector3::new(0., 0., alt));
+        let moved = self.my_spine.as_ref().moved(&Location::new(t), false)?;
+        fr.init(&topods::face(&moved)?, false, false);
+        fr.perform()?;
+        while fr.more() {
+            let f = fr.current()?;
+            BRepBuilder::default().add(&mut self.my_shape, f.as_ref())?;
+            for ce in Explorer::new(f.as_ref(), ShapeEnum::Edge, ShapeEnum::Shape)? {
+                let ce = topods::edge(&ce)?;
+                if off_anc.has_ancestor(&ce) {
+                    let init_e = off_anc.ancestor(&ce)?.clone();
+                    self.append_generated(&init_e, e.as_ref(), [f.as_ref().clone()]);
+                }
+            }
+            fr.next()?;
+        }
+        Ok(())
+    }
+
+    /// `PlanarPerform(Spine, Profile, Locus, Link, Join)` (private): the faces between
+    /// the parallels of the spine for each edge of a planar profile part;
+    /// natively one offset tool serves every edge.
+    pub(super) fn planar_perform(&mut self, sp: &Face, pr: &Wire, locus: &BRepMAT2dBisectingLocus, link: &mut BRepMAT2dLinkTopoBilo, join: JoinType) -> Result<(), Failure> {
+        self.start_volevo(sp, pr)?;
+        let mut map_vp = ShapeOrigins::default();
+        let mut paral = BRepFillOffsetWire::default();
+        let mut bilo: Bilo<'_> = (locus, link);
+        let mut prof_exp = WireExplorer::with_wire(&self.my_profile)?;
+        while prof_exp.more() {
+            let e = prof_exp.current().clone();
+            self.planar_edge(&e, &mut bilo, join, &mut paral, &mut map_vp)?;
+            prof_exp.next()?;
+        }
+        Ok(())
+    }
+
+    /// The parallel at the first vertex of a vertical part, recorded at that vertex by
+    /// ancestor.
+    fn vertical_base(&mut self, v1: &Vertex, bilo: &mut Bilo<'_>, join: JoinType, paral: &mut BRepFillOffsetWire, off_anc: &mut BRepFillOffsetAncestors) -> Result<Shape, Failure> {
+        let mut offset = distance_to_oz(v1)?;
+        if offset.abs() < confusion() {
+            offset = 0.;
+        }
+        let spine = self.my_spine.clone();
+        paral.perform_with_bilo(&spine, offset, bilo.0, bilo.1, join, altitud(v1)?)?;
+        off_anc.perform(paral)?;
+        let base = paral.shape().clone();
+        for an_edge in Explorer::new(&base, ShapeEnum::Edge, ShapeEnum::Shape)? {
+            let ae = off_anc.ancestor(&topods::edge(&an_edge)?)?.clone();
+            self.append_generated(&ae, v1.as_ref(), [an_edge]);
+        }
+        Ok(base)
+    }
+
+    /// The prism images of the shapes generated at `v1` recorded at `v2` (last shapes)
+    /// and at `e` (swept shapes), for every spine shape (the list at `v1` is read
+    /// before the appends; natively the same list when `v1` is `v2`).
+    fn record_prism(&mut self, ps: &mut BRepSweepPrism, v1: &Vertex, v2: &Vertex, e: &Edge) -> Result<(), Failure> {
+        let keys: Vec<Shape> = self.my_map.items().map(|(k, _)| k.clone()).collect();
+        for key in keys {
+            let lof = super::find2(&self.my_map, &key, v1.as_ref())?.clone();
+            let (mut last, mut swept) = (Vec::new(), Vec::new());
+            for os in lof.iter() {
+                last.push(ps.last_shape_of(os)?);
+                swept.push(ps.shape_of(os)?);
+            }
+            self.append_generated(&key, v2.as_ref(), []);
+            self.append_generated(&key, e.as_ref(), []);
+            self.append_generated(&key, v2.as_ref(), last);
+            self.append_generated(&key, e.as_ref(), swept);
+        }
+        Ok(())
+    }
+
+    /// `VerticalPerform(Spine, Profile, Locus, Link, Join)` (private): the parallel of
+    /// the spine at the first vertex swept edge by edge along Oz.
+    pub(super) fn vertical_perform(&mut self, sp: &Face, pr: &Wire, locus: &BRepMAT2dBisectingLocus, link: &mut BRepMAT2dLinkTopoBilo, join: JoinType) -> Result<(), Failure> {
+        self.start_volevo(sp, pr)?;
+        let mut paral = BRepFillOffsetWire::default();
+        let mut off_anc = BRepFillOffsetAncestors::new();
+        let mut bilo: Bilo<'_> = (locus, link);
+        let (mut first, mut base) = (true, Shape::default());
+        let mut prof_exp = WireExplorer::with_wire(&self.my_profile)?;
+        while prof_exp.more() {
+            let e = prof_exp.current().clone();
+            let (v1, v2) = edge_vertices(&e);
+            let (alt1, alt2) = (altitud(&v1)?, altitud(&v2)?);
+            if first {
+                base = self.vertical_base(&v1, &mut bilo, join, &mut paral, &mut off_anc)?;
+                first = false;
+            }
+            let mut ps = BRepSweepPrism::new(&base, Vector3::new(0., 0., alt2 - alt1), false, true)?;
+            base = ps.last_shape()?;
+            let swept = ps.shape()?;
+            for f in Explorer::new(&swept, ShapeEnum::Face, ShapeEnum::Shape)? {
+                BRepBuilder::default().add(&mut self.my_shape, &f)?;
+            }
+            self.record_prism(&mut ps, &v1, &v2, &e)?;
+            prof_exp.next()?;
+        }
+        Ok(())
+    }
+}
diff --git a/crates/tkbool/src/brep_fill/evolved/profile.rs b/crates/tkbool/src/brep_fill/evolved/profile.rs
new file mode 100644
index 000000000..247962a05
--- /dev/null
+++ b/crates/tkbool/src/brep_fill/evolved/profile.rs
@@ -0,0 +1,336 @@
+// Rust translation of BRepFill_Evolved::PrepareProfile, PrepareSpine and the static
+// CutEdgeProf and CutEdge of ModelingAlgorithms/TKBool/BRepFill/BRepFill_Evolved.cxx at
+// 3d097a0328e71b826377d4814ab05ec3c3d23871.
+
+//! The preparation of the profile (projected on yOz and cut at its extrema of distance
+//! to Oz and at Oz, split into wires on one side of Oz, planar and vertical parts apart)
+//! and of the spine (its edges cut at the extrema of curvature and inflexions).
+use super::statics::{bubble_reals, confusion, distance_to_oz, edge_vertices, is_planar, is_vertical};
+use super::{BRepFillEvolved, ShapeOrigins};
+use rustycad_tkbrep::brep::{BRepBuilder, BRepTool};
+use rustycad_tkbrep::brep_tools::WireExplorer;
+use rustycad_tkbrep::topexp::{self, Explorer};
+use rustycad_tkbrep::topods::{self, Edge, Face, Shape, ShapeIterator, Vertex, Wire};
+use rustycad_tkernel::ncollection::List;
+use rustycad_tkernel::precision;
+use rustycad_tkernel::standard::{Failure, Handle};
+use rustycad_tkg2d::geom2d::{Geom2dCurve, Geom2dLine, Geom2dTrimmedCurve};
+use rustycad_tkg2d::geom2d_adaptor::Geom2dAdaptorCurve;
+use rustycad_tkg3d::geom::{GeomCurve, GeomGeometry, GeomPlane, GeomSurface, GeomTrimmedCurve};
+use rustycad_tkg3d::top_abs::{Orientation, ShapeEnum};
+use rustycad_tkgeomalgo::geom2d_api::ExtremaCurveCurve;
+use rustycad_tkgeomalgo::geom2d_int::GInter;
+use rustycad_tkgeombase::bnd_lib::Add2dCurve;
+use rustycad_tkgeombase::geom_proj_lib;
+use rustycad_tkmath::bnd::BoundingBox2;
+use rustycad_tkmath::gp::{self, Axis3, Point3};
+use rustycad_tktopalgo::brep_lib::{self, BRepLibMakeEdge, BRepLibMakeVertex};
+use rustycad_tktopalgo::mat2d::Mat2dCutCurve;
+
+/// The projection of the edge curve on the plane yOz: the 3d projected curve and its
+/// p-curve on the plane.
+fn project_on_yoz(e: &Edge, plane: &Handle<GeomPlane>) -> Result<(Handle<dyn GeomCurve>, Handle<dyn Geom2dCurve>), Failure> {
+    let found = BRepTool::curve_with_location(e)?;
+    let ct = Handle::new(GeomTrimmedCurve::new(&found.curve, found.first, found.last, true, true)?);
+    ct.transform(found.location.transformation())?;
+    let normal = plane.get().ok_or_else(|| Failure::new("CutEdgeProf: null plane"))?.pln().axis().direction();
+    let c = geom_proj_lib::project_on_plane(&ct.cast(), plane, normal, false)?;
+    let surface: Handle<dyn GeomSurface> = plane.cast();
+    let c2d = geom_proj_lib::curve2d(&c, &surface)?;
+    Ok((c, c2d))
+}
+
+/// The parameters on `c2d` of its extrema of distance to the line and of its
+/// intersections with it.
+fn cut_parameters(line: &Handle<dyn Geom2dCurve>, c2d: &Handle<dyn Geom2dCurve>) -> Result<Vec<f64>, Failure> {
+    let mut seq: Vec<f64> = Vec::new();
+    let (f, l) = (c2d.first_parameter(), c2d.last_parameter());
+    let ac2d = Geom2dAdaptorCurve::with_curve(c2d)?;
+    let mut b = BoundingBox2::default();
+    Add2dCurve::add_adaptor(&ac2d, confusion(), &mut b)?;
+    let [_, u1, _, u2] = b.get()?;
+    // no sense if C2 is normal to Line or really is a point (NIZHNY-EAP 2000-02-02)
+    if u1 != u2 {
+        let extrema = ExtremaCurveCurve::new(line, c2d, u1 - 1., u2 + 1., f, l)?;
+        for i in 1..=extrema.nb_extrema() {
+            seq.push(extrema.parameters(i)?.1);
+        }
+    }
+    let a_line = Geom2dAdaptorCurve::with_curve(line)?;
+    let intersector = GInter::between(&a_line, &ac2d, 0., precision::intersection())?;
+    for i in 1..=intersector.nb_points()? {
+        seq.push(intersector.point(i)?.param_on_second());
+    }
+    Ok(seq)
+}
+
+/// The projected vertex of a profile vertex, made once.
+fn moved_vertex(vr: &Vertex, p: Point3, map_ver_ref_moved: &mut ShapeOrigins) -> Result<Vertex, Failure> {
+    if let Some(v) = map_ver_ref_moved.seek(vr.as_ref()) {
+        return topods::vertex(v);
+    }
+    let mut v = Vertex::default();
+    BRepBuilder::default().make_vertex_at(&mut v, p, BRepTool::vertex_tolerance(vr)?)?;
+    map_ver_ref_moved.bind(vr.as_ref().clone(), v.as_ref().clone());
+    Ok(v)
+}
+
+/// The cut piece appended (FORWARD) or prepended with the orientation of `e`.
+fn push_piece(cuts: &mut List<Shape>, c: &Handle<dyn GeomCurve>, v1: &Vertex, v2: &Vertex, e: &Edge) -> Result<(), Failure> {
+    let mut ee = BRepLibMakeEdge::from_curve_vertices(c, v1, v2)?.edge()?.into_shape();
+    ee.set_orientation(e.as_ref().orientation());
+    if ee.orientation() == Orientation::Forward {
+        cuts.append(ee);
+    } else {
+        cuts.prepend(ee);
+    }
+    Ok(())
+}
+
+/// `CutEdgeProf(E, Plane, Line, Cuts, MapVerRefMoved)` (static): the edge projected on
+/// the plane and cut at its extrema of distance to the line and at its intersections
+/// with it (the projected end vertices shared through `map_ver_ref_moved`).
+fn cut_edge_prof(e: &Edge, plane: &Handle<GeomPlane>, line: &Handle<dyn Geom2dCurve>, cuts: &mut List<Shape>, map_ver_ref_moved: &mut ShapeOrigins) -> Result<(), Failure> {
+    cuts.clear();
+    let (c, c2d) = project_on_yoz(e, plane)?;
+    let (f, l) = (c2d.first_parameter(), c2d.last_parameter());
+    let mut seq = cut_parameters(line, &c2d)?;
+    let (vrf, vrl) = topexp::vertices(e, false);
+    let mut vf = moved_vertex(&vrf, c.value(f)?, map_ver_ref_moved)?;
+    let vl = moved_vertex(&vrl, c.value(l)?, map_ver_ref_moved)?;
+    bubble_reals(&mut seq);
+    let mut cur_param = f;
+    for param in seq {
+        if (param - cur_param).abs() > confusion() && (param - l).abs() > confusion() {
+            let vv = BRepLibMakeVertex::new(c.value(param)?)?.vertex()?;
+            push_piece(cuts, &c, &vf, &vv, e)?;
+            (cur_param, vf) = (param, vv);
+        }
+    }
+    push_piece(cuts, &c, &vf, &vl, e)
+}
+
+/// The profile wires under construction (`WP` natively) with the current one.
+struct ProfileWires {
+    wires: List<Shape>,
+    current: Shape,
+}
+
+impl ProfileWires {
+    /// A list with one new empty wire.
+    fn new() -> Self {
+        let mut pw = Self { wires: List::default(), current: Shape::default() };
+        pw.start_wire();
+        pw
+    }
+
+    /// A new empty wire, current and appended.
+    fn start_wire(&mut self) {
+        let mut w = Wire::default();
+        BRepBuilder::default().make_wire(&mut w);
+        self.current = w.into_shape();
+        self.wires.append(self.current.clone());
+    }
+
+    /// `e` added to the current wire.
+    fn add(&mut self, e: &Shape) -> Result<(), Failure> {
+        BRepBuilder::default().add(&mut self.current, e)
+    }
+}
+
+/// The parts of a wire with planar or vertical edges: a new wire at each change of
+/// kind (vertical, planar, other); the wire itself when it has no such edge.
+fn split_by_kind(cur_w: &Shape, work_prof: &mut List<Shape>) -> Result<(), Failure> {
+    let edges: Vec<Edge> = Explorer::new(cur_w, ShapeEnum::Edge, ShapeEnum::Shape)?.map(|e| topods::edge(&e)).collect::<Result<_, _>>()?;
+    let mut kinds = Vec::with_capacity(edges.len());
+    for ee in &edges {
+        kinds.push(if is_vertical(ee)? { 3 } else if is_planar(ee)? { 2 } else { 1 });
+    }
+    if !kinds.iter().any(|k| *k != 1) {
+        work_prof.append(cur_w.clone());
+        return Ok(());
+    }
+    let bb = BRepBuilder::default();
+    let (mut status, mut nw) = (0, Shape::default());
+    for (ee, kind) in edges.iter().zip(kinds) {
+        if kind != status {
+            let mut w = Wire::default();
+            bb.make_wire(&mut w);
+            nw = w.into_shape();
+            work_prof.append(nw.clone());
+            status = kind;
+        }
+        bb.add(&mut nw, ee.as_ref())?;
+    }
+    Ok(())
+}
+
+impl BRepFillEvolved {
+    /// The pieces of one profile edge added to the wires: a new wire after a piece
+    /// ending on Oz (after the edge for its last piece); whether a new wire is due.
+    fn add_profile_pieces(e: &Edge, cuts: &mut List<Shape>, wp: &mut ProfileWires, map_prof: &mut ShapeOrigins) -> Result<bool, Failure> {
+        let mut new_wire = false;
+        while let Some(first) = cuts.first().cloned() {
+            let ne = topods::edge(&first)?;
+            map_prof.bind(ne.as_ref().clone(), e.as_ref().clone());
+            let (v1, v2) = edge_vertices(&ne);
+            for v in [&v1, &v2] {
+                if !map_prof.is_bound(v.as_ref()) {
+                    map_prof.bind(v.as_ref().clone(), e.as_ref().clone());
+                }
+            }
+            wp.add(ne.as_ref())?;
+            cuts.remove_first()?;
+            if distance_to_oz(&v2)? < confusion() && distance_to_oz(&v1)? > confusion() {
+                if cuts.is_empty() {
+                    new_wire = true;
+                } else {
+                    wp.start_wire();
+                }
+            }
+        }
+        Ok(new_wire)
+    }
+
+    /// `PrepareProfile(WorkProf, MapProf)` (private): the profile projected on yOz and
+    /// cut, split into wires ending on Oz, then into planar, vertical and other parts;
+    /// `map_prof` binds the new edges and vertices to their origin.
+    pub(super) fn prepare_profile(&self, work_prof: &mut List<Shape>, map_prof: &mut ShapeOrigins) -> Result<(), Failure> {
+        let plane = Handle::new(GeomPlane::new(Axis3::from_axis2(gp::yoz())));
+        let line: Handle<dyn Geom2dCurve> = Handle::new(Geom2dLine::new(gp::oy2d())).cast();
+        let mut map_ver_ref_moved = ShapeOrigins::default();
+        let mut wp = ProfileWires::new();
+        let mut exp = WireExplorer::with_wire(&self.my_profile)?;
+        while exp.more() {
+            let e = exp.current().clone();
+            let mut cuts = List::default();
+            cut_edge_prof(&e, &plane, &line, &mut cuts, &mut map_ver_ref_moved)?;
+            let new_wire = if cuts.is_empty() {
+                wp.add(e.as_ref())?;
+                map_prof.bind(e.as_ref().clone(), e.as_ref().clone());
+                false
+            } else {
+                Self::add_profile_pieces(&e, &mut cuts, &mut wp, map_prof)?
+            };
+            exp.next()?;
+            if exp.more() && new_wire {
+                wp.start_wire();
+            }
+        }
+        for cur_w in wp.wires.iter() {
+            split_by_kind(cur_w, work_prof)?;
+        }
+        for (key, value) in map_ver_ref_moved.items() {
+            map_prof.bind(value.clone(), key.clone());
+        }
+        Ok(())
+    }
+
+    /// The edges of one wire of the spine cut, added to `nw` and bound to their origin.
+    fn prepare_spine_wire(&self, w: &Shape, nw: &mut Shape, map_spine: &mut ShapeOrigins) -> Result<(), Failure> {
+        let bb = BRepBuilder::default();
+        for s in ShapeIterator::new(w, true, true) {
+            let e = topods::edge(&s)?;
+            let (v1, v2) = edge_vertices(&e);
+            map_spine.bind(v1.as_ref().clone(), v1.as_ref().clone());
+            map_spine.bind(v2.as_ref().clone(), v2.as_ref().clone());
+            let mut cuts = List::default();
+            cut_edge(&e, &self.my_spine, &mut cuts)?;
+            if cuts.is_empty() {
+                bb.add(nw, e.as_ref())?;
+                map_spine.bind(e.as_ref().clone(), e.as_ref().clone());
+                continue;
+            }
+            for ne in cuts.iter() {
+                bb.add(nw, ne)?;
+                map_spine.bind(ne.clone(), e.as_ref().clone());
+                let (v1, v2) = edge_vertices(&topods::edge(ne)?);
+                for v in [v1, v2] {
+                    if !map_spine.is_bound(v.as_ref()) {
+                        map_spine.bind(v.as_ref().clone(), e.as_ref().clone());
+                    }
+                }
+            }
+        }
+        Ok(())
+    }
+
+    /// `PrepareSpine(WorkSpine, MapSpine)` (private): a face on the spine surface with
+    /// the wires of its cut edges (closed flags kept), with 3d curves.
+    pub(super) fn prepare_spine(&self, work_spine: &mut Face, map_spine: &mut ShapeOrigins) -> Result<(), Failure> {
+        let bb = BRepBuilder::default();
+        let (s, l) = BRepTool::surface_with_location(&self.my_spine)?;
+        let tol_f = BRepTool::face_tolerance(&self.my_spine)?;
+        bb.make_face_on_located_surface(work_spine, &s, &l, tol_f)?;
+        let mut ws = work_spine.clone().into_shape();
+        for w in ShapeIterator::new(self.my_spine.as_ref(), true, true) {
+            let mut nw = Wire::default();
+            bb.make_wire(&mut nw);
+            let mut nw = nw.into_shape();
+            let is_closed = w.closed()?;
+            self.prepare_spine_wire(&w, &mut nw, map_spine)?;
+            nw.set_closed(is_closed)?;
+            bb.add(&mut ws, &nw)?;
+        }
+        *work_spine = topods::face(&ws)?;
+        brep_lib::build_curves3d_default(work_spine.as_ref())?;
+        Ok(())
+    }
+}
+
+/// An edge copy of `e` (FORWARD) between `v1` and `v2` over `range`.
+fn piece_of(e: &Edge, v1: &Shape, v2: &Shape, range: (f64, f64)) -> Result<Shape, Failure> {
+    let b = BRepBuilder::default();
+    let mut ne = e.as_ref().empty_copied()?;
+    ne.set_orientation(Orientation::Forward);
+    b.add(&mut ne, v1)?;
+    b.add(&mut ne, v2)?;
+    b.range(&topods::edge(&ne)?, range.0, range.1, false)?;
+    Ok(ne.oriented(e.as_ref().orientation()))
+}
+
+/// The vertex at a 2d point of the plane z = 0.
+fn vertex_at_uv(c: &Handle<Geom2dTrimmedCurve>, u: f64) -> Result<Shape, Failure> {
+    let p = c.get().ok_or_else(|| Failure::new("CutEdge: null curve"))?.value(u)?;
+    Ok(BRepLibMakeVertex::new(Point3::new(p.x(), p.y(), 0.))?.vertex()?.into_shape())
+}
+
+/// The closed circle cut in three at the thirds of its range.
+fn cut_closed_circle(e: &Edge, ct2d: &Handle<Geom2dTrimmedCurve>, (f, l): (f64, f64), cuts: &mut List<Shape>) -> Result<(), Failure> {
+    let (v1, v2) = topexp::vertices(e, false);
+    let (m1, m2) = ((2. * f + l) / 3., (f + 2. * l) / 3.);
+    let (vl1, vl2) = (vertex_at_uv(ct2d, m1)?, vertex_at_uv(ct2d, m2)?);
+    cuts.append(piece_of(e, v1.as_ref(), &vl1.oriented(Orientation::Reversed), (f, m1))?);
+    cuts.append(piece_of(e, &vl1.oriented(Orientation::Forward), &vl2.oriented(Orientation::Reversed), (m1, m2))?);
+    cuts.append(piece_of(e, &vl2.oriented(Orientation::Forward), v2.as_ref(), (m2, l))?);
+    Ok(())
+}
+
+/// `CutEdge(E, F, Cuts)` (static): the edge cut at the extrema of curvature and the
+/// inflexions of its p-curve (a closed circle in three); empty when not cut.
+fn cut_edge(e: &Edge, f: &Face, cuts: &mut List<Shape>) -> Result<(), Failure> {
+    cuts.clear();
+    let (v1, v2) = topexp::vertices(e, false);
+    let pc = BRepTool::curve_on_face(e, f)?;
+    let ct2d = Handle::new(Geom2dTrimmedCurve::new(&pc.pcurve, pc.first, pc.last, true, true)?);
+    let basis = ct2d.get().ok_or_else(|| Failure::new("CutEdge: null p-curve"))?.basis_curve();
+    if basis.is_kind_name("Geom2d_Circle") && BRepTool::is_closed(e.as_ref())? {
+        return cut_closed_circle(e, &ct2d, (pc.first, pc.last), cuts);
+    }
+    let mut cuter = Mat2dCutCurve::new();
+    cuter.perform(&ct2d.cast())?;
+    if cuter.un_modified() {
+        return Ok(());
+    }
+    let mut vf = v1.as_ref().clone();
+    let n = cuter.nb_curves()?;
+    for k in 1..=n {
+        let cc = cuter.value(k)?;
+        let ccr = cc.get().ok_or_else(|| Failure::new("CutEdge: null cut curve"))?;
+        let vl = if k == n { v2.as_ref().clone() } else { vertex_at_uv(&cc, ccr.last_parameter())? };
+        let range = (ccr.first_parameter(), ccr.last_parameter());
+        cuts.append(piece_of(e, &vf.oriented(Orientation::Forward), &vl.oriented(Orientation::Reversed), range)?);
+        vf = vl;
+    }
+    Ok(())
+}
diff --git a/crates/tkbool/src/brep_fill/evolved/statics.rs b/crates/tkbool/src/brep_fill/evolved/statics.rs
new file mode 100644
index 000000000..e16290f9d
--- /dev/null
+++ b/crates/tkbool/src/brep_fill/evolved/statics.rs
@@ -0,0 +1,224 @@
+// Rust translation of the static BRepFill_Confusion, EdgeVertices, IsVertical, IsPlanar, Side,
+// IsInversed, ConcaveSide, Bubble, Compare, Relative, PosOnFace, DoubleOrNotInFace,
+// DistanceToOZ, Altitud and SimpleExpression of
+// ModelingAlgorithms/TKBool/BRepFill/BRepFill_Evolved.cxx at
+// 3d097a0328e71b826377d4814ab05ec3c3d23871.
+
+//! The geometric predicates of the evolved shape: the position of the profile parts
+//! relative to the axis Oz, the tangents at the spine and the bisector curves.
+use rustycad_tkbrep::brep::BRepTool;
+use rustycad_tkbrep::brep_adaptor::BRepAdaptorCurve;
+use rustycad_tkbrep::topexp::{self, Explorer};
+use rustycad_tkbrep::topods::{self, Edge, Face, Shape, Vertex, Wire};
+use rustycad_tkernel::standard::{Failure, Handle};
+use rustycad_tkg2d::adaptor2d::Adaptor2dCurve2d;
+use rustycad_tkg2d::geom2d::{Geom2dCurve, Geom2dTrimmedCurve};
+use rustycad_tkg2d::geom2d_adaptor::Geom2dAdaptorCurve;
+use rustycad_tkg3d::adaptor3d::Adaptor3dCurve;
+use rustycad_tkg3d::top_abs::{Orientation, ShapeEnum};
+use rustycad_tkmath::geom_abs::CurveType;
+use rustycad_tkmath::gp::Vector3;
+use rustycad_tktopalgo::bisector::{Bisec, BisecAna};
+use rustycad_tktopalgo::brep_lib::BRepLibMakeWire;
+
+/// `BRepFill_Confusion()` (static): 1e-6.
+pub fn confusion() -> f64 {
+    1.0e-6
+}
+
+/// `EdgeVertices(E, V1, V2)` (static): the vertices of the edge in its orientation.
+pub fn edge_vertices(e: &Edge) -> (Vertex, Vertex) {
+    let (v1, v2) = topexp::vertices(e, false);
+    if e.as_ref().orientation() == Orientation::Reversed { (v2, v1) } else { (v1, v2) }
+}
+
+/// The edge is a line with both ends at the same coordinate `coord` (Y or Z).
+fn is_line_at_constant(e: &Edge, coord: fn(&rustycad_tkmath::gp::Point3) -> f64) -> Result<bool, Failure> {
+    let (v1, v2) = topexp::vertices(e, false);
+    let (p1, p2) = (BRepTool::pnt(&v1)?, BRepTool::pnt(&v2)?);
+    if (coord(&p1) - coord(&p2)).abs() >= confusion() {
+        return Ok(false);
+    }
+    Ok(BRepTool::curve_with_location(e)?.curve.is_instance_name("Geom_Line"))
+}
+
+/// `IsVertical(E)` (static): a line at constant Y.
+pub fn is_vertical(e: &Edge) -> Result<bool, Failure> {
+    is_line_at_constant(e, |p| p.y())
+}
+
+/// `IsPlanar(E)` (static): a line at constant Z.
+pub fn is_planar(e: &Edge) -> Result<bool, Failure> {
+    is_line_at_constant(e, |p| p.z())
+}
+
+/// `Side(Profil, Tol)` (static): 1 left, 4 right (a first vertex below -Tol in Y),
+/// plus 1 when planar or 2 when vertical, from the first edge of the profile.
+pub fn side(profil: &Wire, tol: f64) -> Result<i32, Failure> {
+    let first = Explorer::new(profil.as_ref(), ShapeEnum::Edge, ShapeEnum::Shape)?
+        .take(1)
+        .collect::<Vec<Shape>>()
+        .pop()
+        .ok_or_else(|| Failure::with_type("Standard_NoSuchObject", "BRepFill_Evolved Side: the profile has no edge; expected one", "BRepFill_Evolved"))?;
+    let e = topods::edge(&first)?;
+    let (v1, v2) = topexp::vertices(&e, false);
+    let (p1, p2) = (BRepTool::pnt(&v1)?, BRepTool::pnt(&v2)?);
+    let mut the_side = if p1.y() < -tol || p2.y() < -tol { 4 } else { 1 };
+    if is_vertical(&e)? {
+        the_side += 2;
+    } else if is_planar(&e)? {
+        the_side += 1;
+    }
+    Ok(the_side)
+}
+
+/// The tangent of an edge at its start in its orientation.
+fn start_tangent(e: &Edge) -> Result<Vector3, Failure> {
+    let c = BRepAdaptorCurve::with_edge(e)?;
+    if e.as_ref().orientation() == Orientation::Forward {
+        return Ok(c.d1(c.first_parameter()?)?.1);
+    }
+    Ok(c.d1(c.last_parameter()?)?.1.reversed())
+}
+
+/// `IsInversed(S, E1, E2, Inverse)` (static): for an edge `s`, whether `e1` and `e2`
+/// start against its start tangent (a degenerated one always does).
+pub fn is_inversed(s: &Shape, e1: &Edge, e2: &Edge) -> Result<[bool; 2], Failure> {
+    if s.shape_type()? != ShapeEnum::Edge {
+        return Ok([false, false]);
+    }
+    let ds = start_tangent(&topods::edge(s)?)?;
+    let inv = |e: &Edge| -> Result<bool, Failure> {
+        if BRepTool::degenerated(e)? {
+            return Ok(true);
+        }
+        Ok(ds.dot(start_tangent(e)?) < 0.)
+    };
+    Ok([inv(e1)?, inv(e2)?])
+}
+
+/// `ConcaveSide(S, F)` (static): an edge on a circle of the face turning counter
+/// clockwise in its orientation (done only for circles, as natively).
+pub fn concave_side(s: &Shape, f: &Face) -> Result<bool, Failure> {
+    if s.shape_type()? != ShapeEnum::Edge {
+        return Ok(false);
+    }
+    let pc = BRepTool::curve_on_face(&topods::edge(s)?, f)?;
+    let ac = Geom2dAdaptorCurve::with_range(&pc.pcurve, pc.first, pc.last)?;
+    if ac.get_type()? != CurveType::Circle {
+        return Ok(false);
+    }
+    let direct = ac.circle()?.is_direct();
+    Ok(if s.orientation() == Orientation::Reversed { !direct } else { direct })
+}
+
+/// `Bubble(Seq)` (static): the reals bubble sorted.
+pub fn bubble_reals(seq: &mut [f64]) {
+    let mut invert = true;
+    while invert {
+        invert = false;
+        for i in 0..seq.len().saturating_sub(1) {
+            if seq[i + 1] < seq[i] {
+                seq.swap(i, i + 1);
+                invert = true;
+            }
+        }
+    }
+}
+
+/// `Compare(E1, E2)` (static): REVERSED when the first point of `e1` is nearer the last
+/// point of `e2` than its first.
+pub fn compare(e1: &Edge, e2: &Edge) -> Result<Orientation, Failure> {
+    let (v10, _) = topexp::vertices(e1, false);
+    let (v20, v21) = topexp::vertices(e2, false);
+    let (p1, p2, p3) = (BRepTool::pnt(&v10)?, BRepTool::pnt(&v20)?, BRepTool::pnt(&v21)?);
+    Ok(if p1.distance(&p3) < p1.distance(&p2) { Orientation::Reversed } else { Orientation::Forward })
+}
+
+/// The first edge of `w` with `v` as a vertex.
+fn edge_at(w: &Wire, v: &Vertex) -> Result<Option<Edge>, Failure> {
+    for s in Explorer::new(w.as_ref(), ShapeEnum::Edge, ShapeEnum::Shape)? {
+        let e = topods::edge(&s)?;
+        let (v1, v2) = topexp::vertices(&e, false);
+        if v1.as_ref().is_same(v.as_ref()) || v2.as_ref().is_same(v.as_ref()) {
+            return Ok(Some(e));
+        }
+    }
+    Ok(None)
+}
+
+/// `Relative(W1, W2, V, Commun)` (static): whether both wires have an edge at `v`
+/// (`commun`), and FORWARD when those edges are on the same side of Oz (both strictly
+/// left, or both beyond the right side code 4), else REVERSED.
+pub fn relative(w1: &Wire, w2: &Wire, v: &Vertex) -> Result<(Orientation, bool), Failure> {
+    let (Some(e1), Some(e2)) = (edge_at(w1, v)?, edge_at(w2, v)?) else {
+        return Ok((Orientation::Forward, false));
+    };
+    let ww1 = BRepLibMakeWire::from_edge(&e1)?.wire()?;
+    let ww2 = BRepLibMakeWire::from_edge(&e2)?.wire()?;
+    let tol = confusion();
+    let (s1, s2) = (side(&ww1, tol)?, side(&ww2, tol)?);
+    if (s1 < 4 && s2 < 4) || (s1 > 4 && s2 > 4) {
+        return Ok((Orientation::Forward, true));
+    }
+    Ok((Orientation::Reversed, true))
+}
+
+/// `PosOnFace(d1, d2, d3)` (static): 1 on the d2 edge, 3 on the d3 edge, 2 strictly
+/// inside, 0 out (within the confusion).
+pub fn pos_on_face(d1: f64, d2: f64, d3: f64) -> i32 {
+    let c = confusion();
+    if (d1 - d2).abs() <= c {
+        return 1;
+    }
+    if (d1 - d3).abs() <= c {
+        return 3;
+    }
+    let (lo, hi) = if d2 < d3 { (d2, d3) } else { (d3, d2) };
+    if d1 > lo + c && d1 < hi - c { 2 } else { 0 }
+}
+
+/// `DoubleOrNotInFace(EC, V)` (static): `v` is a vertex of no edge of `ec`, or of two
+/// ends.
+pub fn double_or_not_in_face(ec: &[Shape], v: &Vertex) -> Result<bool, Failure> {
+    let mut vu = false;
+    for s in ec {
+        let (v1, v2) = topexp::vertices(&topods::edge(s)?, false);
+        for end in [v1, v2] {
+            if end.as_ref().is_same(v.as_ref()) {
+                if vu {
+                    return Ok(true);
+                }
+                vu = true;
+            }
+        }
+    }
+    Ok(!vu)
+}
+
+/// `DistanceToOZ(V)` (static): |Y| of the vertex point.
+pub fn distance_to_oz(v: &Vertex) -> Result<f64, Failure> {
+    Ok(BRepTool::pnt(v)?.y().abs())
+}
+
+/// `Altitud(V)` (static): Z of the vertex point.
+pub fn altitud(v: &Vertex) -> Result<f64, Failure> {
+    Ok(BRepTool::pnt(v)?.z())
+}
+
+/// `SimpleExpression(B, Bis)` (static): the bisector curve, its analytic basis
+/// trimmed in place of a trimmed Bisector_BisecAna.
+pub fn simple_expression(b: &Bisec) -> Result<Handle<dyn Geom2dCurve>, Failure> {
+    let value = b.value();
+    let bis: Handle<dyn Geom2dCurve> = value.clone().cast();
+    let Some(tr_bis) = value.get() else {
+        return Ok(bis);
+    };
+    let bas_bis = tr_bis.basis_curve();
+    let ana: Handle<BisecAna> = bas_bis.cast();
+    let Some(ana) = ana.get() else {
+        return Ok(bis);
+    };
+    let curve = ana.geom2d_curve();
+    Ok(Handle::new(Geom2dTrimmedCurve::new(&curve, tr_bis.first_parameter(), tr_bis.last_parameter(), true, true)?).cast())
+}
diff --git a/crates/tkbool/src/brep_fill/evolved/trim.rs b/crates/tkbool/src/brep_fill/evolved/trim.rs
new file mode 100644
index 000000000..8df7a2db4
--- /dev/null
+++ b/crates/tkbool/src/brep_fill/evolved/trim.rs
@@ -0,0 +1,204 @@
+// Rust translation of the static TrimFace, AddDegeneratedEdge and TrimEdge of
+// ModelingAlgorithms/TKBool/BRepFill/BRepFill_Evolved.cxx at
+// 3d097a0328e71b826377d4814ab05ec3c3d23871.
+
+//! The trimming of the tubes and revolutions: their parallel edges cut between the
+//! vertices of the bisectors, their faces bounded by the wires of the trimming edges.
+use super::statics::{double_or_not_in_face, edge_vertices};
+use rustycad_tkbrep::brep::{BRepBuilder, BRepTool};
+use rustycad_tkbrep::brep_tools::{self, WireExplorer};
+use rustycad_tkbrep::topods::{self, Edge, Face, Shape, Vertex, Wire};
+use rustycad_tkernel::standard::{Failure, Handle};
+use rustycad_tkg2d::geom2d::{Geom2dCurve, Geom2dLine};
+use rustycad_tkg3d::top_abs::Orientation;
+use rustycad_tkmath::gp::{Direction2, Point2, Vector2};
+use rustycad_tktopalgo::brep_lib::{self, BRepLibMakeEdge, BRepLibMakeWire, BRepLibWireError};
+
+/// The vertices of `ver` (with their parameters) sorted by parameter.
+fn sort_by_parameter(ver: &mut [Shape], par: &mut [f64]) {
+    let mut change = true;
+    while change {
+        change = false;
+        for i in 0..par.len().saturating_sub(1) {
+            if par[i] > par[i + 1] {
+                par.swap(i, i + 1);
+                ver.swap(i, i + 1);
+                change = true;
+            }
+        }
+    }
+}
+
+/// The vertices not in the control edges, or in two, removed; then of two equal
+/// neighbours one kept (both removed when in two control edges).
+fn filter_vertices(control: &[Shape], ver: &mut Vec<Shape>, par: &mut Vec<f64>) -> Result<(), Failure> {
+    let mut k = 0;
+    while k < ver.len() {
+        if double_or_not_in_face(control, &topods::vertex(&ver[k])?)? {
+            ver.remove(k);
+            par.remove(k);
+        } else {
+            k += 1;
+        }
+    }
+    let mut k: isize = 0;
+    while (k as usize) + 1 < ver.len() {
+        let ku = k as usize;
+        if ver[ku].is_same(&ver[ku + 1]) {
+            ver.remove(ku + 1);
+            par.remove(ku + 1);
+            if double_or_not_in_face(control, &topods::vertex(&ver[ku])?)? {
+                ver.remove(ku);
+                par.remove(ku);
+            }
+            k -= 1;
+        }
+        k += 1;
+    }
+    Ok(())
+}
+
+/// `TrimEdge(Edge, TheEdgesControle, TheVer, ThePar, S)` (static): the vertices sorted
+/// by parameter (and filtered by the control edges for a non degenerated edge), then
+/// a copy of the edge between each odd vertex and the next.
+pub fn trim_edge(edge: &Edge, the_edges_controle: &[Shape], the_ver: &mut Vec<Shape>, the_par: &mut Vec<f64>) -> Result<Vec<Shape>, Failure> {
+    sort_by_parameter(the_ver, the_par);
+    if !BRepTool::degenerated(edge)? {
+        filter_vertices(the_edges_controle, the_ver, the_par)?;
+    }
+    let b = BRepBuilder::default();
+    let mut s = Vec::new();
+    let mut k = 0;
+    while k + 1 < the_ver.len() {
+        let mut new_edge = edge.as_ref().empty_copied()?;
+        let (o1, o2) = if new_edge.orientation() == Orientation::Reversed { (Orientation::Reversed, Orientation::Forward) } else { (Orientation::Forward, Orientation::Reversed) };
+        b.add(&mut new_edge, &the_ver[k].oriented(o1))?;
+        b.add(&mut new_edge, &the_ver[k + 1].oriented(o2))?;
+        b.range(&topods::edge(&new_edge)?, the_par[k], the_par[k + 1], false)?;
+        // NIZHNY-EAP 1999-12-22
+        brep_lib::update_tolerances(&new_edge, false)?;
+        s.push(new_edge);
+        k += 2;
+    }
+    Ok(s)
+}
+
+/// The UV ends of an edge on the face in the edge orientation.
+fn oriented_uv_points(ce: &Edge, f: &Face) -> Result<(Point2, Point2), Failure> {
+    let (pa, pb) = BRepTool::uv_points_on_face(ce, f)?;
+    Ok(if ce.as_ref().orientation() == Orientation::Reversed { (pb, pa) } else { (pa, pb) })
+}
+
+/// A degenerated edge of the surface of `f` from `p` to `q` at the vertex `v`, added
+/// to the wire.
+fn add_degenerated(f: &Face, w: &mut Shape, v: &Vertex, p: Point2, q: Point2) -> Result<(), Failure> {
+    let s = BRepTool::surface(f)?;
+    let c2d: Handle<dyn Geom2dCurve> = Handle::new(Geom2dLine::from_point(p, Direction2::from_vector(Vector2::between(p, q))?)).cast();
+    let (first, last) = (0., p.distance(q));
+    let ne = BRepLibMakeEdge::from_pcurve(&c2d, &s)?.edge()?;
+    let b = BRepBuilder::default();
+    b.degenerated(&ne, true)?;
+    let mut ne = ne.into_shape();
+    b.add(&mut ne, &v.as_ref().oriented(Orientation::Forward))?;
+    b.add(&mut ne, &v.as_ref().oriented(Orientation::Reversed))?;
+    b.range(&topods::edge(&ne)?, first, last, false)?;
+    b.add(w, &ne)
+}
+
+/// One pass of AddDegeneratedEdge: the first gap in UV between consecutive edges (or
+/// the closing gap of a closed wire) filled; whether one was filled.
+fn fill_one_gap(f: &Face, w: &mut Shape, tol_conf: f64) -> Result<bool, Failure> {
+    let mut we = WireExplorer::with_wire_on_face(&topods::wire(w)?, f)?;
+    let (mut vf, mut pf, mut prev_p) = (Vertex::default(), Point2::default(), Point2::default());
+    let (mut v2, mut p2) = (Vertex::default(), Point2::default());
+    while we.more() {
+        let ce = we.current().clone();
+        let (v1, v2c) = edge_vertices(&ce);
+        let (p1, p2c) = oriented_uv_points(&ce, f)?;
+        (v2, p2) = (v2c, p2c);
+        if vf.as_ref().is_null() {
+            (vf, pf) = (v1, p1);
+        } else if !p1.is_equal(prev_p, tol_conf) {
+            add_degenerated(f, w, &v1, prev_p, p1)?;
+            return Ok(true);
+        }
+        prev_p = p2;
+        we.next()?;
+    }
+    if vf.as_ref().is_same(v2.as_ref()) && !pf.is_equal(p2, tol_conf) {
+        add_degenerated(f, w, &vf, p2, pf)?;
+        return Ok(true);
+    }
+    Ok(false)
+}
+
+/// `AddDegeneratedEdge(F, W)` (static): the missing degenerated edges of the wire on a
+/// non planar face (vertices at nodes of the map), found by comparing the UV points
+/// of consecutive vertices within 1e-4.
+fn add_degenerated_edge(f: &Face, w: &mut Shape) -> Result<(), Failure> {
+    let s = BRepTool::surface(f)?;
+    if s.is_instance_name("Geom_Plane") {
+        return Ok(());
+    }
+    if s.is_instance_name("Geom_RectangularTrimmedSurface") {
+        let rts: Handle<rustycad_tkg3d::geom::GeomRectangularTrimmedSurface> = s.cast();
+        if let Some(r) = rts.get()
+            && r.basis_surface().is_instance_name("Geom_Plane")
+        {
+            return Ok(());
+        }
+    }
+    while fill_one_gap(f, w, 1.0e-4)? {}
+    Ok(())
+}
+
+/// One wire of TrimFace: the first edge then every edge that connects (degenerated
+/// edges dropped), restarting after each success.
+fn connected_wire(the_edges: &mut Vec<Shape>) -> Result<Wire, Failure> {
+    let first = the_edges.remove(0);
+    let mut m_wire = BRepLibMakeWire::from_edge(&topods::edge(&first)?)?;
+    let mut good_wire = m_wire.wire()?;
+    loop {
+        let mut add_edge = false;
+        let mut i = 0;
+        while i < the_edges.len() && !add_edge {
+            let e = topods::edge(&the_edges[i])?;
+            if BRepTool::degenerated(&e)? {
+                the_edges.remove(i);
+                add_edge = true;
+                good_wire = m_wire.wire()?;
+                continue;
+            }
+            m_wire.add_edge(&e)?;
+            if m_wire.error() == BRepLibWireError::WireDone {
+                the_edges.remove(i);
+                add_edge = true;
+                good_wire = m_wire.wire()?;
+                continue;
+            }
+            i += 1;
+        }
+        if !add_edge {
+            return Ok(good_wire);
+        }
+    }
+}
+
+/// `TrimFace(Face, TheEdges, S)` (static): the faces (copies of `face`) bounded by the
+/// wires connecting the edges, completed with degenerated edges.
+pub fn trim_face(face: &Face, the_edges: &mut Vec<Shape>) -> Result<Vec<Shape>, Failure> {
+    let mut s = Vec::new();
+    while !the_edges.is_empty() {
+        let good_wire = connected_wire(the_edges)?;
+        let mut face_cut = face.as_ref().empty_copied()?;
+        face_cut.set_orientation(Orientation::Forward);
+        let fc = topods::face(&face_cut)?;
+        brep_tools::update_face(&fc)?;
+        let mut w = good_wire.into_shape();
+        add_degenerated_edge(&fc, &mut w)?;
+        BRepBuilder::default().add(&mut face_cut, &w)?;
+        face_cut.set_orientation(face.as_ref().orientation());
+        s.push(face_cut);
+    }
+    Ok(s)
+}
