# Draw_GraphicCommands in batch mode: no views exist.
puts "view: [catch {view 1 +X+Y} message] <$message>"
puts "zoom all: [zoom 2] [2dzoom 2]"
puts "zoom view: [catch {zoom 1 2} message] <$message>"
puts "zoom bad id: [catch {zoom 99 2} message]"
puts "fit: [fit] [2dfit] [catch {fit 3} message]"
puts "delete: [delete] [catch {delete 2} message]"
puts "mu/md: [mu] [md] [2dmu] [2dmd] [catch {mu 4} message]"
puts "rotate: [u] [d] [l] [r] [catch {u 5} message]"
puts "pan: [pu] [pd] [pl] [pr] [2dpu] [2dpd] [2dpl] [2dpr]"
puts "focal: [fu] [fd] <[focal]> [focal 100]"
puts "ptv: [ptv 1 2 3] [dptv 1 2 3] [catch {ptv 1} message]"
puts "color: [color] [color 3 Red]"
puts "hcolor: [string map {\n | \t ~} [hcolor]]"
puts "hcolor set: [hcolor 1 2 0.5]"
puts "dfont: [dfont] [dfont Courier] [dfont Times 120] [dfont]"
puts "grid: [grid] [grid 10] [grid 1 2] [grid 1 2 3] [catch {grid 1 2 3 4} message]"
puts "dflush: [dflush]"
puts "dtext: [dtext 1 2 a2d] [dtext 1 2 3 a3d] [dtext x]"
puts "xwd: [catch {xwd file.png} message]"
puts "wzoom args: [catch {wzoom 1 2} message] <$message>"
puts "wzoom bad: [catch {wzoom 99 0 0 1 1} message]"
